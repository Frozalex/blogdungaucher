# Hostinger / Apache  -  Astro avec trailingSlash: "always"
# Les rubriques sont des dossiers (/fr/science/) avec index.html dedans.
# Sans slash final, Apache peut répondre 404 ; on redirige vers la même URL avec /

DirectoryIndex index.html index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/ [R=301,L,QSA]
</IfModule>

# ── Redirections 301 : résolution cannibalisation SEO ──
# Articles fusionnés vers leur version canonique. Les anciennes URLs
# transfèrent leur autorité vers la cible et évitent les doublons d'index.

# Groupe 1 — Syndrome de l'imposteur (esprit)
Redirect 301 /fr/blog/echecs-et-syndrome-imposteur/ /fr/blog/syndrome-imposteur-aux-echecs/
Redirect 301 /en/blog/chess-impostor-syndrome/ /en/blog/impostor-syndrome-in-chess/

# Groupe 2 — Échecs et cerveau (science)
Redirect 301 /fr/blog/bienfaits-des-echecs-sur-le-cerveau/ /fr/blog/les-echecs-et-le-cerveau/
Redirect 301 /en/blog/chess-benefits-for-the-brain/ /en/blog/chess-and-the-brain/

# Groupe 3 — Vieillissement / Alzheimer / Seniors (science)
Redirect 301 /fr/blog/echecs-et-seniors/ /fr/blog/echecs-alzheimer-prevention-declin-cognitif/
Redirect 301 /fr/blog/echecs-vieillissement-cognitif/ /fr/blog/echecs-alzheimer-prevention-declin-cognitif/
Redirect 301 /en/blog/chess-and-seniors/ /en/blog/chess-and-alzheimer-prevention/
Redirect 301 /en/blog/chess-and-cognitive-aging/ /en/blog/chess-and-alzheimer-prevention/

# Groupe 4 — Grand oral Maths (FR uniquement, pas de traduction EN existante)
Redirect 301 /fr/blog/grand-oral-maths-spe-echecs/ /fr/blog/guide-grand-oral-echecs-maths/
