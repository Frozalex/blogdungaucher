---
import BaseLayout from "../layouts/BaseLayout.astro";

/* Détecte la langue depuis l'URL : Astro sert 404 en SSR-statique, donc
   `Astro.url.pathname` reflète le chemin demandé par l'utilisateur (ex.
   `/en/blog/foo-non-existant`). On adapte les CTAs en conséquence. */
const pathname = Astro.url.pathname || "/";
const lang: "fr" | "en" = pathname.startsWith("/en/")
  ? "en"
  : "fr";

const copy = {
  fr: {
    title: "Page introuvable | Blog d'un Gaucher",
    description: "La page demandée n'existe pas.",
    eyebrow: "Échec et mat",
    h1: "Cette page a quitté l'échiquier.",
    lead: "La position recherchée n'existe pas, ou a été déplacée vers une autre case.",
    quote: "On ne peut pas gagner sans risquer de perdre.",
    quoteAuthor: "Emanuel Lasker",
    home: "Retour à l'accueil",
    blog: "Tous les articles",
    search: "Rechercher",
    homeHref: "/fr/",
    blogHref: "/fr/blog/",
    searchHref: "/fr/recherche/",
  },
  en: {
    title: "Page not found | A Left-Hander's Blog",
    description: "The page you are looking for does not exist.",
    eyebrow: "Checkmate",
    h1: "This page has left the board.",
    lead: "The position you requested does not exist or has been moved to another square.",
    quote: "You cannot win without risking losing.",
    quoteAuthor: "Emanuel Lasker",
    home: "Back to home",
    blog: "All articles",
    search: "Search",
    homeHref: "/en/",
    blogHref: "/en/blog/",
    searchHref: "/en/recherche/",
  },
};
const t = copy[lang];
---
<BaseLayout
  title={t.title}
  description={t.description}
  canonicalPath="/404"
  lang={lang as "fr" | "en"}
  noindex={true}
>
  <section class="nf">
    <div class="container nf-container">
      <span class="eyebrow">{t.eyebrow}</span>
      <span class="nf-code" aria-hidden="true">404</span>
      <h1 class="nf-title">{t.h1}</h1>
      <p class="nf-lead">{t.lead}</p>

      <figure class="nf-quote">
        <blockquote>{t.quote}</blockquote>
        <figcaption>{t.quoteAuthor}</figcaption>
      </figure>

      <div class="section-divider section-divider--editorial" aria-hidden="true"><span></span></div>

      <div class="nf-actions">
        <a href={t.homeHref} class="button-primary">{t.home}</a>
        <a href={t.blogHref} class="button-secondary">{t.blog}</a>
        <a href={t.searchHref} class="button-secondary">{t.search}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding: 4.5rem 0 6rem;
    position: relative;
  }
  .nf-container {
    max-width: 38rem;
    text-align: center;
  }

  .eyebrow {
    margin-bottom: 1.25rem;
  }

  .nf-code {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(6rem, 18vw, 11rem);
    line-height: 0.95;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--green) 32%, var(--border-strong));
    margin: 0.5rem 0 0.25rem;
    letter-spacing: -0.03em;
    font-optical-sizing: auto;
    user-select: none;
  }

  .nf-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--text-main);
    margin: 0.5rem 0 0.75rem;
    font-optical-sizing: auto;
  }

  .nf-lead {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 auto;
    max-width: 28rem;
  }

  .nf-quote {
    margin: 2.5rem auto 0;
    max-width: 26rem;
  }
  .nf-quote blockquote {
    margin: 0;
    padding: 0;
    border: none;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.5;
    color: var(--text-main);
    font-optical-sizing: auto;
  }
  .nf-quote blockquote::before {
    content: "« ";
    color: var(--green);
  }
  .nf-quote blockquote::after {
    content: " »";
    color: var(--green);
  }
  .nf-quote figcaption {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .nf-quote figcaption::before {
    content: none;
  }

  .nf-actions {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.5rem;
  }
</style>
