---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  grappeText,
  itemLabel,
  seriePsychologieGrappes,
  seriePsychologieTotal,
} from "../../../data/serie-psychologie";
import {
  absoluteUrl,
  buildBreadcrumbJsonLd,
  filterPostsForLang,
  formatDateForLang,
  getAllPosts,
  getLocalizedPostText,
  getPostUrlEn,
} from "../../../utils/blog";

const LANG = "en" as const;

// Même logique que la page FR : getAllPosts() ne renvoie que les articles déjà publiés, donc la
// série se dévoile au fil des semaines. Les articles à venir restent listés sans lien.
// Différence ici : le titre et l'extrait viennent de la traduction, et l'URL du slug localisé.
const published = filterPostsForLang(await getAllPosts(), LANG);
const bySlug = new Map(published.map((post) => [post.id.split("/").pop() ?? post.id, post]));

const grappes = await Promise.all(
  seriePsychologieGrappes.map(async (grappe) => ({
    id : grappe.id,
    ...grappeText(grappe, LANG),
    items : await Promise.all(
      grappe.items.map(async (item) => {
        const post = bySlug.get(item.slug);
        if (!post) {
          return { ...item, href : null, date : null, title : itemLabel(item, LANG), excerpt : null };
        }
        const text = await getLocalizedPostText(post, LANG);
        return {
          ...item,
          href : await getPostUrlEn(post),
          date : formatDateForLang(post.data.publishDate, LANG),
          title : text.title,
          excerpt : text.excerpt,
        };
      }),
    ),
  })),
);

const publishedCount = grappes.reduce(
  (total, grappe) => total + grappe.items.filter((item) => item.href).length,
  0,
);

const canonPath = "/en/series/psychologie/";
const title = "Series: The Psychology of Chess";
const description =
  `A ${seriePsychologieTotal}-article series on what psychology actually says about the chess player: bias, memory, motivation, influence and status. Every concept is set against its critique.`;

// ItemList : rend la série citable comme un ensemble, et pas seulement article par article.
const structuredData = [
  buildBreadcrumbJsonLd([
    { name : "Home", path : "/en/" },
    { name : "Series", path : "/en/series/" },
    { name : "Psychology", path : canonPath },
  ]),
  {
    "@context" : "https://schema.org",
    "@type" : "CollectionPage",
    name : title,
    description,
    url : absoluteUrl(canonPath),
    inLanguage : "en",
    mainEntity : {
      "@type" : "ItemList",
      numberOfItems : publishedCount,
      itemListElement : grappes
        .flatMap((grappe) => grappe.items)
        .filter((item) => item.href)
        .map((item, index) => ({
          "@type" : "ListItem",
          position : index + 1,
          url : absoluteUrl(item.href as string),
          name : item.title,
        })),
    },
  },
];
---

<BaseLayout
  title={`${title} | Blog d’un Gaucher`}
  description={description}
  canonicalPath={canonPath}
  structuredData={structuredData}
  lang="en"
>
  <main class="serie">
    <header class="serie__hero">
      <p class="serie__eyebrow">A series in {seriePsychologieTotal} articles</p>
      <h1>The psychology of chess</h1>
      <p class="serie__lede">
        Chess produces a rare kind of information: an unambiguous defeat, with no teammate to pin it
        on, no element of luck, public and frequent. That is what makes it the best observation
        ground there is for understanding how a brain handles what contradicts it.
      </p>
      <p class="serie__lede">
        Every article opens on a scene from a game, cites the founding study <strong>and its
        critique</strong>, and ends with one thing to do. Several classics you think you know did not
        survive replication: that gets said every time.
      </p>
      <p class="serie__progress">
        <strong>{publishedCount}</strong> of {seriePsychologieTotal} article{seriePsychologieTotal > 1 ? "s" : ""} published.
      </p>
    </header>

    {grappes.map((grappe) => (
      <section class="grappe" id={grappe.id}>
        <h2>{grappe.titre}</h2>
        <p class="grappe__chapeau">{grappe.chapeau}</p>
        <ol class="grappe__list">
          {grappe.items.map((item) => (
            <li class:list={["item", { "item--pilier" : item.pilier, "item--soon" : !item.href }]}>
              {item.href ? (
                <a href={item.href}>
                  <span class="item__title">{item.title}</span>
                  {item.excerpt && <span class="item__excerpt">{item.excerpt}</span>}
                  <span class="item__meta">
                    <span class="item__date">{item.date}</span>
                  </span>
                </a>
              ) : (
                <div>
                  <span class="item__title">{item.title}</span>
                  <span class="item__meta">
                    <span class="item__date">coming soon</span>
                  </span>
                </div>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .serie {
    max-width: var(--container);
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }

  .serie__hero {
    max-width: 46rem;
    margin-bottom: 3.5rem;
  }

  .serie__eyebrow {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.75rem;
  }

  .serie__hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .serie__lede {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .serie__progress {
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    background: var(--surface-warm);
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .grappe {
    margin-bottom: 3rem;
  }

  .grappe h2 {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    margin-bottom: 0.4rem;
  }

  .grappe__chapeau {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
    max-width: 44rem;
  }

  .grappe__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .item > a,
  .item > div {
    display: block;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  .item > a:hover,
  .item > a:focus-visible {
    border-color: var(--green-border);
    transform: translateX(2px);
  }

  .item--pilier > a,
  .item--pilier > div {
    border-left: 3px solid var(--green);
  }

  .item--soon > div {
    background: transparent;
    border-style: dashed;
    opacity: 0.6;
  }

  .item__title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .item__excerpt {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .item__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }


  .item__date {
    font-size: 0.8rem;
    color: var(--text-dim);
  }
</style>
