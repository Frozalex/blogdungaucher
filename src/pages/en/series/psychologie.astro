---
import EditorialSeriesHeader from "../../../components/EditorialSeriesHeader.astro";
import EditorialSeriesCard from "../../../components/EditorialSeriesCard.astro";
import "../../../styles/editorial-resources.css";
import "../../../styles/editorial-series.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  grappeText,
  seriePsychologieGrappes,
  seriePsychologieTotal,
} from "../../../data/serie-psychologie";
import {
  absoluteUrl,
  buildBreadcrumbJsonLd,
  filterPostsForLang,
  formatDateForLang,
  getAllPosts,
  getLocalizedPostText,
  getPostUrlEn,
} from "../../../utils/blog";

const LANG = "en" as const;

// Même logique que la page FR : getAllPosts() ne renvoie que les articles déjà publiés, donc la
// série se dévoile au fil des semaines. Les articles à venir restent listés sans lien.
// Différence ici : le titre et l'extrait viennent de la traduction, et l'URL du slug localisé.
const published = filterPostsForLang(await getAllPosts(), LANG);
const bySlug = new Map(published.map((post) => [post.id.split("/").pop() ?? post.id, post]));

// Seuls les articles publiés sont affichés : pas de ligne « coming soon » sans lien.
const grappesRaw = await Promise.all(
  seriePsychologieGrappes.map(async (grappe) => ({
    id : grappe.id,
    ...grappeText(grappe, LANG),
    items : await Promise.all(
      grappe.items
        .filter((item) => bySlug.has(item.slug))
        .map(async (item) => {
          const post = bySlug.get(item.slug)!;
          const text = await getLocalizedPostText(post, LANG);
          return {
            ...item,
            post,
            href : await getPostUrlEn(post),
            date : formatDateForLang(post.data.publishDate, LANG),
            title : text.title,
            excerpt : text.excerpt,
          };
        }),
    ),
  })),
);
const grappes = grappesRaw.filter((grappe) => grappe.items.length > 0);

const publishedCount = grappes.reduce((total, grappe) => total + grappe.items.length, 0);

const canonPath = "/en/series/psychologie/";
const title = "Series: The Psychology of Chess";
const description =
  `A ${seriePsychologieTotal}-article series on what psychology actually says about the chess player: bias, memory, motivation, influence and status. Every concept is set against its critique.`;

// ItemList : rend la série citable comme un ensemble, et pas seulement article par article.
const structuredData = [
  buildBreadcrumbJsonLd([
    { name : "Home", path : "/en/" },
    { name : "Series", path : "/en/series/" },
    { name : "Psychology", path : canonPath },
  ]),
  {
    "@context" : "https://schema.org",
    "@type" : "CollectionPage",
    name : title,
    description,
    url : absoluteUrl(canonPath),
    inLanguage : "en",
    mainEntity : {
      "@type" : "ItemList",
      numberOfItems : publishedCount,
      itemListElement : grappes
        .flatMap((grappe) => grappe.items)
        .filter((item) => item.href)
        .map((item, index) => ({
          "@type" : "ListItem",
          position : index + 1,
          url : absoluteUrl(item.href as string),
          name : item.title,
        })),
    },
  },
];
---
<BaseLayout
  title={`${title} | Blog d’un Gaucher`}
  description={description}
  canonicalPath={canonPath}
  structuredData={structuredData}
  lang="en"
>
<div class="resource-page"><div class="container">
<EditorialSeriesHeader lang="en" active="psychologie" title="The psychology of chess" published={publishedCount} total={seriePsychologieTotal}>
      <p>
        Chess produces a rare kind of information: an unambiguous defeat, with no teammate to pin it
        on, no element of luck, public and frequent. That is what makes it the best observation
        ground there is for understanding how a brain handles what contradicts it.
      </p>
      <p>
        Every article opens on a scene from a game, cites the founding study <strong>and its
        critique</strong>, and ends with one thing to do. Several classics you think you know did not
        survive replication: that gets said every time.
      </p>

<Fragment slot="status">{grappes[0]?.items[0]&&<a class="resource-button" href={grappes[0].items[0].href}>Start reading →</a>}<a class="resource-link series-status-link" href="#parcours">Explore the themes ↓</a></Fragment>
</EditorialSeriesHeader>
<nav class="series-jumps" id="parcours" aria-label="Explore the themes"><span>Explore the themes</span><ol>{grappes.map((grappe,i)=><li><a href={`#${grappe.id}`}>{String(i+1).padStart(2,"0")} · {grappe.titre}</a></li>)}</ol></nav>
{grappes.map((grappe,i)=><section class="series-section" id={grappe.id}><div class="series-section__heading"><span class="series-section__number" aria-hidden="true">{String(i+1).padStart(2,"0")}</span><h2>{grappe.titre}</h2></div><p class="series-section__intro">{grappe.chapeau}</p><ol class:list={["series-articles",{"series-articles--single":grappe.items.length===1,"series-articles--pair":grappe.items.length===2}]}>{grappe.items.map(item=><li><EditorialSeriesCard lang="en" post={item.post} title={item.title} excerpt={item.excerpt} href={item.href} pilier={item.pilier} /></li>)}</ol></section>)}
<div class="resource-end"><a class="resource-link" href="/en/series/">← All series</a></div>
</div></div>
</BaseLayout>
