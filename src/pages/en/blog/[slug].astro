---
import { render, getEntry } from "astro:content";

// KaTeX CSS chargé ici (et non dans BaseLayout) : seuls les articles peuvent contenir des formules.
import "katex/dist/katex.min.css";

import AdBanner from "../../../components/AdBanner.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TableOfContents from "../../../components/TableOfContents.astro";
import ShareButtons from "../../../components/ShareButtons.astro";
import Comments from "../../../components/Comments.astro";
import FocusMode from "../../../components/FocusMode.astro";
import TextHighlight from "../../../components/TextHighlight.astro";

import { categoryMap, siteConfig } from "../../../data/site";
import {
  absoluteUrl,
  buildArticleJsonLd,
  buildBreadcrumbJsonLd,
  buildFaqJsonLd,
  calculateReadingTime,
  formatDateEn,
  filterPostsForLang,
  getAllPosts,
  getEnSlugMap,
  getPostSlug,
  getPostUrl,
  getPostUrlEn,
  getPostUrlEnSync,
  getPostUrlPtBr,
  getPostHeroSrc,
} from "../../../utils/blog";
import { renderEnglishMarkdown } from "../../../utils/english-article";
import { swapLangPrefix } from "../../../utils/lang-paths";
import {
  renderMarkdownToArticleHtml,
  stripFaqH2Section,
} from "../../../utils/markdown-strip-faq";
import FAQ from "../../../components/FAQ.astro";
import ArticleVideo from "../../../components/ArticleVideo.astro";
import KeyTakeaways from "../../../components/KeyTakeaways.astro";
import { isPublicAssetAvailable } from "../../../utils/public-asset";

export async function getStaticPaths() {
  const posts = filterPostsForLang(await getAllPosts(), "en");
  const enSlugMap = await getEnSlugMap();
  return posts.map((post) => {
    const frSlug = getPostSlug(post);
    const enSlug = enSlugMap.get(frSlug) ?? frSlug;
    return { params: { slug: enSlug }, props: { post, frSlug, enSlug } };
  });
}

const { post, frSlug, enSlug } = Astro.props as {
  post: Awaited<ReturnType<typeof getAllPosts>>[number];
  frSlug: string;
  enSlug: string;
};
const slug = frSlug;

// Récupère la traduction EN depuis la collection enTranslations (si elle existe
// ET qu'elle n'est pas marquée draft). Une traduction en draft est ignorée comme
// si elle n'existait pas : la page affiche le contenu FR + bandeau d'avertissement.
const enEntryRaw = await getEntry("enTranslations", slug);
const enEntry = enEntryRaw && !enEntryRaw.data.draft ? enEntryRaw : undefined;
const englishMarkdown = enEntry?.body;

const faqsForDisplay = enEntry?.data?.faq ?? post.data.faq ?? [];
const stripInlineFaq = faqsForDisplay.length > 0;
const mdSource = englishMarkdown ?? post.body;
const mdForArticle = stripInlineFaq ? stripFaqH2Section(mdSource) : mdSource;

let Content: Awaited<ReturnType<typeof render>>["Content"] | undefined;
let headings: Awaited<ReturnType<typeof render>>["headings"];
let englishHtml: string | undefined;

if (englishMarkdown) {
  const rendered = stripInlineFaq
    ? renderEnglishMarkdown(mdForArticle)
    : renderEnglishMarkdown(englishMarkdown);
  englishHtml = rendered.html;
  headings = rendered.headings;
} else if (stripInlineFaq) {
  const r = await renderMarkdownToArticleHtml(mdForArticle);
  englishHtml = r.html;
  headings = r.headings;
} else {
  const r = await render(post);
  Content = r.Content;
  headings = r.headings;
}

const category = categoryMap[post.data.category];

const readingTime =
  post.data.readingTime ??
  (englishMarkdown ? calculateReadingTime(englishMarkdown) : calculateReadingTime(post.body));

const allPosts = await getAllPosts();
const currentTags = new Set(post.data.tags ?? []);
const related = filterPostsForLang(
  allPosts
    .filter((e) => e.id !== post.id)
    .map((e) => {
      const sharedTags = (e.data.tags ?? []).filter((t) => currentTags.has(t)).length;
      const sameCategory = e.data.category === post.data.category ? 1 : 0;
      return { entry: e, score: sharedTags * 2 + sameCategory };
    })
    .filter(({ score }) => score > 0)
    .sort((a, b) => b.score - a.score)
    .map(({ entry }) => entry),
  "en",
).slice(0, 3);

const relatedWithUrls = await Promise.all(
  related.map(async (e) => ({ entry: e, url: await getPostUrlEn(e) })),
);

const postUrlEn = getPostUrlEnSync(post, enSlug);
const postUrlPtBr = await getPostUrlPtBr(post);
const postUrlFr = getPostUrl(post);
const absolutePostUrl = absoluteUrl(postUrlEn);

// Métadonnées EN : issues de enTranslations, fallback sur FR
const enTitle        = enEntry?.data?.seoTitle ?? enEntry?.data?.title ?? post.data.seoTitle ?? post.data.title;
const enDesc         = enEntry?.data?.seoDescription ?? enEntry?.data?.excerpt ?? post.data.seoDescription ?? post.data.excerpt;
const displayTitle   = enEntry?.data?.title   ?? post.data.title;
const displayExcerpt = enEntry?.data?.excerpt ?? post.data.excerpt;
const hasEnTranslation = !!enEntry;

const heroSrc = getPostHeroSrc(post);
const heroImage = heroSrc ? post.data.heroImage : undefined;

const summaryVideoSrc = post.data.summaryVideo?.trim();
const showSummaryVideo =
  !!summaryVideoSrc && isPublicAssetAvailable(summaryVideoSrc);

const enCategoryLabels: Record<string, string> = {
  science: "Science",
  esprit: "Mind",
  societe: "Society",
};
const enCategoryLabel = enCategoryLabels[post.data.category] ?? category.label;
const enCategoryHref = swapLangPrefix(category.href, "en");

const structuredData = [
  await buildArticleJsonLd(post, { lang: "en", headline: enTitle, description: enDesc, pageUrl: postUrlEn }),
  buildBreadcrumbJsonLd([
    { name: "Home", path: "/en/" },
    { name: "Articles", path: "/en/blog/" },
    { name: displayTitle, path: postUrlEn },
  ]),
  ...(faqsForDisplay.length > 0 ? [buildFaqJsonLd(faqsForDisplay)] : []),
];

---
<BaseLayout
  title={`${enTitle} | A Left-Hander's Blog`}
  description={enDesc}
  canonicalPath={postUrlEn}
  lang="en"
  frPath={postUrlFr}
  enPath={postUrlEn}
  ptBrPath={postUrlPtBr}
  image={post.data.ogImage ?? siteConfig.defaultOgImage}
  type="article"
  publishDate={post.data.publishDate}
  modifiedDate={post.data.updatedDate ?? post.data.publishDate}
  section={enCategoryLabel}
  structuredData={structuredData}
  accentColor={category.accent}
  tags={post.data.tags}
>
  <article class="article-page" style={`--c:${category.accent}`}>
    {/* Thin breadcrumb above the hero */}
    <div class="container">
      <nav class="hero-breadcrumb" aria-label="Breadcrumb">
        <a href="/en/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/en/blog/">Articles</a>
        <span aria-hidden="true">›</span>
        <a href={enCategoryHref} style={`color:${category.accent}`}>{enCategoryLabel}</a>
      </nav>
    </div>

    <!-- ── PT's Coffee hero: full-height photo + overlapping white-box title ── -->
    <div class={`article-hero${(!showSummaryVideo && heroSrc && heroImage) ? " article-hero--has-image" : " article-hero--placeholder"}`}>

      {!showSummaryVideo && heroSrc && heroImage ? (
        <figure class="hero-photo-wrap">
          <img class="hero-photo" src={heroSrc} alt={heroImage.alt} loading="eager" decoding="async" />
          {(heroImage.credit || heroImage.sourceUrl) && (
            <figcaption class="hero-photo-credit">
              {heroImage.credit && <span>Photograph: {heroImage.credit}</span>}
              {heroImage.sourceUrl && (
                <a href={heroImage.sourceUrl} target="_blank" rel="noreferrer">Source</a>
              )}
            </figcaption>
          )}
        </figure>
      ) : (
        <div class="hero-photo-wrap hero-photo-wrap--placeholder" aria-hidden="true">
          <span class="hero-chess-deco">♛</span>
        </div>
      )}

      <div class="container hero-overlay">
        <div class="hero-content">
          <time datetime={post.data.publishDate.toISOString()} class="hero-date">
            {formatDateEn(post.data.publishDate)}
          </time>

          <h1 class="hero-title" data-pagefind-meta="title">
            <span>{displayTitle}</span>
          </h1>

          <div class="hero-byline">
            <div class="hero-avatar">
              <img src="/images/logo.svg" alt="A Left-Hander's Blog" width="28" height="40" />
            </div>
            <div class="hero-author-info">
              <p class="hero-author-name">
                <span class="hero-author-prefix">By&nbsp;</span>A Left-Hander's Blog
              </p>
              <p class="hero-author-role">
                {enCategoryLabel} · {readingTime}
                {post.data.updatedDate &&
                  post.data.updatedDate.getTime() !== post.data.publishDate.getTime() && (
                  <span class="hero-updated"> · Updated {formatDateEn(post.data.updatedDate)}</span>
                )}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="container">
        <nav class="article-tags hero-tags" aria-label="Tags">
          {post.data.tags.slice(0, 6).map((tag) => (
            <a href={`/en/recherche/?q=${encodeURIComponent(tag)}`} class="article-tag">{tag}</a>
          ))}
        </nav>
      </div>
    )}

    <!-- ── 3-column body: share rail | content | aside ── -->
    <div class="container article-layout">

      <aside class="article-share-sidebar" aria-label="Share this article">
        <div class="share-sidebar-sticky">
          <ShareButtons title={displayTitle} url={absolutePostUrl} variant="sidebar" />
        </div>
      </aside>

      <div class="article-main">

        {showSummaryVideo && summaryVideoSrc && (
          <ArticleVideo
            src={summaryVideoSrc}
            poster={heroSrc}
            title={`Video summary: ${displayTitle}`}
            eyebrow="Video summary of the article"
            accentColor={category.accent}
            note={post.data.summaryVideoNote}
          />
        )}

        {!hasEnTranslation && (
          <div class="translation-notice" role="note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            <span>The full English translation of this article is in progress. The content below is currently in French.</span>
          </div>
        )}

        <div class="article-tools">
          <FocusMode lang="en" />
        </div>

        {headings.length > 0 && (
          <div class="toc-inline-wrap">
            <TableOfContents headings={headings} mode="mobile" lang="en" />
          </div>
        )}

        <div class="article-body fade-up" style="--motion-delay: 100ms;" data-pagefind-body>
          {englishHtml ? (
            <div class="md-chunk" set:html={englishHtml} />
          ) : (
            Content && <Content />
          )}
        </div>

        <AdBanner format="inline" compact={true} />

        {post.data.keyTakeaways && post.data.keyTakeaways.length > 0 && (
          <KeyTakeaways items={post.data.keyTakeaways} accentColor={category.accent} />
        )}

        {faqsForDisplay.length > 0 && <FAQ items={faqsForDisplay} lang="en" />}

        <Comments lang="en" />
        <TextHighlight lang="en" />

      </div>
    </div>

    {relatedWithUrls.length > 0 && (
      <section class="related-carousel container" aria-label="Recommended articles" data-pagefind-ignore>
        <div class="related-carousel__head">
          <span class="related-carousel__label">For you</span>
          <div class="related-carousel__nav">
            <button type="button" class="rc-btn" data-rc-prev aria-label="Previous articles">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="rc-btn" data-rc-next aria-label="Next articles">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>
        <div class="related-carousel__track" data-rc-track>
          {relatedWithUrls.map(({ entry: e, url }) => (
            <a href={url} class="rc-card">
              {getPostHeroSrc(e) && (
                <img class="rc-card__img" src={getPostHeroSrc(e)!} alt="" loading="lazy" decoding="async" width="320" height="180" />
              )}
              <div class="rc-card__body">
                <span class="rc-card__cat" style={`color:${categoryMap[e.data.category]?.accent}`}>
                  {categoryMap[e.data.category]?.shortLabel}
                </span>
                <p class="rc-card__title">{e.data.title}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .translation-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--green) 30%, var(--border-soft));
    background: color-mix(in srgb, var(--green) 6%, var(--surface));
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }
  .translation-notice svg { flex-shrink: 0; margin-top: 0.1rem; color: var(--green); }

  .article-page { padding: 0 0 2rem; }

  /* ══════════════════════════════════════
     Hero PT's Coffee : photo pleine hauteur à droite,
     titre géant en boîtes blanches superposé sur l'image
  ══════════════════════════════════════ */
  .hero-breadcrumb {
    display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center;
    font-size: 0.78rem; color: var(--text-dim); padding-top: 1.5rem;
  }
  .hero-breadcrumb a { color: var(--text-dim); transition: color 150ms ease; }
  .hero-breadcrumb a:hover { color: var(--text-main); }

  .article-hero {
    position: relative;
    min-height: min(82vh, 760px);
    margin: 1.25rem 0 0;
    display: flex;
    align-items: stretch;
  }
  .hero-photo-wrap {
    position: absolute; inset: 0 0 0 auto; width: 56%; margin: 0;
    overflow: hidden; z-index: 0;
  }
  .hero-photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-photo-wrap--placeholder {
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--c) 12%, var(--surface));
  }
  .hero-chess-deco {
    font-size: clamp(6rem, 14vw, 12rem);
    color: color-mix(in srgb, var(--c) 28%, var(--border-soft)); line-height: 1;
  }
  .hero-photo-credit {
    position: absolute; bottom: 0; right: 0; padding: 0.4rem 0.8rem;
    font-size: 0.72rem; color: #fff; background: rgba(0,0,0,0.55);
    display: flex; gap: 0.75rem;
  }
  .hero-photo-credit a { color: #fff; text-decoration: underline; }

  .hero-overlay {
    position: relative; z-index: 2; width: 100%;
    display: flex; flex-direction: column; justify-content: center;
    pointer-events: none;
  }
  .hero-content { max-width: 64%; padding: 3rem 0; }
  .hero-content > * { pointer-events: auto; }

  .hero-date {
    display: block; font-family: var(--font-display); font-size: 0.95rem;
    font-weight: 500; color: var(--text-muted); margin-bottom: 1rem; padding-left: 0.2rem;
  }
  .hero-title {
    margin: 0 0 2rem; font-size: clamp(2.6rem, 6.5vw, 6rem);
    line-height: 1.42; letter-spacing: -0.01em;
  }
  .hero-title span {
    font-family: var(--font-serif); font-weight: 700; font-style: normal;
    color: color-mix(in srgb, var(--c) 60%, var(--text-main));
    background: var(--surface);
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    padding: 0.06em 0.3em; box-shadow: 0 2px 14px rgba(0,0,0,0.08);
    font-optical-sizing: auto;
  }
  .hero-byline { display: flex; align-items: center; gap: 0.8rem; }
  .hero-avatar {
    width: 3.2rem; height: 3.2rem; border-radius: 50%;
    border: 2px solid var(--border-soft); background: var(--surface);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; flex-shrink: 0; box-shadow: var(--shadow-sm);
  }
  .hero-avatar img { width: 20px; height: 28px; object-fit: contain; }
  :global([data-theme="dark"]) .hero-avatar img { filter: invert(1); }
  .hero-author-info { display: flex; flex-direction: column; gap: 0.1rem; }
  .hero-author-name { font-size: 1rem; font-weight: 700; color: var(--text-main); margin: 0; }
  .hero-author-prefix { font-weight: 400; color: var(--text-dim); }
  .hero-author-role { font-size: 0.85rem; color: var(--text-muted); margin: 0; }
  .hero-updated { color: var(--text-dim); }
  .hero-tags { margin-top: 1.5rem; }

  .article-layout {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0 2.5rem;
    align-items: start;
    max-width: 68rem;
    margin-inline: auto;
  }
  .article-share-sidebar { grid-column: 1; grid-row: 1; }
  .share-sidebar-sticky {
    position: sticky; top: calc(var(--navbar-h) + 5rem);
    display: flex; flex-direction: column; align-items: center;
  }
  .article-main { grid-column: 2; grid-row: 1; }

  .meta-cat {
    display: inline-flex; align-items: center; min-height: 1.5rem; padding: 0 0.5rem;
    border-radius: var(--radius-pill); border: 1px solid var(--c); color: var(--c);
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    transition: background 150ms ease;
  }
  .meta-cat:hover { background: var(--c); color: #fff; }

  .article-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.85rem; }
  .article-tag {
    display: inline-flex; align-items: center; padding: 0.22rem 0.6rem;
    border-radius: var(--radius-pill); border: 1px solid var(--border-soft);
    background: var(--surface); color: var(--text-dim);
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.01em; text-decoration: none;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
  }
  .article-tag:hover {
    border-color: var(--c); color: var(--c);
    background: color-mix(in srgb, var(--c) 6%, var(--surface));
  }

  /* article body – same rich styles as FR */
  .article-body {
    padding: 2rem 0;
  }
  .article-body :global(h2) {
    margin: 1.9rem 0 0.7rem;
    font-family: var(--font-serif);
    font-weight: 500;
    font-style: italic;
    font-size: 1.65rem;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--c) 72%, var(--text-main));
    font-optical-sizing: auto;
  }
  .article-body :global(h3) {
    margin: 1.4rem 0 0.5rem;
    font-size: 1.18rem;
    color: var(--text-main);
  }
  .article-body :global(p),
  .article-body :global(li) { color: var(--text-muted); line-height: 1.75; font-size: clamp(18px, 1vw + 13.5px, 20.5px); }
  .article-body :global(p:first-of-type)::first-letter {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 3.4em;
    line-height: 0.9;
    float: left;
    padding: 0.22rem 0.6rem 0 0;
    color: var(--c);
  }
  .article-body :global(li::marker) { color: color-mix(in srgb, var(--c) 55%, var(--text-dim)); }
  .article-body :global(p + p),
  .article-body :global(p + ul),
  .article-body :global(ul + p) { margin-top: 0.85rem; }
  .article-body :global(ul),
  .article-body :global(ol) { padding-left: 1.2rem; }
  .article-body :global(li + li) { margin-top: 0.3rem; }
  .article-body :global(strong) { color: var(--text-main); }
  .article-body :global(a) {
    color: var(--c);
    font-weight: 600;
    text-decoration: none;
    background-image: linear-gradient(
      to top,
      color-mix(in srgb, var(--c) 16%, transparent) 0%,
      color-mix(in srgb, var(--c) 16%, transparent) 36%,
      transparent 36%
    );
    border-radius: 0.2rem;
    padding: 0 0.05rem;
    transition:
      color 160ms ease,
      background-size 160ms ease,
      background-color 160ms ease;
  }
  .article-body :global(a:hover) {
    color: color-mix(in srgb, var(--c) 80%, black);
    background-image: linear-gradient(
      to top,
      color-mix(in srgb, var(--c) 22%, transparent) 0%,
      color-mix(in srgb, var(--c) 22%, transparent) 42%,
      transparent 42%
    );
  }
  .article-body :global(a[href^="http"])::after {
    content: " ↗";
    font-size: 0.8em;
    font-weight: 700;
    opacity: 0.75;
  }
  .article-body :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.9rem 1.2rem;
    border-left: 3px solid var(--c);
    background: color-mix(in srgb, var(--c) 7%, var(--surface));
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--text-main);
    font-style: italic;
  }
  .article-body :global(hr) { border: none; border-top: 1px solid var(--border-soft); margin: 1.5rem 0; }
  .article-body :global(code) {
    font-size: 0.88em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: var(--bg-warm);
    color: var(--text-main);
  }
  .article-body :global(hr + h3) {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.8rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c) 10%, white);
    border: 1px solid color-mix(in srgb, var(--c) 16%, var(--border-soft));
    margin-top: 1.8rem;
  }
  .article-body :global(pre) { border-radius: var(--radius-sm); padding: 1rem 1.2rem; overflow-x: auto; font-size: 0.9rem; margin: 1.2rem 0; background: var(--surface-warm); border: 1px solid var(--border-soft); }
  .article-body :global(img) { max-width: 100%; border-radius: var(--radius-sm); margin: 1rem 0; }

  .article-tools {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.75rem;
  }

  .toc-inline-wrap { margin-bottom: 1.5rem; }

  /* ── "For you" carousel — interactive slide cards ── */
  .related-carousel { margin: 3.5rem auto 1rem; max-width: 64rem; }
  .related-carousel__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem; }
  .related-carousel__label { font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; color: var(--text-main); }
  .related-carousel__nav { display: flex; gap: 0.5rem; }
  .rc-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.6rem; height: 2.6rem; border-radius: 50%;
    border: 1.5px solid var(--border-strong); background: var(--surface);
    color: var(--text-muted); cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .rc-btn:hover { background: var(--text-main); border-color: var(--text-main); color: var(--bg); }
  .rc-btn:disabled { opacity: 0.35; cursor: not-allowed; pointer-events: none; }
  .related-carousel__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(17rem, 17rem);
    gap: 1.25rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    padding-bottom: 0.75rem; scrollbar-width: none;
  }
  .related-carousel__track::-webkit-scrollbar { display: none; }
  .rc-card {
    scroll-snap-align: start; display: flex; flex-direction: column;
    border-radius: var(--radius-lg); border: 1px solid var(--border-soft);
    background: var(--surface); overflow: hidden; text-decoration: none;
    transition: transform 220ms var(--ease-out), box-shadow 220ms ease, border-color 220ms ease;
  }
  .rc-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--border-strong); }
  .rc-card__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--surface-warm); display: block; }
  .rc-card__body { display: flex; flex-direction: column; gap: 0.45rem; padding: 1rem 1.1rem 1.2rem; }
  .rc-card__cat { font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .rc-card__title {
    font-family: var(--font-display); font-size: 0.98rem; font-weight: 600; color: var(--text-main); line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }

  @media (max-width: 1100px) {
    .article-hero { min-height: min(70vh, 600px); }
    .hero-photo-wrap { width: 50%; }
    .hero-content { max-width: 70%; }
  }

  @media (max-width: 820px) {
    .article-hero { display: flex; flex-direction: column; min-height: auto; margin-top: 1rem; }
    .hero-photo-wrap {
      position: relative; inset: auto; width: 100%; height: 52vw;
      max-height: 20rem; border-radius: var(--radius-lg);
    }
    .hero-overlay { justify-content: flex-start; }
    .hero-content { max-width: 100%; padding: 1.75rem 0 0; }
    .hero-title { font-size: clamp(2.2rem, 9vw, 3.4rem); line-height: 1.35; }
    .hero-title span { box-shadow: none; padding: 0.04em 0.15em; }
  }

  @media (max-width: 900px) {
    .article-share-sidebar { display: none; }
    .article-layout { grid-template-columns: 1fr; }
    .article-main { grid-column: 1; }
  }

  @media (max-width: 560px) {
    .related-carousel__track { grid-auto-columns: minmax(14rem, 80%); }
    .related-carousel__label { font-size: 1.15rem; }
  }
</style>

<script>
  function initRelatedCarousel() {
    const track = document.querySelector("[data-rc-track]") as HTMLElement | null;
    const prevBtn = document.querySelector("[data-rc-prev]") as HTMLButtonElement | null;
    const nextBtn = document.querySelector("[data-rc-next]") as HTMLButtonElement | null;
    if (!track || !prevBtn || !nextBtn) return;
    const step = () => {
      const card = track.querySelector(".rc-card") as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap || "20") || 20;
      return card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
    };
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prevBtn.disabled = track.scrollLeft <= 2;
      nextBtn.disabled = track.scrollLeft >= max;
    };
    prevBtn.addEventListener("click", () => track.scrollBy({ left: -step() * 1.5, behavior: "smooth" }));
    nextBtn.addEventListener("click", () => track.scrollBy({ left: step() * 1.5, behavior: "smooth" }));
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();
  }

  document.addEventListener("astro:page-load", initRelatedCarousel);
</script>
