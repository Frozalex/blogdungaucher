---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EditorialPageHeader from "../../../components/EditorialPageHeader.astro";
import { glossaryTerms, type GlossaryCategory } from "../../../data/glossary";
import { getAllPosts, getPostSlug, buildBreadcrumbJsonLd } from "../../../utils/blog";
import "../../../styles/editorial-resources.css";
const normalize=(text:string)=>text.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const terms=[...glossaryTerms].sort((a,b)=>a.title.localeCompare(b.title,'fr'));
const categories:Record<GlossaryCategory,string>={echecs:"Échecs",neuro:"Neurosciences",psycho:"Psychologie",compet:"Compétition"};
const letters=[...new Set(terms.map(term=>normalize(term.title).charAt(0).toUpperCase()))];
const byLetter=letters.map(letter=>({letter,terms:terms.filter(term=>normalize(term.title).charAt(0).toUpperCase()===letter)}));
const posts=(await getAllPosts()).filter(post=>!post.data.noindex);
const bySlug=new Map(posts.map(post=>[getPostSlug(post),post]));
const termBySlug=new Map(terms.map(term=>[term.slug,term]));
const structuredData={"@context":"https://schema.org","@type":"DefinedTermSet",name:"Glossaire du Gaucher",url:"https://blogdungaucher.com/fr/glossaire/",hasDefinedTerm:terms.map(term=>({"@type":"DefinedTerm","@id":`https://blogdungaucher.com/fr/glossaire/#${term.slug}`,name:term.title,description:term.def,termCode:term.slug,url:`https://blogdungaucher.com/fr/glossaire/#${term.slug}`}))};
---
<BaseLayout title="Glossaire des échecs : les mots pour comprendre le jeu" description={`${terms.length} définitions des échecs, des neurosciences et de la psychologie. Recherche, exemples sur l’échiquier, notions liées et articles pour approfondir.`} canonicalPath="/fr/glossaire/" omitEnDeAlternateLinks={true} structuredData={[structuredData,buildBreadcrumbJsonLd([{name:"Accueil",path:"/fr/"},{name:"Glossaire",path:"/fr/glossaire/"}])]}>
<div class="resource-page"><div class="container" data-glossary>
  <EditorialPageHeader active="glossary" label={`Le glossaire · ${terms.length} notions à explorer`} title="Les mots pour comprendre le jeu." intro="Un terme t’arrête dans un article ? Je rassemble ici les notions du jeu, de la psychologie et des neurosciences, avec un exemple pour les rendre concrètes." />
  <div class="glossary-tools">
    <div class="glossary-search" hidden data-glossary-controls><label for="glossary-search">Chercher une notion<input id="glossary-search" class="resource-field" type="search" placeholder="Mémoire, roque, dopamine…" autocomplete="off" data-glossary-query /></label><button class="resource-link glossary-reset" type="button" data-glossary-reset>Tout réinitialiser ↺</button></div>
    <div class="resource-filter glossary-filters" hidden data-glossary-controls role="group" aria-label="Filtrer les définitions par thème"><button type="button" data-glossary-category="all" aria-pressed="true">Tout</button>{Object.entries(categories).map(([key,label])=><button type="button" data-glossary-category={key} aria-pressed="false">{label}</button>)}</div>
    <nav class="glossary-alphabet" aria-label="Navigation alphabétique">{"ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("").map(letter=>letters.includes(letter)?<a href={`#lettre-${letter}`} data-glossary-letter={letter} aria-label={`Lettre ${letter}`}>{letter}</a>:<span aria-hidden="true">{letter}</span>)}</nav>
  </div>
  <div class="glossary-results-line"><p class="resource-feedback" data-glossary-count role="status">{terms.length} notions, de A à Z</p><a class="resource-link" href="/fr/infographie/">Explorer les articles ↗</a></div>
  <div class="glossary-empty" hidden data-glossary-empty><h2>Aucune notion trouvée.</h2><p>Essaie un autre mot ou enlève le filtre de thème.</p><button class="resource-button" type="button" data-glossary-reset>Afficher toutes les notions</button></div>
  <div class="glossary-definitions">{byLetter.map(group=><section class="glossary-letter" id={`lettre-${group.letter}`} data-glossary-group data-letter={group.letter} aria-labelledby={`heading-${group.letter}`}><h2 id={`heading-${group.letter}`}>{group.letter}</h2><dl>{group.terms.map(term=><div class="glossary-entry" id={term.slug} data-glossary-term data-category={term.cat} data-search={normalize(`${term.title} ${term.def} ${term.example}`)}>
    <dt><span class="glossary-title">{term.title}</span><a class="glossary-anchor" href={`#${term.slug}`} aria-label={`Lien vers la définition : ${term.title}`}>#</a><span class="glossary-category">{categories[term.cat]}</span></dt>
    <dd><p>{term.def}</p><p class="glossary-example"><span>Sur l’échiquier</span>{term.example}</p>
      {term.related.length>0&&<div class="glossary-related"><span>À rapprocher de</span>{term.related.map(slug=>{const related=termBySlug.get(slug);return related&&<a href={`#${slug}`}>{related.title}</a>})}</div>}
      {term.articles.map(slug=>{const post=bySlug.get(slug);return post&&<a class="resource-link glossary-reading" href={`/fr/blog/${slug}/`}>Pour approfondir : {post.data.title} <span aria-hidden="true">↗</span></a>})}
      {term.source&&<a class="glossary-source" href={term.source.href} target="_blank" rel="noopener noreferrer">Source : {term.source.label} ↗<span class="resource-sr-only"> (nouvel onglet)</span></a>}
    </dd>
  </div>)}</dl></section>)}</div>
  <div class="resource-end"><p>Ce glossaire évolue avec mes lectures et les articles. Une notion manque ?</p><a class="resource-link" href="mailto:contact@blogdungaucher.com">Propose-la-moi ↗</a></div>
</div></div>
</BaseLayout>
<script>
  function initGlossary(){
    const root=document.querySelector<HTMLElement>('[data-glossary]');if(!root||root.dataset.bound)return;root.dataset.bound='true';
    const query=root.querySelector<HTMLInputElement>('[data-glossary-query]')!;const terms=[...root.querySelectorAll<HTMLElement>('[data-glossary-term]')];const groups=[...root.querySelectorAll<HTMLElement>('[data-glossary-group]')];const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-glossary-category]')];const letters=[...root.querySelectorAll<HTMLAnchorElement>('[data-glossary-letter]')];let category='all';
    const normalize=(text:string)=>text.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
    function render(){const words=normalize(query.value).split(/\s+/).filter(Boolean);let count=0;terms.forEach(term=>{const match=(category==='all'||term.dataset.category===category)&&words.every(word=>(term.dataset.search||'').includes(word));term.hidden=!match;if(match)count++;});groups.forEach(group=>{group.hidden=![...group.querySelectorAll<HTMLElement>('[data-glossary-term]')].some(term=>!term.hidden);});letters.forEach(link=>{const group=groups.find(group=>group.dataset.letter===link.dataset.glossaryLetter);const disabled=!group||group.hidden;link.setAttribute('aria-disabled',String(disabled));link.tabIndex=disabled?-1:0;});buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.glossaryCategory===category)));root!.querySelector('[data-glossary-count]')!.textContent=`${count} notion${count===1?'':'s'} sur ${terms.length}`;root!.querySelector<HTMLElement>('[data-glossary-empty]')!.hidden=count>0;}
    function reset(){category='all';query.value='';render();}
    query.addEventListener('input',render);buttons.forEach(button=>button.addEventListener('click',()=>{category=button.dataset.glossaryCategory!;render();}));root.querySelectorAll('[data-glossary-reset]').forEach(button=>button.addEventListener('click',()=>{reset();query.focus();}));
    root.addEventListener('click',event=>{const link=(event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');if(!link)return;if(link.getAttribute('aria-disabled')==='true'){event.preventDefault();return;}const target=document.getElementById(decodeURIComponent(link.hash.slice(1)));if(target?.matches('[data-glossary-term]')&&target.hidden)reset();});
    root.querySelectorAll<HTMLElement>('[data-glossary-controls]').forEach(control=>control.hidden=false);const tools=root.querySelector<HTMLElement>('.glossary-tools')!;const updateOffset=()=>root.style.setProperty('--glossary-tools-height',`${Math.ceil(tools.getBoundingClientRect().height)}px`);new ResizeObserver(updateOffset).observe(tools);updateOffset();render();
  }
  initGlossary();document.addEventListener('astro:page-load',initGlossary);
</script>
<style>
.glossary-tools{position:sticky;top:var(--navbar-h);z-index:20;background:var(--bg);padding:1rem 0 0;border-top:2px solid var(--text-main);border-bottom:1px solid var(--border-strong)}.glossary-search{display:flex;align-items:end;gap:1rem;margin-bottom:.8rem}.glossary-search label{display:flex;flex-direction:column;gap:.45rem;flex:1;max-width:42rem;font-size:.72rem;color:var(--text-muted)}.glossary-reset{background:none;border:0;padding:.85rem 0;cursor:pointer;white-space:nowrap}.glossary-filters{margin-bottom:.6rem}.glossary-alphabet{display:flex;gap:.2rem;overflow-x:auto;padding:.4rem 0 .6rem;scrollbar-width:thin}.glossary-alphabet a,.glossary-alphabet>span{display:grid;place-items:center;flex:0 0 2rem;height:2.25rem;font-size:.82rem;font-weight:550}.glossary-alphabet a{color:var(--green)}.glossary-alphabet a:hover{background:var(--green-light)}.glossary-alphabet>span,.glossary-alphabet a[aria-disabled="true"]{color:var(--text-dim);opacity:.5}.glossary-results-line{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.5rem 0 1rem}.glossary-letter{display:grid;grid-template-columns:5rem minmax(0,1fr);gap:2rem;border-top:1px solid var(--border-strong);scroll-margin-top:calc(var(--navbar-h) + var(--glossary-tools-height,15rem) + 1rem);padding-top:1.5rem;margin-bottom:1.5rem}.glossary-letter>h2{font-family:var(--font-serif);font-size:3rem;font-weight:500;line-height:1;margin:0;color:var(--green)}.glossary-letter>dl{margin:0}.glossary-entry{padding:0 0 1.75rem;scroll-margin-top:calc(var(--navbar-h) + var(--glossary-tools-height,15rem) + 1rem);max-width:54rem}.glossary-entry+.glossary-entry{border-top:1px solid var(--border-strong);padding-top:1.75rem}.glossary-entry:target{border-left:3px solid var(--green);padding-left:1rem}.glossary-entry dt{display:flex;align-items:baseline;gap:.6rem;flex-wrap:wrap;margin-bottom:.6rem}.glossary-title{font-family:var(--font-serif);font-size:1.55rem;font-weight:550;letter-spacing:-.02em;line-height:1.2}.glossary-anchor{font-size:1rem;color:var(--text-dim)}.glossary-category{color:var(--green);font-size:.65rem;letter-spacing:.09em;text-transform:uppercase;margin-left:auto}.glossary-entry dd{margin:0}.glossary-entry dd>p{font-size:.96rem;line-height:1.75;color:var(--text-muted);margin:0 0 1rem}.glossary-entry dd>p.glossary-example{border-left:2px solid var(--green-border);padding:.2rem 0 .2rem 1rem;font-size:.9rem}.glossary-example>span{display:block;color:var(--text-main);font-size:.7rem;font-weight:600;margin-bottom:.3rem;letter-spacing:.06em;text-transform:uppercase}.glossary-related{display:flex;flex-wrap:wrap;align-items:baseline;gap:.4rem 1rem;font-size:.78rem;margin-bottom:1rem}.glossary-related>span{color:var(--text-dim)}.glossary-related a{color:var(--green);text-decoration:underline;text-underline-offset:.2em}.glossary-reading{display:block;line-height:1.6;margin-top:.5rem}.glossary-source{display:block;font-size:.72rem;color:var(--text-dim);margin-top:.75rem;text-decoration:underline;text-underline-offset:.2em}.glossary-empty{padding:2rem 0 3rem}.glossary-empty h2{font-family:var(--font-serif);font-weight:500}.glossary-empty p{color:var(--text-muted);margin:1rem 0}@media(max-width:639px){.glossary-letter{grid-template-columns:2rem minmax(0,1fr);gap:1rem}.glossary-letter>h2{font-size:2rem}.glossary-title{font-size:1.3rem}.glossary-category{margin-left:0;flex-basis:100%}.glossary-search{align-items:start;flex-direction:column;gap:.3rem}.glossary-search label{width:100%}.glossary-reset{padding:.3rem 0}.glossary-results-line{align-items:start;flex-direction:column;gap:0}.glossary-tools{padding-top:.65rem}.glossary-filters{gap:.35rem}.glossary-filters button{padding:.4rem .5rem;font-size:.73rem}.glossary-entry,.glossary-letter{scroll-margin-top:calc(var(--navbar-h) + var(--glossary-tools-height,20rem) + 1rem)}.glossary-entry dd>p{font-size:.9rem}}
</style>
