---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getAllPosts } from "../../../utils/blog";

const allPosts = await getAllPosts();
---

<BaseLayout
  title="Rechercher, Blog d'un Gaucher"
  description="Recherchez un article sur les échecs par mot-clé : Alzheimer, TDAH, Elo, AlphaZero, Grand Oral, dopamine, stress, mémoire. Plus de 80 analyses disponibles."
  canonicalPath="/fr/recherche/"
>
  <div class="search-page container">
    <header class="search-header">
      <h1 class="search-title">Rechercher</h1>
      <p class="search-subtitle">
        {allPosts.length} analyses disponibles : science, esprit, société, Grand Oral.
      </p>
    </header>

    <div class="search-box-wrap">
      <label for="search-input" class="sr-only">Rechercher un article</label>
      <div class="search-box">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="Alzheimer, TDAH, Elo, minimax, Grand Oral…"
          autocomplete="off"
          spellcheck="false"
          aria-describedby="search-kbd-hint"
        />
        <span id="search-kbd-hint" class="search-kbd-hint" aria-hidden="true">
          <kbd>/</kbd> focus · <kbd>↑↓</kbd> naviguer · <kbd>↵</kbd> ouvrir
        </span>
        <button id="search-clear" class="search-clear" type="button" aria-label="Effacer" hidden>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <div id="search-state" class="search-state" aria-live="polite" aria-atomic="true"></div>
    <ul id="search-results" class="search-results" role="list"></ul>
  </div>
</BaseLayout>

<script>
  const inputEl  = document.getElementById("search-input")  as HTMLInputElement;
  const clearBtn = document.getElementById("search-clear")   as HTMLButtonElement;
  const stateEl  = document.getElementById("search-state")  as HTMLElement;
  const listEl   = document.getElementById("search-results") as HTMLUListElement;

  let pagefindInstance: { search: (q: string) => Promise<{ results: { data: () => Promise<PagefindResult> }[] }> } | null = null;

  type PagefindResult = {
    url: string;
    excerpt: string;
    meta: Record<string, string>;
    word_count: number;
  };

  async function getPagefind() {
    if (pagefindInstance) return pagefindInstance;
    try {
      // @ts-ignore - fichier généré au build par Pagefind (absent au moment du bundling).
      // Le spécifieur est construit à l'EXÉCUTION (window.location.origin) : Rollup ne peut donc
      // pas l'analyser/résoudre statiquement et laisse l'import dynamique intact. Indispensable -
      // un littéral "/pagefind/pagefind.js" déclenche « Rollup failed to resolve import » et casse
      // le build serveur (le fichier n'existe qu'après `pagefind --site dist`).
      const pagefindUrl = window.location.origin + "/pagefind/pagefind.js";
      const pf = await import(/* @vite-ignore */ pagefindUrl);
      await pf.init();
      pagefindInstance = pf;
      return pf;
    } catch {
      return null;
    }
  }

  function render(results: PagefindResult[], q: string) {
    listEl.innerHTML = "";

    if (results.length === 0) {
      stateEl.textContent = `Aucun résultat pour « ${q} ».`;
      return;
    }

    stateEl.textContent = `${results.length} résultat${results.length > 1 ? "s" : ""} pour « ${q} »`;

    results.forEach((data) => {
      const li = document.createElement("li");
      li.className = "search-result";
      const title   = data.meta?.title    ?? "Sans titre";
      const cat     = data.meta?.category ?? "";
      const accent  = data.meta?.accent   ?? "var(--green)";
      li.innerHTML = `
        <a href="${data.url}" class="search-result__link" style="--accent:${accent}">
          ${cat ? `<span class="search-result__cat">${cat}</span>` : ""}
          <strong class="search-result__title">${title}</strong>
          <p class="search-result__excerpt">${data.excerpt}</p>
        </a>
      `;
      listEl.appendChild(li);
    });
  }

  async function search(q: string) {
    q = q.trim();
    clearBtn.hidden = q.length === 0;

    if (q.length < 2) {
      stateEl.textContent = q.length === 1 ? "Continue à taper…" : "";
      listEl.innerHTML = "";
      return;
    }

    stateEl.textContent = "Recherche en cours…";

    const pf = await getPagefind();
    if (!pf) {
      stateEl.textContent = "Index de recherche indisponible (lancez d'abord un build).";
      listEl.innerHTML = "";
      return;
    }

    const response = await pf.search(q);
    const results  = await Promise.all(response.results.slice(0, 20).map((r) => r.data()));
    render(results, q);
  }

  // Auto-populate depuis l'URL ?q=
  const params   = new URLSearchParams(window.location.search);
  const initialQ = params.get("q") ?? "";
  if (initialQ) {
    inputEl.value = initialQ;
    search(initialQ);
  }

  inputEl.addEventListener("input", () => search(inputEl.value));
  clearBtn.addEventListener("click", () => {
    inputEl.value = "";
    inputEl.focus();
    search("");
  });

  // ── Navigation clavier ──────────────────────────────────────
  let activeIdx = -1;

  function getResultLinks(): HTMLAnchorElement[] {
    return Array.from(listEl.querySelectorAll<HTMLAnchorElement>(".search-result__link"));
  }

  function setActive(idx: number) {
    const links = getResultLinks();
    if (links.length === 0) { activeIdx = -1; return; }
    activeIdx = ((idx % links.length) + links.length) % links.length;
    links.forEach((a, i) => {
      const on = i === activeIdx;
      a.classList.toggle("is-active", on);
      if (on) {
        a.setAttribute("aria-current", "true");
        a.scrollIntoView({ block: "nearest", behavior: "smooth" });
      } else {
        a.removeAttribute("aria-current");
      }
    });
  }

  new MutationObserver(() => { activeIdx = -1; }).observe(listEl, { childList: true });

  inputEl.addEventListener("keydown", (e) => {
    const links = getResultLinks();
    if (e.key === "ArrowDown") {
      e.preventDefault(); setActive(activeIdx + 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault(); setActive(activeIdx - 1);
    } else if (e.key === "Enter") {
      const target = activeIdx >= 0 ? links[activeIdx] : links[0];
      if (target) { e.preventDefault(); target.click(); }
    } else if (e.key === "Escape") {
      if (inputEl.value.length > 0) { inputEl.value = ""; search(""); }
      else inputEl.blur();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "/") return;
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const tag = target.tagName;
    if (tag === "INPUT" || tag === "TEXTAREA" || target.isContentEditable) return;
    e.preventDefault();
    inputEl.focus();
    inputEl.select();
  });
</script>

<style>
  .search-page {
    padding: calc(var(--navbar-h) + 2.5rem) 0 5rem;
    max-width: 50rem;
  }

  .search-header {
    margin-bottom: 2rem;
  }

  .search-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--text-main);
    margin: 0 0 0.4rem;
  }

  .search-subtitle {
    color: var(--text-muted);
    font-size: 1rem;
    margin: 0;
  }

  /* ── Search box ── */
  .search-box-wrap {
    margin-bottom: 1.5rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    color: var(--text-dim);
    pointer-events: none;
    flex-shrink: 0;
  }

  #search-input {
    width: 100%;
    padding: 0.85rem 2.75rem 0.85rem 2.75rem;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border-soft);
    background: var(--surface);
    color: var(--text-main);
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 160ms ease, box-shadow 160ms ease;
    outline: none;
    box-shadow: var(--shadow-xs);
  }

  #search-input:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 18%, transparent);
  }

  #search-input::placeholder {
    color: var(--text-dim);
  }

  /* Hint clavier discret sous le champ. */
  .search-kbd-hint {
    display: inline-block;
    margin-top: 0.55rem;
    font-size: 0.75rem;
    color: var(--text-dim);
    font-family: var(--font-display);
  }
  .search-kbd-hint kbd {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    margin: 0 0.1rem;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface-warm);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 0 var(--border-soft);
  }
  @media (max-width: 560px) {
    .search-kbd-hint { display: none; }
  }

  .search-clear {
    position: absolute;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: none;
    background: var(--border-soft);
    color: var(--text-muted);
    cursor: pointer;
    transition: background 140ms ease;
  }
  .search-clear:hover { background : var(--border-strong); }

  /* ── State ── */
  .search-state {
    font-size: 0.85rem;
    color: var(--text-dim);
    min-height: 1.4rem;
    margin-bottom: 0.75rem;
  }

  /* ── Results list ── */
  .search-results {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }

  /* Les <li class="search-result"> et leurs enfants sont créés en JS (listEl.innerHTML) :
     ils n'ont PAS l'attribut de scope Astro. On scope via le parent `.search-results` (élément
     de template, donc porteur du cid) et on globalise les enfants injectés avec `:global()`.
     Sans ça, ces règles exigeraient `.search-result__link[cid]` → liste de résultats sans style. */
  .search-results :global(.search-result__link) {
    display: block;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-soft);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 200ms var(--ease-spring);
    text-decoration: none;
  }

  .search-results :global(.search-result__link:hover),
  .search-results :global(.search-result__link.is-active) {
    border-color: var(--accent, var(--green));
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }
  .search-results :global(.search-result__link.is-active) {
    /* Highlight visuel plus net pour la navigation clavier. */
    box-shadow: var(--shadow-sm), 0 0 0 2px color-mix(in srgb, var(--accent, var(--green)) 35%, transparent);
  }

  .search-results :global(.search-result__cat) {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent, var(--green));
    margin-bottom: 0.3rem;
  }

  .search-results :global(.search-result__title) {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-main);
    margin-bottom: 0.3rem;
    line-height: 1.35;
  }

  .search-results :global(.search-result__excerpt) {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 0 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient : vertical;
    overflow: hidden;
  }

  .search-results :global(.search-result__meta) {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
