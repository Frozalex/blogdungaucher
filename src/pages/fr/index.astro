---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomePortal from "../../components/HomePortal.astro";

import { buildWebsiteJsonLd, getAllPosts, filterPostsForLang, getPostHeroSrc } from "../../utils/blog";
import { getHomeEditorialPosts, homeTitles } from "../../data/home-editorial";
import { buildSrcset } from "../../utils/image-variants";
const { lead } = getHomeEditorialPosts(filterPostsForLang(await getAllPosts(), "fr"));
const leadImage = lead ? getPostHeroSrc(lead) : null;

---
<BaseLayout
  title={homeTitles["fr"]}
  description="Explore les échecs sous un autre angle. Deux articles par semaine sur la science du jeu, la psychologie du joueur et la place des échecs dans la société."
  canonicalPath="/fr/"
  preloadImage={leadImage ?? undefined}
  preloadImageSrcset={buildSrcset(leadImage)}
  preloadImageSizes="(min-width: 1280px) 576px, (min-width: 901px) 45vw, (min-width: 601px) 39vw, calc(100vw - 80px)"
  structuredData={buildWebsiteJsonLd()}
>
  <HomePortal lang="fr" />
</BaseLayout>
