---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { series } from "../../../data/series";
import { absoluteUrl, buildBreadcrumbJsonLd, getAllPosts } from "../../../utils/blog";

// Chaque série se dévoile au fil des semaines : on compte les articles réellement publiés.
const published = await getAllPosts();
const publishedSlugs = new Set(published.map((post) => post.id.split("/").pop() ?? post.id));

const items = series
  .slice()
  .sort((a, b) => a.rank - b.rank)
  .map((serie) => ({
    ...serie,
    published : (serie.slugs ?? []).filter((slug) => publishedSlugs.has(slug)).length,
    /** Une série sans page d'index est annoncée mais pas encore ouverte. */
    ouverte : Boolean(serie.href),
  }));

const canonPath = "/fr/series/";
const title = "Les séries";
const description =
  "Les séries du blog : des ensembles d'articles conçus ensemble, publiés dans un ordre voulu, et pensés pour être lus comme un tout plutôt qu'un par un.";

const structuredData = [
  buildBreadcrumbJsonLd([
    { name : "Accueil", path : "/fr/" },
    { name : "Séries", path : canonPath },
  ]),
  {
    "@context" : "https://schema.org",
    "@type" : "CollectionPage",
    name : title,
    description,
    url : absoluteUrl(canonPath),
    inLanguage : "fr-FR",
    // Seules les séries réellement ouvertes entrent dans l'ItemList : une entrée
    // sans URL n'a pas de sens pour un moteur.
    mainEntity : {
      "@type" : "ItemList",
      numberOfItems : items.filter((serie) => serie.ouverte).length,
      itemListElement : items
        .filter((serie) => serie.ouverte)
        .map((serie, index) => ({
          "@type" : "ListItem",
          position : index + 1,
          url : absoluteUrl(serie.href as string),
          name : serie.title,
        })),
    },
  },
];
---

<BaseLayout
  title={`${title} | Blog d’un Gaucher`}
  description={description}
  canonicalPath={canonPath}
  structuredData={structuredData}
  omitEnDeAlternateLinks
  omitPtBrNlAlternates
>
  <main class="series">
    <header class="series__hero">
      <p class="series__eyebrow">Lectures au long cours</p>
      <h1>Les séries</h1>
      <p class="series__lede">
        La plupart des articles de ce blog se lisent seuls. Certains sujets, eux, demandent un
        ensemble : plusieurs textes conçus ensemble, publiés dans un ordre voulu, qui se répondent
        et se complètent. C’est ce que rassemble cette page.
      </p>
    </header>

    <ul class="series__list">
      {items.filter((serie) => serie.ouverte).map((serie) => {
        const complete = serie.published >= serie.total;
        const progress = Math.round((serie.published / serie.total) * 100);
        return (
          <li class="serie-card">
            <a href={serie.href}>
              <h2 class="serie-card__title">{serie.title}</h2>
              <p class="serie-card__lede">{serie.lede}</p>
              <div class="serie-card__foot">
                <div class="serie-card__bar" role="presentation">
                  <span class="serie-card__fill" style={`width:${progress}%`}></span>
                </div>
                <p class="serie-card__count">
                  <strong>{serie.published}</strong> sur {serie.total}
                  {!complete && serie.cadence && <span> · {serie.cadence}</span>}
                </p>
              </div>
              <span class="serie-card__cta">Voir la série</span>
            </a>
          </li>
        );
      })}
    </ul>

    {items.some((serie) => !serie.ouverte) && (
      <section class="series__soon">
        <h2 class="series__soon-title">En préparation</h2>
        <p class="series__soon-lede">
          Ces séries sont écrites ou en cours d’écriture. Elles s’ouvriront ici au fur et à mesure.
        </p>
        <ul class="series__list">
          {items.filter((serie) => !serie.ouverte).map((serie) => (
            <li class="serie-card serie-card--soon">
              <div>
                <h3 class="serie-card__title">{serie.title}</h3>
                <p class="serie-card__lede">{serie.lede}</p>
                <p class="serie-card__count">
                  {serie.total} articles prévus
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .series {
    max-width: var(--container);
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }

  .series__hero {
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .series__eyebrow {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.75rem;
  }

  .series__hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .series__lede {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .series__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .serie-card > a {
    display: block;
    padding: 1.75rem 1.9rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--motion-fast) var(--ease-out),
      box-shadow var(--motion-fast) var(--ease-out);
  }

  .serie-card > a:hover,
  .serie-card > a:focus-visible {
    border-color: var(--green-border);
    box-shadow: var(--shadow-sm);
  }

  .serie-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3.5vw, 1.7rem);
    line-height: 1.25;
    margin: 0 0 0.6rem;
  }

  .serie-card__lede {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 1.15rem;
    max-width: 44rem;
  }

  .serie-card__foot {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .serie-card__bar {
    flex: 1 1 8rem;
    max-width: 14rem;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--border-soft);
    overflow: hidden;
  }

  .serie-card__fill {
    display: block;
    height: 100%;
    background: var(--green);
    border-radius: var(--radius-pill);
  }

  .serie-card__count {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .serie-card__cta {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--green);
  }

  .serie-card > a:hover .serie-card__cta {
    text-decoration: underline;
  }

  /* ── Séries annoncées, pas encore ouvertes ── */
  .series__soon {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-soft);
  }

  .series__soon-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    margin: 0 0 0.4rem;
  }

  .series__soon-lede {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin: 0 0 1.5rem;
    max-width: 42rem;
  }

  /* Pas de <a> : l'entrée est volontairement non cliquable. */
  .serie-card--soon > div {
    display: block;
    padding: 1.35rem 1.6rem;
    border: 1px dashed var(--border-soft);
    border-radius: var(--radius-lg);
    background: transparent;
  }

  .serie-card--soon .serie-card__title {
    font-size: clamp(1.1rem, 3vw, 1.35rem);
    color: var(--text-muted);
  }

  .serie-card--soon .serie-card__lede {
    font-size: 0.92rem;
    margin-bottom: 0.75rem;
    color: var(--text-dim);
  }
</style>
