---
import EditorialSeriesHeader from "../../../components/EditorialSeriesHeader.astro";
import EditorialSeriesCard from "../../../components/EditorialSeriesCard.astro";
import "../../../styles/editorial-resources.css";
import "../../../styles/editorial-series.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { seriePsychologieGrappes, seriePsychologieTotal } from "../../../data/serie-psychologie";
import { absoluteUrl, buildBreadcrumbJsonLd, formatDate, getAllPosts } from "../../../utils/blog";

// getAllPosts() ne renvoie que les articles dont la publishDate est passée : la série se dévoile
// donc au fil des semaines. Seuls les articles déjà disponibles sont affichés.
const published = await getAllPosts();
const bySlug = new Map(published.map((post) => [post.id.split("/").pop() ?? post.id, post]));

// Seuls les articles publiés sont affichés : pas de ligne « à venir » sans lien.
const grappes = seriePsychologieGrappes
  .map((grappe) => ({
    ...grappe,
    items : grappe.items
      .filter((item) => bySlug.has(item.slug))
      .map((item) => {
        const post = bySlug.get(item.slug)!;
        return {
          ...item,
          post,
          href : `/fr/blog/${item.slug}/`,
          date : formatDate(post.data.publishDate),
          excerpt : post.data.excerpt ?? null,
        };
      }),
  }))
  .filter((grappe) => grappe.items.length > 0);

const firstArticle = grappes[0]?.items[0];
const publishedCount = grappes.reduce((total, grappe) => total + grappe.items.length, 0);

const canonPath = "/fr/series/psychologie/";
const title = "Série : la psychologie appliquée aux échecs";
const description =
  `Une série de ${seriePsychologieTotal} articles sur ce que la psychologie dit vraiment du joueur d'échecs : biais, mémoire, motivation, influence et statut. Chaque concept est confronté à sa critique.`;

// ItemList : rend la série citable comme un ensemble, et pas seulement article par article.
const structuredData = [
  buildBreadcrumbJsonLd([
    { name : "Accueil", path : "/fr/" },
    { name : "Séries", path : "/fr/series/" },
    { name : "Psychologie", path : canonPath },
  ]),
  {
    "@context" : "https://schema.org",
    "@type" : "CollectionPage",
    name : title,
    description,
    url : absoluteUrl(canonPath),
    inLanguage : "fr-FR",
    mainEntity : {
      "@type" : "ItemList",
      numberOfItems : publishedCount,
      itemListElement : grappes
        .flatMap((grappe) => grappe.items)
        .filter((item) => item.href)
        .map((item, index) => ({
          "@type" : "ListItem",
          position : index + 1,
          url : absoluteUrl(item.href as string),
          name : item.post?.data.title ?? item.label,
        })),
    },
  },
];
---

<BaseLayout title={`${title} | Blog d’un Gaucher`} description={description} canonicalPath={canonPath} structuredData={structuredData}>
  <div class="resource-page"><div class="container">
    <EditorialSeriesHeader active="psychologie" title="La psychologie appliquée aux échecs" published={publishedCount} total={seriePsychologieTotal}>
      <p>
        Les échecs produisent une information rare : une défaite sans ambiguïté, sans coéquipier à qui
        l’attribuer, sans part de hasard, publique et fréquente. C’est ce qui en fait le meilleur
        terrain d’observation qui soit pour comprendre comment un cerveau traite ce qui le contredit.
      </p>
      <p>
        Chaque article part d’une scène de partie, cite l’étude fondatrice <strong>et sa critique</strong>,
        et se termine par une chose à faire. Plusieurs classiques que tu crois connaître n’ont pas
        survécu aux réplications : c’est dit à chaque fois.
      </p>
      <Fragment slot="status"><p class="series-cadence">Un nouveau chaque mardi.</p>{firstArticle && <a class="resource-button" href={firstArticle.href}>Commencer la lecture →</a>}<a class="resource-link series-status-link" href="#parcours">Explorer les thèmes ↓</a></Fragment>
    </EditorialSeriesHeader>
    <nav class="series-jumps" id="parcours" aria-label="Les thèmes disponibles"><span>Le parcours</span><ol>{grappes.map((grappe,i) => <li><a href={`#${grappe.id}`}>{String(i+1).padStart(2,"0")} · {grappe.titre}</a></li>)}</ol></nav>
    {grappes.map((grappe,i) => <section class="series-section" id={grappe.id} aria-labelledby={`${grappe.id}-title`}>
      <div class="series-section__heading"><span class="series-section__number" aria-hidden="true">{String(i+1).padStart(2,"0")}</span><h2 id={`${grappe.id}-title`}>{grappe.titre}</h2><span class="series-section__count">{grappe.items.length} article{grappe.items.length>1?"s":""} disponible{grappe.items.length>1?"s":""}</span></div>
      <p class="series-section__intro">{grappe.chapeau}</p>
      <ol class:list={["series-articles",{"series-articles--single":grappe.items.length===1,"series-articles--pair":grappe.items.length===2}]}>{grappe.items.map(item => <li><EditorialSeriesCard post={item.post} title={item.post.data.title} excerpt={item.excerpt} href={item.href} pilier={item.pilier} /></li>)}</ol>
    </section>)}
    <div class="resource-end"><a class="resource-link" href="/fr/series/">← Toutes les séries</a><a class="resource-link" href="/fr/esprit/">Explorer la rubrique Esprit →</a><a class="resource-link" href="/fr/series/moteur-python/">Le parcours Moteur Python →</a></div>
  </div></div>
</BaseLayout>
