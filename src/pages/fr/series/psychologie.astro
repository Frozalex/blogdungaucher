---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { seriePsychologieGrappes, seriePsychologieTotal } from "../../../data/serie-psychologie";
import { absoluteUrl, buildBreadcrumbJsonLd, formatDate, getAllPosts } from "../../../utils/blog";

// getAllPosts() ne renvoie que les articles dont la publishDate est passée : la série se dévoile
// donc au fil des semaines. Les articles à venir restent listés (sans lien) pour que l'ensemble
// soit lisible en bloc dès le départ.
const published = await getAllPosts();
const bySlug = new Map(published.map((post) => [post.id.split("/").pop() ?? post.id, post]));

const grappes = seriePsychologieGrappes.map((grappe) => ({
  ...grappe,
  items : grappe.items.map((item) => {
    const post = bySlug.get(item.slug);
    return {
      ...item,
      post,
      href : post ? `/fr/blog/${item.slug}/` : null,
      date : post ? formatDate(post.data.publishDate) : null,
      excerpt : post?.data.excerpt ?? null,
    };
  }),
}));

const publishedCount = grappes.reduce(
  (total, grappe) => total + grappe.items.filter((item) => item.post).length,
  0,
);

const canonPath = "/fr/series/psychologie/";
const title = "Série : la psychologie appliquée aux échecs";
const description =
  `Une série de ${seriePsychologieTotal} articles sur ce que la psychologie dit vraiment du joueur d'échecs : biais, mémoire, motivation, influence et statut. Chaque concept est confronté à sa critique.`;

// ItemList : rend la série citable comme un ensemble, et pas seulement article par article.
const structuredData = [
  buildBreadcrumbJsonLd([
    { name : "Accueil", path : "/fr/" },
    { name : "Séries", path : "/fr/series/" },
    { name : "Psychologie", path : canonPath },
  ]),
  {
    "@context" : "https://schema.org",
    "@type" : "CollectionPage",
    name : title,
    description,
    url : absoluteUrl(canonPath),
    inLanguage : "fr-FR",
    mainEntity : {
      "@type" : "ItemList",
      numberOfItems : publishedCount,
      itemListElement : grappes
        .flatMap((grappe) => grappe.items)
        .filter((item) => item.href)
        .map((item, index) => ({
          "@type" : "ListItem",
          position : index + 1,
          url : absoluteUrl(item.href as string),
          name : item.post?.data.title ?? item.label,
        })),
    },
  },
];
---

<BaseLayout
  title={`${title} | Blog d’un Gaucher`}
  description={description}
  canonicalPath={canonPath}
  structuredData={structuredData}
  omitEnDeAlternateLinks
  omitPtBrNlAlternates
>
  <main class="serie">
    <header class="serie__hero">
      <p class="serie__eyebrow">Série en {seriePsychologieTotal} articles</p>
      <h1>La psychologie appliquée aux échecs</h1>
      <p class="serie__lede">
        Les échecs produisent une information rare : une défaite sans ambiguïté, sans coéquipier à qui
        l’attribuer, sans part de hasard, publique et fréquente. C’est ce qui en fait le meilleur
        terrain d’observation qui soit pour comprendre comment un cerveau traite ce qui le contredit.
      </p>
      <p class="serie__lede">
        Chaque article part d’une scène de partie, cite l’étude fondatrice <strong>et sa critique</strong>,
        et se termine par une chose à faire. Plusieurs classiques que tu crois connaître n’ont pas
        survécu aux réplications : c’est dit à chaque fois.
      </p>
      <p class="serie__progress">
        <strong>{publishedCount}</strong> article{publishedCount > 1 ? "s" : ""} publié{publishedCount > 1 ? "s" : ""}
        sur {seriePsychologieTotal}. Un nouveau chaque mardi.
      </p>
    </header>

    {grappes.map((grappe) => (
      <section class="grappe" id={grappe.id}>
        <h2>{grappe.titre}</h2>
        <p class="grappe__chapeau">{grappe.chapeau}</p>
        <ol class="grappe__list">
          {grappe.items.map((item) => (
            <li class:list={["item", { "item--pilier" : item.pilier, "item--soon" : !item.href }]}>
              {item.href ? (
                <a href={item.href}>
                  <span class="item__title">{item.post?.data.title ?? item.label}</span>
                  {item.excerpt && <span class="item__excerpt">{item.excerpt}</span>}
                  <span class="item__meta">
                    <span class="item__date">{item.date}</span>
                  </span>
                </a>
              ) : (
                <div>
                  <span class="item__title">{item.label}</span>
                  <span class="item__meta">
                    <span class="item__date">à venir</span>
                  </span>
                </div>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .serie {
    max-width: var(--container);
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }

  .serie__hero {
    max-width: 46rem;
    margin-bottom: 3.5rem;
  }

  .serie__eyebrow {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.75rem;
  }

  .serie__hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .serie__lede {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .serie__progress {
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    background: var(--surface-warm);
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .grappe {
    margin-bottom: 3rem;
  }

  .grappe h2 {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    margin-bottom: 0.4rem;
  }

  .grappe__chapeau {
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
    max-width: 44rem;
  }

  .grappe__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .item > a,
  .item > div {
    display: block;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  .item > a:hover,
  .item > a:focus-visible {
    border-color: var(--green-border);
    transform: translateX(2px);
  }

  .item--pilier > a,
  .item--pilier > div {
    border-left: 3px solid var(--green);
  }

  .item--soon > div {
    background: transparent;
    border-style: dashed;
    opacity: 0.6;
  }

  .item__title {
    display: block;
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .item__excerpt {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .item__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }


  .item__date {
    font-size: 0.8rem;
    color: var(--text-dim);
  }
</style>
