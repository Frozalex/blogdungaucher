---
import { getCollection } from "astro:content";

import EditorialSeriesHeader from "../../../components/EditorialSeriesHeader.astro";
import EditorialSeriesCard from "../../../components/EditorialSeriesCard.astro";
import "../../../styles/editorial-resources.css";
import "../../../styles/editorial-series.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { serieMoteurPhases, serieMoteurSlugs, serieMoteurTotal } from "../../../data/serie-moteur-python";
import { absoluteUrl, buildBreadcrumbJsonLd, formatDate, getAllPosts } from "../../../utils/blog";

// getAllPosts() ne renvoie que les articles dont la publishDate est passée : la série se
// dévoile au fil des semaines. Les articles à venir restent listés, sans lien, pour que le
// parcours complet soit lisible dès le départ.
const published = await getAllPosts();
const bySlug = new Map(published.map((post) => [post.id.split("/").pop() ?? post.id, post]));

// La collection complète, elle, contient aussi les articles à venir : c'est la seule
// façon d'annoncer la date de sortie sans la recopier à la main dans cette page.
const toutes = await getCollection("blog");
const illustrations = new Map(toutes.map(post => [post.id.split("/").pop() ?? post.id, post]));
const datesDeLaSerie = toutes
  .filter((post) => serieMoteurSlugs.includes(post.id.split("/").pop() ?? post.id))
  .map((post) => post.data.publishDate)
  .sort((a, b) => a.getTime() - b.getTime());
const premiereDate = datesDeLaSerie.at(0) ?? null;
const derniereDate = datesDeLaSerie.at(-1) ?? null;

const phases = serieMoteurPhases.map((phase) => ({
  ...phase,
  items : phase.items.map((item) => {
    const post = bySlug.get(item.slug);
    return {
      ...item,
      post,
      illustrationPost: illustrations.get(item.slug),
      href : post ? `/fr/blog/${item.slug}/` : null,
      date : post ? formatDate(post.data.publishDate) : null,
      excerpt : post?.data.excerpt ?? null,
    };
  }),
}));

const publishedCount = phases.reduce(
  (total, phase) => total + phase.items.filter((item) => item.post).length,
  0,
);

const canonPath = "/fr/series/moteur-python/";
const title = "Série : programmer son moteur d'échecs en Python";
const description =
  `Une série de ${serieMoteurTotal} articles pour construire un moteur d'échecs de zéro en Python : échiquier, coups légaux, perft, évaluation, minimax, alpha-bêta, UCI. Du code qui tourne et un test vérifiable à chaque étape.`;

const structuredData = [
  buildBreadcrumbJsonLd([
    { name : "Accueil", path : "/fr/" },
    { name : "Séries", path : "/fr/series/" },
    { name : "Moteur en Python", path : canonPath },
  ]),
  {
    "@context" : "https://schema.org",
    "@type" : "CollectionPage",
    name : title,
    description,
    url : absoluteUrl(canonPath),
    inLanguage : "fr-FR",
    mainEntity : {
      "@type" : "ItemList",
      numberOfItems : publishedCount,
      itemListElement : phases
        .flatMap((phase) => phase.items)
        .filter((item) => item.href)
        .map((item, index) => ({
          "@type" : "ListItem",
          position : index + 1,
          url : absoluteUrl(item.href as string),
          name : item.post?.data.title ?? item.label,
        })),
    },
  },
];
---

<BaseLayout title={`${title} | Blog d’un Gaucher`} description={description} canonicalPath={canonPath} structuredData={structuredData} noindex={publishedCount === 0} omitEnDeAlternateLinks omitPtBrNlAlternates>
  <div class="resource-page"><div class="container">
    <EditorialSeriesHeader active="moteur-python" title="Programmer son moteur d’échecs en Python" published={publishedCount} total={serieMoteurTotal}>
      <p>
        Construire un moteur de zéro, article après article : représenter l’échiquier, générer les
        coups légaux, évaluer une position, chercher le meilleur coup, et finir par le brancher dans
        une vraie interface. Chaque étape livre du code qui tourne.
      </p>
      <p>
        La particularité de cette série tient en un mot : <strong>vérifiable</strong>. La correction du
        générateur de coups se prouve par <em>perft</em>, en comparant à des valeurs de référence
        publiées. La force du moteur se mesure contre Stockfish bridé. À chaque article, tu sais si
        ton code est juste, et de combien tu as progressé.
      </p>
      <Fragment slot="status"><p class="series-cadence">{publishedCount === 0 && premiereDate && `Un article par mardi, du ${formatDate(premiereDate)} au ${formatDate(derniereDate!)}.`}{publishedCount > 0 && publishedCount < serieMoteurTotal && derniereDate && `Un nouvel article chaque mardi, jusqu’au ${formatDate(derniereDate)}.`}</p><a class="resource-button" href="#parcours">{publishedCount === 0 ? "Découvrir le programme ↓" : "Explorer les étapes ↓"}</a></Fragment>
    </EditorialSeriesHeader>
    <nav class="series-jumps" id="parcours" aria-label="Les phases du parcours"><span>Le programme</span><ol>{phases.map(phase => <li><a href={`#${phase.id}`}>{phase.titre}</a></li>)}</ol></nav>
    {phases.map((phase,i) => <section class="series-section" id={phase.id} aria-labelledby={`${phase.id}-title`}>
      <div class="series-section__heading"><span class="series-section__number" aria-hidden="true">{String(i+1).padStart(2,"0")}</span><h2 id={`${phase.id}-title`}>{phase.titre}</h2><span class="series-section__count">{phase.items.length} étape{phase.items.length>1?"s":""}</span></div>
      <p class="series-section__intro">{phase.chapeau}</p>
      <ol class:list={["series-articles",{"series-articles--single":phase.items.length===1,"series-articles--pair":phase.items.length===2,"series-articles--quad":phase.items.length===4}]}>{phase.items.map(item => <li><EditorialSeriesCard post={item.post} illustrationPost={item.illustrationPost} title={item.post?.data.title ?? item.label} excerpt={item.excerpt} href={item.href} verification={item.verification} /></li>)}</ol>
    </section>)}
    <div class="resource-end"><a class="resource-link" href="/fr/series/">← Toutes les séries</a><a class="resource-link" href="/fr/science/">Explorer la rubrique Science →</a><a class="resource-link" href="/fr/series/psychologie/">Le parcours Psychologie →</a></div>
  </div></div>
</BaseLayout>
