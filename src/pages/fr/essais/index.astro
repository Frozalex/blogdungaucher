---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EssaisComingSoon from "../../../components/EssaisComingSoon.astro";
import { buildBreadcrumbJsonLd } from "../../../utils/blog";
---

<BaseLayout
  title="Essais | textes longs et personnels | Blog d'un Gaucher"
  description="Essais personnels sur les échecs : réflexions longues sur la compétition, la progression, la vie de joueur de club et la passion du jeu. À paraître."
  canonicalPath="/fr/essais/"
  lang="fr"
  enPath="/en/essais/"
  dePath="/de/essais/"
  structuredData={buildBreadcrumbJsonLd([
    { name: "Accueil", path: "/fr/" },
    { name: "Essais", path: "/fr/essais/" },
  ])}
>
  <EssaisComingSoon lang="fr" />
</BaseLayout>
