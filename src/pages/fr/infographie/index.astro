---
import BaseLayout from "../../../layouts/BaseLayout.astro";

import { categoryMap } from "../../../data/site";
import { getAllPosts, getPostSlug } from "../../../utils/blog";

/** L'Observatoire éditorial : refonte data viz totale.
 *  Toutes les publications hors grand-oral, agrégées en plusieurs cartes.
 *  Données calculées au build, animations clientes. */
const allPosts = await getAllPosts();
const baseList = allPosts
  .filter((p) => p.data.category !== "grand-oral")
  .sort((a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime());

function parseReadingMinutes(rt?: string): number {
  if (!rt) return 15;
  const m = rt.match(/(\d+)/);
  return m ? Number(m[1]) : 15;
}

type ArticleVM = {
  num: string;
  slug: string;
  title: string;
  excerpt: string;
  category: "science" | "esprit" | "societe";
  categoryLabel: string;
  pillar?: string;
  date: string;
  isoDate: string;
  ts: number;
  readingTime: number;
  tags: string[];
  x: number;
  y: number;
};

const articles: ArticleVM[] = baseList.map((post, idx) => {
  const cat = post.data.category as ArticleVM["category"];
  const meta = categoryMap[cat];
  const minutes = parseReadingMinutes(post.data.readingTime);
  return {
    num: String(idx + 1).padStart(2, "0"),
    slug: getPostSlug(post),
    title: post.data.title,
    excerpt: post.data.excerpt,
    category: cat,
    categoryLabel: meta.label,
    pillar: post.data.pillar,
    date: post.data.publishDate.toLocaleDateString("fr-FR", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    }),
    isoDate: post.data.publishDate.toISOString().slice(0, 10),
    ts: post.data.publishDate.getTime(),
    readingTime: minutes,
    tags: (post.data.tags ?? []).slice(0, 3),
    x: 0,
    y: 0,
  };
});

/* ── Stats globales ─────────────────────────────────────── */
const totalArticles = articles.length;
const totalMin = articles.reduce((s, a) => s + a.readingTime, 0);
const totalHours = Math.floor(totalMin / 60);
const totalMinRest = totalMin % 60;
const totalReadingLabel =
  totalHours > 0
    ? `${totalHours}h${String(totalMinRest).padStart(2, "0")}`
    : `${totalMinRest} min`;

const firstDate = baseList[0]?.data.publishDate;
const lastDate = baseList[baseList.length - 1]?.data.publishDate;
const startTs = firstDate ? firstDate.getTime() : 0;
const endTs = lastDate ? lastDate.getTime() : 0;
const spanDays =
  endTs && startTs
    ? Math.max(1, Math.round((endTs - startTs) / 86_400_000))
    : 0;
const avgReadingTime =
  totalArticles > 0 ? Math.round(totalMin / totalArticles) : 0;

const fmtLong = (d?: Date) =>
  d
    ? d.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
    : "";

/* ── Scatter plot : positions normalisées ──────────────── */
const minMinutes = Math.min(...articles.map((a) => a.readingTime));
const maxMinutes = Math.max(...articles.map((a) => a.readingTime));
const timeRange = Math.max(1, endTs - startTs);
const minRange = Math.max(1, maxMinutes - minMinutes);

articles.forEach((a) => {
  a.x = ((a.ts - startTs) / timeRange) * 100;
  a.y = 100 - ((a.readingTime - minMinutes) / minRange) * 100;
});

/* ── Heatmap mensuelle ─────────────────────────────────── */
const monthlyCounts = new Map<string, number>();
articles.forEach((a) => {
  const ym = a.isoDate.slice(0, 7);
  monthlyCounts.set(ym, (monthlyCounts.get(ym) ?? 0) + 1);
});

type MonthCell = { ym: string; label: string; year: string; count: number };
const months: MonthCell[] = [];
if (firstDate && lastDate) {
  const cur = new Date(Date.UTC(firstDate.getUTCFullYear(), firstDate.getUTCMonth(), 1));
  const endMonth = new Date(Date.UTC(lastDate.getUTCFullYear(), lastDate.getUTCMonth(), 1));
  while (cur <= endMonth) {
    const ym = cur.toISOString().slice(0, 7);
    months.push({
      ym,
      label: cur.toLocaleDateString("fr-FR", { month: "short", timeZone: "UTC" }).replace(".", ""),
      year: String(cur.getUTCFullYear()),
      count: monthlyCounts.get(ym) ?? 0,
    });
    cur.setUTCMonth(cur.getUTCMonth() + 1);
  }
}
const maxMonthCount = Math.max(1, ...months.map((m) => m.count));

/* ── Top tags par rubrique ─────────────────────────────── */
type CatKey = "science" | "esprit" | "societe";
const tagsByCategory: Record<CatKey, Map<string, number>> = {
  science: new Map(),
  esprit: new Map(),
  societe: new Map(),
};
articles.forEach((a) => {
  const map = tagsByCategory[a.category];
  a.tags.forEach((t) => {
    if (!t) return;
    map.set(t, (map.get(t) ?? 0) + 1);
  });
});

const enrichedCats = (["science", "esprit", "societe"] as const)
  .map((key) => {
    const items = articles.filter((a) => a.category === key);
    const total = items.length;
    const totalRT = items.reduce((s, a) => s + a.readingTime, 0);
    const avg = total > 0 ? Math.round(totalRT / total) : 0;
    const topTags = [...tagsByCategory[key].entries()]
      .sort((a, b) => b[1] - a[1])
      .slice(0, 6)
      .map(([tag, n]) => ({ tag, n }));
    return {
      key,
      label: categoryMap[key].label,
      color: categoryMap[key].accent,
      tagline: categoryMap[key].tagline,
      count: total,
      pct: total > 0 ? Math.round((total / totalArticles) * 100) : 0,
      totalRT,
      avg,
      topTags,
      first: items[0],
      last: items[items.length - 1],
    };
  })
  .filter((c) => c.count > 0);

/* ── Top 5 lectures longues ───────────────────────────── */
const topLong = [...articles].sort((a, b) => b.readingTime - a.readingTime).slice(0, 5);
const maxLong = topLong[0]?.readingTime ?? 1;
---

<BaseLayout
  title="L'Observatoire éditorial du Blog d'un Gaucher"
  description={`L'Observatoire : data viz interactive des ${totalArticles} publications du Blog d'un Gaucher. Firmament des articles, anatomie des rubriques, rythme éditorial, lectures profondes.`}
  canonicalPath="/fr/infographie/"
  omitEnDeAlternateLinks={true}
>

<div class="obs">

  {/* ═══════════════ HERO ═══════════════ */}
  <header class="obs-hero">
    <div class="obs-hero__bg" aria-hidden="true">
      {Array.from({ length: 80 }).map((_, i) => {
        const x = (i * 137.5) % 100;
        const y = (i * 41.7) % 100;
        const size = 1 + (i % 5) * 0.4;
        const op = 0.04 + ((i * 13) % 12) / 220;
        return (
          <span
            class="star"
            style={`left:${x}%;top:${y}%;width:${size}px;height:${size}px;opacity:${op}`}
          ></span>
        );
      })}
    </div>

    <div class="obs-hero__inner">
      <p class="kicker">Blog d'un Gaucher · vue d'ensemble</p>
      <h1 class="obs-title">
        <span class="obs-title__top">L'Observatoire</span>
        <span class="obs-title__bot">éditorial</span>
      </h1>
      <p class="obs-lede">
        Chaque article, une étoile. Voici le firmament des
        <strong>{totalArticles} publications</strong> du blog, cartographié
        par durée, par rubrique et par rythme.
      </p>

      <dl class="obs-stats">
        <div class="obs-stat" style={`--c:var(--c-sci)`}>
          <dt class="obs-stat__l">Articles</dt>
          <dd class="obs-stat__n" data-count={totalArticles}>{totalArticles}</dd>
        </div>
        <div class="obs-stat" style={`--c:var(--c-esp)`}>
          <dt class="obs-stat__l">Heures de lecture</dt>
          <dd class="obs-stat__n obs-stat__n--text">{totalReadingLabel}</dd>
        </div>
        <div class="obs-stat" style={`--c:var(--c-soc)`}>
          <dt class="obs-stat__l">Jours couverts</dt>
          <dd class="obs-stat__n" data-count={spanDays}>{spanDays}</dd>
        </div>
        <div class="obs-stat" style={`--c:var(--text-main)`}>
          <dt class="obs-stat__l">Durée moyenne</dt>
          <dd class="obs-stat__n" data-count={avgReadingTime}>
            {avgReadingTime}<span class="obs-stat__u">min</span>
          </dd>
        </div>
      </dl>

      <p class="obs-range">
        <span>{fmtLong(firstDate)}</span>
        <span class="obs-range__arrow" aria-hidden="true">⤍</span>
        <span>{fmtLong(lastDate)}</span>
      </p>
    </div>

    <a class="obs-scroll" href="#firmament" aria-label="Vers le firmament">
      <span>Explorer</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12l7 7 7-7"/></svg>
    </a>
  </header>

  {/* ═══════════════ LE FIRMAMENT ═══════════════ */}
  <section class="firm" id="firmament">
    <div class="firm__head">
      <p class="eyebrow">Carte n°1</p>
      <h2 class="card-title">Le firmament</h2>
      <p class="card-sub">
        Chaque point est un article. Sa position horizontale dit
        <em>quand</em> il a paru, sa hauteur dit <em>combien de minutes</em>
        il demande. Survole pour identifier, clique pour lire.
      </p>
      <div class="legend">
        {enrichedCats.map((c) => (
          <button
            class="legend__btn"
            type="button"
            data-cat={c.key}
            style={`--c:${c.color}`}
            aria-pressed="false"
          >
            <span class="legend__dot" aria-hidden="true"></span>
            <span class="legend__name">{c.label}</span>
            <span class="legend__n">{c.count}</span>
          </button>
        ))}
        <button class="legend__btn legend__btn--all" type="button" data-cat="all" aria-pressed="true">
          <span class="legend__name">Tout</span>
        </button>
      </div>
    </div>

    <div class="plot">
      <div class="plot__yaxis" aria-hidden="true">
        <span class="plot__yl plot__yl--top">{maxMinutes} min</span>
        <span class="plot__yl plot__yl--mid">{Math.round((maxMinutes + minMinutes) / 2)} min</span>
        <span class="plot__yl plot__yl--bot">{minMinutes} min</span>
        <span class="plot__yaxis-label">Durée de lecture</span>
      </div>

      <div class="plot__area" role="list" aria-label="Articles sur le firmament">
        <span class="plot__grid plot__grid--h plot__grid--h25"></span>
        <span class="plot__grid plot__grid--h plot__grid--h50"></span>
        <span class="plot__grid plot__grid--h plot__grid--h75"></span>
        <span class="plot__grid plot__grid--v plot__grid--v25"></span>
        <span class="plot__grid plot__grid--v plot__grid--v50"></span>
        <span class="plot__grid plot__grid--v plot__grid--v75"></span>

        {articles.map((a, i) => {
          const r = 6 + Math.min(14, (a.readingTime - minMinutes) / Math.max(1, maxMinutes - minMinutes) * 10);
          return (
            <a
              class={`star-pt star-pt--${a.category}`}
              href={`/fr/blog/${a.slug}/`}
              data-cat={a.category}
              data-idx={i}
              role="listitem"
              style={`left:${a.x}%;top:${a.y}%;--r:${r}px;--d:${(i % 12) * 40}ms`}
              aria-label={`${a.date} — ${a.title} (${a.readingTime} min)`}
            >
              <span class="star-pt__halo" aria-hidden="true"></span>
              <span class="star-pt__core" aria-hidden="true"></span>
              <span class="star-pt__tip">
                <span class="star-pt__tip-d">{a.date} · {a.readingTime} min</span>
                <span class="star-pt__tip-t">{a.title}</span>
                <span class="star-pt__tip-c">{a.categoryLabel}</span>
              </span>
            </a>
          );
        })}
      </div>

      <div class="plot__xaxis" aria-hidden="true">
        <span class="plot__xl plot__xl--lo">{fmtLong(firstDate)}</span>
        <span class="plot__xl plot__xl--mid">·</span>
        <span class="plot__xl plot__xl--hi">{fmtLong(lastDate)}</span>
        <span class="plot__xaxis-label">Date de publication</span>
      </div>
    </div>

    <p class="firm__note">
      Pour les esprits curieux : le firmament est une matrice
      <em>date × densité de lecture</em>. Plus une étoile est haute, plus
      elle demande de patience. Les couleurs distinguent les trois rubriques.
    </p>
  </section>

  {/* ═══════════════ TROIS CONSTELLATIONS ═══════════════ */}
  <section class="const">
    <div class="const__head">
      <p class="eyebrow">Carte n°2</p>
      <h2 class="card-title">Trois constellations</h2>
      <p class="card-sub">
        L'anatomie comparée des rubriques : volume, profondeur, motifs récurrents.
      </p>
    </div>

    <div class="const__grid">
      {enrichedCats.map((c) => (
        <article class="const__card" style={`--c:${c.color}`}>
          <header class="const__top">
            <span class="const__orb" aria-hidden="true"></span>
            <div>
              <p class="const__name">{c.label}</p>
              <p class="const__tagline">{c.tagline}</p>
            </div>
          </header>

          <div class="const__big">
            <span class="const__big-n" data-count={c.count}>{c.count}</span>
            <span class="const__big-l">articles · {c.pct} %</span>
          </div>

          <div class="const__share" role="img" aria-label={`${c.pct} % de la collection`}>
            <span class="const__share-fill" style={`width:${c.pct}%`}></span>
          </div>

          <dl class="const__kpi">
            <div>
              <dt>Lecture cumulée</dt>
              <dd>{Math.floor(c.totalRT / 60)}h{String(c.totalRT % 60).padStart(2, "0")}</dd>
            </div>
            <div>
              <dt>Durée moyenne</dt>
              <dd>{c.avg} min</dd>
            </div>
          </dl>

          {c.topTags.length > 0 && (
            <div class="const__tags">
              <p class="const__tags-l">Motifs récurrents</p>
              <ul>
                {c.topTags.map((t) => (
                  <li>
                    <span class="const__tags-t">{t.tag}</span>
                    <span class="const__tags-n">×{t.n}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <footer class="const__foot">
            {c.first && (
              <a href={`/fr/blog/${c.first.slug}/`} class="const__link">
                <span class="const__link-l">Premier</span>
                <span class="const__link-t">{c.first.title}</span>
              </a>
            )}
            {c.last && c.last !== c.first && (
              <a href={`/fr/blog/${c.last.slug}/`} class="const__link">
                <span class="const__link-l">Dernier</span>
                <span class="const__link-t">{c.last.title}</span>
              </a>
            )}
          </footer>
        </article>
      ))}
    </div>
  </section>

  {/* ═══════════════ LE POULS ═══════════════ */}
  <section class="pulse">
    <div class="pulse__head">
      <p class="eyebrow">Carte n°3</p>
      <h2 class="card-title">Le pouls éditorial</h2>
      <p class="card-sub">
        Combien d'articles par mois ? La densité révèle le rythme : périodes
        de tempo soutenu, accalmies, accélérations.
      </p>
    </div>

    <div class="pulse__chart">
      <div class="pulse__row" role="list">
        {months.map((m) => {
          const intensity = m.count / maxMonthCount;
          const h = Math.max(8, intensity * 100);
          return (
            <div
              class={`pulse__col ${m.count === 0 ? "pulse__col--zero" : ""}`}
              style={`--h:${h}%;--i:${intensity.toFixed(2)}`}
              role="listitem"
              data-tip={`${m.label} ${m.year} : ${m.count} ${m.count > 1 ? "articles" : "article"}`}
            >
              <span class="pulse__bar" aria-hidden="true"></span>
              <span class="pulse__n">{m.count > 0 ? m.count : ""}</span>
              <span class="pulse__m">{m.label}</span>
            </div>
          );
        })}
      </div>

      <div class="pulse__legend">
        <span class="pulse__legend-l">Densité</span>
        <span class="pulse__legend-bar" aria-hidden="true"></span>
        <span class="pulse__legend-min">0</span>
        <span class="pulse__legend-max">{maxMonthCount}/mois</span>
      </div>
    </div>
  </section>

  {/* ═══════════════ LECTURES PROFONDES ═══════════════ */}
  <section class="deep">
    <div class="deep__head">
      <p class="eyebrow">Carte n°4</p>
      <h2 class="card-title">Lectures profondes</h2>
      <p class="card-sub">
        Le top des articles qui demandent le plus de patience — ceux qu'on ne
        lit pas entre deux rames de métro.
      </p>
    </div>

    <ol class="deep__list">
      {topLong.map((a, i) => {
        const pct = (a.readingTime / maxLong) * 100;
        return (
          <li class={`deep__row deep__row--${a.category}`} style={`--c:var(--c-${a.category === "science" ? "sci" : a.category === "esprit" ? "esp" : "soc"});--w:${pct}%`}>
            <span class="deep__rank">{String(i + 1).padStart(2, "0")}</span>
            <div class="deep__body">
              <a href={`/fr/blog/${a.slug}/`} class="deep__t">{a.title}</a>
              <div class="deep__meta">
                <span class="deep__cat">{a.categoryLabel}</span>
                <span class="deep__dot">·</span>
                <time datetime={a.isoDate}>{a.date}</time>
              </div>
              <div class="deep__bar" aria-hidden="true">
                <span class="deep__fill"></span>
              </div>
            </div>
            <span class="deep__min">
              <span class="deep__min-n">{a.readingTime}</span>
              <span class="deep__min-u">min</span>
            </span>
          </li>
        );
      })}
    </ol>
  </section>

  {/* ═══════════════ CLOSING ═══════════════ */}
  <footer class="obs-end">
    <div class="obs-end__inner">
      <p class="obs-end__q">Le firmament continue de s'étendre.</p>
      <p class="obs-end__sub">
        Un article par lundi, un par jeudi — sauf surprise.
      </p>
      <div class="obs-end__ctas">
        <a class="obs-end__btn obs-end__btn--p" href="/fr/blog/">
          Voir tous les articles
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
        <a class="obs-end__btn" href="/fr/about/">À propos du projet</a>
      </div>
    </div>
  </footer>

</div>
</BaseLayout>

{/* ═══════════════ SCRIPT ═══════════════ */}
<script>
  /* ─ Filtre par catégorie sur le firmament + légende ─ */
  const legBtns = document.querySelectorAll<HTMLButtonElement>(".legend__btn");
  const points  = document.querySelectorAll<HTMLAnchorElement>(".star-pt");

  let active: string = "all";
  function setActive(next: string) {
    active = next;
    legBtns.forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.cat === active)),
    );
    points.forEach((p) => {
      const match = active === "all" || p.dataset.cat === active;
      p.classList.toggle("star-pt--dim", !match);
    });
  }
  legBtns.forEach((b) =>
    b.addEventListener("click", () => {
      const next = b.dataset.cat ?? "all";
      setActive(active === next && next !== "all" ? "all" : next);
    }),
  );

  /* ─ Tooltip de heatmap au survol ─ */
  const tipEl = document.createElement("div");
  tipEl.className = "pulse-tip";
  document.body.appendChild(tipEl);
  document.querySelectorAll<HTMLElement>(".pulse__col").forEach((col) => {
    col.addEventListener("mouseenter", () => {
      const tip = col.dataset.tip ?? "";
      tipEl.textContent = tip;
      tipEl.classList.add("pulse-tip--on");
    });
    col.addEventListener("mousemove", (e) => {
      tipEl.style.left = e.clientX + "px";
      tipEl.style.top = e.clientY + "px";
    });
    col.addEventListener("mouseleave", () => {
      tipEl.classList.remove("pulse-tip--on");
    });
  });

  /* ─ Count-up sur les chiffres clés ─ */
  function animateCount(el: HTMLElement) {
    const target = parseInt(el.dataset.count ?? "0", 10);
    if (!target || target < 1) return;
    const original = el.innerHTML;
    const duration = 1100;
    const start = performance.now();
    function step(now: number) {
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      const current = Math.round(eased * target);
      if (p < 1) {
        el.textContent = String(current);
        requestAnimationFrame(step);
      } else {
        el.innerHTML = original;
      }
    }
    el.textContent = "0";
    requestAnimationFrame(step);
  }

  const countIo = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          animateCount(e.target as HTMLElement);
          countIo.unobserve(e.target);
        }
      });
    },
    { threshold: 0.5 },
  );
  document
    .querySelectorAll<HTMLElement>("[data-count]")
    .forEach((el) => countIo.observe(el));

  /* ─ Reveal scroll : sections + cartes ─ */
  const revealIo = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-in");
          revealIo.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12 },
  );
  document
    .querySelectorAll<HTMLElement>(".firm, .const__card, .pulse, .deep__row, .obs-end")
    .forEach((el) => {
      el.classList.add("reveal");
      revealIo.observe(el);
    });

  /* ─ Apparition des étoiles au scroll : staggered ─ */
  const starIo = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("star-pt--in");
          starIo.unobserve(e.target);
        }
      });
    },
    { threshold: 0.05 },
  );
  document
    .querySelectorAll<HTMLElement>(".star-pt")
    .forEach((el) => starIo.observe(el));
</script>

{/* ═══════════════ STYLES ═══════════════ */}
<style>
  /* ─ Tokens locaux ─ */
  .obs {
    --c-sci: #5b9fd4;
    --c-esp: #f0a050;
    --c-soc: #5cc4b0;
    --paper: var(--surface);
    --paper-2: color-mix(in srgb, var(--text-main) 3%, var(--surface));
    --paper-3: color-mix(in srgb, var(--text-main) 6%, var(--surface));
    --ink: var(--text-main);
    --ink-2: var(--text-muted);
    --rule: var(--border-soft);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans, "Space Grotesk", system-ui, sans-serif);
    overflow-x: clip;
  }

  /* Common utility */
  .eyebrow {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 0.75rem;
  }
  .card-title {
    font-family: var(--font-serif, "Fraunces", Georgia, serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: -0.025em;
    line-height: 1;
    margin: 0 0 1rem;
    color: var(--ink);
  }
  .card-sub {
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0 0 2rem;
  }
  .card-sub em {
    color: var(--ink);
    font-style: italic;
    font-family: var(--font-serif, serif);
  }

  /* Reveal */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity 700ms ease, transform 700ms cubic-bezier(0.16,1,0.3,1); }
  .reveal.is-in { opacity: 1; transform: none; }

  /* ═══════ HERO ═══════ */
  .obs-hero {
    position: relative;
    min-height: 100vh;
    padding: clamp(4rem, 9vw, 7rem) clamp(1.5rem, 6vw, 5rem) clamp(5rem, 9vw, 7rem);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background:
      radial-gradient(ellipse at 80% 20%, color-mix(in srgb, var(--c-sci) 4%, transparent) 0%, transparent 55%),
      radial-gradient(ellipse at 20% 80%, color-mix(in srgb, var(--c-esp) 4%, transparent) 0%, transparent 55%),
      var(--paper);
  }
  .obs-hero__bg { position: absolute; inset: 0; pointer-events: none; }
  .star {
    position: absolute;
    border-radius: 50%;
    background: var(--ink);
    animation: twinkle 5s ease-in-out infinite;
  }
  @keyframes twinkle {
    0%, 100% { opacity: var(--op, 0.1); transform: scale(1); }
    50%      { opacity: 0.4; transform: scale(1.4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .star { animation: none; }
  }

  .obs-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }

  .kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 2.5rem;
  }

  .obs-title {
    font-family: var(--font-serif, serif);
    font-weight: 300;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -0.035em;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
  }
  .obs-title__top {
    font-size: clamp(3.5rem, 11vw, 9.5rem);
    color: var(--ink);
  }
  .obs-title__bot {
    font-size: clamp(2.6rem, 8vw, 7rem);
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--ink) 38%, transparent);
    padding-left: clamp(1.5rem, 6vw, 5rem);
  }

  .obs-lede {
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0 0 3rem;
  }
  .obs-lede strong { color: var(--ink); font-weight: 600; }

  /* Stats grid */
  .obs-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    padding: 1.5rem 0;
    margin: 0 0 1.5rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 760px) {
    .obs-stats { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; padding: 1.5rem; }
  }
  .obs-stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0 1.5rem 0 0;
    position: relative;
  }
  .obs-stat + .obs-stat::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12%;
    bottom: 12%;
    width: 1px;
    background: var(--rule);
  }
  @media (max-width: 760px) {
    .obs-stat + .obs-stat::before { display: none; }
    .obs-stat { padding: 0; }
  }
  .obs-stat__l {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .obs-stat__n {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--c);
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.25em;
  }
  .obs-stat__n--text { font-size: clamp(2.1rem, 4.4vw, 3.6rem); }
  .obs-stat__u {
    font-size: 0.32em;
    font-weight: 500;
    font-style: normal;
    letter-spacing: 0;
    color: var(--ink-2);
    font-family: var(--font-sans, sans-serif);
  }

  .obs-range {
    font-size: 0.78rem;
    color: var(--ink-2);
    display: flex;
    align-items: center;
    gap: 0.8em;
    flex-wrap: wrap;
  }
  .obs-range__arrow {
    color: var(--ink);
    opacity: 0.4;
    font-size: 1.2em;
  }

  .obs-scroll {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .obs-scroll:hover { color: var(--ink); }
  .obs-scroll svg {
    animation: bob 1.8s ease-in-out infinite;
  }
  @keyframes bob { 0%,100% { transform: translateY(0);} 50% { transform: translateY(4px);} }
  @media (prefers-reduced-motion: reduce) { .obs-scroll svg { animation: none; } }

  /* ═══════ LE FIRMAMENT (scatter plot) ═══════ */
  .firm {
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .firm__head { max-width: 1100px; margin: 0 auto 3rem; }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .legend__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.9rem;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 99px;
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }
  .legend__btn:hover {
    background: color-mix(in srgb, var(--c, var(--ink)) 7%, var(--paper));
    border-color: color-mix(in srgb, var(--c, var(--ink)) 30%, var(--rule));
    color: var(--ink);
  }
  .legend__btn[aria-pressed="true"] {
    background: color-mix(in srgb, var(--c, var(--ink)) 12%, var(--paper));
    border-color: color-mix(in srgb, var(--c, var(--ink)) 50%, var(--rule));
    color: var(--ink);
  }
  .legend__dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 18%, transparent);
  }
  .legend__name { letter-spacing: 0.03em; }
  .legend__n {
    font-family: var(--font-serif, serif);
    font-style: italic;
    color: var(--c);
    font-size: 0.95rem;
    margin-left: 0.1rem;
  }
  .legend__btn--all { color: var(--ink); }
  .legend__btn--all[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  /* Plot frame */
  .plot {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 64px 1fr;
    grid-template-rows: auto 36px;
    gap: 0;
  }

  .plot__yaxis {
    position: relative;
    border-right: 1px solid var(--rule);
  }
  .plot__yl {
    position: absolute;
    right: 12px;
    font-size: 0.66rem;
    color: var(--ink-2);
    letter-spacing: 0.04em;
    font-feature-settings: "tnum";
  }
  .plot__yl--top { top: 0; }
  .plot__yl--mid { top: 50%; transform: translateY(-50%); }
  .plot__yl--bot { bottom: 0; }
  .plot__yaxis-label {
    position: absolute;
    left: 4px;
    top: 50%;
    transform: rotate(-90deg) translateX(50%);
    transform-origin: left top;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    opacity: 0.7;
    white-space: nowrap;
  }

  .plot__area {
    position: relative;
    aspect-ratio: 16 / 9;
    min-height: 360px;
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--ink) 1%, var(--paper)), var(--paper));
    border-bottom: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    overflow: hidden;
  }
  @media (max-width: 640px) {
    /* aspect-ratio + min-height forçait la largeur à 460×4/5 = 368px, au-delà
       de la colonne de grille (≈263px) : le côté droit du scatter (articles
       récents) débordait hors écran. On fixe la hauteur et on laisse la largeur
       suivre la cellule 1fr. */
    .plot__area { aspect-ratio: auto; height: 460px; min-height: 0; }
  }

  .plot__grid {
    position: absolute;
    background: var(--rule);
    pointer-events: none;
  }
  .plot__grid--h { left: 0; right: 0; height: 1px; }
  .plot__grid--v { top: 0; bottom: 0; width: 1px; }
  .plot__grid--h25 { top: 25%; }
  .plot__grid--h50 { top: 50%; }
  .plot__grid--h75 { top: 75%; }
  .plot__grid--v25 { left: 25%; }
  .plot__grid--v50 { left: 50%; }
  .plot__grid--v75 { left: 75%; }

  /* Star point */
  .star-pt {
    position: absolute;
    transform: translate(-50%, -50%);
    width: var(--r, 10px);
    height: var(--r, 10px);
    cursor: pointer;
    text-decoration: none;
    opacity: 0;
    transition: opacity 600ms ease;
    transition-delay: var(--d, 0ms);
    z-index: 1;
  }
  .star-pt--in { opacity: 1; }
  .star-pt--science { --pc: var(--c-sci); }
  .star-pt--esprit  { --pc: var(--c-esp); }
  .star-pt--societe { --pc: var(--c-soc); }

  .star-pt__halo {
    position: absolute;
    inset: -45%;
    background: radial-gradient(circle, color-mix(in srgb, var(--pc) 38%, transparent) 0%, transparent 70%);
    border-radius: 50%;
    opacity: 0.6;
    transition: opacity 220ms ease, transform 220ms ease;
  }
  .star-pt__core {
    position: absolute;
    inset: 0;
    background: var(--pc);
    border-radius: 50%;
    border: 1.5px solid var(--paper);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--ink) 18%, transparent);
    transition: transform 220ms cubic-bezier(0.34,1.56,0.64,1), box-shadow 220ms ease;
  }
  .star-pt:hover { z-index: 10; }
  .star-pt:hover .star-pt__core,
  .star-pt:focus-visible .star-pt__core {
    transform: scale(1.4);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--pc) 60%, transparent);
  }
  .star-pt:hover .star-pt__halo,
  .star-pt:focus-visible .star-pt__halo {
    opacity: 1;
    transform: scale(1.3);
  }
  .star-pt--dim {
    opacity: 0.12 !important;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.7);
  }

  .star-pt__tip {
    position: absolute;
    bottom: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: var(--ink);
    color: var(--paper);
    padding: 0.55rem 0.75rem;
    border-radius: 4px;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.74rem;
    line-height: 1.4;
    width: max-content;
    max-width: 280px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease, transform 180ms ease;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    z-index: 20;
  }
  .star-pt__tip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--ink);
  }
  .star-pt:hover .star-pt__tip,
  .star-pt:focus-visible .star-pt__tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .star-pt__tip-d {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .star-pt__tip-t {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 0.85rem;
    line-height: 1.3;
    white-space: normal;
  }
  .star-pt__tip-c {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pc);
    opacity: 0.95;
  }

  /* X axis */
  .plot__xaxis {
    grid-column: 2;
    position: relative;
    padding: 0.4rem 0 0;
  }
  .plot__xl {
    font-size: 0.66rem;
    color: var(--ink-2);
    font-feature-settings: "tnum";
  }
  .plot__xl--lo { position: absolute; left: 0; top: 0.4rem; }
  .plot__xl--mid { position: absolute; left: 50%; top: 0.4rem; transform: translateX(-50%); opacity: 0.5; }
  .plot__xl--hi { position: absolute; right: 0; top: 0.4rem; text-align: right; }
  .plot__xaxis-label {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    opacity: 0.7;
  }
  @media (max-width: 540px) {
    .plot__xl--mid { display: none; }
    .plot__xaxis { padding-bottom: 1.2rem; }
  }

  .firm__note {
    max-width: 1100px;
    margin: 2.5rem auto 0;
    font-size: 0.82rem;
    color: var(--ink-2);
    font-style: italic;
    font-family: var(--font-serif, serif);
    line-height: 1.6;
    padding-left: 1rem;
    border-left: 2px solid color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .firm__note em { font-style: normal; color: var(--ink); font-weight: 600; font-family: var(--font-sans, sans-serif); }

  /* ═══════ CONSTELLATIONS ═══════ */
  .const {
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }
  .const__head { max-width: 1100px; margin: 0 auto 3rem; }

  .const__grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 900px) {
    .const__grid { grid-template-columns: 1fr; }
  }

  .const__card {
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
    overflow: hidden;
    transition: border-color 250ms ease, transform 350ms ease, box-shadow 350ms ease;
  }
  .const__card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--c);
    opacity: 0.85;
  }
  .const__card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--c) 45%, var(--rule));
    box-shadow: 0 12px 32px color-mix(in srgb, var(--c) 12%, transparent);
  }

  .const__top {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .const__orb {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--c) 90%, white) 0%, var(--c) 100%);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--c) 16%, transparent),
      0 0 22px color-mix(in srgb, var(--c) 38%, transparent);
    flex-shrink: 0;
  }
  .const__name {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 1.25rem;
    margin: 0;
    color: var(--ink);
  }
  .const__tagline {
    font-size: 0.78rem;
    color: var(--ink-2);
    margin: 0.1rem 0 0;
    line-height: 1.4;
  }

  .const__big {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.4rem 0 0;
  }
  .const__big-n {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--c);
  }
  .const__big-l {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink-2);
    text-transform: uppercase;
  }

  .const__share {
    height: 4px;
    background: color-mix(in srgb, var(--c) 12%, var(--paper-3));
    border-radius: 99px;
    overflow: hidden;
  }
  .const__share-fill {
    display: block;
    height: 100%;
    background: var(--c);
    border-radius: 99px;
    transition: width 1.2s cubic-bezier(0.16,1,0.3,1) 0.2s;
  }

  .const__kpi {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin: 0;
    padding: 0.85rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .const__kpi div { padding: 0 0.5rem; }
  .const__kpi div:first-child { padding-left: 0; border-right: 1px solid var(--rule); }
  .const__kpi dt {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .const__kpi dd {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--ink);
    margin: 0.25rem 0 0;
  }

  .const__tags-l {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 0.65rem;
  }
  .const__tags ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .const__tags li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px dotted color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .const__tags li:last-child { border-bottom: none; padding-bottom: 0; }
  .const__tags-t {
    font-size: 0.85rem;
    color: var(--ink);
    text-transform: lowercase;
  }
  .const__tags-n {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--c);
  }

  .const__foot {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 0.5rem;
    margin-top: auto;
  }
  .const__link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 0.5rem 0;
    border-top: 1px solid var(--rule);
    transition: padding 200ms ease;
  }
  .const__link:hover { padding-left: 0.4rem; }
  .const__link-l {
    display: block;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c);
    margin-bottom: 0.15rem;
  }
  .const__link-t {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.3;
    color: var(--ink);
  }

  /* ═══════ POULS / HEATMAP ═══════ */
  .pulse {
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .pulse__head { max-width: 1100px; margin: 0 auto 3rem; }

  .pulse__chart {
    max-width: 1100px;
    margin: 0 auto;
  }

  .pulse__row {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 220px;
    padding: 1rem 0 0;
    border-bottom: 1px solid var(--rule);
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .pulse__row::-webkit-scrollbar { height: 4px; }
  .pulse__row::-webkit-scrollbar-thumb { background: var(--rule); border-radius: 2px; }

  .pulse__col {
    flex: 1 0 auto;
    min-width: 36px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    gap: 0.35rem;
    position: relative;
    cursor: default;
