---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EditorialPageHeader from "../../../components/EditorialPageHeader.astro";
import { categoryMap } from "../../../data/site";
import { getAllPosts, getPostSlug, getPostHeroSrc, formatDate, buildBreadcrumbJsonLd } from "../../../utils/blog";
import { buildSrcset } from "../../../utils/image-variants";
import "../../../styles/editorial-resources.css";
const posts = (await getAllPosts()).filter(post => !post.data.noindex && post.data.category !== "grand-oral");
const minutes = (post: typeof posts[number]) => Number.parseInt(post.data.readingTime,10) || 1;
const bySlug = new Map(posts.map(post=>[getPostSlug(post),post]));
const routes = [
  {number:"01",title:"Mémoire & apprentissage",question:"Comment les positions deviennent-elles familières ?",slugs:["echecs-et-memoire","echecs-memoire-de-travail","neuroplasticite-aux-echecs"]},
  {number:"02",title:"Pression & confiance",question:"Que se passe-t-il quand la partie se joue aussi dans ta tête ?",slugs:["echecs-stress-tournoi","syndrome-imposteur-aux-echecs","echecs-et-concentration"]},
  {number:"03",title:"IA & société",question:"Comment les machines changent-elles notre regard sur le jeu ?",slugs:["echecs-alphazero-stockfish","echecs-et-complexite-algorithmique","echecs-et-la-triche"]},
].map(route=>({...route,articles:route.slugs.flatMap(slug=>{const post=bySlug.get(slug);return post?[post]:[];})})).filter(route=>route.articles.length);
const categories = (["science","esprit","societe"] as const).map(key=>({key,...categoryMap[key],count:posts.filter(post=>post.data.category===key).length}));
const earliest = Math.min(...posts.map(post=>post.data.publishDate.getTime()));
const latest = Math.max(...posts.map(post=>post.data.publishDate.getTime()));
const maxMinutes = Math.max(1,...posts.map(minutes));
const readingTotal = posts.reduce((sum,post)=>sum+minutes(post),0);
const monthly = new Map<string,number>();
posts.forEach(post=>{const month=post.data.publishDate.toISOString().slice(0,7);monthly.set(month,(monthly.get(month)||0)+1);});
const months=[...monthly].sort(([a],[b])=>a.localeCompare(b));
const maxCount=Math.max(1,...monthly.values());
---
<BaseLayout title="L’Atlas du Gaucher : explorer les articles" description="Une question, plusieurs chemins pour l’explorer. Parcours de lecture, carte des articles et filtres par rubrique et durée dans l’Atlas du Gaucher." canonicalPath="/fr/infographie/" omitEnDeAlternateLinks={true} structuredData={buildBreadcrumbJsonLd([{name:"Accueil",path:"/fr/"},{name:"L’Atlas du Gaucher",path:"/fr/infographie/"}])}>
<div class="resource-page"><div class="container" data-atlas>
  <EditorialPageHeader active="atlas" label="Explorer · L’Atlas du Gaucher" title="Une question, plusieurs chemins pour l’explorer." intro="Je te propose des itinéraires à travers les articles : pars d’une question, suis un fil, puis choisis ta prochaine lecture." />
  <section class="resource-section" aria-labelledby="routes-title"><div class="resource-section-head"><h2 id="routes-title">Trois parcours pour commencer</h2><span>Ma sélection, dans l’ordre de lecture</span></div>
    <div class="atlas-routes">{routes.map(route=>{const illustrated=route.articles.find(post=>getPostHeroSrc(post));const image=illustrated?getPostHeroSrc(illustrated):null;return <article class="atlas-route">
      {image && <a class="atlas-route__image" href={`/fr/blog/${getPostSlug(illustrated!)}/`} tabindex="-1" aria-hidden="true"><img src={image} srcset={buildSrcset(image)} sizes="(min-width:900px) 360px, (min-width:640px) 45vw, 100vw" alt="" width="600" height="400" loading="eager" /></a>}
      <span class="resource-kicker">Parcours {route.number} · {route.articles.reduce((sum,post)=>sum+minutes(post),0)} min environ</span><h3>{route.title}</h3><p>{route.question}</p>
      <ol>{route.articles.map(post=><li><a href={`/fr/blog/${getPostSlug(post)}/`}>{post.data.title}<span aria-hidden="true">↗</span></a></li>)}</ol>
    </article>})}</div>
  </section>
  <section class="resource-section" aria-labelledby="atlas-title"><div class="resource-section-head"><h2 id="atlas-title">La carte des articles</h2><a href="#atlas-results" class="resource-link">Aller à la liste accessible ↓</a></div><p class="atlas-section-intro">Chaque point représente un article : la date de publication à l’horizontale, la durée de lecture estimée à la verticale. La liste sous la carte donne accès aux mêmes lectures.</p>
    <div class="atlas-controls" hidden data-atlas-controls><div class="resource-filter" role="group" aria-label="Filtrer par rubrique"><button type="button" data-atlas-category="all" aria-pressed="true">Tout</button>{categories.map(cat=><button type="button" data-atlas-category={cat.key} aria-pressed="false">{cat.label}</button>)}</div><label>Temps de lecture<select class="resource-field" aria-label="Temps de lecture" data-atlas-duration><option value="all">Toutes les durées</option><option value="short">5 min ou moins</option><option value="medium">6 à 10 min</option><option value="long">Plus de 10 min</option></select></label></div>
    <div class="atlas-map" aria-hidden="true"><div class="atlas-map__labels"><span>{maxMinutes} min</span><span>Durée estimée</span><span>1 min</span></div><div class="atlas-map__plot">{posts.map(post=><a tabindex="-1" class={`atlas-point atlas-point--${post.data.category}`} data-atlas-point data-category={post.data.category} data-minutes={minutes(post)} style={`left:${3+94*(post.data.publishDate.getTime()-earliest)/Math.max(1,latest-earliest)}%;top:${96-92*(minutes(post)-1)/Math.max(1,maxMinutes-1)}%`} href={`/fr/blog/${getPostSlug(post)}/`} title={`${post.data.title} · ${minutes(post)} min`}><span></span></a>)}</div><div class="atlas-map__dates"><span>{posts.length ? formatDate(new Date(earliest)):""}</span><span>{posts.length ? formatDate(new Date(latest)):""}</span></div></div>
    <div class="atlas-legend">{categories.map(cat=><span><i style={`background:${cat.accent}`} aria-hidden="true"></i>{cat.label}</span>)}</div>
    <div class="atlas-results" id="atlas-results"><div class="atlas-results__heading"><h3>Ta prochaine lecture</h3><p class="resource-feedback" data-atlas-count role="status">{posts.length} articles</p></div>
      <ul class="atlas-list">{posts.map(post=><li data-atlas-result data-category={post.data.category} data-minutes={minutes(post)}><a href={`/fr/blog/${getPostSlug(post)}/`}><span class="resource-kicker">{categoryMap[post.data.category].label} · {minutes(post)} min</span><h4>{post.data.title}</h4><time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time></a></li>)}</ul>
      <p hidden class="atlas-empty" data-atlas-empty>Aucun article ne correspond à ces filtres. Essaie une autre rubrique ou une autre durée.</p><button class="resource-button" type="button" hidden data-atlas-more>Afficher plus d’articles ↓</button>
    </div>
  </section>
  <section class="resource-section atlas-numbers" aria-labelledby="numbers-title"><div class="resource-section-head"><h2 id="numbers-title">Le média en chiffres</h2><span>Des repères sur les publications</span></div><p class="atlas-section-intro">Ces chiffres portent sur les {posts.length} articles publiés de Science, Esprit et Société. Les guides Grand oral sont regroupés dans <a class="resource-link" href="/fr/grand-oral/">leur propre rubrique ↗</a>. Les durées sont des estimations de lecture.</p><div class="atlas-numbers__grid"><dl><div><dt>Articles à explorer</dt><dd>{posts.length}</dd></div><div><dt>Minutes de lecture estimées</dt><dd>{readingTotal}</dd></div></dl><div><h3>Les trois regards</h3>{categories.map(cat=><div class="atlas-share"><a href={cat.href}>{cat.label}</a><span>{cat.count} articles</span><div><span style={`width:${posts.length?100*cat.count/posts.length:0}%`}></span></div></div>)}</div><div><h3>Au fil des mois</h3><div class="atlas-months" role="img" aria-label={months.map(([month,count])=>`${month} : ${count} articles`).join(" ; ")}>{months.map(([month,count])=><div><span>{count}</span><i style={`height:${count/maxCount*90}px`}></i><span>{new Date(`${month}-01T12:00:00Z`).toLocaleDateString('fr-FR',{month:'short',timeZone:'UTC'})}</span></div>)}</div></div></div></section>
  <div class="resource-end"><p>Un mot t’arrête dans ta lecture ?</p><a class="resource-link" href="/fr/glossaire/">Ouvrir le glossaire →</a></div>
</div></div>
</BaseLayout>
<script>
  function initAtlas(){
    const root=document.querySelector<HTMLElement>('[data-atlas]');if(!root||root.dataset.bound)return;root.dataset.bound='true';
    const controls=root.querySelector<HTMLElement>('[data-atlas-controls]')!;const buttons=[...root.querySelectorAll<HTMLButtonElement>('[data-atlas-category]')];const duration=root.querySelector<HTMLSelectElement>('[data-atlas-duration]')!;const items=[...root.querySelectorAll<HTMLElement>('[data-atlas-result]')];const points=[...root.querySelectorAll<HTMLElement>('[data-atlas-point]')];const more=root.querySelector<HTMLButtonElement>('[data-atlas-more]')!;let category='all';let limit=12;
    function matches(item:HTMLElement){const time=Number(item.dataset.minutes);return(category==='all'||item.dataset.category===category)&&(duration.value==='all'||(duration.value==='short'&&time<=5)||(duration.value==='medium'&&time>5&&time<=10)||(duration.value==='long'&&time>10));}
    function render(){const found=items.filter(matches);items.forEach(item=>item.hidden=true);found.slice(0,limit).forEach(item=>item.hidden=false);points.forEach(point=>point.hidden=!matches(point));root!.querySelector('[data-atlas-count]')!.textContent=`${Math.min(limit,found.length)} articles affichés sur ${found.length}`;root!.querySelector<HTMLElement>('[data-atlas-empty]')!.hidden=found.length>0;more.hidden=found.length<=limit;buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.atlasCategory===category)));}
    buttons.forEach(button=>button.addEventListener('click',()=>{category=button.dataset.atlasCategory!;limit=12;render();}));duration.addEventListener('change',()=>{limit=12;render();});more.addEventListener('click',()=>{limit+=12;render();});controls.hidden=false;render();
  }
  initAtlas();document.addEventListener('astro:page-load',initAtlas);
</script>
<style>
.atlas-routes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}.atlas-route{min-width:0}.atlas-route__image{display:block;aspect-ratio:3/2;overflow:hidden;border-radius:4px;margin-bottom:1.2rem}.atlas-route__image img{width:100%;height:100%;object-fit:cover}.atlas-route h3{font-family:var(--font-serif);font-size:1.7rem;font-weight:600;letter-spacing:-.03em;line-height:1.15;margin:.65rem 0}.atlas-route>p{font-size:.9rem;line-height:1.6;color:var(--text-muted);min-height:3rem}.atlas-route ol{padding:0;list-style:none;counter-reset:route}.atlas-route li{border-top:1px solid var(--border-strong);padding:.9rem 0;counter-increment:route}.atlas-route li a{display:flex;gap:.6rem;align-items:baseline;font-size:.9rem;line-height:1.5}.atlas-route li a:before{content:counter(route);color:var(--green);font-size:.7rem}.atlas-route li a>span{margin-left:auto;color:var(--green)}.atlas-section-intro{font-size:.92rem;line-height:1.7;color:var(--text-muted);max-width:75ch;margin-bottom:1.5rem}.atlas-controls{display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;align-items:end;padding:1rem 0}.atlas-controls label{display:flex;flex-direction:column;gap:.4rem;font-size:.72rem;color:var(--text-muted)}.atlas-controls select{padding:.5rem .7rem;font-size:.8rem}.atlas-map{display:grid;grid-template-columns:4rem 1fr;grid-template-rows:250px auto;gap:.6rem .5rem;margin-top:1rem}.atlas-map__labels{display:flex;flex-direction:column;justify-content:space-between;font-size:.65rem;color:var(--text-dim)}.atlas-map__plot{position:relative;border-left:1px solid var(--border-strong);border-bottom:1px solid var(--border-strong);background:repeating-linear-gradient(to top,transparent 0,transparent calc(25% - 1px),var(--border-soft) calc(25% - 1px),var(--border-soft) 25%)}.atlas-point{position:absolute;width:24px;height:24px;transform:translate(-50%,-50%);display:grid;place-items:center;z-index:1}.atlas-point span{width:10px;height:10px;border-radius:50%;border:1px solid var(--text-muted);background:var(--point)}.atlas-point:hover{z-index:2}.atlas-point:hover span{width:16px;height:16px}.atlas-point--science{--point:#5b9fd4}.atlas-point--esprit{--point:#f0a050}.atlas-point--societe{--point:#5cc4b0}.atlas-map__dates{grid-column:2;display:flex;justify-content:space-between;gap:1rem;font-size:.67rem;color:var(--text-dim)}.atlas-legend{display:flex;justify-content:center;gap:1.5rem;margin:1rem 0 2rem;font-size:.72rem;color:var(--text-muted)}.atlas-legend>span{display:flex;align-items:center;gap:.4rem}.atlas-legend i{width:8px;height:8px;border-radius:50%;border:1px solid var(--text-muted)}.atlas-results{scroll-margin-top:5rem}.atlas-results__heading{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;border-top:1px solid var(--border-strong);padding:1rem 0}.atlas-results h3,.atlas-numbers h3{font-family:var(--font-serif);font-size:1.4rem;font-weight:550;margin:0}.atlas-list{list-style:none;padding:0;margin:0 0 1.5rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 2rem}.atlas-list li{border-bottom:1px solid var(--border-strong)}.atlas-list a{display:block;padding:1.1rem 0}.atlas-list h4{font-family:var(--font-serif);font-weight:550;font-size:1.15rem;line-height:1.3;letter-spacing:-.015em;margin:.5rem 0}.atlas-list a:hover h4{color:var(--green)}.atlas-list time{font-size:.7rem;color:var(--text-dim)}.atlas-numbers__grid{display:grid;grid-template-columns:.8fr 1fr 1.2fr;gap:2.5rem;padding-top:1rem}.atlas-numbers dl{margin:0}.atlas-numbers dl>div+div{margin-top:1.25rem}.atlas-numbers dt{font-size:.72rem;color:var(--text-dim)}.atlas-numbers dd{font-family:var(--font-serif);font-size:2.6rem;color:var(--green);margin:0}.atlas-share{display:grid;grid-template-columns:1fr auto;gap:.4rem;margin-top:1rem;font-size:.8rem}.atlas-share>span{color:var(--text-dim);font-size:.72rem}.atlas-share>div{grid-column:span 2;height:3px;background:var(--border-soft)}.atlas-share>div span{display:block;height:100%;background:var(--green)}.atlas-months{display:flex;gap:.6rem;justify-content:space-between;align-items:end;margin-top:1.2rem;height:125px}.atlas-months>div{display:flex;flex-direction:column;align-items:center;justify-content:end;gap:.3rem;font-size:.62rem;color:var(--text-dim);flex:1;min-width:0}.atlas-months i{display:block;background:var(--green);width:100%;max-width:22px;opacity:.8}.atlas-empty{padding:1.5rem 0;color:var(--text-muted)}@media(max-width:899px){.atlas-routes{gap:1.25rem}.atlas-route h3{font-size:1.4rem}.atlas-numbers__grid{grid-template-columns:1fr 1fr}.atlas-numbers dl{display:flex;gap:2rem;grid-column:span 2}.atlas-numbers dl>div+div{margin-top:0}}@media(max-width:639px){.atlas-routes,.atlas-list,.atlas-numbers__grid{grid-template-columns:1fr}.atlas-route>p{min-height:0}.atlas-route+.atlas-route{padding-top:1.5rem;border-top:1px solid var(--border-strong)}.atlas-numbers dl{grid-column:auto}.atlas-numbers__grid{gap:1.5rem}.atlas-map{grid-template-columns:2.5rem 1fr;grid-template-rows:200px auto}.atlas-results__heading{align-items:start;flex-direction:column;gap:.5rem}.atlas-results__heading p{margin:0}.atlas-map__labels{font-size:.6rem}.atlas-controls{align-items:start;flex-direction:column}.atlas-map__dates{font-size:.6rem}}
</style>
