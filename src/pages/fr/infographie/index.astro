---
import BaseLayout from "../../../layouts/BaseLayout.astro";

import { categoryMap } from "../../../data/site";
import { getAllPosts, getPostSlug } from "../../../utils/blog";

/** Page hommage : « les premiers articles » du blog.
 *  Récupère dynamiquement les 10 plus anciennes publications (hors grand-oral,
 *  pour rester sur les piliers science/esprit/société) afin que la page reste
 *  toujours fidèle au calendrier réel sans intervention manuelle. */
const allPosts = await getAllPosts();
const firstPosts = allPosts
  .filter((p) => p.data.category !== "grand-oral")
  .sort((a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime())
  .slice(0, 10);

/** Formatte le readingTime ("18 min") → nombre entier de minutes, fallback 15. */
function parseReadingMinutes(rt?: string): number {
  if (!rt) return 15;
  const m = rt.match(/(\d+)/);
  return m ? Number(m[1]) : 15;
}

const articles = firstPosts.map((post, idx) => {
  const cat = post.data.category;
  const meta = categoryMap[cat];
  const minutes = parseReadingMinutes(post.data.readingTime);
  return {
    num: String(idx + 1).padStart(2, "0"),
    slug: getPostSlug(post),
    title: post.data.title,
    subtitle: post.data.pillar,
    excerpt: post.data.excerpt,
    category: cat,
    categoryLabel: meta.label,
    pillar: post.data.pillar,
    date: post.data.publishDate.toLocaleDateString("fr-FR", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    }),
    isoDate: post.data.publishDate.toISOString().slice(0, 10),
    readingTime: minutes,
    tags: (post.data.tags ?? []).slice(0, 3),
  };
});

/** Statistiques hero / closing calculées sur les 10 premiers articles. */
const totalMin = articles.reduce((s, a) => s + a.readingTime, 0);
const totalHours = Math.floor(totalMin / 60);
const totalMinRest = totalMin % 60;
const totalReadingLabel =
  totalHours > 0
    ? `${totalHours}${"h"}${String(totalMinRest).padStart(2, "0")}`
    : `${totalMinRest} min`;

const firstDate = firstPosts[0]?.data.publishDate;
const lastDate = firstPosts[firstPosts.length - 1]?.data.publishDate;
const spanDays =
  firstDate && lastDate
    ? Math.max(
        1,
        Math.round((lastDate.getTime() - firstDate.getTime()) / 86_400_000),
      )
    : 0;

const fmtRange = (d?: Date) =>
  d
    ? d.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
    : "";

/** Distribution par rubrique, ne montre que les rubriques effectivement présentes. */
const countsByCat = articles.reduce<Record<string, number>>((acc, a) => {
  acc[a.category] = (acc[a.category] ?? 0) + 1;
  return acc;
}, {});

const catBreakdown = (["science", "societe", "esprit"] as const)
  .map((key) => ({
    key,
    label: categoryMap[key].label,
    count: countsByCat[key] ?? 0,
    color: categoryMap[key].accent,
  }))
  .filter((c) => c.count > 0);

const totalArticles = articles.length;
const totalCats = catBreakdown.length;
---

<BaseLayout
  title="Les 10 premiers articles, Infographie | Blog d'un Gaucher"
  description={`Visualisation interactive des ${totalArticles} premières publications du Blog d'un Gaucher : timeline éditoriale, répartition par rubrique, ${totalMin} minutes de lecture.`}
  canonicalPath="/fr/infographie/"
  omitEnDeAlternateLinks={true}
>

<div class="igp">

  <!-- ════════════ HERO ════════════ -->
  <header class="hero">
    <div class="hero-grid">
      <!-- Background texture : faint chess squares -->
      <div class="chess-bg" aria-hidden="true">
        {Array.from({length:64}).map((_,i) => (
          <div class={`sq ${(Math.floor(i/8)+i)%2===0 ? "sq--dark" : ""}`}></div>
        ))}
      </div>

      <div class="hero-content">
        <p class="hero-label">Blog d'un Gaucher · {firstDate?.getUTCFullYear() ?? new Date().getFullYear()}</p>
        <h1 class="hero-title">
          <span class="hero-title-line1">Naissance</span>
          <span class="hero-title-line2">d'un blog</span>
        </h1>
        <p class="hero-sub">Les {totalArticles} premières publications : une plongée dans les thèmes fondateurs</p>

        <div class="hero-stats">
          <div class="hstat">
            <span class="hstat-n">{totalArticles}</span>
            <span class="hstat-l">articles</span>
          </div>
          <div class="hstat-div" aria-hidden="true"></div>
          <div class="hstat">
            <span class="hstat-n">{totalReadingLabel}</span>
            <span class="hstat-l">de lecture</span>
          </div>
          <div class="hstat-div" aria-hidden="true"></div>
          <div class="hstat">
            <span class="hstat-n">{spanDays}</span>
            <span class="hstat-l">jours</span>
          </div>
          <div class="hstat-div" aria-hidden="true"></div>
          <div class="hstat">
            <span class="hstat-n">{totalCats}</span>
            <span class="hstat-l">rubriques</span>
          </div>
        </div>

        <p class="hero-range">{fmtRange(firstDate)} <span class="hero-arrow">→</span> {fmtRange(lastDate)}</p>
      </div>
    </div>
  </header>

  <!-- ════════════ DISTRIBUTION ════════════ -->
  <section class="distrib">
    <div class="distrib-inner">
      <p class="section-label">Répartition par rubrique</p>
      <div class="distrib-grid">
        {catBreakdown.map(cat => (
          <div class="dcat" style={`--acc:${cat.color}`}>
            <span class="dcat-n">{cat.count}<span class="dcat-of">/{totalArticles}</span></span>
            <span class="dcat-name">{cat.label}</span>
            <div class="dcat-bar">
              <div class="dcat-fill" style={`width:${(cat.count / totalArticles) * 100}%`}></div>
            </div>
            <span class="dcat-pct">{Math.round((cat.count / totalArticles) * 100)} %</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════ FILTERS ════════════ -->
  <div class="filters-wrap">
    <div class="filters">
      <button class="fbtn fbtn--on" data-f="all">Tous</button>
      {catBreakdown.map((cat) => (
        <button class="fbtn" data-f={cat.key}>{cat.label}</button>
      ))}
    </div>
  </div>

  <!-- ════════════ ARTICLE LIST ════════════ -->
  <section class="alist">
    {articles.map((a, i) => (
      <article
        class={`arow arow--${a.category}`}
        data-cat={a.category}
        style={`--delay:${i * 60}ms`}
      >
        <!-- Ghost number -->
        <span class="arow-ghost" aria-hidden="true">{a.num}</span>

        <div class="arow-inner">
          <!-- Left : number + meta -->
          <div class="arow-left">
            <span class="arow-num">{a.num}</span>
            <div class="arow-meta">
              <span class="arow-badge">{a.categoryLabel}</span>
              <span class="arow-pillar">{a.pillar}</span>
            </div>
          </div>

          <!-- Center : title + content -->
          <div class="arow-center">
            <time class="arow-date" datetime={a.isoDate}>{a.date}</time>
            <h2 class="arow-title">
              <a class="arow-link" href={`/fr/blog/${a.slug}/`}>{a.title}</a>
            </h2>
            <p class="arow-subtitle">{a.subtitle}</p>
            <p class="arow-excerpt">{a.excerpt}</p>
            <div class="arow-tags">
              {a.tags.map(t => <span class="arow-tag">{t}</span>)}
            </div>
          </div>

          <!-- Right : time + CTA -->
          <div class="arow-right">
            <div class="arow-time">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>{a.readingTime} min</span>
            </div>
            <a class="arow-cta" href={`/fr/blog/${a.slug}/`} aria-label={`Lire : ${a.title}`}>
              Lire
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- ════════════ CLOSING ════════════ -->
  <footer class="closing">
    <div class="closing-inner">
      <p class="closing-q">{spanDays} jours.</p>
      <p class="closing-q">{totalMin} minutes de lecture.</p>
      <p class="closing-q closing-q--dim">Le début d'un projet.</p>
      <a class="closing-btn" href="/fr/blog/">
        Voir tous les articles
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </footer>

</div>
</BaseLayout>

<!-- ════════════ SCRIPT ════════════ -->
<script>
  // Category filter
  const btns = document.querySelectorAll<HTMLButtonElement>(".fbtn");
  const rows = document.querySelectorAll<HTMLElement>(".arow");

  btns.forEach(btn => {
    btn.addEventListener("click", () => {
      btns.forEach(b => b.classList.remove("fbtn--on"));
      btn.classList.add("fbtn--on");
      const f = btn.dataset.f!;
      rows.forEach(r => {
        if (f === "all" || r.dataset.cat === f) {
          r.classList.remove("arow--fade");
        } else {
          r.classList.add("arow--fade");
        }
      });
    });
  });

  // Scroll reveal
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add("arow--in");
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.08 });

  rows.forEach(r => io.observe(r));

  // Bar animation on load
  document.querySelectorAll<HTMLElement>(".dcat-fill").forEach(el => {
    const w = el.style.width;
    el.style.width = "0";
    requestAnimationFrame(() => {
      el.style.transition = "width 1.2s cubic-bezier(0.16,1,0.3,1)";
      el.style.width = w;
    });
  });
</script>

<!-- ════════════ STYLES ════════════ -->
<style>
  /* ── Editorial shell : aliased onto site design tokens ── */
  .igp {
    /* Aliases → design system. Les couleurs de rubrique sont fixes
       (mêmes en clair/sombre): le reste suit le thème. */
    --bg:   var(--surface);
    --bg2:  color-mix(in srgb, var(--text-main) 4%, var(--surface));
    --bg3:  color-mix(in srgb, var(--text-main) 8%, var(--surface));
    --fg:   var(--text-main);
    --fg2:  var(--text-muted);
    --fg3:  var(--border-soft);
    --line : var(--border-soft);
    --c-sci: #5b9fd4;
    --c-esp: #f0a050;
    --c-soc: #5cc4b0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans, "Space Grotesk", sans-serif);
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding: clamp(5rem, 12vw, 9rem) clamp(1.5rem, 6vw, 5rem);
  }

  /* Chess background */
  .chess-bg {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, 1fr);
    opacity: 0.028;
    pointer-events: none;
    user-select: none;
  }
  .sq { background : transparent; }
  .sq--dark { background : var(--fg); }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .hero-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg2);
    margin-bottom: 2.5rem;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 1.75rem;
    line-height: 0.88;
  }

  .hero-title-line1 {
    font-family: var(--font-serif, "Fraunces", Georgia, serif);
    font-size: clamp(4rem, 12vw, 9.5rem);
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.03em;
    color: var(--fg);
    display: block;
  }

  .hero-title-line2 {
    font-family: var(--font-serif, "Fraunces", Georgia, serif);
    font-size: clamp(4rem, 12vw, 9.5rem);
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.03em;
    /* Outlined / ghost text for second line */
    -webkit-text-stroke: 1px color-mix(in srgb, var(--fg) 35%, transparent);
    color: transparent;
    display: block;
  }

  .hero-sub {
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    color: var(--fg2);
    line-height: 1.6;
    max-width: 440px;
    margin-bottom: 3rem;
  }

  /* Stats */
  .hero-stats {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 2rem;
  }

  .hstat {
    display: flex;
    flex-direction: column;
    padding: 0 2rem 0 0;
  }
  .hstat:first-child { padding-left: 0; }

  .hstat-n {
    font-family: var(--font-serif, serif);
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 300;
    font-style: italic;
    color: var(--fg);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hstat-unit {
    font-size: 0.6em;
    font-style: italic;
  }

  .hstat-l {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg2);
    margin-top: 0.2rem;
  }

  .hstat-div {
    width: 1px;
    height: 2.5rem;
    background: var(--fg3);
    margin-right: 2rem;
    flex-shrink: 0;
    align-self: center;
  }

  .hero-range {
    font-size: 0.82rem;
    color: var(--fg2);
    letter-spacing: 0.06em;
  }

  .hero-arrow {
    display: inline-block;
    margin: 0 0.4em;
    opacity: 0.5;
  }

  /* ── Distribution ── */
  .distrib {
    background: var(--bg2);
    border-bottom: 1px solid var(--line);
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 6vw, 5rem);
  }

  .distrib-inner { max-width: 860px; }

  .section-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg2);
    margin-bottom: 2.5rem;
  }

  .distrib-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }

  @media (max-width: 600px) {
    .distrib-grid { grid-template-columns: 1fr; gap: 2rem; }
  }

  .dcat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .dcat-n {
    font-family: var(--font-serif, serif);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 300;
    font-style: italic;
    color: var(--acc);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .dcat-of {
    font-size: 0.4em;
    color: var(--fg2);
    font-style: normal;
    font-weight: 400;
  }

  .dcat-name {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--acc);
  }

  .dcat-bar {
    height: 2px;
    background: var(--line);
    border-radius: 99px;
    overflow: hidden;
    margin-top: 0.75rem;
  }

  .dcat-fill {
    height: 100%;
    background: var(--acc);
    border-radius: 99px;
  }

  .dcat-pct {
    font-size: 0.72rem;
    color: var(--fg2);
    margin-top: 0.25rem;
  }

  /* ── Filters ── */
  .filters-wrap {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg2);
    border-bottom: 1px solid var(--line);
    padding: 0 clamp(1.5rem, 6vw, 5rem);
  }

  .filters {
    display: flex;
    gap: 0;
    max-width: 860px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filters::-webkit-scrollbar { display : none; }

  .fbtn {
    padding: 1rem 1.25rem;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--fg2);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease;
    white-space: nowrap;
    margin-bottom: -1px;
  }

  .fbtn:hover { color : var(--fg); }
  .fbtn--on {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }

  /* ── Article list ── */
  .alist {
    max-width: 100%;
  }

  .arow {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    transition: background 250ms ease, opacity 350ms ease, transform 500ms cubic-bezier(0.16,1,0.3,1);
    opacity: 0;
    transform: translateY(16px);
  }

  .arow--in {
    opacity: 1;
    transform: none;
  }

  .arow--fade {
    opacity: 0.1;
    pointer-events: none;
  }

  /* Left accent line per category */
  .arow::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--acc-c);
    opacity: 0;
    transition: opacity 250ms ease;
  }
  .arow:hover::before { opacity: 1; }

  .arow--science { --acc-c : var(--c-sci); }
  .arow--esprit  { --acc-c : var(--c-esp); }
  .arow--societe { --acc-c : var(--c-soc); }

  /* Ghost big number */
  .arow-ghost {
    position: absolute;
    right: -0.1em;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-serif, serif);
    font-size: clamp(6rem, 16vw, 14rem);
    font-weight: 300;
    font-style: italic;
    color: var(--fg);
    opacity: 0.025;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    letter-spacing: -0.06em;
  }

  .arow:hover .arow-ghost { opacity: 0.045; }

  /* Row inner layout */
  .arow-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 120px 1fr 120px;
    gap: 0 2rem;
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.5rem, 6vw, 5rem);
    align-items: start;
    transition: background 250ms ease;
  }

  .arow:hover .arow-inner {
    background: color-mix(in srgb, var(--text-main) 3%, var(--surface));
  }

  @media (max-width: 740px) {
    .arow-inner {
      grid-template-columns: 64px 1fr;
      grid-template-rows: auto auto;
    }
    .arow-right {
      grid-column: 2;
      grid-row: 2;
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .arow-inner { grid-template-columns: 48px 1fr; gap: 0 1rem; }
    .arow-ghost { font-size: 6rem; }
  }

  /* Left column */
  .arow-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding-top: 0.15rem;
  }

  .arow-num {
    font-family: var(--font-serif, serif);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 300;
    font-style: italic;
    color: var(--fg2);
    line-height: 1;
    letter-spacing: -0.02em;
    transition: color 200ms ease;
  }
  .arow:hover .arow-num { color : var(--acc-c); }

  .arow-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .arow-badge {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--acc-c);
    padding: 0.15rem 0.45rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    width: fit-content;
    opacity: 0.85;
  }

  .arow-pillar {
    font-size: 0.68rem;
    color: var(--fg2);
    font-style: italic;
  }

  /* Center column */
  .arow-center {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .arow-date {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg2);
    display: block;
  }

  .arow-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
  }

  .arow-link {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--acc-c), var(--acc-c));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 300ms ease, color 200ms ease;
  }
  .arow:hover .arow-link {
    background-size: 100% 1px;
    color: var(--fg);
  }

  .arow-subtitle {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--fg2);
    margin: 0;
  }

  .arow-excerpt {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--fg2);
    margin: 0.25rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient : vertical;
    overflow: hidden;
  }

  .arow-tags {
    display: flex;
