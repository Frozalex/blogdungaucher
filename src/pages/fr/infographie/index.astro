---
import BaseLayout from "../../../layouts/BaseLayout.astro";

import { categoryMap } from "../../../data/site";
import { getAllPosts, getPostSlug } from "../../../utils/blog";

/** Vue d'ensemble du blog : toutes les publications hors grand-oral
 *  (les piliers science/esprit/société), triées par date de publication.
 *  Stats et timeline auto-générées à chaque build. */
const allPosts = await getAllPosts();
const firstPosts = allPosts
  .filter((p) => p.data.category !== "grand-oral")
  .sort((a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime());

/** Formatte le readingTime ("18 min") → nombre entier de minutes, fallback 15. */
function parseReadingMinutes(rt?: string): number {
  if (!rt) return 15;
  const m = rt.match(/(\d+)/);
  return m ? Number(m[1]) : 15;
}

const articles = firstPosts.map((post, idx) => {
  const cat = post.data.category;
  const meta = categoryMap[cat];
  const minutes = parseReadingMinutes(post.data.readingTime);
  return {
    num: String(idx + 1).padStart(2, "0"),
    slug: getPostSlug(post),
    title: post.data.title,
    subtitle: post.data.pillar,
    excerpt: post.data.excerpt,
    category: cat,
    categoryLabel: meta.label,
    pillar: post.data.pillar,
    date: post.data.publishDate.toLocaleDateString("fr-FR", {
      day: "numeric",
      month: "short",
      year: "numeric",
      timeZone: "UTC",
    }),
    isoDate: post.data.publishDate.toISOString().slice(0, 10),
    readingTime: minutes,
    tags: (post.data.tags ?? []).slice(0, 3),
  };
});

/** Statistiques hero / closing calculées sur les 10 premiers articles. */
const totalMin = articles.reduce((s, a) => s + a.readingTime, 0);
const totalHours = Math.floor(totalMin / 60);
const totalMinRest = totalMin % 60;
const totalReadingLabel =
  totalHours > 0
    ? `${totalHours}${"h"}${String(totalMinRest).padStart(2, "0")}`
    : `${totalMinRest} min`;

const firstDate = firstPosts[0]?.data.publishDate;
const lastDate = firstPosts[firstPosts.length - 1]?.data.publishDate;
const spanDays =
  firstDate && lastDate
    ? Math.max(
        1,
        Math.round((lastDate.getTime() - firstDate.getTime()) / 86_400_000),
      )
    : 0;

const fmtRange = (d?: Date) =>
  d
    ? d.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
    : "";

/** Distribution par rubrique, ne montre que les rubriques effectivement présentes. */
const countsByCat = articles.reduce<Record<string, number>>((acc, a) => {
  acc[a.category] = (acc[a.category] ?? 0) + 1;
  return acc;
}, {});

const catBreakdown = (["science", "societe", "esprit"] as const)
  .map((key) => ({
    key,
    label: categoryMap[key].label,
    count: countsByCat[key] ?? 0,
    color: categoryMap[key].accent,
  }))
  .filter((c) => c.count > 0);

const totalArticles = articles.length;
const totalCats = catBreakdown.length;
---

<BaseLayout
  title="Infographie du blog : toutes les publications | Blog d'un Gaucher"
  description={`Visualisation interactive des ${totalArticles} publications du Blog d'un Gaucher : timeline éditoriale, répartition par rubrique, ${totalReadingLabel} de lecture cumulée.`}
  canonicalPath="/fr/infographie/"
  omitEnDeAlternateLinks={true}
>

<div class="igp">

  <!-- ════════════ HERO ════════════ -->
  <header class="hero">
    <div class="hero-grid">
      <!-- Background texture : faint chess squares -->
      <div class="chess-bg" aria-hidden="true">
        {Array.from({length:64}).map((_,i) => (
          <div class={`sq ${(Math.floor(i/8)+i)%2===0 ? "sq--dark" : ""}`}></div>
        ))}
      </div>

      <div class="hero-content">
        <p class="hero-label">Blog d'un Gaucher · vue d'ensemble</p>
        <h1 class="hero-title">
          <span class="hero-title-line1">Cartographie</span>
          <span class="hero-title-line2">du blog</span>
        </h1>
        <p class="hero-sub">Les {totalArticles} publications réunies en une seule timeline éditoriale.</p>

        <div class="hero-stats">
          <div class="hstat">
            <span class="hstat-n" data-count={totalArticles}>{totalArticles}</span>
            <span class="hstat-l">articles</span>
          </div>
          <div class="hstat-div" aria-hidden="true"></div>
          <div class="hstat">
            <span class="hstat-n" data-count-text>{totalReadingLabel}</span>
            <span class="hstat-l">de lecture</span>
          </div>
          <div class="hstat-div" aria-hidden="true"></div>
          <div class="hstat">
            <span class="hstat-n" data-count={spanDays}>{spanDays}</span>
            <span class="hstat-l">jours</span>
          </div>
          <div class="hstat-div" aria-hidden="true"></div>
          <div class="hstat">
            <span class="hstat-n" data-count={totalCats}>{totalCats}</span>
            <span class="hstat-l">rubriques</span>
          </div>
        </div>

        <p class="hero-range">{fmtRange(firstDate)} <span class="hero-arrow">→</span> {fmtRange(lastDate)}</p>
      </div>
    </div>
  </header>

  <!-- ════════════ DISTRIBUTION ════════════ -->
  <section class="distrib">
    <div class="distrib-inner">
      <p class="section-label">Répartition par rubrique <span class="section-hint">— clique pour filtrer</span></p>
      <div class="distrib-grid">
        {catBreakdown.map(cat => (
          <button
            class="dcat"
            type="button"
            data-cat={cat.key}
            style={`--acc:${cat.color}`}
            aria-pressed="false"
          >
            <span class="dcat-n" data-count={cat.count}>{cat.count}<span class="dcat-of">/{totalArticles}</span></span>
            <span class="dcat-name">{cat.label}</span>
            <div class="dcat-bar">
              <div class="dcat-fill" style={`width:${(cat.count / totalArticles) * 100}%`}></div>
            </div>
            <span class="dcat-pct">{Math.round((cat.count / totalArticles) * 100)} %</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════ TIMELINE STRIP ════════════ -->
  <section class="tstrip">
    <div class="tstrip-inner">
      <p class="section-label">Timeline des publications <span class="section-hint">— survole un point, clique pour aller à l'article</span></p>
      <div class="ts-axis" role="list">
        {articles.map((a, i) => {
          const ts = new Date(a.isoDate).getTime();
          const first = new Date(articles[0].isoDate).getTime();
          const last = new Date(articles[articles.length - 1].isoDate).getTime();
          const range = Math.max(1, last - first);
          const pos = ((ts - first) / range) * 100;
          return (
            <button
              class={`ts-dot ts-dot--${a.category}`}
              type="button"
              style={`left:${pos}%`}
              data-idx={i}
              data-cat={a.category}
              aria-label={`${a.date} — ${a.title}`}
              role="listitem"
            >
              <span class="ts-tip">
                <span class="ts-tip__date">{a.date}</span>
                <span class="ts-tip__title">{a.title}</span>
              </span>
            </button>
          );
        })}
      </div>
      <div class="ts-labels">
        <span>{fmtRange(firstDate)}</span>
        <span>{fmtRange(lastDate)}</span>
      </div>
    </div>
  </section>

  <!-- ════════════ FILTERS ════════════ -->
  <div class="filters-wrap">
    <div class="filters">
      <div class="filters-cats">
        <button class="fbtn fbtn--on" data-f="all">Tous</button>
        {catBreakdown.map((cat) => (
          <button class="fbtn" data-f={cat.key}>{cat.label}</button>
        ))}
      </div>
      <label class="fsort-label">
        <span class="fsort-label__txt">Trier</span>
        <select class="fsort" aria-label="Trier les articles">
          <option value="oldest">Plus anciens</option>
          <option value="newest">Plus récents</option>
          <option value="long">Lecture longue</option>
          <option value="short">Lecture rapide</option>
        </select>
      </label>
    </div>
  </div>

  <!-- ════════════ ARTICLE LIST ════════════ -->
  <section class="alist">
    {articles.map((a, i) => (
      <article
        class={`arow arow--${a.category}`}
        data-cat={a.category}
        style={`--delay:${i * 60}ms`}
      >
        <!-- Ghost number -->
        <span class="arow-ghost" aria-hidden="true">{a.num}</span>

        <div class="arow-inner">
          <!-- Left : number + meta -->
          <div class="arow-left">
            <span class="arow-num">{a.num}</span>
            <div class="arow-meta">
              <span class="arow-badge">{a.categoryLabel}</span>
              <span class="arow-pillar">{a.pillar}</span>
            </div>
          </div>

          <!-- Center : title + content -->
          <div class="arow-center">
            <time class="arow-date" datetime={a.isoDate}>{a.date}</time>
            <h2 class="arow-title">
              <a class="arow-link" href={`/fr/blog/${a.slug}/`}>{a.title}</a>
            </h2>
            <p class="arow-subtitle">{a.subtitle}</p>
            <p class="arow-excerpt">{a.excerpt}</p>
            <div class="arow-tags">
              {a.tags.map(t => <span class="arow-tag">{t}</span>)}
            </div>
          </div>

          <!-- Right : time + CTA -->
          <div class="arow-right">
            <div class="arow-time">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>{a.readingTime} min</span>
            </div>
            <a class="arow-cta" href={`/fr/blog/${a.slug}/`} aria-label={`Lire : ${a.title}`}>
              Lire
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- ════════════ CLOSING ════════════ -->
  <footer class="closing">
    <div class="closing-inner">
      <p class="closing-q">{totalArticles} articles.</p>
      <p class="closing-q">{totalReadingLabel} de lecture.</p>
      <p class="closing-q closing-q--dim">Un projet en construction.</p>
      <a class="closing-btn" href="/fr/blog/">
        Voir tous les articles
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </footer>

</div>
</BaseLayout>

<!-- ════════════ SCRIPT ════════════ -->
<script>
  const fbtns  = document.querySelectorAll<HTMLButtonElement>(".fbtn");
  const dcats  = document.querySelectorAll<HTMLButtonElement>(".dcat[data-cat]");
  const dots   = document.querySelectorAll<HTMLButtonElement>(".ts-dot");
  const rows   = Array.from(document.querySelectorAll<HTMLElement>(".arow"));
  const sortEl = document.querySelector<HTMLSelectElement>(".fsort");
  const alist  = document.querySelector<HTMLElement>(".alist");

  let activeCat: string = "all";

  function applyFilter(cat: string) {
    activeCat = cat;
    fbtns.forEach(b => b.classList.toggle("fbtn--on", b.dataset.f === cat));
    dcats.forEach(c => c.setAttribute("aria-pressed", String(c.dataset.cat === cat)));
    dots.forEach(d => d.classList.toggle("ts-dot--dim", cat !== "all" && d.dataset.cat !== cat));
    rows.forEach(r => {
      const match = cat === "all" || r.dataset.cat === cat;
      r.classList.toggle("arow--fade", !match);
    });
  }

  fbtns.forEach(btn => btn.addEventListener("click", () => {
    const next = btn.dataset.f!;
    applyFilter(activeCat === next && next !== "all" ? "all" : next);
  }));

  dcats.forEach(card => card.addEventListener("click", () => {
    const next = card.dataset.cat!;
    applyFilter(activeCat === next ? "all" : next);
  }));

  // Timeline dot → scroll + highlight
  dots.forEach(dot => dot.addEventListener("click", () => {
    const idx = parseInt(dot.dataset.idx ?? "0", 10);
    const target = rows[idx];
    if (!target) return;
    target.scrollIntoView({ behavior: "smooth", block: "center" });
    target.classList.add("arow--pulse");
    setTimeout(() => target.classList.remove("arow--pulse"), 1600);
  }));

  // Sort
  function readingMin(row: HTMLElement): number {
    const txt = row.querySelector(".arow-time span")?.textContent ?? "";
    const m = txt.match(/\d+/);
    return m ? parseInt(m[0], 10) : 0;
  }
  function rowDate(row: HTMLElement): number {
    const t = row.querySelector("time")?.getAttribute("datetime");
    return t ? new Date(t).getTime() : 0;
  }
  sortEl?.addEventListener("change", () => {
    if (!alist) return;
    const mode = sortEl.value;
    const sorted = [...rows].sort((a, b) => {
      if (mode === "newest") return rowDate(b) - rowDate(a);
      if (mode === "oldest") return rowDate(a) - rowDate(b);
      if (mode === "long")   return readingMin(b) - readingMin(a);
      if (mode === "short")  return readingMin(a) - readingMin(b);
      return 0;
    });
    sorted.forEach(r => alist.appendChild(r));
  });

  // Scroll reveal
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add("arow--in");
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.08 });
  rows.forEach(r => io.observe(r));

  // Count-up animation (hero stats + distribution numbers)
  function animateCount(el: HTMLElement) {
    const target = parseInt(el.dataset.count ?? "0", 10);
    if (!target || target < 1) return;
    const originalHTML = el.innerHTML;
    const duration = 1200;
    const start = performance.now();
    function step(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = Math.round(eased * target);
      if (progress < 1) {
        el.textContent = String(current);
        requestAnimationFrame(step);
      } else {
        el.innerHTML = originalHTML;
      }
    }
    el.textContent = "0";
    requestAnimationFrame(step);
  }
  const countIo = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        animateCount(e.target as HTMLElement);
        countIo.unobserve(e.target);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll<HTMLElement>("[data-count]").forEach(el => countIo.observe(el));

  // Bar animation on load
  document.querySelectorAll<HTMLElement>(".dcat-fill").forEach(el => {
    const w = el.style.width;
    el.style.width = "0";
    requestAnimationFrame(() => {
      el.style.transition = "width 1.2s cubic-bezier(0.16,1,0.3,1)";
      el.style.width = w;
    });
  });
</script>

<!-- ════════════ STYLES ════════════ -->
<style>
  /* ── Editorial shell : aliased onto site design tokens ── */
  .igp {
    /* Aliases → design system. Les couleurs de rubrique sont fixes
       (mêmes en clair/sombre): le reste suit le thème. */
    --bg:   var(--surface);
    --bg2:  color-mix(in srgb, var(--text-main) 4%, var(--surface));
    --bg3:  color-mix(in srgb, var(--text-main) 8%, var(--surface));
    --fg:   var(--text-main);
    --fg2:  var(--text-muted);
    --fg3:  var(--border-soft);
    --line : var(--border-soft);
    --c-sci: #5b9fd4;
    --c-esp: #f0a050;
    --c-soc: #5cc4b0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans, "Space Grotesk", sans-serif);
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding: clamp(5rem, 12vw, 9rem) clamp(1.5rem, 6vw, 5rem);
  }

  /* Chess background */
  .chess-bg {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(8, 1fr);
    opacity: 0.028;
    pointer-events: none;
    user-select: none;
  }
  .sq { background : transparent; }
  .sq--dark { background : var(--fg); }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .hero-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg2);
    margin-bottom: 2.5rem;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 1.75rem;
    line-height: 0.88;
  }

  .hero-title-line1 {
    font-family: var(--font-serif, "Fraunces", Georgia, serif);
    font-size: clamp(4rem, 12vw, 9.5rem);
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.03em;
    color: var(--fg);
    display: block;
  }

  .hero-title-line2 {
    font-family: var(--font-serif, "Fraunces", Georgia, serif);
    font-size: clamp(4rem, 12vw, 9.5rem);
    font-weight: 300;
    font-style: italic;
    letter-spacing: -0.03em;
    /* Outlined / ghost text for second line */
    -webkit-text-stroke: 1px color-mix(in srgb, var(--fg) 35%, transparent);
    color: transparent;
    display: block;
  }

  .hero-sub {
    font-size: clamp(0.9rem, 1.6vw, 1.05rem);
    color: var(--fg2);
    line-height: 1.6;
    max-width: 440px;
    margin-bottom: 3rem;
  }

  /* Stats */
  .hero-stats {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 2rem;
  }

  .hstat {
    display: flex;
    flex-direction: column;
    padding: 0 2rem 0 0;
  }
  .hstat:first-child { padding-left: 0; }

  .hstat-n {
    font-family: var(--font-serif, serif);
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 300;
    font-style: italic;
    color: var(--fg);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hstat-unit {
    font-size: 0.6em;
    font-style: italic;
  }

  .hstat-l {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg2);
    margin-top: 0.2rem;
  }

  .hstat-div {
    width: 1px;
    height: 2.5rem;
    background: var(--fg3);
    margin-right: 2rem;
    flex-shrink: 0;
    align-self: center;
  }

  .hero-range {
    font-size: 0.82rem;
    color: var(--fg2);
    letter-spacing: 0.06em;
  }

  .hero-arrow {
    display: inline-block;
    margin: 0 0.4em;
    opacity: 0.5;
  }

  /* ── Distribution ── */
  .distrib {
    background: var(--bg2);
    border-bottom: 1px solid var(--line);
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 6vw, 5rem);
  }

  .distrib-inner { max-width: 860px; }

  .section-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--fg2);
    margin-bottom: 2.5rem;
  }

  .section-hint {
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--fg2);
    opacity: 0.75;
    margin-left: 0.4rem;
  }

  .distrib-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }

  @media (max-width: 600px) {
    .distrib-grid { grid-template-columns: 1fr; gap: 2rem; }
  }

  .dcat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0.85rem 1rem;
    margin: -0.85rem -1rem;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
    transition: background 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .dcat:hover {
    background: color-mix(in srgb, var(--acc) 6%, var(--bg2));
    border-color: color-mix(in srgb, var(--acc) 25%, var(--line));
    transform: translateY(-1px);
  }

  .dcat[aria-pressed="true"] {
    background: color-mix(in srgb, var(--acc) 10%, var(--bg2));
    border-color: color-mix(in srgb, var(--acc) 45%, var(--line));
  }

  .dcat[aria-pressed="true"] .dcat-n {
    text-shadow: 0 0 32px color-mix(in srgb, var(--acc) 30%, transparent);
  }

  .dcat:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 3px;
  }

  .dcat-n {
    font-family: var(--font-serif, serif);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 300;
    font-style: italic;
    color: var(--acc);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .dcat-of {
    font-size: 0.4em;
    color: var(--fg2);
    font-style: normal;
    font-weight: 400;
  }

  .dcat-name {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--acc);
  }

  .dcat-bar {
    height: 2px;
    background: var(--line);
    border-radius: 99px;
    overflow: hidden;
    margin-top: 0.75rem;
  }

  .dcat-fill {
    height: 100%;
    background: var(--acc);
    border-radius: 99px;
  }

  .dcat-pct {
    font-size: 0.72rem;
    color: var(--fg2);
    margin-top: 0.25rem;
  }

  /* ── Timeline strip ── */
  .tstrip {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
  }

  .tstrip-inner { max-width: 100%; }

  .ts-axis {
    position: relative;
    height: 60px;
    margin: 1.5rem 0 0.75rem;
    border-top: 1px solid var(--fg3);
  }

  .ts-axis::before {
    content: "";
