---
import { render } from "astro:content";

// KaTeX CSS chargé ici (et non dans BaseLayout) : seuls les articles peuvent contenir des formules.
import "katex/dist/katex.min.css";

import AdBanner from "../../../components/AdBanner.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import TableOfContents from "../../../components/TableOfContents.astro";
import ShareButtons from "../../../components/ShareButtons.astro";
import DownloadPdfButton from "../../../components/DownloadPdfButton.astro";
import CodeBlockEnhancer from "../../../components/CodeBlockEnhancer.astro";
import Comments from "../../../components/Comments.astro";
import KeyTakeaways from "../../../components/KeyTakeaways.astro";
import FAQ from "../../../components/FAQ.astro";
import ArticleVideo from "../../../components/ArticleVideo.astro";
import InteractiveWidgets from "../../../components/InteractiveWidgets.astro";
import PyodideTrace from "../../../components/PyodideTrace.astro";
import FocusMode from "../../../components/FocusMode.astro";
import TextHighlight from "../../../components/TextHighlight.astro";

import { categoryMap, categorySlugs, siteConfig } from "../../../data/site";
import {
  absoluteUrl,
  buildArticleJsonLd,
  buildBreadcrumbJsonLd,
  buildFaqJsonLd,
  calculateReadingTime,
  formatDate,
  getAllPosts,
  getPostSlug,
  getPostUrl,
  getPostUrlEn,
  getPostUrlPtBr,
  getPostHeroSrc,
} from "../../../utils/blog";
import {
  renderMarkdownToArticleHtml,
  stripFaqH2Section,
} from "../../../utils/markdown-strip-faq";
import { isPublicAssetAvailable } from "../../../utils/public-asset";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug : getPostSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const category = categoryMap[post.data.category];

const faqs = post.data.faq ?? [];
const stripInlineFaq = faqs.length > 0;
const mdForArticle = stripInlineFaq ? stripFaqH2Section(post.body ?? "") : (post.body ?? "");

let Content : Awaited<ReturnType<typeof render>>["Content"] | undefined;
let headings : Awaited<ReturnType<typeof render>>["headings"];
let strippedArticleHtml : string | undefined;

if (stripInlineFaq) {
  const r = await renderMarkdownToArticleHtml(mdForArticle);
  strippedArticleHtml = r.html;
  headings = r.headings;
} else {
  const r = await render(post);
  Content = r.Content;
  headings = r.headings;
}

const readingTime = post.data.readingTime ?? calculateReadingTime(post.body ?? "");

const allPosts = await getAllPosts();
const currentTags = new Set(post.data.tags ?? []);
const related = allPosts
  .filter((e) => e.id !== post.id)
  .map((e) => {
    const sharedTags = (e.data.tags ?? []).filter((t) => currentTags.has(t)).length;
    const sameCategory = e.data.category === post.data.category ? 1 : 0;
    return { entry: e, score: sharedTags * 2 + sameCategory };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ entry }) => entry);

const postUrl = getPostUrl(post);
const postUrlEn = await getPostUrlEn(post);
const grandOralOnly = post.data.category === "grand-oral";
// PT-BR : URL localisée (slug pt-br) si l'article n'est pas FR-only, sinon accueil pt-br.
// Corrige le lien du sélecteur de langue + le hreflang pt-BR (auparavant dérivé du slug FR
// via swapLangPrefix, donc en 404 pour tout article au slug pt-br localisé).
const postUrlPtBr = grandOralOnly ? "/pt-br/" : await getPostUrlPtBr(post);
const absolutePostUrl = absoluteUrl(postUrl);

const heroSrc = getPostHeroSrc(post);
const heroImage = heroSrc ? post.data.heroImage : undefined;

// Résumé vidéo Motion Canvas : affiché si le MP4 existe dans public/.
const summaryVideoSrc = post.data.summaryVideo?.trim();
const showSummaryVideo =
  !!summaryVideoSrc && isPublicAssetAvailable(summaryVideoSrc);

const structuredData = [
  await buildArticleJsonLd(post),
  buildBreadcrumbJsonLd([
    { name : "Accueil", path : "/fr/" },
    { name : "Articles", path : "/fr/blog/" },
    { name : post.data.title, path : postUrl },
  ]),
  ...(faqs.length > 0 ? [buildFaqJsonLd(faqs)] : []),
];
---
<BaseLayout
  title={`${post.data.seoTitle ?? post.data.title} | Blog d'un Gaucher`}
  description={post.data.seoDescription ?? post.data.excerpt}
  canonicalPath={postUrl}
  image={post.data.ogImage ?? siteConfig.defaultOgImage}
  type="article"
  publishDate={post.data.publishDate}
  modifiedDate={post.data.updatedDate ?? post.data.publishDate}
  section={category.label}
  structuredData={structuredData}
  accentColor={category.accent}
  tags={post.data.tags}
  enPath={grandOralOnly ? "/en/blog/" : postUrlEn}
  ptBrPath={postUrlPtBr}
  omitEnDeAlternateLinks={grandOralOnly}
>
  <article class="article-page" style={`--c:${category.accent}`} data-pagefind-meta={`accent:${category.accent}`}>
    {/* Fil d'Ariane fin au-dessus du hero */}
    <div class="container">
      <nav class="hero-breadcrumb" aria-label="Fil d'Ariane">
        <a href="/fr/">Accueil</a>
        <span aria-hidden="true">›</span>
        <a href="/fr/blog/">Articles</a>
        <span aria-hidden="true">›</span>
        <a href={category.href} style={`color:${category.accent}`}>{category.label}</a>
      </nav>
    </div>

    <!-- ── Hero PT's Coffee : titre superposé sur photo pleine hauteur ── -->
    <div class={`article-hero${(!showSummaryVideo && heroSrc && heroImage) ? " article-hero--has-image" : " article-hero--placeholder"}`}>

      {!showSummaryVideo && heroSrc && heroImage ? (
        <figure class="hero-photo-wrap">
          <img
            class="hero-photo"
            src={heroSrc}
            alt={heroImage.alt}
            loading="eager"
            decoding="async"
          />
          {(heroImage.credit || heroImage.sourceUrl) && (
            <figcaption class="hero-photo-credit">
              {heroImage.credit && <span>Photographie : {heroImage.credit}</span>}
              {heroImage.sourceUrl && (
                <a href={heroImage.sourceUrl} target="_blank" rel="noreferrer">Source</a>
              )}
            </figcaption>
          )}
        </figure>
      ) : (
        <div class="hero-photo-wrap hero-photo-wrap--placeholder" aria-hidden="true">
          <span class="hero-logo-deco" role="presentation"></span>
        </div>
      )}

      <div class="container hero-overlay">
        <div class="hero-content">
          <time datetime={post.data.publishDate.toISOString()} class="hero-date">
            {formatDate(post.data.publishDate)}
          </time>

          <h1 class="hero-title" data-pagefind-meta="title">
            <span>{post.data.title}</span>
          </h1>

          <div class="hero-byline">
            <div class="hero-avatar">
              <img src="/images/logo.svg" alt="Blog d'un Gaucher" width="28" height="40" />
            </div>
            <div class="hero-author-info">
              <p class="hero-author-name">
                <span class="hero-author-prefix">Par&nbsp;</span>Blog d'un Gaucher
              </p>
              <p class="hero-author-role">
                {category.label} · {readingTime}
                {post.data.updatedDate &&
                  post.data.updatedDate.getTime() !== post.data.publishDate.getTime() && (
                  <span class="hero-updated"> · MàJ {formatDate(post.data.updatedDate)}</span>
                )}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="container">
        <nav class="article-tags hero-tags" aria-label="Tags">
          {post.data.tags.slice(0, 6).map((tag) => (
            <a href={`/fr/recherche/?q=${encodeURIComponent(tag)}`} class="article-tag">{tag}</a>
          ))}
        </nav>
      </div>
    )}

    <!-- ── Corps 3 colonnes : partage | contenu | aside ── -->
    <div class="container article-layout">

      <!-- Sidebar gauche : boutons de partage verticaux -->
      <aside class="article-share-sidebar" aria-label="Partager l'article" data-pagefind-ignore>
        <div class="share-sidebar-sticky">
          <ShareButtons title={post.data.title} url={absolutePostUrl} variant="sidebar" />
        </div>
      </aside>

      <div class="article-main">

        {grandOralOnly && (
          <DownloadPdfButton title={post.data.title} slug={getPostSlug(post)} />
        )}

        {showSummaryVideo && summaryVideoSrc && (
          <ArticleVideo
            src={summaryVideoSrc}
            poster={heroSrc}
            title={`Résumé vidéo : ${post.data.title}`}
            eyebrow="Résumé vidéo de l'article"
            accentColor={category.accent}
            note={post.data.summaryVideoNote}
          />
        )}

        <div class="article-tools">
          <FocusMode lang="fr" />
        </div>

        {headings.length > 0 && (
          <div class="toc-inline-wrap">
            <TableOfContents headings={headings} mode="mobile" lang="fr" />
          </div>
        )}

        <div class="article-body fade-up" style="--motion-delay: 100ms;" data-pagefind-body>
          {strippedArticleHtml ? (
            <div class="md-chunk" set:html={strippedArticleHtml} />
          ) : (
            Content && <Content />
          )}
        </div>

        {/* Définit les custom elements interactifs (<minimax-tree>…) que les
            articles peuvent invoquer en HTML brut dans leur Markdown. N'émet
            aucun visuel propre : ne fait qu'enregistrer les web components. */}
        <InteractiveWidgets />

        {/* Visualiseur d'exécution Python (trace pas-à-pas). S'active sur les
            blocs ```python précédés d'un <div data-pytrace></div>. Pyodide
            chargé en lazy au clic uniquement. */}
        <PyodideTrace />

        <AdBanner format="inline" compact={true} />

        {post.data.keyTakeaways && post.data.keyTakeaways.length > 0 && (
          <KeyTakeaways items={post.data.keyTakeaways} accentColor={category.accent} />
        )}

        {faqs.length > 0 && <FAQ items={faqs} lang="fr" />}

        <Comments lang="fr" postId={postUrl} />
        <TextHighlight lang="fr" />

      </div>

      <CodeBlockEnhancer />
    </div>

    {related.length > 0 && (
      <section class="related-carousel container" aria-label="Articles recommandés" data-pagefind-ignore>
        <div class="related-carousel__head">
          <span class="related-carousel__label">Pour vous</span>
          <div class="related-carousel__nav">
            <button type="button" class="rc-btn" data-rc-prev aria-label="Articles précédents">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="rc-btn" data-rc-next aria-label="Articles suivants">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>
        <div class="related-carousel__track" data-rc-track>
          {related.map((e) => (
            <a href={getPostUrl(e)} class="rc-card">
              {getPostHeroSrc(e) && (
                <img
                  class="rc-card__img"
                  src={getPostHeroSrc(e)!}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width="320"
                  height="180"
                />
              )}
              <div class="rc-card__body">
                <span class="rc-card__cat" style={`color:${categoryMap[e.data.category]?.accent}`}>
                  {categoryMap[e.data.category]?.shortLabel}
                </span>
                <p class="rc-card__title">{e.data.title}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .article-page  { padding: 0 0 2rem; }

  /* ══════════════════════════════════════
     Hero PT's Coffee : photo pleine hauteur à droite,
     titre géant en boîtes blanches superposé sur l'image
  ══════════════════════════════════════ */
  .hero-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--text-dim);
    padding-top: 1.5rem;
  }
  .hero-breadcrumb a { color: var(--text-dim); transition: color 150ms ease; }
  .hero-breadcrumb a:hover { color: var(--text-main); }

  .article-hero {
    position: relative;
    min-height: min(82vh, 760px);
    margin: 1.25rem 0 0;
    display: flex;
    align-items: stretch;
  }

  /* Photo : ancrée à droite, ~56% de la largeur viewport, pleine hauteur */
  .hero-photo-wrap {
    position: absolute;
    inset: 0 0 0 auto;
    width: 56%;
    margin: 0;
    overflow: hidden;
    z-index: 0;
  }
  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-photo-wrap--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--c) 12%, var(--surface));
  }
  .hero-logo-deco {
    width: clamp(5rem, 12vw, 8.5rem);
    aspect-ratio: 625 / 868;
    background-color: color-mix(in srgb, var(--c) 30%, var(--border-soft));
    -webkit-mask-image: url("/images/logo.svg");
    mask-image: url("/images/logo.svg");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  .hero-photo-credit {
    position: absolute;
    bottom: 0;
    right: 0;
    padding: 0.4rem 0.8rem;
    font-size: 0.72rem;
    color: #fff;
    background: rgba(0,0,0,0.55);
    display: flex;
    gap: 0.75rem;
  }
  .hero-photo-credit a { color: #fff; text-decoration: underline; }

  /* Calque de contenu : par-dessus la photo, aligné au container */
  .hero-overlay {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    pointer-events: none;
  }
  .hero-content {
    /* le titre déborde volontairement sur la photo : largeur ~62% du container */
    max-width: 64%;
    padding: 3rem 0;
  }
  .hero-content > * { pointer-events: auto; }

  .hero-date {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 1rem;
    padding-left: 0.2rem;
  }

  /* Titre géant en boîtes blanches (signature PT's Coffee) */
  .hero-title {
    margin: 0 0 2rem;
    font-size: clamp(2.6rem, 6.5vw, 6rem);
    line-height: 1.42; /* lâche pour espacer les boîtes blanches empilées */
    letter-spacing: -0.01em;
  }
  .hero-title span {
    font-family: var(--font-serif);
    font-weight: 700;
    font-style: normal;
    color: color-mix(in srgb, var(--c) 60%, var(--text-main));
    background: var(--surface);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0.06em 0.3em;
    box-shadow: 0 2px 14px rgba(0,0,0,0.08);
    font-optical-sizing: auto;
  }

  .hero-byline {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .hero-avatar {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    border: 2px solid var(--border-soft);
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
  }
  .hero-avatar img {
    width: 20px;
    height: 28px;
    object-fit: contain;
  }
  :global([data-theme="dark"]) .hero-avatar img { filter: invert(1); }

  .hero-author-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .hero-author-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
  }
  .hero-author-prefix { font-weight: 400; color: var(--text-dim); }
  .hero-author-role {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }
  .hero-updated { color: var(--text-dim); }

  /* Tags sous le hero */
  .hero-tags {
    margin-top: 1.5rem;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0 2.5rem;
    align-items: start;
    max-width: 68rem;
    margin-inline: auto;
  }

  /* Left share sidebar */
  .article-share-sidebar {
    grid-column: 1;
    grid-row: 1;
  }
  .share-sidebar-sticky {
    position: sticky;
    top: calc(var(--navbar-h) + 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Shift article-main to col 2 */
  .article-main {
    grid-column: 2;
    grid-row: 1;
  }

  .meta-cat {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0 0.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--c);
    color: var(--c);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 150ms ease;
  }
  .meta-cat:hover { background : var(--c); color: #fff; }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.85rem;
  }

  .article-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-soft);
    background: var(--surface);
    color: var(--text-dim);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
  }
  .article-tag:hover {
    border-color: var(--c);
    color: var(--c);
    background: color-mix(in srgb, var(--c) 6%, var(--surface));
  }

  /* corps : pas de card : le texte respire directement sur le fond page */
  .article-body {
    padding: 2rem 0;
  }
  .article-body :global(h2) {
    margin: 1.9rem 0 0.7rem;
    font-family: var(--font-serif);
    font-weight: 500;
    font-style: italic;
    font-size: 1.65rem;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--c) 72%, var(--text-main));
    font-optical-sizing: auto;
  }
  .article-body :global(h3) {
    margin: 1.4rem 0 0.5rem;
    font-size: 1.18rem;
    color: var(--text-main);
  }
  .article-body :global(p),
  .article-body :global(li) { color: var(--text-muted); line-height: 1.75; font-size: clamp(18px, 1vw + 13.5px, 20.5px); }
  .article-body :global(p:first-of-type)::first-letter {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 3.4em;
    line-height: 0.9;
    float: left;
    padding: 0.22rem 0.6rem 0 0;
    color: var(--c);
  }
  .article-body :global(li::marker) { color : color-mix(in srgb, var(--c) 55%, var(--text-dim)); }
  .article-body :global(p + p),
  .article-body :global(p + ul),
  .article-body :global(ul + p) { margin-top: 0.85rem; }
  .article-body :global(ul),
  .article-body :global(ol)   { padding-left: 1.2rem; }
  .article-body :global(li + li) { margin-top: 0.3rem; }
  .article-body :global(strong) { color : var(--text-main); }
  .article-body :global(a) {
    color: var(--c);
    font-weight: 600;
    text-decoration: none;
    background-image: linear-gradient(
      to top,
      color-mix(in srgb, var(--c) 16%, transparent) 0%,
      color-mix(in srgb, var(--c) 16%, transparent) 36%,
      transparent 36%
    );
    border-radius: 0.2rem;
    padding: 0 0.05rem;
    transition:
      color 160ms ease,
      background-size 160ms ease,
      background-color 160ms ease;
  }
  .article-body :global(a:hover) {
    color: color-mix(in srgb, var(--c) 80%, black);
    background-image: linear-gradient(
      to top,
      color-mix(in srgb, var(--c) 22%, transparent) 0%,
      color-mix(in srgb, var(--c) 22%, transparent) 42%,
      transparent 42%
    );
  }
  .article-body :global(a[href^="http"])::after {
    content: " ↗";
    font-size: 0.8em;
    font-weight: 700;
    opacity: 0.75;
  }
  .article-body :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.9rem 1.2rem;
    border-left: 3px solid var(--c);
    background: color-mix(in srgb, var(--c) 7%, var(--surface));
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    color: var(--text-main);
    font-style: italic;
  }
  .article-body :global(hr) { border : none; border-top: 1px solid var(--border-soft); margin: 1.5rem 0; }
  .article-body :global(code) {
    font-size: 0.88em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: var(--bg-warm);
    color: var(--text-main);
  }
  .article-body :global(hr + h3) {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.8rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c) 10%, white);
    border: 1px solid color-mix(in srgb, var(--c) 16%, var(--border-soft));
    margin-top: 1.8rem;
  }
  .article-body :global(hr + h3 + p) {
    margin-top: 0.9rem;
  }
  .article-body :global(hr + h3 + p + ul) {
    display: grid;
    gap: 0.7rem;
    padding-left: 0;
    margin-top: 1rem;
    list-style: none;
  }
  .article-body :global(hr + h3 + p + ul li) {
    padding: 0.95rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-soft);
    background: color-mix(in srgb, var(--c) 3%, white);
    box-shadow: var(--shadow-xs);
  }
  .article-body :global(hr + h3 + p + ul li::marker) {
    content: "";
  }

  /* aside */
  .article-aside {
    position: sticky;
    top: 5rem;
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .article-tools {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.75rem;
  }

  .toc-inline-wrap {
    margin-bottom: 1.5rem;
  }

  /* ════════════════════════════════════════════
     Carrousel "Pour vous" — slide cards interactifs
  ════════════════════════════════════════════ */
  .related-carousel {
    margin: 3.5rem auto 1rem;
    max-width: 64rem;
  }
  .related-carousel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }
  .related-carousel__label {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-main);
  }
  .related-carousel__nav {
    display: flex;
    gap: 0.5rem;
  }
  .rc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }
  .rc-btn:hover {
    background: var(--text-main);
    border-color: var(--text-main);
    color: var(--bg);
  }
  .rc-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }
  .related-carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(17rem, 17rem);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 0.75rem;
    scrollbar-width: none;
  }
  .related-carousel__track::-webkit-scrollbar { display: none; }
  .rc-card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-soft);
    background: var(--surface);
    overflow: hidden;
    text-decoration: none;
    transition: transform 220ms var(--ease-out), box-shadow 220ms ease, border-color 220ms ease;
  }
  .rc-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .rc-card__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface-warm);
    display: block;
  }
  .rc-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1rem 1.1rem 1.2rem;
  }
  .rc-card__cat {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .rc-card__title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-main);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 1100px) {
    .article-hero { min-height: min(70vh, 600px); }
    .hero-photo-wrap { width: 50%; }
    .hero-content { max-width: 70%; }
  }

  /* En dessous : photo passe au-dessus, titre dessous (empilé) */
  @media (max-width: 820px) {
    .article-hero {
      display: flex;
      flex-direction: column;
      min-height: auto;
      margin-top: 1rem;
    }
    .hero-photo-wrap {
      position: relative;
      inset: auto;
      width: 100%;
      height: 52vw;
      max-height: 20rem;
      border-radius: var(--radius-lg);
    }
    .hero-overlay {
      justify-content: flex-start;
    }
    .hero-content {
      max-width: 100%;
      padding: 1.75rem 0 0;
    }
    .hero-title {
      font-size: clamp(2.2rem, 9vw, 3.4rem);
      line-height: 1.35;
    }
    .hero-title span { box-shadow: none; padding: 0.04em 0.15em; }
  }

  @media (max-width: 900px) {
    .article-share-sidebar { display: none; }
    .article-layout { grid-template-columns: 1fr; }
    .article-main { grid-column: 1; }
  }

  @media (max-width: 560px) {
    .related-carousel__track { grid-auto-columns: minmax(14rem, 80%); }
    .related-carousel__label { font-size: 1.15rem; }
  }
</style>

<script>
  let articleCleanup;

  function initArticlePage() {
    articleCleanup?.();

    const articleBody = document.querySelector(".article-body");
    if (!articleBody) return;

    articleBody
      .querySelectorAll('a[href^="http"]')
      .forEach((link) => {
        link.target = "_blank";
        link.rel = "noopener noreferrer";
      });

    // ── Carrousel "Pour vous" ──
    const track = document.querySelector("[data-rc-track]");
    const prevBtn = document.querySelector("[data-rc-prev]");
    const nextBtn = document.querySelector("[data-rc-next]");
    let onTrackScroll = null;
    if (track && prevBtn && nextBtn) {
      const step = () => {
        const card = track.querySelector(".rc-card");
        const gap = parseFloat(getComputedStyle(track).columnGap || "20") || 20;
        return card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
      };
      const syncBtns = () => {
        const maxScroll = track.scrollWidth - track.clientWidth - 2;
        prevBtn.disabled = track.scrollLeft <= 2;
        nextBtn.disabled = track.scrollLeft >= maxScroll;
      };
      prevBtn.addEventListener("click", () => track.scrollBy({ left: -step() * 1.5, behavior: "smooth" }));
      nextBtn.addEventListener("click", () => track.scrollBy({ left: step() * 1.5, behavior: "smooth" }));
      onTrackScroll = syncBtns;
      track.addEventListener("scroll", syncBtns, { passive: true });
      window.addEventListener("resize", syncBtns);
      syncBtns();
    }

    articleCleanup = () => {
      if (track && onTrackScroll) {
        track.removeEventListener("scroll", onTrackScroll);
        window.removeEventListener("resize", onTrackScroll);
      }
    };
  }

  document.addEventListener("astro:page-load", initArticlePage);
</script>
