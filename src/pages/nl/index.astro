---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomePortal from "../../components/HomePortal.astro";

import { buildWebsiteJsonLd, getAllPosts, filterPostsForLang, getPostHeroSrc } from "../../utils/blog";
import { getHomeEditorialPosts } from "../../data/home-editorial";
import { buildSrcset } from "../../utils/image-variants";
import { NL_LAUNCH_DATE } from "../../data/site";

if (new Date() < NL_LAUNCH_DATE) return Astro.redirect("/fr/", 302);
const { lead } = getHomeEditorialPosts(filterPostsForLang(await getAllPosts(), "nl"));
const leadImage = lead ? getPostHeroSrc(lead) : null;

---
<BaseLayout
  title="Blog van een Linkshandige — Schaken zonder oversimplificatie"
  description="Schaakwetenschap, de competitieve mindset en schaken in de samenleving: twee nieuwe artikelen per week. Een rigoureuze en menselijke redactionele ruimte."
  canonicalPath="/nl/"
  lang="nl"
  frPath="/fr/"
  enPath="/en/"
  preloadImage={leadImage ?? undefined}
  preloadImageSrcset={buildSrcset(leadImage)}
  preloadImageSizes="(min-width: 900px) 730px, 100vw"
  structuredData={buildWebsiteJsonLd()}
>
  <HomePortal lang="nl" />
</BaseLayout>
