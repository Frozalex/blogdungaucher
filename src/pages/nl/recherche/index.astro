---
import EditorialSearchPage from "../../../components/EditorialSearchPage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { NL_LAUNCH_DATE } from "../../../data/site";

if (new Date() < NL_LAUNCH_DATE) return Astro.redirect("/fr/recherche/", 302);

---
<BaseLayout
  title="Zoeken | Blog van een Linkshandige"
  description="Zoek een schaakartikelen op trefwoord: Alzheimer, ADHD, Elo, AlphaZero, dopamine, stress, geheugen. Meer dan 80 analyses beschikbaar."
  canonicalPath="/nl/recherche/"
  lang="nl"
  frPath="/fr/recherche/"
  enPath="/en/recherche/"
  ptBrPath="/pt-br/recherche/"
  noindex={true}
  omitEnDeAlternateLinks={true}
>
  <EditorialSearchPage lang="nl" />
</BaseLayout>
