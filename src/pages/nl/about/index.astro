        <a class="author-contact" href="mailto:contact@blogdungaucher.com">Neem contact op <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>
    {starts.length > 0 && <section class="resource-section" aria-labelledby="starts-title">
      <div class="resource-section-head"><h2 id="starts-title">Geselecteerde artikelen</h2><span>{nlLive ? "Drie artikelen, drie invalshoeken" : "Drie artikelen in het Engels"}</span></div>
      <p class="about-starts-intro">Geheugen om het leren te begrijpen, concentratie om de schaakpraktijk te onderzoeken en valsspelen om vertrouwen te onderzoeken: drie ingangen tot het project.{!nlLive && " Deze leestips zijn voorlopig Engelstalig."}</p>
      <div class="about-starts">{starts.map(post => <EditorialArticle post={post} lang={readingLang} variant="feature" showImageCredit={true} />)}</div>
    </section>}
    <div class="resource-end"><div><span class="resource-kicker">Redactioneel contact</span><p>Correcties, onderwerpvoorstellen en onderwijsprojecten.</p></div><a class="resource-button" href="mailto:contact@blogdungaucher.com">Contact opnemen <span aria-hidden="true">↗</span></a></div>
  </div></article>
</BaseLayout>
