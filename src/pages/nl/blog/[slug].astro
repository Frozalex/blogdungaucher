---
import { getCollection, render } from "astro:content";

import "katex/dist/katex.min.css";

import AdBanner from "../../../components/AdBanner.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TableOfContents from "../../../components/TableOfContents.astro";
import ShareButtons from "../../../components/ShareButtons.astro";
import Comments from "../../../components/Comments.astro";
import NewsletterCta from "../../../components/NewsletterCta.astro";
import FAQ from "../../../components/FAQ.astro";
import ArticleVideo from "../../../components/ArticleVideo.astro";
import KeyTakeaways from "../../../components/KeyTakeaways.astro";
import FocusMode from "../../../components/FocusMode.astro";

import { categoryMap, categorySlugs, siteConfig, NL_LAUNCH_DATE } from "../../../data/site";
import {
  absoluteUrl,
  buildBreadcrumbJsonLd,
  buildFaqJsonLd,
  calculateReadingTime,
  formatDateNl,
  filterPostsForLang,
  getAllPosts,
  getEnSlugMap,
  getNlSlugMap,
  getPostSlug,
  getPostUrl,
  getPostUrlEnSync,
  getPostUrlNl,
  getPostUrlNlSync,
  getPostHeroSrc,
} from "../../../utils/blog";
import { renderEnglishMarkdown } from "../../../utils/english-article";
import { swapLangPrefix } from "../../../utils/lang-paths";
import {
  renderMarkdownToArticleHtml,
  stripFaqH2Section,
} from "../../../utils/markdown-strip-faq";
import { isPublicAssetAvailable } from "../../../utils/public-asset";

export async function getStaticPaths() {
  if (new Date() < NL_LAUNCH_DATE) return [];

  const posts = filterPostsForLang(await getAllPosts(), "nl");
  const nlSlugMap = await getNlSlugMap();
  const enSlugMap = await getEnSlugMap();

  return posts.map((post) => {
    const frSlug = getPostSlug(post);
    const nlSlug = nlSlugMap.get(frSlug) ?? frSlug;
    const enSlug = enSlugMap.get(frSlug) ?? frSlug;
    return { params: { slug: nlSlug }, props: { post, frSlug, nlSlug, enSlug } };
  });
}

const { post, frSlug, nlSlug, enSlug } = Astro.props as {
  post: Awaited<ReturnType<typeof getAllPosts>>[number];
  frSlug: string;
  nlSlug: string;
  enSlug: string;
};

const nlEntries = await getCollection("nlTranslations");
const nlEntryRaw = nlEntries.find((e) => (e.data.frSlug ?? getPostSlug(post)) === frSlug);
const nlEntry = nlEntryRaw && !nlEntryRaw.data.draft ? nlEntryRaw : undefined;
const nlMarkdown = nlEntry?.body;

const faqsForDisplay = nlEntry?.data?.faq ?? post.data.faq ?? [];
const stripInlineFaq = faqsForDisplay.length > 0;
const mdSource = nlMarkdown ?? post.body;
const mdForArticle = stripInlineFaq ? stripFaqH2Section(mdSource) : mdSource;

let Content: Awaited<ReturnType<typeof render>>["Content"] | undefined;
let headings: Awaited<ReturnType<typeof render>>["headings"];
let nlHtml: string | undefined;

if (nlMarkdown) {
  const rendered = stripInlineFaq
    ? renderEnglishMarkdown(mdForArticle)
    : renderEnglishMarkdown(nlMarkdown);
  nlHtml = rendered.html;
  headings = rendered.headings;
} else if (stripInlineFaq) {
  const r = await renderMarkdownToArticleHtml(mdForArticle);
  nlHtml = r.html;
  headings = r.headings;
} else {
  const r = await render(post);
  Content = r.Content;
  headings = r.headings;
}

const category = categoryMap[post.data.category];

const readingTime =
  post.data.readingTime ??
  (nlMarkdown ? calculateReadingTime(nlMarkdown) : calculateReadingTime(post.body));

const allPosts = await getAllPosts();
const related = filterPostsForLang(
  allPosts.filter((e) => e.id !== post.id && e.data.category === post.data.category),
  "nl",
).slice(0, 3);

const relatedWithUrls = await Promise.all(
  related.map(async (e) => ({ entry: e, url: await getPostUrlNl(e) })),
);

const postUrlNl = getPostUrlNlSync(post, nlSlug);
const postUrlFr = getPostUrl(post);
const postUrlEn = getPostUrlEnSync(post, enSlug);
const absolutePostUrl = absoluteUrl(postUrlNl);

const nlTitle     = nlEntry?.data?.seoTitle ?? nlEntry?.data?.title ?? post.data.seoTitle ?? post.data.title;
const nlDesc      = nlEntry?.data?.seoDescription ?? nlEntry?.data?.excerpt ?? post.data.seoDescription ?? post.data.excerpt;
const displayTitle  = nlEntry?.data?.title ?? post.data.title;
const displayExcerpt = nlEntry?.data?.excerpt ?? post.data.excerpt;
const hasNlTranslation = !!nlEntry;

const heroSrc = getPostHeroSrc(post);
const heroImage = heroSrc ? post.data.heroImage : undefined;

const summaryVideoSrc = post.data.summaryVideo?.trim();
const showSummaryVideo = !!summaryVideoSrc && isPublicAssetAvailable(summaryVideoSrc);

const nlCategoryLabels: Record<string, string> = {
  science: "Wetenschap",
  esprit: "Geest",
  societe: "Samenleving",
};
const nlCategoryLabel = nlCategoryLabels[post.data.category] ?? category.label;
const nlCategoryHref = swapLangPrefix(category.href, "nl");

const structuredData = [
  buildBreadcrumbJsonLd([
    { name: "Home", path: "/nl/" },
    { name: "Artikelen", path: "/nl/blog/" },
    { name: nlCategoryLabel, path: nlCategoryHref },
    { name: displayTitle, path: postUrlNl },
  ]),
  ...(faqsForDisplay.length > 0 ? [buildFaqJsonLd(faqsForDisplay)] : []),
];

const nlCategoryShortLabels: Record<string, string> = {
  science: "Wetenschap",
  esprit: "Geest & Focus",
  societe: "Schaken & Samenleving",
};

const otherPillars = categorySlugs
  .filter((s) => s !== post.data.category && s !== "grand-oral")
  .map((s) => ({ ...categoryMap[s], nlShort: nlCategoryShortLabels[s] ?? categoryMap[s].shortLabel }));
---
<BaseLayout
  title={`${nlTitle} | Blog van een Linkshandige`}
  description={nlDesc}
  canonicalPath={postUrlNl}
  lang="nl"
  frPath={postUrlFr}
  enPath={postUrlEn}
  nlPath={postUrlNl}
  image={post.data.ogImage ?? siteConfig.defaultOgImage}
  type="article"
  publishDate={post.data.publishDate}
  modifiedDate={post.data.updatedDate ?? post.data.publishDate}
  section={nlCategoryLabel}
  structuredData={structuredData}
  accentColor={category.accent}
  tags={post.data.tags}
>
  <article class="article-page" style={`--c:${category.accent}`}>
    <div class="reading-progress" aria-hidden="true">
      <span id="reading-progress-fill"></span>
    </div>

    {/* Dunne broodkruimel boven de hero */}
    <div class="container">
      <nav class="hero-breadcrumb" aria-label="Broodkruimel">
        <a href="/nl/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/nl/blog/">Artikelen</a>
        <span aria-hidden="true">›</span>
        <a href={nlCategoryHref} style={`color:${category.accent}`}>{nlCategoryLabel}</a>
      </nav>
    </div>

    <!-- ── PT's Coffee hero: foto op volledige hoogte + overlappende titel ── -->
    <div class={`article-hero${(!showSummaryVideo && heroSrc && heroImage) ? " article-hero--has-image" : " article-hero--placeholder"}`}>

      {!showSummaryVideo && heroSrc && heroImage ? (
        <figure class="hero-photo-wrap">
          <img class="hero-photo" src={heroSrc} alt={heroImage.alt} loading="eager" decoding="async" />
          {(heroImage.credit || heroImage.sourceUrl) && (
            <figcaption class="hero-photo-credit">
              {heroImage.credit && <span>Foto: {heroImage.credit}</span>}
              {heroImage.sourceUrl && (
                <a href={heroImage.sourceUrl} target="_blank" rel="noreferrer">Bron</a>
              )}
            </figcaption>
          )}
        </figure>
      ) : (
        <div class="hero-photo-wrap hero-photo-wrap--placeholder" aria-hidden="true">
          <span class="hero-chess-deco">♛</span>
        </div>
      )}

      <div class="container hero-overlay">
        <div class="hero-content">
          <time datetime={post.data.publishDate.toISOString()} class="hero-date">
            {formatDateNl(post.data.publishDate)}
          </time>

          <h1 class="hero-title">
            <span>{displayTitle}</span>
          </h1>

          <div class="hero-byline">
            <div class="hero-avatar">
              <img src="/images/logo.svg" alt="Blog van een Linkshandige" width="28" height="40" />
            </div>
            <div class="hero-author-info">
              <p class="hero-author-name">
                <span class="hero-author-prefix">Door&nbsp;</span>Blog van een Linkshandige
              </p>
              <p class="hero-author-role">
                {nlCategoryLabel} · {readingTime}
                {post.data.updatedDate &&
                  post.data.updatedDate.getTime() !== post.data.publishDate.getTime() && (
                  <span class="hero-updated"> · Bijgewerkt {formatDateNl(post.data.updatedDate)}</span>
                )}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="container">
        <nav class="article-tags hero-tags" aria-label="Tags">
          {post.data.tags.slice(0, 6).map((tag) => (
            <a href={`/nl/recherche/?q=${encodeURIComponent(tag)}`} class="article-tag">{tag}</a>
          ))}
        </nav>
      </div>
    )}

    <!-- ── 3-koloms body: delen | inhoud | aside ── -->
    <div class="container article-layout">

      <aside class="article-share-sidebar" aria-label="Dit artikel delen">
        <div class="share-sidebar-sticky">
          <ShareButtons title={displayTitle} url={absolutePostUrl} variant="sidebar" />
        </div>
      </aside>

      <div class="article-main">

        {showSummaryVideo && summaryVideoSrc && (
          <ArticleVideo
            src={summaryVideoSrc}
            poster={heroSrc}
            title={`Videooverzicht: ${displayTitle}`}
            eyebrow="Videooverzicht van het artikel"
            accentColor={category.accent}
            note={post.data.summaryVideoNote}
          />
        )}

        {!hasNlTranslation && (
          <div class="translation-notice" role="note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            <span>De volledige Nederlandse vertaling van dit artikel is in voorbereiding. De onderstaande inhoud is momenteel in het Frans.</span>
          </div>
        )}

        <div class="article-tools">
          <FocusMode lang="nl" />
        </div>

        <div class="toc-mobile-wrap">
          <TableOfContents headings={headings} mode="mobile" lang="nl" />
        </div>

        <div class="article-body fade-up" style="--motion-delay: 100ms;">
          {nlHtml ? (
            <div class="md-chunk" set:html={nlHtml} />
          ) : (
            Content && <Content />
          )}
        </div>

        {post.data.keyTakeaways && post.data.keyTakeaways.length > 0 && (
          <KeyTakeaways items={post.data.keyTakeaways} accentColor={category.accent} />
        )}

        <AdBanner format="inline" compact={true} />

        {faqsForDisplay.length > 0 && <FAQ items={faqsForDisplay} lang="nl" />}

        {otherPillars.length > 0 && (
          <nav class="pillar-links fade-up" style="--motion-delay: 130ms;" aria-label="Andere secties van de blog">
            <span class="pillar-links__eyebrow">Verder ontdekken</span>
            <div class="pillar-links__grid">
              {otherPillars.map((p) => (
                <a href={swapLangPrefix(p.href, "nl")} class="pillar-link" style={`--pc:${p.accent}`}>
                  <span class="pillar-link__dot"></span>
                  <div>
                    <strong>{p.nlShort}</strong>
                    <span>{p.tagline}</span>
                  </div>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                </a>
              ))}
            </div>
          </nav>
        )}

        <NewsletterCta />
        <Comments lang="nl" />

      </div>

      <aside class="article-aside">
        <div class="toc-desktop-wrap">
          <TableOfContents headings={headings} mode="desktop" lang="nl" />
        </div>

        {relatedWithUrls.length > 0 && (
          <div class="aside-related fade-up" style="--motion-delay: 120ms;">
            <span class="aside-related__label">Voor jou</span>
            <div class="aside-related__list">
              {relatedWithUrls.map(({ entry: e, url }) => (
                <a href={url} class="aside-related__item">
                  {getPostHeroSrc(e) && (
                    <img class="aside-related__thumb" src={getPostHeroSrc(e)!} alt="" loading="lazy" decoding="async" width="60" height="60" />
                  )}
                  <div class="aside-related__body">
                    <span class="aside-related__cat" style={`color:${categoryMap[e.data.category]?.accent}`}>
                      {categoryMap[e.data.category]?.shortLabel}
                    </span>
                    <p class="aside-related__title">{e.data.title}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="aside-card fade-up" style="--motion-delay: 160ms;">
          <span class="aside-dot" style={`background:${category.accent}`}></span>
          <h2>{nlCategoryLabel}</h2>
          <p data-t={`categories.${post.data.category}.tagline`}>{category.tagline}</p>
          <a href={nlCategoryHref} class="aside-link">
            Deze sectie verkennen
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <AdBanner format="rectangle" />
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .translation-notice {
    display: flex; align-items: flex-start; gap: 0.6rem;
    padding: 0.85rem 1rem; border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--green) 30%, var(--border-soft));
    background: color-mix(in srgb, var(--green) 6%, var(--surface));
    color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin-bottom: 1.5rem;
  }
  .translation-notice svg { flex-shrink: 0; margin-top: 0.15rem; color: var(--green); }

  .reading-progress {
    position: fixed; top: calc(var(--navbar-h) + 2rem);
    right: max(0.65rem, calc(50vw - 640px - 1rem));
    bottom: 2rem; width: 3px; z-index: 30;
    background: color-mix(in srgb, var(--border-soft) 70%, transparent);
    border-radius: 3px; overflow: hidden; pointer-events: none;
    opacity: 0.55; transition: opacity 220ms ease;
  }
  .reading-progress:hover { opacity: 1; }
  #reading-progress-fill {
    position: absolute; inset: 0 0 auto 0; display: block; width: 100%; height: 0%;
    background: linear-gradient(180deg, var(--c, var(--green)), color-mix(in srgb, var(--c, var(--green)) 55%, #fff));
    transition: height 120ms linear; border-radius: 3px;
  }

  .article-page { padding: 0 0 2rem; }

  /* ══════════════════════════════════════
     Hero PT's Coffee : photo pleine hauteur à droite,
     titre géant en boîtes blanches superposé sur l'image
  ══════════════════════════════════════ */
  .hero-breadcrumb {
    display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center;
    font-size: 0.78rem; color: var(--text-dim); padding-top: 1.5rem;
  }
  .hero-breadcrumb a { color: var(--text-dim); transition: color 150ms ease; }
  .hero-breadcrumb a:hover { color: var(--text-main); }

  .article-hero {
    position: relative;
    min-height: min(82vh, 760px);
    margin: 1.25rem 0 0;
    display: flex;
    align-items: stretch;
  }
  .hero-photo-wrap {
    position: absolute; inset: 0 0 0 auto; width: 56%; margin: 0;
    overflow: hidden; z-index: 0;
  }
  .hero-photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-photo-wrap--placeholder {
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--c) 12%, var(--surface));
  }
  .hero-chess-deco {
    font-size: clamp(6rem, 14vw, 12rem);
    color: color-mix(in srgb, var(--c) 28%, var(--border-soft)); line-height: 1;
  }
  .hero-photo-credit {
    position: absolute; bottom: 0; right: 0; padding: 0.4rem 0.8rem;
    font-size: 0.72rem; color: #fff; background: rgba(0,0,0,0.55);
    display: flex; gap: 0.75rem;
  }
  .hero-photo-credit a { color: #fff; text-decoration: underline; }

  .hero-overlay {
    position: relative; z-index: 2; width: 100%;
    display: flex; flex-direction: column; justify-content: center;
    pointer-events: none;
  }
  .hero-content { max-width: 64%; padding: 3rem 0; }
  .hero-content > * { pointer-events: auto; }

  .hero-date {
    display: block; font-family: var(--font-display); font-size: 0.95rem;
    font-weight: 500; color: var(--text-muted); margin-bottom: 1rem; padding-left: 0.2rem;
  }
  .hero-title {
    margin: 0 0 2rem; font-size: clamp(2.6rem, 6.5vw, 6rem);
    line-height: 1.42; letter-spacing: -0.01em;
  }
  .hero-title span {
    font-family: var(--font-serif); font-weight: 700; font-style: normal;
    color: color-mix(in srgb, var(--c) 60%, var(--text-main));
    background: var(--surface);
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    padding: 0.06em 0.3em; box-shadow: 0 2px 14px rgba(0,0,0,0.08);
    font-optical-sizing: auto;
  }
  .hero-byline { display: flex; align-items: center; gap: 0.8rem; }
  .hero-avatar {
    width: 3.2rem; height: 3.2rem; border-radius: 50%;
    border: 2px solid var(--border-soft); background: var(--surface);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; flex-shrink: 0; box-shadow: var(--shadow-sm);
  }
  .hero-avatar img { width: 20px; height: 28px; object-fit: contain; }
  :global([data-theme="dark"]) .hero-avatar img { filter: invert(1); }
  .hero-author-info { display: flex; flex-direction: column; gap: 0.1rem; }
  .hero-author-name { font-size: 1rem; font-weight: 700; color: var(--text-main); margin: 0; }
  .hero-author-prefix { font-weight: 400; color: var(--text-dim); }
  .hero-author-role { font-size: 0.85rem; color: var(--text-muted); margin: 0; }
  .hero-updated { color: var(--text-dim); }
  .hero-tags { margin-top: 1.5rem; }

  .article-layout {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 17rem;
    gap: 0 2rem;
    align-items: start;
  }
  .article-share-sidebar { grid-column: 1; grid-row: 1; }
  .share-sidebar-sticky {
    position: sticky; top: calc(var(--navbar-h) + 5rem);
    display: flex; flex-direction: column; align-items: center;
  }
  .article-main { grid-column: 2; grid-row: 1; min-width: 0; }
  .article-aside { grid-column: 3; grid-row: 1; }

  .meta-cat {
    display: inline-flex; align-items: center; min-height: 1.5rem; padding: 0 0.5rem;
    border-radius: var(--radius-pill); border: 1px solid var(--c); color: var(--c);
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    transition: background 150ms ease;
  }
  .meta-cat:hover { background: var(--c); color: #fff; }

  .article-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.85rem; }
  .article-tag {
    display: inline-flex; align-items: center; padding: 0.22rem 0.6rem;
    border-radius: var(--radius-pill); border: 1px solid var(--border-soft);
    background: var(--surface); color: var(--text-dim);
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.01em; text-decoration: none;
    transition: border-color 140ms ease, color 140ms ease, background 140ms ease;
  }
  .article-tag:hover {
    border-color: var(--c); color: var(--c);
    background: color-mix(in srgb, var(--c) 6%, var(--surface));
  }

  .article-body { padding: 2rem 0; }
  .article-body :global(h2) {
    margin: 1.9rem 0 0.7rem; font-family: var(--font-serif); font-weight: 500; font-style: italic;
    font-size: 1.65rem; letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--c) 72%, var(--text-main)); font-optical-sizing: auto;
  }
  .article-body :global(h3) { margin: 1.4rem 0 0.5rem; font-size: 1.18rem; color: var(--text-main); }
  .article-body :global(p),
  .article-body :global(li) { color: var(--text-muted); line-height: 1.75; }
  .article-body :global(p:first-of-type)::first-letter {
    font-family: var(--font-serif); font-style: italic; font-weight: 500;
    font-size: 3.4em; line-height: 0.9; float: left; padding: 0.22rem 0.6rem 0 0; color: var(--c);
  }
  .article-body :global(li::marker) { color: color-mix(in srgb, var(--c) 55%, var(--text-dim)); }
  .article-body :global(p + p),
  .article-body :global(p + ul),
  .article-body :global(ul + p) { margin-top: 0.85rem; }
  .article-body :global(ul),
  .article-body :global(ol) { padding-left: 1.2rem; }
  .article-body :global(li + li) { margin-top: 0.3rem; }
  .article-body :global(strong) { color: var(--text-main); }
  .article-body :global(a) {
    color: var(--c); font-weight: 600; text-decoration: none;
    background-image: linear-gradient(to top, color-mix(in srgb, var(--c) 16%, transparent) 0%, color-mix(in srgb, var(--c) 16%, transparent) 36%, transparent 36%);
    border-radius: 0.2rem; padding: 0 0.05rem;
    transition: color 160ms ease, background-size 160ms ease, background-color 160ms ease;
  }
  .article-body :global(a:hover) {
    color: color-mix(in srgb, var(--c) 80%, black);
    background-image: linear-gradient(to top, color-mix(in srgb, var(--c) 22%, transparent) 0%, color-mix(in srgb, var(--c) 22%, transparent) 42%, transparent 42%);
  }
  .article-body :global(a[href^="http"])::after { content: " ↗"; font-size: 0.8em; font-weight: 700; opacity: 0.75; }
  .article-body :global(blockquote) {
    margin: 1.25rem 0; padding: 0.9rem 1.2rem; border-left: 3px solid var(--c);
    background: color-mix(in srgb, var(--c) 7%, var(--surface));
    border-radius: 0 var(--radius-md) var(--radius-md) 0; color: var(--text-main); font-style: italic;
  }
  .article-body :global(hr) { border: none; border-top: 1px solid var(--border-soft); margin: 1.5rem 0; }
  .article-body :global(code) {
    font-size: 0.88em; padding: 0.15em 0.4em; border-radius: 4px;
    background: var(--bg-warm); color: var(--text-main);
  }
  .article-body :global(pre) { border-radius: var(--radius-sm); padding: 1rem 1.2rem; overflow-x: auto; font-size: 0.9rem; margin: 1.2rem 0; background: var(--surface-warm); border: 1px solid var(--border-soft); }
  .article-body :global(img) { max-width: 100%; border-radius: var(--radius-sm); margin: 1rem 0; }

  .article-aside { position: sticky; top: 5rem; display: grid; gap: 1rem; align-content: start; }
