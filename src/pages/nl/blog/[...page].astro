---
import EditorialArchivePage from "../../../components/EditorialArchivePage.astro";
import type { GetStaticPathsOptions, Page } from "astro";
import type { BlogEntry } from "../../../utils/blog";
import BaseLayout from "../../../layouts/BaseLayout.astro";

import { NL_LAUNCH_DATE } from "../../../data/site";
import {
  buildBreadcrumbJsonLd,
  buildWebsiteJsonLd,
  filterPostsForLang,
  getAllPosts,
  getBlogIndexPagePath,
} from "../../../utils/blog";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  if (new Date() < NL_LAUNCH_DATE) return [];
  const posts = filterPostsForLang(await getAllPosts(), "nl");
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props as { page: Page<BlogEntry> };
const isFirstPage = page.currentPage === 1;

const structuredData = isFirstPage
  ? [buildWebsiteJsonLd(), buildBreadcrumbJsonLd([{ name: "Home", path: "/nl/" }, { name: "Artikelen", path: "/nl/blog/" }])]
  : undefined;

const canonicalPath = isFirstPage ? "/nl/blog/" : `/nl/blog/${page.currentPage}/`;
const frCanonicalPath = getBlogIndexPagePath("fr", page.currentPage);
const enCanonicalPath = getBlogIndexPagePath("en", page.currentPage);
---
<BaseLayout
  title={isFirstPage ? "Alle artikelen | Blog van een Linkshandige" : `Artikelen - pagina ${page.currentPage} | Blog van een Linkshandige`}
  description="De volledige bibliotheek: schaakwetenschap, competitieve mindset, schaken en samenleving."
  canonicalPath={canonicalPath}
  lang="nl"
  frPath={frCanonicalPath}
  enPath={enCanonicalPath}
  noindex={!isFirstPage}
  structuredData={structuredData}
>
  <EditorialArchivePage page={page} lang="nl" />
</BaseLayout>
