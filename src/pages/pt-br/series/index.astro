---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { seriePsychologieSlugs, seriePsychologieTotal } from "../../../data/serie-psychologie";
import {
  absoluteUrl,
  buildBreadcrumbJsonLd,
  filterPostsForLang,
  getAllPosts,
} from "../../../utils/blog";

/**
 * Index des séries en portugais brésilien.
 *
 * On ne réutilise pas `data/series.ts` : ce registre liste aussi les séries qui n'existent qu'en
 * français (moteur Python, etc.). Les annoncer ici pointerait vers des pages absentes ou du
 * contenu français. Cette page ne liste donc que les séries réellement traduites, et gagnera une
 * entrée quand une autre série le sera.
 */
const published = filterPostsForLang(await getAllPosts(), "pt-br");
const publishedSlugs = new Set(published.map((post) => post.id.split("/").pop() ?? post.id));

const items = [
  {
    title : "A psicologia aplicada ao xadrez",
    lede :
      "Vieses, memória, motivação, influência, status: o que a pesquisa diz de verdade sobre o enxadrista. Cada conceito é confrontado com a sua crítica, e vários clássicos não sobrevivem a ela.",
    href : "/pt-br/series/psychologie/",
    total : seriePsychologieTotal,
    published : seriePsychologieSlugs.filter((slug) => publishedSlugs.has(slug)).length,
  },
];

const canonPath = "/pt-br/series/";
const title = "As séries";
const description =
  "As séries do blog: conjuntos de artigos pensados juntos, publicados numa ordem proposital, e feitos para serem lidos como um todo e não um a um.";

const structuredData = [
  buildBreadcrumbJsonLd([
    { name : "Início", path : "/pt-br/" },
    { name : "Séries", path : canonPath },
  ]),
  {
    "@context" : "https://schema.org",
    "@type" : "CollectionPage",
    name : title,
    description,
    url : absoluteUrl(canonPath),
    inLanguage : "pt-BR",
    mainEntity : {
      "@type" : "ItemList",
      numberOfItems : items.length,
      itemListElement : items.map((serie, index) => ({
        "@type" : "ListItem",
        position : index + 1,
        url : absoluteUrl(serie.href),
        name : serie.title,
      })),
    },
  },
];
---

<BaseLayout
  title={`${title} | Blog d’un Gaucher`}
  description={description}
  canonicalPath={canonPath}
  structuredData={structuredData}
  lang="pt-br"
>
  <main class="series">
    <header class="series__hero">
      <p class="series__eyebrow">Leituras de fôlego</p>
      <h1>As séries</h1>
      <p class="series__lede">
        A maior parte dos artigos deste blog se lê sozinha. Alguns assuntos, porém, pedem um
        conjunto: vários textos pensados juntos, publicados numa ordem proposital, que se respondem e
        se completam. É isso que esta página reúne.
      </p>
    </header>

    <ul class="series__list">
      {items.map((serie) => {
        const complete = serie.published >= serie.total;
        const progress = Math.round((serie.published / serie.total) * 100);
        return (
          <li class="serie-card">
            <a href={serie.href}>
              <h2 class="serie-card__title">{serie.title}</h2>
              <p class="serie-card__lede">{serie.lede}</p>
              <div class="serie-card__foot">
                <div class="serie-card__bar" role="presentation">
                  <span class="serie-card__fill" style={`width:${progress}%`}></span>
                </div>
                <p class="serie-card__count">
                  <strong>{serie.published}</strong> de {serie.total}
                  {!complete && <span> · em andamento</span>}
                </p>
              </div>
              <span class="serie-card__cta">Ver a série</span>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
</BaseLayout>

<style>
  .series {
    max-width: var(--container);
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }

  .series__hero {
    max-width: 44rem;
    margin-bottom: 3rem;
  }

  .series__eyebrow {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.75rem;
  }

  .series__hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .series__lede {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .series__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .serie-card > a {
    display: block;
    padding: 1.75rem 1.9rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--motion-fast) var(--ease-out),
      box-shadow var(--motion-fast) var(--ease-out);
  }

  .serie-card > a:hover,
  .serie-card > a:focus-visible {
    border-color: var(--green-border);
    box-shadow: var(--shadow-sm);
  }

  .serie-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3.5vw, 1.7rem);
    line-height: 1.25;
    margin: 0 0 0.6rem;
  }

  .serie-card__lede {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0 0 1.15rem;
    max-width: 44rem;
  }

  .serie-card__foot {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }

  .serie-card__bar {
    flex: 1 1 8rem;
    max-width: 14rem;
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--border-soft);
    overflow: hidden;
  }

  .serie-card__fill {
    display: block;
    height: 100%;
    background: var(--green);
    border-radius: var(--radius-pill);
  }

  .serie-card__count {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .serie-card__cta {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--green);
  }

  .serie-card > a:hover .serie-card__cta {
    text-decoration: underline;
  }
</style>
