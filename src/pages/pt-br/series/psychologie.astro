---
import EditorialSeriesHeader from "../../../components/EditorialSeriesHeader.astro";
import EditorialSeriesCard from "../../../components/EditorialSeriesCard.astro";
import "../../../styles/editorial-resources.css";
import "../../../styles/editorial-series.css";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  grappeText,
  seriePsychologieGrappes,
  seriePsychologieTotal,
} from "../../../data/serie-psychologie";
import {
  absoluteUrl,
  buildBreadcrumbJsonLd,
  filterPostsForLang,
  formatDateForLang,
  getAllPosts,
  getLocalizedPostText,
  getPostUrlPtBr,
} from "../../../utils/blog";

const LANG = "pt-br" as const;

// Même logique que la page FR : getAllPosts() ne renvoie que les articles déjà publiés, donc la
// série se dévoile au fil des semaines. Les articles à venir restent listés sans lien.
// Différence ici : le titre et l'extrait viennent de la traduction, et l'URL du slug localisé.
const published = filterPostsForLang(await getAllPosts(), LANG);
const bySlug = new Map(published.map((post) => [post.id.split("/").pop() ?? post.id, post]));

// Seuls les articles publiés sont affichés : pas de ligne « em breve » sans lien.
const grappesRaw = await Promise.all(
  seriePsychologieGrappes.map(async (grappe) => ({
    id : grappe.id,
    ...grappeText(grappe, LANG),
    items : await Promise.all(
      grappe.items
        .filter((item) => bySlug.has(item.slug))
        .map(async (item) => {
          const post = bySlug.get(item.slug)!;
          const text = await getLocalizedPostText(post, LANG);
          return {
            ...item,
            post,
            href : await getPostUrlPtBr(post),
            date : formatDateForLang(post.data.publishDate, LANG),
            title : text.title,
            excerpt : text.excerpt,
          };
        }),
    ),
  })),
);
const grappes = grappesRaw.filter((grappe) => grappe.items.length > 0);

const publishedCount = grappes.reduce((total, grappe) => total + grappe.items.length, 0);

const canonPath = "/pt-br/series/psychologie/";
const title = "Série: a psicologia aplicada ao xadrez";
const description =
  `Uma série de ${seriePsychologieTotal} artigos sobre o que a psicologia diz de verdade a respeito do enxadrista: vieses, memória, motivação, influência e status. Cada conceito é confrontado com a sua crítica.`;

// ItemList : rend la série citable comme un ensemble, et pas seulement article par article.
const structuredData = [
  buildBreadcrumbJsonLd([
    { name : "Início", path : "/pt-br/" },
    { name : "Séries", path : "/pt-br/series/" },
    { name : "Psicologia", path : canonPath },
  ]),
  {
    "@context" : "https://schema.org",
    "@type" : "CollectionPage",
    name : title,
    description,
    url : absoluteUrl(canonPath),
    inLanguage : "pt-BR",
    mainEntity : {
      "@type" : "ItemList",
      numberOfItems : publishedCount,
      itemListElement : grappes
        .flatMap((grappe) => grappe.items)
        .filter((item) => item.href)
        .map((item, index) => ({
          "@type" : "ListItem",
          position : index + 1,
          url : absoluteUrl(item.href as string),
          name : item.title,
        })),
    },
  },
];
---
<BaseLayout
  title={`${title} | Blog d’un Gaucher`}
  description={description}
  canonicalPath={canonPath}
  structuredData={structuredData}
  lang="pt-br"
>
<div class="resource-page"><div class="container">
<EditorialSeriesHeader lang="pt-br" active="psychologie" title="A psicologia aplicada ao xadrez" published={publishedCount} total={seriePsychologieTotal}>
      <p>
        O xadrez produz uma informação rara: uma derrota sem ambiguidade, sem companheiro de equipe a
        quem atribuí-la, sem parcela de sorte, pública e frequente. É isso que faz dele o melhor
        terreno de observação que existe para entender como um cérebro lida com o que o contradiz.
      </p>
      <p>
        Cada artigo parte de uma cena de partida, cita o estudo fundador <strong>e a sua
        crítica</strong>, e termina com uma coisa a fazer. Vários clássicos que você acha que conhece
        não sobreviveram às replicações: isso é dito toda vez.
      </p>

<Fragment slot="status">{grappes[0]?.items[0]&&<a class="resource-button" href={grappes[0].items[0].href}>Começar a leitura →</a>}<a class="resource-link series-status-link" href="#parcours">Explorar os temas ↓</a></Fragment>
</EditorialSeriesHeader>
<nav class="series-jumps" id="parcours" aria-label="Explorar os temas"><span>Explorar os temas</span><ol>{grappes.map((grappe,i)=><li><a href={`#${grappe.id}`}>{String(i+1).padStart(2,"0")} · {grappe.titre}</a></li>)}</ol></nav>
{grappes.map((grappe,i)=><section class="series-section" id={grappe.id}><div class="series-section__heading"><span class="series-section__number" aria-hidden="true">{String(i+1).padStart(2,"0")}</span><h2>{grappe.titre}</h2></div><p class="series-section__intro">{grappe.chapeau}</p><ol class:list={["series-articles",{"series-articles--single":grappe.items.length===1,"series-articles--pair":grappe.items.length===2}]}>{grappe.items.map(item=><li><EditorialSeriesCard lang="pt-br" post={item.post} title={item.title} excerpt={item.excerpt} href={item.href} pilier={item.pilier} /></li>)}</ol></section>)}
<div class="resource-end"><a class="resource-link" href="/pt-br/series/">← Todas as séries</a></div>
</div></div>
</BaseLayout>
