---
import EditorialArchivePage from "../../../components/EditorialArchivePage.astro";
import type { GetStaticPathsOptions, Page } from "astro";
import type { BlogEntry } from "../../../utils/blog";



import BaseLayout from "../../../layouts/BaseLayout.astro";

import { categoryMap, categorySlugs, PT_BR_LAUNCH_DATE } from "../../../data/site";
import {
  buildBreadcrumbJsonLd,
  buildWebsiteJsonLd,
  filterPostsForLang,
  getAllPosts,
  getBlogIndexPagePath,
} from "../../../utils/blog";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  if (new Date() < PT_BR_LAUNCH_DATE) return [];
  const posts = filterPostsForLang(await getAllPosts(), "pt-br");
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props as { page: Page<BlogEntry> };
const isFirstPage = page.currentPage === 1;

const structuredData = isFirstPage
  ? [buildWebsiteJsonLd(), buildBreadcrumbJsonLd([{ name: "Início", path: "/pt-br/" }, { name: "Artigos", path: "/pt-br/blog/" }])]
  : undefined;

const canonicalPath = isFirstPage ? "/pt-br/blog/" : `/pt-br/blog/${page.currentPage}/`;
const frCanonicalPath = getBlogIndexPagePath("fr", page.currentPage);
const enCanonicalPath = getBlogIndexPagePath("en", page.currentPage);
---
<BaseLayout
  title={isFirstPage ? "Todos os artigos | Blog de um Canhoto" : `Artigos - página ${page.currentPage} | Blog de um Canhoto`}
  description="A biblioteca completa: ciência do xadrez, mentalidade competitiva, xadrez e sociedade."
  canonicalPath={canonicalPath}
  lang="pt-br"
  frPath={frCanonicalPath}
  enPath={enCanonicalPath}
  noindex={!isFirstPage}
  structuredData={structuredData}
>
  <EditorialArchivePage page={page} lang="pt-br" />
</BaseLayout>
