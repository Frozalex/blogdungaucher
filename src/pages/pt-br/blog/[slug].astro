---
import { getCollection, render } from "astro:content";

import "katex/dist/katex.min.css";

import AdBanner from "../../../components/AdBanner.astro";
import ArticleCard from "../../../components/ArticleCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import TableOfContents from "../../../components/TableOfContents.astro";
import ShareButtons from "../../../components/ShareButtons.astro";
import Comments from "../../../components/Comments.astro";
import NewsletterCta from "../../../components/NewsletterCta.astro";
import FAQ from "../../../components/FAQ.astro";
import ArticleVideo from "../../../components/ArticleVideo.astro";
import KeyTakeaways from "../../../components/KeyTakeaways.astro";

import { categoryMap, categorySlugs, siteConfig, PT_BR_LAUNCH_DATE } from "../../../data/site";
import {
  absoluteUrl,
  buildBreadcrumbJsonLd,
  buildFaqJsonLd,
  calculateReadingTime,
  formatDatePtBr,
  filterPostsForLang,
  getAllPosts,
  getEnSlugMap,
  getPtBrSlugMap,
  getPostSlug,
  getPostUrl,
  getPostUrlEnSync,
  getPostUrlPtBrSync,
  getPostHeroSrc,
} from "../../../utils/blog";
import { renderEnglishMarkdown } from "../../../utils/english-article";
import { swapLangPrefix } from "../../../utils/lang-paths";
import {
  renderMarkdownToArticleHtml,
  stripFaqH2Section,
} from "../../../utils/markdown-strip-faq";
import { isPublicAssetAvailable } from "../../../utils/public-asset";

export async function getStaticPaths() {
  if (new Date() < PT_BR_LAUNCH_DATE) return [];

  const posts = filterPostsForLang(await getAllPosts(), "pt-br");
  const ptBrSlugMap = await getPtBrSlugMap();
  const enSlugMap = await getEnSlugMap();

  return posts.map((post) => {
    const frSlug = getPostSlug(post);
    const ptBrSlug = ptBrSlugMap.get(frSlug) ?? frSlug;
    const enSlug = enSlugMap.get(frSlug) ?? frSlug;
    return { params: { slug: ptBrSlug }, props: { post, frSlug, ptBrSlug, enSlug } };
  });
}

const { post, frSlug, ptBrSlug, enSlug } = Astro.props as {
  post: Awaited<ReturnType<typeof getAllPosts>>[number];
  frSlug: string;
  ptBrSlug: string;
  enSlug: string;
};

// Récupère la traduction PT-BR depuis la collection (si elle existe et n'est pas draft).
const ptBrEntries = await getCollection("ptBrTranslations");
const ptBrEntryRaw = ptBrEntries.find((e) => (e.data.frSlug ?? getPostSlug(post)) === frSlug);
const ptBrEntry = ptBrEntryRaw && !ptBrEntryRaw.data.draft ? ptBrEntryRaw : undefined;
const ptBrMarkdown = ptBrEntry?.body;

const faqsForDisplay = ptBrEntry?.data?.faq ?? post.data.faq ?? [];
const stripInlineFaq = faqsForDisplay.length > 0;
const mdSource = ptBrMarkdown ?? post.body;
const mdForArticle = stripInlineFaq ? stripFaqH2Section(mdSource) : mdSource;

let Content: Awaited<ReturnType<typeof render>>["Content"] | undefined;
let headings: Awaited<ReturnType<typeof render>>["headings"];
let ptBrHtml: string | undefined;

if (ptBrMarkdown) {
  const rendered = stripInlineFaq
    ? renderEnglishMarkdown(mdForArticle)
    : renderEnglishMarkdown(ptBrMarkdown);
  ptBrHtml = rendered.html;
  headings = rendered.headings;
} else if (stripInlineFaq) {
  const r = await renderMarkdownToArticleHtml(mdForArticle);
  ptBrHtml = r.html;
  headings = r.headings;
} else {
  const r = await render(post);
  Content = r.Content;
  headings = r.headings;
}

const category = categoryMap[post.data.category];

const readingTime =
  post.data.readingTime ??
  (ptBrMarkdown ? calculateReadingTime(ptBrMarkdown) : calculateReadingTime(post.body));

const allPosts = await getAllPosts();
const related = filterPostsForLang(
  allPosts.filter((e) => e.id !== post.id && e.data.category === post.data.category),
  "pt-br",
).slice(0, 3);

const postUrlPtBr = getPostUrlPtBrSync(post, ptBrSlug);
const postUrlFr = getPostUrl(post);
const postUrlEn = getPostUrlEnSync(post, enSlug);
const absolutePostUrl = absoluteUrl(postUrlPtBr);

const ptBrTitle     = ptBrEntry?.data?.seoTitle ?? ptBrEntry?.data?.title ?? post.data.seoTitle ?? post.data.title;
const ptBrDesc      = ptBrEntry?.data?.seoDescription ?? ptBrEntry?.data?.excerpt ?? post.data.seoDescription ?? post.data.excerpt;
const displayTitle  = ptBrEntry?.data?.title ?? post.data.title;
const displayExcerpt = ptBrEntry?.data?.excerpt ?? post.data.excerpt;
const hasPtBrTranslation = !!ptBrEntry;

const heroSrc = getPostHeroSrc(post);
const heroImage = heroSrc ? post.data.heroImage : undefined;

const summaryVideoSrc = post.data.summaryVideo?.trim();
const showSummaryVideo = !!summaryVideoSrc && isPublicAssetAvailable(summaryVideoSrc);

const ptBrCategoryLabels: Record<string, string> = {
  science: "Ciência",
  esprit: "Mente",
  societe: "Sociedade",
};
const ptBrCategoryLabel = ptBrCategoryLabels[post.data.category] ?? category.label;
const ptBrCategoryHref = swapLangPrefix(category.href, "pt-br");

const structuredData = [
  buildBreadcrumbJsonLd([
    { name: "Início", path: "/pt-br/" },
    { name: "Artigos", path: "/pt-br/blog/" },
    { name: ptBrCategoryLabel, path: ptBrCategoryHref },
    { name: displayTitle, path: postUrlPtBr },
  ]),
  ...(faqsForDisplay.length > 0 ? [buildFaqJsonLd(faqsForDisplay)] : []),
];

const ptBrCategoryShortLabels: Record<string, string> = {
  science: "Ciência",
  esprit: "Mente & Foco",
  societe: "Xadrez & Sociedade",
};

const otherPillars = categorySlugs
  .filter((s) => s !== post.data.category && s !== "grand-oral")
  .map((s) => ({ ...categoryMap[s], ptBrShort: ptBrCategoryShortLabels[s] ?? categoryMap[s].shortLabel }));
---
<BaseLayout
  title={`${ptBrTitle} | Blog de um Canhoto`}
  description={ptBrDesc}
  canonicalPath={postUrlPtBr}
  lang="pt-br"
  frPath={postUrlFr}
  enPath={postUrlEn}
  ptBrPath={postUrlPtBr}
  image={post.data.ogImage ?? siteConfig.defaultOgImage}
  type="article"
  publishDate={post.data.publishDate}
  modifiedDate={post.data.updatedDate ?? post.data.publishDate}
  section={ptBrCategoryLabel}
  structuredData={structuredData}
  accentColor={category.accent}
  tags={post.data.tags}
>
  <article class="article-page" style={`--c:${category.accent}`}>
    <div class="reading-progress" aria-hidden="true">
      <span id="reading-progress-fill"></span>
    </div>
    <div class="container article-layout">
      <div class="article-main">

        <Breadcrumb items={[
          { label: "Início", href: "/pt-br/" },
          { label: "Artigos", href: "/pt-br/blog/" },
          { label: ptBrCategoryLabel, href: ptBrCategoryHref },
          { label: displayTitle },
        ]} />

        <header class="article-header fade-up" style="--motion-delay: 40ms;">
          <div class="article-meta">
            <a href={ptBrCategoryHref} class="meta-cat" style={`--c:${category.accent}`}>
              {ptBrCategoryLabel}
            </a>
            <span>{readingTime}</span>
            <time datetime={post.data.publishDate.toISOString()}>
              {formatDatePtBr(post.data.publishDate)}
            </time>
          </div>
          <h1>{displayTitle}</h1>
          <p class="article-excerpt">{displayExcerpt}</p>
          {post.data.updatedDate &&
            post.data.updatedDate.getTime() !== post.data.publishDate.getTime() && (
            <p class="meta-updated">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12a9 9 0 1 0 3-6.7" />
                <path d="M3 4v5h5" />
              </svg>
              Atualizado em
              <time datetime={post.data.updatedDate.toISOString()}>
                {formatDatePtBr(post.data.updatedDate)}
              </time>
            </p>
          )}
        </header>

        {showSummaryVideo && summaryVideoSrc && (
          <ArticleVideo
            src={summaryVideoSrc}
            poster={heroSrc}
            title={`Resumo em vídeo: ${displayTitle}`}
            eyebrow="Resumo em vídeo do artigo"
            accentColor={category.accent}
            note={post.data.summaryVideoNote}
          />
        )}

        {!showSummaryVideo && heroSrc && heroImage && (
          <figure class="hero-media fade-up" style="--motion-delay: 70ms;">
            <img class="hero-img" src={heroSrc} alt={heroImage.alt} loading="lazy" decoding="async" />
            {(heroImage.credit || heroImage.license || heroImage.sourceUrl) && (
              <figcaption class="hero-credit">
                {heroImage.credit && <span class="credit-piece">Crédito: {heroImage.credit}</span>}
                {heroImage.license && <span class="credit-piece">Licença: {heroImage.license}</span>}
                {heroImage.sourceUrl && (
                  <a class="credit-link" href={heroImage.sourceUrl} target="_blank" rel="noreferrer">
                    Fonte
                  </a>
                )}
              </figcaption>
            )}
          </figure>
        )}

        {!hasPtBrTranslation && (
          <div class="translation-notice" role="note">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            <span>A tradução completa deste artigo para o português está em preparação. O conteúdo abaixo está atualmente em francês.</span>
          </div>
        )}

        <div class="toc-mobile-wrap">
          <TableOfContents headings={headings} mode="mobile" lang="pt-br" />
        </div>

        <div class="article-body fade-up" style="--motion-delay: 100ms;">
          {ptBrHtml ? (
            <div class="md-chunk" set:html={ptBrHtml} />
          ) : (
            Content && <Content />
          )}
        </div>

        {post.data.keyTakeaways && post.data.keyTakeaways.length > 0 && (
          <KeyTakeaways items={post.data.keyTakeaways} accentColor={category.accent} />
        )}

        <AdBanner format="inline" compact={true} />

        {faqsForDisplay.length > 0 && <FAQ items={faqsForDisplay} lang="pt-br" />}

        {otherPillars.length > 0 && (
          <nav class="pillar-links fade-up" style="--motion-delay: 130ms;" aria-label="Outras seções do blog">
            <span class="pillar-links__eyebrow">Continue explorando</span>
            <div class="pillar-links__grid">
              {otherPillars.map((p) => (
                <a href={swapLangPrefix(p.href, "pt-br")} class="pillar-link" style={`--pc:${p.accent}`}>
                  <span class="pillar-link__dot"></span>
                  <div>
                    <strong>{p.ptBrShort}</strong>
                    <span>{p.tagline}</span>
                  </div>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                </a>
              ))}
            </div>
          </nav>
        )}

        <ShareButtons title={displayTitle} url={absolutePostUrl} />
        <NewsletterCta />
        <Comments lang="pt-br" />

      </div>

      <aside class="article-aside">
        <div class="toc-desktop-wrap">
          <TableOfContents headings={headings} mode="desktop" lang="pt-br" />
        </div>

        <div class="aside-card fade-up" style="--motion-delay: 120ms;">
          <span class="aside-dot" style={`background:${category.accent}`}></span>
          <h2>{ptBrCategoryLabel}</h2>
          <p data-t={`categories.${post.data.category}.tagline`}>{category.tagline}</p>
          <a href={ptBrCategoryHref} class="aside-link">
            Explorar esta seção
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <AdBanner format="rectangle" />
      </aside>
    </div>

    {related.length > 0 && (
      <section class="related">
        <div class="container">
          <span class="eyebrow">Artigos relacionados</span>
          <div class="related-grid">
            {related.map((p) => <ArticleCard post={p} lang="pt-br" />)}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .translation-notice {
    display: flex; align-items: flex-start; gap: 0.6rem;
    padding: 0.85rem 1rem; border-radius: var(--radius-sm);
    border: 1px solid color-mix(in srgb, var(--green) 30%, var(--border-soft));
    background: color-mix(in srgb, var(--green) 6%, var(--surface));
    color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin-bottom: 1.5rem;
  }
  .translation-notice svg { flex-shrink: 0; margin-top: 0.1rem; color: var(--green); }

  .reading-progress {
    position: fixed; top: calc(var(--navbar-h) + 2rem);
    right: max(0.65rem, calc(50vw - 640px - 1rem));
    bottom: 2rem; width: 3px; z-index: 30;
    background: color-mix(in srgb, var(--border-soft) 70%, transparent);
    border-radius: 3px; overflow: hidden; pointer-events: none;
    opacity: 0.55; transition: opacity 220ms ease;
  }
  .reading-progress:hover { opacity: 1; }
  #reading-progress-fill {
    position: absolute; inset: 0 0 auto 0; display: block; width: 100%; height: 0%;
    background: linear-gradient(180deg, var(--c, var(--green)), color-mix(in srgb, var(--c, var(--green)) 55%, #fff));
    transition: height 120ms linear; border-radius: 3px;
  }
  @media (max-width: 900px) { .reading-progress { display: none; } }

  .article-page { padding-bottom: 4rem; }

  .article-layout {
    display: grid; grid-template-columns: minmax(0, 1fr) 280px;
    gap: 3rem; padding-top: 2.5rem; align-items: start;
  }

  .article-header { margin-bottom: 2rem; }

  .hero-media {
    margin: 0 0 1.25rem; border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid var(--border-soft); background: var(--surface); box-shadow: var(--shadow-xs);
  }
  .hero-img {
    width: 100%; display: block; aspect-ratio: 16 / 9; object-fit: cover;
    background: color-mix(in srgb, var(--surface-warm) 65%, transparent);
  }
  .hero-credit {
    display: flex; flex-wrap: wrap; gap: 0.4rem 0.6rem; align-items: baseline;
    padding: 0.6rem 0.8rem; border-top: 1px solid var(--border-soft);
    font-size: 0.75rem; color: var(--text-dim);
    background: color-mix(in srgb, var(--surface-warm) 70%, transparent);
  }
  .credit-piece { white-space: nowrap; }
  .credit-link { color: var(--green); font-weight: 700; text-decoration: none; }
  .credit-link:hover { text-decoration: underline; }

  .article-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem;
    font-size: 0.82rem; color: var(--text-dim); margin-bottom: 1rem;
  }
  .meta-cat {
    padding: 0.18rem 0.55rem; border-radius: var(--radius-pill);
    border: 1px solid var(--c, var(--green)); color: var(--c, var(--green));
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  }

  .article-header h1 {
    font-family: var(--font-serif); font-size: clamp(1.9rem, 4vw, 2.8rem);
    font-weight: 500; font-style: italic; line-height: 1.15;
    letter-spacing: -0.02em; margin: 0 0 0.9rem;
  }
  .article-excerpt { color: var(--text-muted); font-size: 1.05rem; line-height: 1.7; max-width: 48rem; }

  .meta-updated {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.85rem;
    padding: 0.3rem 0.7rem; border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c) 8%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--c) 18%, var(--border-soft));
    font-family: var(--font-display); font-size: 0.78rem; font-weight: 500;
    color: var(--text-muted); line-height: 1;
  }
  .meta-updated svg { flex-shrink: 0; color: var(--c); opacity: 0.85; }
  .meta-updated time { font-weight: 600; color: var(--text-main); }

  .article-body { padding: 2rem 0; }
  .article-body :global(h2) {
    margin: 1.9rem 0 0.7rem; font-family: var(--font-serif); font-weight: 500; font-style: italic;
    font-size: 1.65rem; letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--c) 72%, var(--text-main)); font-optical-sizing: auto;
  }
  .article-body :global(h3) { margin: 1.4rem 0 0.5rem; font-size: 1.18rem; color: var(--text-main); }
  .article-body :global(p),
  .article-body :global(li) { color: var(--text-muted); line-height: 1.75; }
  .article-body :global(p:first-of-type)::first-letter {
    font-family: var(--font-serif); font-style: italic; font-weight: 500;
    font-size: 3.4em; line-height: 0.9; float: left; padding: 0.22rem 0.6rem 0 0; color: var(--c);
  }
  .article-body :global(li::marker) { color: color-mix(in srgb, var(--c) 55%, var(--text-dim)); }
  .article-body :global(p + p),
  .article-body :global(p + ul),
  .article-body :global(ul + p) { margin-top: 0.85rem; }
  .article-body :global(ul),
  .article-body :global(ol) { padding-left: 1.2rem; }
  .article-body :global(li + li) { margin-top: 0.3rem; }
  .article-body :global(strong) { color: var(--text-main); }
  .article-body :global(a) {
    color: var(--c); font-weight: 600; text-decoration: none;
    background-image: linear-gradient(to top, color-mix(in srgb, var(--c) 16%, transparent) 0%, color-mix(in srgb, var(--c) 16%, transparent) 36%, transparent 36%);
    border-radius: 0.2rem; padding: 0 0.05rem;
    transition: color 160ms ease, background-size 160ms ease, background-color 160ms ease;
  }
  .article-body :global(a:hover) {
    color: color-mix(in srgb, var(--c) 80%, black);
    background-image: linear-gradient(to top, color-mix(in srgb, var(--c) 22%, transparent) 0%, color-mix(in srgb, var(--c) 22%, transparent) 42%, transparent 42%);
  }
  .article-body :global(a[href^="http"])::after { content: " ↗"; font-size: 0.8em; font-weight: 700; opacity: 0.75; }
  .article-body :global(blockquote) {
    margin: 1.25rem 0; padding: 0.9rem 1.2rem; border-left: 3px solid var(--c);
    background: color-mix(in srgb, var(--c) 7%, var(--surface));
    border-radius: 0 var(--radius-md) var(--radius-md) 0; color: var(--text-main); font-style: italic;
  }
  .article-body :global(hr) { border: none; border-top: 1px solid var(--border-soft); margin: 1.5rem 0; }
  .article-body :global(code) {
    font-size: 0.88em; padding: 0.15em 0.4em; border-radius: 4px;
    background: var(--bg-warm); color: var(--text-main);
  }
  .article-body :global(hr + h3) {
    display: inline-flex; align-items: center; min-height: 2rem; padding: 0 0.8rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--c) 10%, white);
    border: 1px solid color-mix(in srgb, var(--c) 16%, var(--border-soft)); margin-top: 1.8rem;
  }
  .article-body :global(pre) { border-radius: var(--radius-sm); padding: 1rem 1.2rem; overflow-x: auto; font-size: 0.9rem; margin: 1.2rem 0; background: var(--surface-warm); border: 1px solid var(--border-soft); }
  .article-body :global(img) { max-width: 100%; border-radius: var(--radius-sm); margin: 1rem 0; }

  .article-aside { position: sticky; top: 5rem; display: grid; gap: 1.5rem; }
  .toc-mobile-wrap { display: none; }

  .aside-card {
    padding: 1.1rem 1.2rem; border-radius: var(--radius-lg);
    border: 1.5px solid var(--border-soft); background: var(--surface); display: grid; gap: 0.4rem;
  }
  .aside-dot { width: 8px; height: 8px; border-radius: 50%; display: block; }
  .aside-card h2 { font-family: var(--font-display); font-size: 0.95rem; font-weight: 700; color: var(--text-main); }
  .aside-card p { font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; }
  .aside-link { display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.3rem; font-size: 0.82rem; font-weight: 600; color: var(--green); transition: gap 180ms var(--ease-spring); }
  .aside-link:hover { gap: 0.5rem; }

  .pillar-links { margin-top: 2rem; padding: 1.5rem; border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--border-soft); box-shadow: var(--shadow-xs); }
  .pillar-links__eyebrow { display: block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 0.9rem; }
  .pillar-links__grid { display: grid; gap: 0.7rem; }
  .pillar-link { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.85rem 1rem; border-radius: var(--radius-md); border: 1px solid var(--border-soft); background: color-mix(in srgb, var(--pc) 4%, var(--bg-warm)); transition: border-color 180ms ease, background 180ms ease; text-decoration: none; }
  .pillar-link:hover { border-color: var(--pc); background: color-mix(in srgb, var(--pc) 8%, var(--bg-warm)); }
  .pillar-link__dot { flex-shrink: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--pc); margin-top: 0.35rem; }
  .pillar-link div { flex: 1; display: flex; flex-direction: column; gap: 0.15rem; }
  .pillar-link strong { font-size: 0.9rem; color: var(--text-main); }
  .pillar-link span { font-size: 0.8rem; color: var(--text-dim); line-height: 1.5; }
  .pillar-link svg { flex-shrink: 0; color: var(--pc); margin-top: 0.25rem; }

  .related { padding: 3rem 0 2rem; border-top: 1px solid var(--border-soft); margin-top: 3rem; }
  .related .eyebrow { display: block; margin-bottom: 0.8rem; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.85rem; }

  @media (max-width: 1024px) {
    .article-layout { grid-template-columns: 1fr; }
    .article-aside { position: static; }
    .toc-mobile-wrap { display: block; }
    .toc-desktop-wrap { display: none; }
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) { .related-grid { grid-template-columns: 1fr; } }
</style>

<script>
  function initReadingProgress() {
    const fill = document.getElementById("reading-progress-fill");
    const body = document.querySelector(".article-body") as HTMLElement | null;
    if (!fill || !body) return;

    function update() {
      const rect  = body!.getBoundingClientRect();
      const total = body!.offsetHeight;
      const read  = Math.max(0, -rect.top);
      const pct   = Math.min(100, (read / total) * 100);
      fill.style.height = `${pct}%`;
    }

    window.addEventListener("scroll", update, { passive: true });
    update();
  }

  document.addEventListener("astro:page-load", initReadingProgress);
</script>
