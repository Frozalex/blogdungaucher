---
import EditorialSearchPage from "../../../components/EditorialSearchPage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { PT_BR_LAUNCH_DATE } from "../../../data/site";

if (new Date() < PT_BR_LAUNCH_DATE) return Astro.redirect("/fr/recherche/", 302);

---
<BaseLayout
  title="Buscar | Blog de um Canhoto"
  description="Busque um artigo de xadrez por palavra-chave : Alzheimer, TDAH, Elo, AlphaZero, dopamina, estresse, memória. Mais de 80 análises disponíveis."
  canonicalPath="/pt-br/recherche/"
  lang="pt-br"
  frPath="/fr/recherche/"
  enPath="/en/recherche/"
  ptBrPath="/pt-br/recherche/"
  noindex={true}
  omitEnDeAlternateLinks={true}
>
  <EditorialSearchPage lang="pt-br" />
</BaseLayout>
