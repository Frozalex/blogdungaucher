---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeLanding from "../../components/HomeLanding.astro";

import { buildWebsiteJsonLd, getAllPosts, getLatestPosts, isFrenchOnlyPost } from "../../utils/blog";
import { categorySlugs, PT_BR_LAUNCH_DATE } from "../../data/site";

if (new Date() < PT_BR_LAUNCH_DATE) return Astro.redirect("/fr/", 302);

const allPosts = await getAllPosts();
const totalPosts = allPosts.filter((p) => !isFrenchOnlyPost(p)).length;
const latestPosts = await getLatestPosts(6, "pt-br");

const postsByCategory = Object.fromEntries(
  categorySlugs.map((slug) => [
    slug,
    allPosts.filter((p) => p.data.category === slug && !isFrenchOnlyPost(p)).length,
  ]),
) as Partial<Record<(typeof categorySlugs)[number], number>>;
---
<BaseLayout
  title="Blog de um Canhoto - Xadrez sem simplificação"
  description="Ciência do xadrez, mentalidade competitiva e xadrez na sociedade: dois novos artigos por semana. Um espaço editorial rigoroso e humano."
  canonicalPath="/pt-br/"
  lang="pt-br"
  frPath="/"
  enPath="/en/"
  structuredData={buildWebsiteJsonLd()}
>
  <HomeLanding lang="pt-br" latestPosts={latestPosts} totalPosts={totalPosts} postsByCategory={postsByCategory} />
</BaseLayout>
