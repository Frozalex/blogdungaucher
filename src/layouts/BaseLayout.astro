---
import "../styles/global.css";
// KaTeX CSS (~23 ko, render-blocking) : volontairement PAS importé ici pour ne pas peser
// sur les pages sans formules (accueil, rubriques, listings, à propos…). Il est importé
// uniquement dans les templates qui rendent du markdown d'article :
// pages/{fr,en}/blog/[slug].astro et pages/fr/dissertations/[slug].astro.
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import CookieConsent from "../components/CookieConsent.astro";

import { siteConfig, PT_BR_LAUNCH_DATE, NL_LAUNCH_DATE, enStaticRoutes, ptBrStaticRoutes } from "../data/site";
import { swapLangPrefix, withTrailingSlash } from "../utils/lang-paths";

// Préchargement de la police de titre (Space Grotesk, subset latin) : présente dans le H1/LCP de
// toutes les pages, légère (~22 ko), donc gaspillage négligeable. `?url` renvoie l'URL hashée émise
// par Astro → même fichier que le @font-face, aucun double téléchargement. On NE précharge PAS Fraunces
// (accent du hero, 80 ko, spécifique à l'accueil) : sur Slow-4G le tuyau est le goulot, pas la découverte.
import spaceGroteskWoff2 from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";

import { readFileSync } from "node:fs";
import { createHash } from "node:crypto";
import { join } from "node:path";

// Dictionnaire i18n runtime externalisé (public/i18n-dict.js) pour alléger chaque page HTML.
// On calcule un hash de contenu au build → cache long côté hôte + invalidation auto au moindre changement.
// Lecture défensive (try/catch) : si le fichier est introuvable dans l'env de build (cwd différent…),
// on retombe sur un horodatage plutôt que de faire planter tout le build.
let i18nDictHash = String(Date.now());
try {
  i18nDictHash = createHash("md5")
    .update(readFileSync(join(process.cwd(), "public/i18n-dict.js")))
    .digest("hex")
    .slice(0, 10);
} catch {
  // garde le fallback horodaté
}

type StructuredData = Record<string, unknown> | Array<Record<string, unknown>>;

const {
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  canonicalPath = Astro.url.pathname,
  image = siteConfig.defaultOgImage,
  type = "website",
  noindex = false,
  structuredData,
  accentColor,
  tags,
  publishDate,
  modifiedDate,
  section,
  lang = "fr",
  frPath,
  enPath,
  ptBrPath,
  nlPath,
  omitEnDeAlternateLinks = false,
  prevHref,
  nextHref,
} = Astro.props as {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  structuredData?: StructuredData;
  accentColor?: string;
  tags?: string[];
  publishDate?: Date;
  modifiedDate?: Date;
  section?: string;
  lang?: "fr" | "en" | "pt-br" | "nl";
  frPath?: string;
  enPath?: string;
  /** Chemin PT-BR optionnel (sinon dérivé du canonical via swapLangPrefix). */
  ptBrPath?: string;
  /** Chemin NL optionnel (sinon dérivé du canonical via swapLangPrefix). */
  nlPath?: string;
  /** Articles FR uniquement (ex. Grand oral) : pas d’hreflang en/de/pt-br vers des URLs inexistantes. */
  omitEnDeAlternateLinks?: boolean;
  /** Pagination : liens rel="prev" et rel="next" pour les moteurs. */
  prevHref?: string;
  nextHref?: string;
};

const resolvedFrPath = frPath ?? swapLangPrefix(canonicalPath, "fr");
const resolvedEnPath = enPath ?? swapLangPrefix(canonicalPath, "en");
const resolvedPtBrPath = ptBrPath ?? swapLangPrefix(canonicalPath, "pt-br");
const resolvedNlPath = nlPath ?? swapLangPrefix(canonicalPath, "nl");

// Hrefs du sélecteur de langue : identiques aux chemins résolus quand la page a
// un équivalent EN/PT-BR connu (routes statiques, ou chemin explicite passé par
// les templates d'article), mais repliés sur l'accueil de la langue sinon —
// pages FR-only (glossaire, grand oral, dissertations, mentions légales…) — pour
// ne jamais exposer de lien mort dans le menu de langue.
const enStaticSet = new Set(enStaticRoutes.map((r) => withTrailingSlash(r)));
const ptBrStaticSet = new Set(ptBrStaticRoutes.map((r) => withTrailingSlash(r)));
const enSwapped = withTrailingSlash(swapLangPrefix(canonicalPath, "en"));
const ptBrSwapped = withTrailingSlash(swapLangPrefix(canonicalPath, "pt-br"));
const enSwitchHref = enPath ?? (enStaticSet.has(enSwapped) ? enSwapped : "/en/");
const ptBrSwitchHref = ptBrPath ?? (ptBrStaticSet.has(ptBrSwapped) ? ptBrSwapped : "/pt-br/");
const canonicalUrl = new URL(canonicalPath, siteConfig.siteUrl).toString();
const frCanonicalUrl = new URL(resolvedFrPath, siteConfig.siteUrl).toString();
const enCanonicalUrl = new URL(resolvedEnPath, siteConfig.siteUrl).toString();
const ptBrCanonicalUrl = new URL(resolvedPtBrPath, siteConfig.siteUrl).toString();
const nlCanonicalUrl = new URL(resolvedNlPath, siteConfig.siteUrl).toString();
const ptBrLive = new Date() >= PT_BR_LAUNCH_DATE;
const nlLive = new Date() >= NL_LAUNCH_DATE;

const socialImage = new URL(image, siteConfig.siteUrl).toString();
const structuredDataItems = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const inLanguage = lang === "en" ? "en-US" : lang === "pt-br" ? "pt-BR" : lang === "nl" ? "nl-NL" : "fr-FR";

/** Politique d'indexation : FR + EN sont désormais indexables. PT-BR indexable dès lancement. */
const effectiveNoindex = noindex;

// Fallback: si une page "article" oublie de fournir structuredData,
// on injecte un BlogPosting minimal pour ne jamais "perdre" le schema.org.
const fallbackArticleJsonLd =
  type === "article" && structuredDataItems.length === 0
    ? ({
        "@context": "https://schema.org",
        "@type": ["Article", "BlogPosting"],
        "@id": `${canonicalUrl}#article`,
        headline: title,
        name: title,
        description,
        isAccessibleForFree: true,
        inLanguage,
        url: canonicalUrl,
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalUrl,
        },
        image: {
          "@type": "ImageObject",
          "@id": `${canonicalUrl}#primaryimage`,
          url: socialImage,
          width: 1200,
          height: 630,
        },
        ...(publishDate ? { datePublished: publishDate.toISOString() } : {}),
        ...(modifiedDate ? { dateModified: modifiedDate.toISOString() } : {}),
        ...(section ? { articleSection: section } : {}),
        ...(tags?.length ? { keywords: tags.join(", ") } : {}),
        publisher: {
          "@type": "Organization",
          "@id": `${siteConfig.siteUrl}/#publisher`,
          name: siteConfig.name,
          url: siteConfig.siteUrl,
          logo: {
            "@type": "ImageObject",
            url: `${siteConfig.siteUrl}/images/logo.svg`,
            width: 56,
            height: 80,
          },
        },
        author: {
          "@type": "Person",
          "@id": `${siteConfig.siteUrl}/fr/about/#person`,
          name: "Le Gaucher",
          url: lang === "en"
            ? `${siteConfig.siteUrl}/en/about/`
            : `${siteConfig.siteUrl}/fr/about/`,
        },
      } satisfies Record<string, unknown>)
    : null;

const allStructuredDataItems = fallbackArticleJsonLd
  ? [fallbackArticleJsonLd]
  : structuredDataItems;

/** Sérialisation JSON sûre pour inclusion dans une balise <script>.
 *  Échappe les séquences qui peuvent briser le parseur HTML :
 *   - `</script` (ferme la balise prématurément)
 *   - `<!--` / `-->` (commentaire HTML qui mange le JSON)
 *   - U+2028 / U+2029 (line separators interdits dans JS pré-ES2019)
 *  Conserve un JSON valide : on remplace par des escapes Unicode. */
function safeJsonLd(item: unknown): string {
  return JSON.stringify(item)
    .replace(/<\/(script)/gi, "<\\/$1")
    .replace(/<!--/g, "<\\!--")
    .replace(/-->/g, "--\\>")
    .replace(/[\u2028\u2029]/g, (c) =>
      c.charCodeAt(0) === 0x2028 ? "\\u2028" : "\\u2029",
    );
}

const ntfyUrl      = import.meta.env.PUBLIC_NTFY_URL       ?? "";
const ntfyTopic    = import.meta.env.PUBLIC_NTFY_TOPIC     ?? "blog-gaucher";
const ntfyVapidKey = import.meta.env.PUBLIC_NTFY_VAPID_KEY ?? "";
const umamiId      = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ?? "";
const umamiUrl     = import.meta.env.PUBLIC_UMAMI_URL        ?? "https://stats.blogdungaucher.com";
---
<!DOCTYPE html>
<html lang={lang} data-server-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Le Gaucher" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fcfaf6" media="(prefers-color-scheme: light)" id="meta-theme-light" />
    <meta name="theme-color" content="#1c1a16" media="(prefers-color-scheme: dark)" id="meta-theme-dark" />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Blog Gaucher" />
    <link rel="manifest" href="/manifest.json" />

    <!-- ── Préchargement de la police de titre (Space Grotesk) présente dans le H1/LCP de chaque page.
         crossorigin obligatoire : les woff2 sont chargés en mode CORS anonyme même en same-origin. -->
    <link rel="preload" as="font" type="font/woff2" href={spaceGroteskWoff2} crossorigin />

    <!-- ── i18n : dictionnaire runtime externalisé (bloquant + caché), AVANT le script anti-flash ──
         pour qu'il soit disponible synchronement (swap EN + aria-labels FR de la navbar). -->
    <script is:inline src={`/i18n-dict.js?v=${i18nDictHash}`}></script>

    <!-- ── Anti-flash : dark mode + i18n appliqués avant render ── -->
    <script is:inline>
      (function () {
        // ── DARK MODE ──
        var stored = localStorage.getItem("blogdungaucher.theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = stored || (prefersDark ? "dark" : "light");
        document.documentElement.dataset.theme = theme;

        // ── I18N runtime ──
        var T = window.__I18N_DICT__ || { fr: {}, en: {} };

        window.__i18n = T;

        function applyLang(lang) {
          // Update <html lang> attribute
          document.documentElement.lang = lang === "en" ? "en" : "fr";
          var dict = T[lang] || T.fr;
          // Texte simple
          document.querySelectorAll("[data-t]").forEach(function(el) {
            var key = el.getAttribute("data-t");
            if (dict[key] !== undefined) el.textContent = dict[key];
          });
          // HTML (pour les titres avec balises)
          document.querySelectorAll("[data-t-html]").forEach(function(el) {
            var key = el.getAttribute("data-t-html");
            if (dict[key] !== undefined) el.innerHTML = dict[key];
          });
          // Attribut placeholder
          document.querySelectorAll("[data-t-placeholder]").forEach(function(el) {
            var key = el.getAttribute("data-t-placeholder");
            if (dict[key] !== undefined) el.setAttribute("placeholder", dict[key]);
          });
          // Dates bilingues
          document.querySelectorAll("time[datetime]").forEach(function(el) {
            var iso = el.getAttribute("datetime");
            if (!iso) return;
            try {
              el.textContent = new Intl.DateTimeFormat(
                lang === "en" ? "en-GB" : "fr-FR",
                { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }
              ).format(new Date(iso));
            } catch(e) {}
          });
          // Attribut aria-label du burger / toggles
          document.querySelectorAll("[data-t-aria]").forEach(function(el) {
            var key = el.getAttribute("data-t-aria");
            if (dict[key] !== undefined) el.setAttribute("aria-label", dict[key]);
          });
        }

        window.__applyLang = applyLang;

        // Langue dérivée de l'URL : source de vérité sur ce site statique multilingue.
        // Fiable et jamais périmée (contrairement à un attribut swappé ou au localStorage)
        // → aucun retour intempestif au FR après une View Transition.
        function langFromPath(path) {
          if (path === "/en" || path.indexOf("/en/") === 0) return "en";
          if (path === "/pt-br" || path.indexOf("/pt-br/") === 0) return "pt-br";
          if (path === "/nl" || path.indexOf("/nl/") === 0) return "nl";
          return "fr";
        }
        window.__langFromPath = langFromPath;

        var pageLang = langFromPath(location.pathname);
        window.__lang = pageLang;
        // Le rendu serveur fait déjà foi dans chaque langue ; applyLang ne couvre que le
        // runtime fr/en, on ne l'invoque donc que pour EN (parité des nœuds [data-t]).
        if (pageLang === "en") applyLang("en");
      })();
    </script>
    <meta name="google-adsense-account" content="ca-pub-1244325018333025" />
    {tags && tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}
    {effectiveNoindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <title>{title}</title>
    <ClientRouter />
    <link rel="canonical" href={canonicalUrl} />
    {omitEnDeAlternateLinks ? (
      <>
        <link rel="alternate" hrefLang="fr" href={frCanonicalUrl} />
        <link rel="alternate" hrefLang="x-default" href={frCanonicalUrl} />
      </>
    ) : (
      <>
        <link rel="alternate" hrefLang="fr" href={frCanonicalUrl} />
        <link rel="alternate" hrefLang="en" href={enCanonicalUrl} />
        {/* hreflang "de" désactivé : les pages allemandes ne sont plus servies. */}
        {ptBrLive && <link rel="alternate" hrefLang="pt-BR" href={ptBrCanonicalUrl} />}
        {nlLive && <link rel="alternate" hrefLang="nl" href={nlCanonicalUrl} />}
        <link rel="alternate" hrefLang="x-default" href={frCanonicalUrl} />
      </>
    )}
    {/* Flux RSS de la langue courante : fr → /rss.xml ; en → /en/rss.xml ; pt-br → /pt-br/rss.xml.
        Le NL n'a pas encore de flux (rubrique gated). Le flux fr reste la valeur par défaut. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteConfig.name} RSS`}
      href={`${siteConfig.siteUrl}${lang === "en" ? "/en/rss.xml" : lang === "pt-br" ? "/pt-br/rss.xml" : "/rss.xml"}`}
    />
    {prevHref && <link rel="prev" href={new URL(prevHref, siteConfig.siteUrl).toString()} />}
    {nextHref && <link rel="next" href={new URL(nextHref, siteConfig.siteUrl).toString()} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : lang === "pt-br" ? "pt_BR" : lang === "nl" ? "nl_NL" : "fr_FR"} />
    {type === "article" && publishDate && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    {type === "article" && modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate.toISOString()} />
    )}
    {type === "article" && section && <meta property="article:section" content={section} />}
    {type === "article" &&
      tags?.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:url" content={canonicalUrl} />

    {allStructuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={safeJsonLd(item)} />
    ))}

    {umamiId && (
      <script is:inline define:vars={{ umamiId, umamiUrl }}>
        (function() {
          var s = document.createElement('script');
          s.async = true;
          s.defer = true;
          s.dataset.websiteId = umamiId;
          s.dataset.domains = 'blogdungaucher.com';
          s.src = umamiUrl + '/script.js';
          document.head.appendChild(s);
        })();
      </script>
    )}

    <script is:inline define:vars={{ ntfyUrl, ntfyTopic, ntfyVapidKey }}>
      globalThis.__NTFY_URL__       = ntfyUrl;
      globalThis.__NTFY_TOPIC__     = ntfyTopic;
      globalThis.__NTFY_VAPID_KEY__ = ntfyVapidKey;
    </script>

    <script is:inline>
      (() => {
        const CONSENT_KEY = "blogdungaucher.cookieConsent.v1";
        const GA_MEASUREMENT_ID = "G-D31YHTHQT5";
        const ADS_CLIENT = "ca-pub-1244325018333025";

        const state = {
          analyticsLoaded: false,
          adsLoaded: false,
        };

        function readConsent() {
          try {
            const raw = localStorage.getItem(CONSENT_KEY);
            if (!raw) return null;
            const p = JSON.parse(raw);
            if (p && typeof p === "object" && !("notifications" in p)) {
              return {
                ...p,
                notifications: false,
              };
            }
            return p;
          } catch {
            return null;
          }
        }

        function loadScript(src, attrs = {}) {
          if (document.querySelector(`script[src="${src}"]`)) return;
          const script = document.createElement("script");
          script.src = src;
          script.async = true;
          Object.entries(attrs).forEach(([key, value]) => {
            script.setAttribute(key, value);
          });
          document.head.appendChild(script);
        }

        function enableAnalytics() {
          if (state.analyticsLoaded) return;
          state.analyticsLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag() {
            window.dataLayer.push(arguments);
          };
          loadScript(`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`);
          window.gtag("js", new Date());
          window.gtag("config", GA_MEASUREMENT_ID);
        }

        function enableAds() {
          if (state.adsLoaded) return;
          state.adsLoaded = true;
          loadScript(
            `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS_CLIENT}`,
            { crossorigin: "anonymous" },
          );
        }

        function urlBase64ToUint8Array(base64String) {
          try {
            const clean = base64String.replace(/[^A-Za-z0-9+/=_-]/g, "");
            const padding = "=".repeat((4 - (clean.length % 4)) % 4);
            const base64 = (clean + padding).replace(/-/g, "+").replace(/_/g, "/");
            const raw = atob(base64);
            return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
          } catch (_) {
            return null;
          }
        }

        /** ntfy Web Push : abonne le navigateur au topic ntfy via PushManager (VAPID). */
        async function enableNtfyPush() {
          if (!("PushManager" in window) || !("serviceWorker" in navigator)) return;
          const vapidKey = (globalThis.__NTFY_VAPID_KEY__ || "").trim();
          if (!vapidKey) return;
          try {
            const reg = await navigator.serviceWorker.ready;
            if (await reg.pushManager.getSubscription()) return; // déjà abonné
            const serverKey = urlBase64ToUint8Array(vapidKey);
            if (!serverKey) return;
            const sub = await reg.pushManager.subscribe({
              userVisibleOnly: true,
              applicationServerKey: serverKey,
            });
            const url   = (globalThis.__NTFY_URL__   || "").replace(/\/$/, "");
            const topic = (globalThis.__NTFY_TOPIC__ || "blog-gaucher").trim();
            if (!url) return;
            const j = sub.toJSON();
            await fetch(`${url}/v1/account/subscription`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                web_push_subscription: { endpoint: j.endpoint, keys: j.keys },
                url,
                topics: [topic],
              }),
            }).catch(() => {});
          } catch (_) {}
        }

        async function disableNtfyPush() {
          if (!("serviceWorker" in navigator)) return;
          try {
            const reg = await navigator.serviceWorker.ready;
            const sub = await reg.pushManager.getSubscription();
            if (sub) await sub.unsubscribe();
          } catch (_) {}
        }

        function applyConsent(consent) {
          if (!consent) return;
          if (consent.analytics) enableAnalytics();
          if (consent.marketing) enableAds();
          if (consent.notifications) {
            enableNtfyPush();
          } else {
            disableNtfyPush();
          }
        }

        function bootConsentScripts() {
          applyConsent(readConsent());
        }

        document.addEventListener("astro:page-load", bootConsentScripts);
        document.addEventListener("cookie:updated", (event) => {
          applyConsent(event.detail);
        });
      })();
    </script>
    <!-- KaTeX CSS : importé seulement par les templates d'article (cf. en-tête de ce fichier). -->

  </head>
  <!-- Service worker + réapplication des préférences après chaque View Transition -->
  <body style={accentColor ? `--page-accent:${accentColor}` : ""}>
    {/* Skip-link "Aller au contenu" retiré (réintroduction : remettre
        <a class="skip-link" href="#main-content">Aller au contenu</a> ici ;
        le CSS .skip-link reste dormant dans global.css). */}
    <Navbar frHref={resolvedFrPath} enHref={enSwitchHref} ptBrHref={ptBrSwitchHref} nlHref={resolvedNlPath} lang={lang} />
    {/* tabindex="-1" : permet au skip-link de poser le focus programmatiquement
       sur <main>, garantissant que les lecteurs d'écran annoncent bien le landmark
       et que les navigateurs ne se contentent pas de scroller sans focuser. */}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
    <SearchOverlay lang={lang} />
    <BackToTop lang={lang} />

    <!-- ── Service Worker + réapplication préférences après View Transitions ── -->
    <script>
      // Enregistrement du service worker (PWA)
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }

      // Langue courante dérivée de l'URL (repli si le helper anti-flash manque).
      function currentLang() {
        if (typeof window.__langFromPath === "function") {
          return window.__langFromPath(location.pathname);
        }
        const p = location.pathname;
        if (p === "/en" || p.indexOf("/en/") === 0) return "en";
        if (p === "/pt-br" || p.indexOf("/pt-br/") === 0) return "pt-br";
        if (p === "/nl" || p.indexOf("/nl/") === 0) return "nl";
        return "fr";
      }

      // Thème + langue réappliqués AVANT la peinture de la nouvelle page
      // (astro:after-swap) : supprime le flash de thème clair ("film blanc") et tout
      // retour au FR pendant la View Transition. Le rendu serveur fait foi par langue ;
      // applyLang ne concerne que le runtime fr/en, donc invoqué uniquement pour EN.
      function applyThemeAndLang() {
        const theme = localStorage.getItem("blogdungaucher.theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;

        const lang = currentLang();
        window.__lang = lang;
        if (lang === "en" && typeof window.__applyLang === "function") {
          window.__applyLang("en");
        }
      }

      // Boutons (état dark + code langue) synchronisés une fois la page chargée.
      function syncNavButtons() {
        const lang = currentLang();
        const isDark = (document.documentElement.dataset.theme || "light") === "dark";
        const dict = (window.__i18n && (window.__i18n[lang] || window.__i18n.fr)) || {};

        const btn = document.getElementById("dark-toggle");
        if (btn) {
          btn.setAttribute("aria-pressed", String(isDark));
          btn.setAttribute("aria-label", isDark
            ? (dict["nav.darkOff"] || "Disable dark mode")
            : (dict["nav.darkOn"] || "Enable dark mode")
          );
        }

        const shortLabel = lang === "pt-br" ? "PT" : lang === "en" ? "EN" : lang === "nl" ? "NL" : "FR";
        const desktopLangSpan = document.querySelector("#lang-toggle .lang-label");
        if (desktopLangSpan) desktopLangSpan.textContent = shortLabel;
      }

      // Avant peinture (transitions) : tue le flash de thème/langue.
      document.addEventListener("astro:after-swap", applyThemeAndLang);
      // Après chargement complet (premier rendu + transitions) : re-sync + boutons.
      document.addEventListener("astro:page-load", function () {
        applyThemeAndLang();
        syncNavButtons();
      });
    </script>

    <!-- ── Scroll reveal - re-déclenché à chaque transition de page ── -->
    <script>
      function initReveal() {
        const revealObs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                revealObs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.08 }
        );
        document.querySelectorAll(".reveal:not(.is-visible)").forEach((el) =>
          revealObs.observe(el)
        );

        const groupObs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                groupObs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.06 }
        );
        document.querySelectorAll(".reveal-group:not(.is-visible)").forEach((el) =>
          groupObs.observe(el)
        );
      }

      // premier chargement + chaque transition Astro
      document.addEventListener("astro:page-load", initReveal);
    </script>

  </body>
</html>
