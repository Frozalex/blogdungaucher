---
import { getEntry } from "astro:content";

import type { BlogEntry } from "../utils/blog";
import { formatDate, formatDateEn, getCategoryMeta, getPostHeroSrc, getPostSlug, getPostUrlLang } from "../utils/blog";
import { t, type Lang } from "../i18n/translations";

const { post, featured = false, lang = "fr" } = Astro.props as {
  post: BlogEntry;
  featured?: boolean;
  lang?: Lang;
};

const category = getCategoryMeta(post.data.category);

// En contexte EN, on récupère le titre / excerpt depuis la traduction si elle
// existe et n'est pas en draft. Sinon on retombe sur le contenu FR.
let postTitle = post.data.title;
let postExcerpt = post.data.excerpt;
if (lang === "en") {
  const enEntry = await getEntry("enTranslations", getPostSlug(post));
  if (enEntry && !enEntry.data.draft) {
    postTitle = enEntry.data.title;
    postExcerpt = enEntry.data.excerpt;
  }
}

// Étiquettes localisées (server-side, indexable par les moteurs).
const categoryLabel = t(lang, `categories.${post.data.category}.label`);
const categoryShortLabel = t(lang, `categories.${post.data.category}.shortLabel`);
const readLabel = t(lang, "card.read");
const formattedDate = lang === "en" ? formatDateEn(post.data.publishDate) : formatDate(post.data.publishDate);

const thumbSrc = getPostHeroSrc(post);
const postHref = await getPostUrlLang(post, lang);
---
<article
  class={`card scale-in ${featured ? "featured" : ""}`}
  style={`--motion-delay: 60ms; --accent:${category.accent};`}
>
  <a href={postHref} class="card-link card-link--thumb">
    <div class="card-thumb-wrap">
      {thumbSrc ? (
        <img
          class="card-thumb"
          src={thumbSrc}
          alt=""
          width="600"
          height="400"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="card-thumb-fallback" aria-hidden="true">
          <span class="card-thumb-fallback__logo" role="presentation"></span>
          <span class="card-thumb-fallback__kicker" data-t={`categories.${post.data.category}.shortLabel`}>
            {categoryShortLabel}
          </span>
        </div>
      )}
    </div>

    <div class="card-body">
    <div class="card-top">
      <span class="card-badge" data-t={`categories.${post.data.category}.label`}>{categoryLabel}</span>
      <span class="card-time">{post.data.readingTime}</span>
    </div>

    <h3 class="card-title">{postTitle}</h3>
    <p class="card-excerpt">{postExcerpt}</p>

    <div class="card-bottom">
      <time datetime={post.data.publishDate.toISOString()} class="card-date">
        {formattedDate}
      </time>
      <span class="card-cta">
        <span data-t="card.read">{readLabel}</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
      </span>
    </div>
    </div>

  </a>
</article>

<style>
  .card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--border-soft);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
    transition:
      transform    260ms var(--ease-spring),
      border-color 220ms ease,
      box-shadow   260ms var(--ease-out);
  }

  /* Filet supérieur catégorie : signature visuelle discrète, révélée au hover. */
  .card::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent),
      transparent
    );
    opacity: 0.55;
    transform: scaleX(0.5);
    transform-origin: center;
    transition:
      opacity 260ms var(--ease-out),
      transform 360ms var(--ease-editorial);
    pointer-events: none;
    z-index: 2;
  }
  .card:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: var(--shadow-md), 0 0 0 1px var(--accent);
  }

  .card::before {
    content: "";
    position: absolute;
    inset: -18% -25% auto auto;
    width: 9rem;
    height: 9rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 16%, transparent), transparent 68%);
    opacity: 0;
    transform: translate3d(8px, -8px, 0);
    transition: opacity var(--motion-medium) var(--ease-soft), transform var(--motion-medium) var(--ease-soft);
    pointer-events: none;
  }
  .card:hover::before {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .card-link {
    display: grid;
    gap: 0.75rem;
    height: 100%;
    padding: 0;
  }

  .card-link--thumb {
    gap: 0;
  }

  .card-thumb-wrap {
    position: relative;
    /* 3/2 plus généreux pour les illustrations pixel art quasi-carrées. */
    aspect-ratio: 3 / 2;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: color-mix(in srgb, var(--text-main) 6%, var(--surface));
  }

  .card-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /**
   * Article sans hero ni og : motif d'échiquier discret + glyphe pièce d'échecs
   * typé par rubrique. Le glyphe + le kicker court différencient visuellement
   * les cartes sans illustration (évite la répétition du même logo).
   */
  .card-thumb-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background-color: color-mix(in srgb, var(--accent) 6%, var(--surface));
    background-image:
      linear-gradient(
        45deg,
        color-mix(in srgb, var(--accent) 14%, transparent) 25%,
        transparent 25%,
        transparent 75%,
        color-mix(in srgb, var(--accent) 14%, transparent) 75%
      ),
      linear-gradient(
        45deg,
        color-mix(in srgb, var(--accent) 14%, transparent) 25%,
        transparent 25%,
        transparent 75%,
        color-mix(in srgb, var(--accent) 14%, transparent) 75%
      );
    background-size: 24px 24px;
    background-position:
      0 0,
      12px 12px;
    overflow: hidden;
  }
  /* Logo du site appliqué en mask-image : la silhouette du SVG public/images/logo.svg
     est colorisée avec la couleur d'accent de la rubrique via background-color.
     C'est la technique la plus simple pour avoir un SVG externe recolorable. */
  .card-thumb-fallback__logo {
    display: block;
    width: clamp(3.5rem, 18vw, 5.75rem);
    aspect-ratio: 625 / 868;
    background-color: color-mix(in srgb, var(--accent) 78%, var(--text-main));
    -webkit-mask-image: url("/images/logo.svg");
    mask-image: url("/images/logo.svg");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    filter: drop-shadow(0 2px 14px color-mix(in srgb, var(--accent) 22%, transparent));
    user-select: none;
    pointer-events: none;
    transform: rotate(-6deg);
    transition: transform 320ms var(--ease-spring), background-color 220ms ease;
  }
  .card-thumb-fallback__kicker {
    position: absolute;
    bottom: 0.55rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent) 80%, var(--text-main));
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    padding: 0.18rem 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    backdrop-filter: blur(2px);
    white-space: nowrap;
    max-width: calc(100% - 1.5rem);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card:hover .card-thumb-fallback__logo {
    transform: rotate(0deg) scale(1.06);
    background-color: var(--accent);
  }
  :global([data-theme="dark"]) .card-thumb-fallback__logo {
    background-color: color-mix(in srgb, var(--accent) 88%, white);
  }
  @media (prefers-reduced-motion: reduce) {
    .card-thumb-fallback__logo {
      transition: none;
    }
    .card:hover .card-thumb-fallback__logo {
      transform: rotate(-6deg);
    }
  }

  .card-body {
    display: grid;
    gap: 0.75rem;
    padding: 1.3rem 1.35rem 1.2rem;
    min-height: 0;
  }

  /* badge + temps */
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .card-time {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  /* titre - serif éditorial */
  .card-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-style: italic;
    font-size: clamp(1.15rem, 1.95vw, 1.45rem);
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--text-main);
    font-optical-sizing: auto;
    transition: color 180ms ease;
  }
  .card:hover .card-title { color: var(--accent); }
  .featured .card-title { font-size: clamp(1.5rem, 2.7vw, 2rem); }

  /* excerpt */
  .card-excerpt {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .featured .card-excerpt { -webkit-line-clamp: 4; }

  /* bas de carte */
  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.7rem;
    border-top: 1px solid var(--border-soft);
    font-size: 0.8rem;
  }

  .card-date { color: var(--text-dim); }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--green);
    font-weight: 600;
    font-size: 0.82rem;
  }
  .card-cta svg {
    transition: transform 220ms var(--ease-spring);
  }
  .card:hover .card-cta svg { transform: translateX(4px); }
</style>
