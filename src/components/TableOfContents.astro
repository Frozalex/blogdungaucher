---
type Heading = { depth: number; slug: string; text: string };
interface Props {headings:Heading[];mode?:"desktop"|"mobile";lang?:"fr"|"en"|"pt-br"|"nl";}
const {headings,lang="fr"}=Astro.props;
const title={fr:"Dans cet article",en:"In this article","pt-br":"Neste artigo",nl:"In dit artikel"}[lang];
const groups:{heading:Heading;children:Heading[]}[]=[];
for(const heading of headings){if(heading.depth===2)groups.push({heading,children:[]});else if(heading.depth===3&&groups.length)groups[groups.length-1].children.push(heading);}
---
{groups.length>0&&<nav class="toc-static" aria-label={title} data-pagefind-ignore>
 <h2>{title}</h2>
 <ol>{groups.map(({heading,children})=><li><a href={`#${heading.slug}`}>{heading.text}</a>{children.length>0&&<ol>{children.map(child=><li><a href={`#${child.slug}`}>{child.text}</a></li>)}</ol>}</li>)}</ol>
</nav>}
<style>
.toc-static{padding:22px;background:var(--bv-tint,var(--bg-warm));border:1px solid var(--border-strong);border-radius:19px;position:static;color:var(--text-main);font-family:var(--font-body)}
.toc-static h2{font:650 20px/1.25 var(--font-body);letter-spacing:-.025em;padding-bottom:16px;margin:0 0 15px;border-bottom:1px solid var(--border-soft)}
.toc-static>ol{list-style:none;counter-reset:section;padding:0;margin:0}
.toc-static>ol>li{counter-increment:section;position:relative;padding:10px 0 10px 25px;border-bottom:1px solid var(--border-soft);font-size:13px;line-height:1.45}
.toc-static>ol>li:before{content:counter(section,decimal-leading-zero);position:absolute;left:0;top:11px;color:var(--green);font-size:11px;font-weight:600}
.toc-static a{color:inherit;text-decoration:none}.toc-static a:hover{text-decoration:underline;text-underline-offset:3px;color:var(--green)}
.toc-static li>ol{padding:6px 0 0 13px;margin:0;list-style:disc;color:var(--text-muted)}.toc-static li>ol li{padding:4px 0;font-size:12px}
@media print{.toc-static{break-inside:avoid}}
</style>
