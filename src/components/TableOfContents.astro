---
type Heading = { depth: number; slug: string; text: string };

const { headings, mode = "desktop", lang = "fr" } = Astro.props as {
  headings: Heading[];
  mode?: "desktop" | "mobile";
  lang?: "fr" | "en" | "pt-br" | "nl";
};

const t =
  lang === "en"
    ? {
        eyebrow: "Contents",
        label: "Jump to a section",
        navMobile: "Mobile table of contents",
        navDesktop: "Table of contents",
        inArticle: "In this article",
      }
    : lang === "pt-br"
      ? {
          eyebrow: "Sumário",
          label: "Ir para uma seção",
          navMobile: "Sumário mobile",
          navDesktop: "Sumário",
          inArticle: "Neste artigo",
        }
      : lang === "nl"
        ? {
            eyebrow: "Inhoud",
            label: "Naar een sectie springen",
            navMobile: "Mobiele inhoudsopgave",
            navDesktop: "Inhoudsopgave",
            inArticle: "In dit artikel",
          }
        : {
            eyebrow: "Sommaire",
            label: "Sauter à une section",
            navMobile: "Table des matières mobile",
          navDesktop: "Table des matières",
          inArticle: "Dans cet article",
        };

/**
 * Sommaire repensé en "rail" minimal :
 *   - Toutes les H2 affichées (plus de limite à 6, plus de "...")
 *   - H3 nestées sous leur H2 parent (indentation visuelle)
 *   - Barre verticale gauche qui suit l'item actif (Vox/Medium style)
 *   - Scrollable si > viewport (overflow-y: auto)
 *
 * Le composant émet 2 structures différentes selon `mode` :
 *   - desktop : <nav> sticky en aside droit
 *   - mobile  : <details> en bandeau collapsible avant le corps
 *
 * Groupement H2 → enfants H3 : on parcourt la liste plate dans l'ordre du document,
 * et on rattache chaque H3 au dernier H2 vu.
 */
type Group = { h2: Heading; children: Heading[] };

const groups: Group[] = [];
for (const h of headings) {
  if (h.depth === 2) {
    groups.push({ h2: h, children: [] });
  } else if (h.depth === 3 && groups.length > 0) {
    groups[groups.length - 1].children.push(h);
  }
}
---
{groups.length > 0 &&
  (mode === "mobile" ? (
    <details class="toc toc-mobile" id="mobile-toc">
      <summary class="toc-mobile__summary">
        <span class="toc-mobile__text">
          <span class="toc-mobile__eyebrow">{t.eyebrow}</span>
          <span class="toc-mobile__label">{t.label}</span>
        </span>
        <span class="toc-mobile__chevron" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </span>
      </summary>
      <nav aria-label={t.navMobile} class="toc-mobile__panel">
        <ol class="toc-list">
          {groups.map((g) => (
            <li class="toc-row toc-row--h2">
              <a href={`#${g.h2.slug}`} class="toc-link" data-slug={g.h2.slug}>
                {g.h2.text}
              </a>
              {g.children.length > 0 && (
                <ol class="toc-sublist">
                  {g.children.map((c) => (
                    <li class="toc-row toc-row--h3">
                      <a href={`#${c.slug}`} class="toc-link toc-link--sub" data-slug={c.slug}>
                        {c.text}
                      </a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ) : (
    <nav class="toc toc-desktop" aria-label={t.navDesktop}>
      <p class="toc-eyebrow">{t.inArticle}</p>
      <ol class="toc-list">
        {groups.map((g) => (
          <li class="toc-row toc-row--h2">
            <a href={`#${g.h2.slug}`} class="toc-link" data-slug={g.h2.slug}>
              {g.h2.text}
            </a>
            {g.children.length > 0 && (
              <ol class="toc-sublist">
                {g.children.map((c) => (
                  <li class="toc-row toc-row--h3">
                    <a href={`#${c.slug}`} class="toc-link toc-link--sub" data-slug={c.slug}>
                      {c.text}
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  ))}

<style>
  /* ──── Rail desktop ────────────────────────────────────────────────
     Style éditorial minimal : pas de carte, juste une liste avec un
     filet vertical à gauche qui se colore sur l'item actif (Vox style).
     Scrollable si dépasse la hauteur disponible. */
  .toc-desktop {
    position: relative;
    padding: 0.5rem 0 0.5rem 1.1rem;
    border-left: 1px solid var(--border-soft);
    max-height: calc(100vh - var(--navbar-h) - 4rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-desktop::before {
    /* Filet "actif" superposé au filet de bordure : suit la position du lien actif via --toc-active-y / --toc-active-h. */
    content: "";
    position: absolute;
    left: -1px;
    top: var(--toc-active-y, 0);
    width: 2px;
    height: var(--toc-active-h, 0);
    background: var(--c, var(--green));
    border-radius: 2px;
    transition: top 220ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
                height 220ms var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
    opacity: 0.95;
  }

  .toc-eyebrow {
    margin: 0 0 0.85rem;
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* ──── Listes ──────────────────────────────────────────────────── */
  .toc-list,
  .toc-sublist {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-row {
    display: block;
  }

  .toc-row--h2 + .toc-row--h2 {
    margin-top: 0.05rem;
  }

  .toc-sublist {
    margin: 0.1rem 0 0.4rem;
    padding-left: 0.85rem;
    border-left: 1px dashed color-mix(in srgb, var(--border-soft) 90%, transparent);
  }

  /* ──── Liens ───────────────────────────────────────────────────── */
  .toc-link {
    display: block;
    padding: 0.32rem 0.55rem 0.32rem 0.5rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--text-muted);
    transition: color 140ms ease, background 140ms ease;
  }

  .toc-link--sub {
    font-size: 0.8rem;
    color: var(--text-dim);
    padding-left: 0.4rem;
  }

  .toc-link:hover {
    color: var(--text-main);
    background: var(--bg-warm);
  }

  .toc-link.active {
    color: var(--c, var(--green));
    font-weight: 500;
    background: color-mix(in srgb, var(--c, var(--green)) 6%, transparent);
  }
  .toc-link--sub.active {
    font-weight: 500;
  }

  /* ──── Mobile : <details> bandeau ──────────────────────────────── */
  .toc-mobile {
    margin: 1rem 0 1.25rem;
    padding: 0;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--c, var(--green)) 18%, var(--border-soft));
    box-shadow: var(--shadow-xs);
    overflow: hidden;
  }

  .toc-mobile__summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.95rem 1.1rem 1rem;
    cursor: pointer;
    transition: background 180ms ease;
  }
  .toc-mobile__summary::-webkit-details-marker {
    display: none;
  }
  .toc-mobile[open] .toc-mobile__summary {
    background: color-mix(in srgb, var(--c, var(--green)) 5%, var(--surface));
  }

  .toc-mobile__text {
    display: grid;
    gap: 0.15rem;
  }

  .toc-mobile__eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c, var(--green));
  }
  .toc-mobile__label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .toc-mobile__chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c, var(--green)) 10%, var(--surface));
    color: var(--c, var(--green));
    flex-shrink: 0;
    transition: transform 220ms var(--ease-spring, cubic-bezier(.34,1.56,.64,1));
  }
  .toc-mobile[open] .toc-mobile__chevron {
    transform: rotate(180deg);
  }

  .toc-mobile__panel {
    padding: 0.5rem 1.1rem 1rem;
    border-top: 1px solid var(--border-soft);
    max-height: 60vh;
    overflow-y: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-desktop::before,
    .toc-link,
    .toc-mobile__chevron {
      transition: none;
    }
  }
</style>

<script>
  let tocObserver: IntersectionObserver | null = null;

  /** Met à jour la position de la barre verticale active dans le rail desktop. */
  function syncActiveBar(navEl: HTMLElement | null, activeLink: HTMLElement | null) {
    if (!navEl) return;
    if (!activeLink) {
      navEl.style.setProperty("--toc-active-h", "0px");
      return;
    }
    // Position relative au rail (navEl), pas au viewport.
    const navRect = navEl.getBoundingClientRect();
    const linkRect = activeLink.getBoundingClientRect();
    const y = linkRect.top - navRect.top + navEl.scrollTop;
    navEl.style.setProperty("--toc-active-y", `${y}px`);
    navEl.style.setProperty("--toc-active-h", `${linkRect.height}px`);
  }

  function initToc() {
    tocObserver?.disconnect();
    const allLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
    if (!allLinks.length) return;

    const desktopNav = document.querySelector<HTMLElement>(".toc-desktop");

    const slugs = Array.from(allLinks)
      .map((l) => l.dataset.slug)
      .filter(Boolean) as string[];
    const headingEls = slugs
      .map((s) => document.getElementById(s))
      .filter(Boolean) as HTMLElement[];

    const setActive = (slug: string) => {
      let activeLink: HTMLAnchorElement | null = null;
      allLinks.forEach((l) => {
        const isActive = l.dataset.slug === slug;
        l.classList.toggle("active", isActive);
        if (isActive && l.closest(".toc-desktop")) activeLink = l;
      });
      syncActiveBar(desktopNav, activeLink);

      // Auto-scroll du rail pour garder l'item actif visible
      if (activeLink && desktopNav) {
        const navRect  = desktopNav.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        const isAbove  = linkRect.top < navRect.top + 32;
        const isBelow  = linkRect.bottom > navRect.bottom - 32;
        if (isAbove || isBelow) {
          activeLink.scrollIntoView({ block: "nearest", behavior: "smooth" });
        }
      }
    };

    tocObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && e.target && (e.target as HTMLElement).id) {
            setActive((e.target as HTMLElement).id);
          }
        });
      },
      { rootMargin: "-15% 0% -70% 0%", threshold: 0 },
    );

    headingEls.forEach((el) => tocObserver!.observe(el));

    // Sync initial : si l'utilisateur revient sur la page via back, on positionne la barre.
    requestAnimationFrame(() => {
      const initialActive = document.querySelector<HTMLAnchorElement>(".toc-desktop .toc-link.active");
      syncActiveBar(desktopNav, initialActive);
    });

    // Resync à chaque resize (les positions verticales changent).
    const onResize = () => {
      const currentActive = document.querySelector<HTMLAnchorElement>(".toc-desktop .toc-link.active");
      syncActiveBar(desktopNav, currentActive);
    };
    window.addEventListener("resize", onResize, { passive: true });
  }

  document.addEventListener("astro:page-load", initToc);
</script>
