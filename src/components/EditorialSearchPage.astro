---
import EditorialLocaleMasthead from "./EditorialLocaleMasthead.astro";
import { categoryMap, categorySlugs } from "../data/site";
import { editorialUi } from "../data/editorial-ui";
import { filterPostsForLang, getAllPosts } from "../utils/blog";
import { t } from "../i18n/translations";
import type { SiteLang } from "../utils/lang-paths";
import "../styles/editorial-resources.css";
interface Props { lang: SiteLang; }
const { lang } = Astro.props;
const L = editorialUi(lang);
const count = filterPostsForLang(await getAllPosts(),lang).length;
const categories = categorySlugs.filter(slug=>lang==="fr"||slug!=="grand-oral");
---
<div class="resource-page"><div class="container" data-editorial-search data-lang={lang} data-index={`/${"blog-index"}/${lang}.json`}>
  <header><EditorialLocaleMasthead lang={lang} active="search" /><div class="resource-heading"><span class="resource-kicker">{L.searchKicker} · {count} {L.articles}</span><h1>{L.search}</h1><p>{L.searchIntro}</p></div></header>
  <section class="search-tools" aria-labelledby="search-tools-title"><h2 id="search-tools-title" class="resource-kicker">{L.find}</h2>
    <form class="search-form" role="search"><label class="resource-sr-only" for="search-input">{L.searchLabel}</label><div class="search-box"><input id="search-input" class="resource-field" name="q" type="search" placeholder={L.searchPlaceholder} autocomplete="off" spellcheck="false" aria-describedby="search-kbd-hint" aria-controls="search-results" /><button id="search-clear" type="button" aria-label={L.clear} hidden>×</button></div><button type="submit" class="resource-button">{L.search}</button></form>
    <p id="search-kbd-hint" class="search-kbd-hint">{L.hint}</p>
    <div class="resource-filter search-filters" role="group" aria-label={L.filters}><button type="button" class="filter-chip active" data-cat="" aria-pressed="true">{L.allCategories}</button>{categories.map(slug=><button type="button" class="filter-chip" data-cat={slug} aria-pressed="false" style={`--c:${categoryMap[slug].accent}`}><i aria-hidden="true"></i>{t(lang,`categories.${slug}.label`)}</button>)}</div>
  </section>
  <section class="search-output" aria-labelledby="search-results-title"><div class="resource-section-head"><h2 id="search-results-title">{L.results}</h2><p id="search-state" aria-live="polite" aria-atomic="true">{L.start}</p></div>
    <div class="search-guide" data-search-guide><h3>{L.emptyTitle}</h3><p>{L.emptyIntro}</p><div class="search-suggestions">{L.suggestions.map(query=><button type="button" data-query={query}>{query} <span aria-hidden="true">↗</span></button>)}</div></div>
    <p class="search-no-results" data-search-empty hidden>{L.noResultsHint}</p><button type="button" class="resource-button" data-search-retry hidden>{L.retry}</button>
    <ul id="search-results" class="search-results"></ul><button type="button" class="resource-button search-more" data-search-more hidden>{L.more}</button>
    <noscript><p>{L.noJs} <a class="resource-link" href={`/${lang}/blog/`}>{L.all} →</a></p></noscript>
  </section>
  <div class="resource-end"><span>{L.follow}</span><a class="resource-link" href={`/${lang}/blog/`}>{L.all} →</a>{lang!=="nl"&&<a class="resource-link" href={`/${lang}/series/`}>{L.exploreSeries} →</a>}</div>
  <template id="search-result-template"><li class="search-result"><article><a class="search-result__link"><div class="search-result__body"><span class="search-result__cat"></span><h3 class="search-result__title"></h3><p class="search-result__excerpt"></p><p class="search-result__meta"></p></div><div class="search-result__visual"><img width="480" height="320" loading="lazy" sizes="(max-width: 639px) 96px, 180px" /></div></a><p class="search-result__credit" hidden><span data-credit></span><a data-source target="_blank" rel="noopener noreferrer">{L.source} ↗</a><span data-license></span></p></article></li></template>
</div></div>
<style>
.search-tools{border-top:2px solid var(--text-main);padding:1.1rem 0 1.75rem;}.search-tools h2{font-family:var(--font-body);margin:0 0 1rem;}.search-form{display:flex;gap:.65rem;max-width:58rem;}.search-box{position:relative;flex:1;min-width:0;}#search-input::-webkit-search-cancel-button{appearance:none;}#search-input{width:100%;min-height:3.2rem;padding:.9rem 3rem .9rem 1rem;font-size:1rem;}#search-clear{position:absolute;right:.3rem;top:50%;transform:translateY(-50%);width:2.75rem;height:2.75rem;border:0;background:transparent;color:var(--text-muted);font-size:1.5rem;cursor:pointer;}.search-kbd-hint{font-size:.72rem;color:var(--text-dim);margin:.65rem 0 1.25rem;}.search-filters button{display:flex;align-items:center;gap:.5rem;min-height:2.75rem;}.search-filters i{width:6px;height:6px;border-radius:50%;background:var(--c);}.search-filters button[aria-pressed="true"] i{background:var(--on-green);}.search-output{border-top:1px solid var(--border-strong);padding-top:1.25rem;margin-bottom:2rem;min-height:15rem;}#search-state{font-size:.78rem;color:var(--text-dim);margin:0;}.search-guide{padding:1.5rem 0 2rem;}.search-guide h3{font:600 1.9rem/1.2 var(--font-serif);letter-spacing:-.03em;margin:0 0 .7rem;}.search-guide p{max-width:60ch;line-height:1.7;font-size:.95rem;color:var(--text-muted);}.search-suggestions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.25rem;}.search-suggestions button{display:flex;align-items:center;gap:1rem;border:0;border-bottom:1px solid var(--border-strong);background:transparent;color:var(--green);padding:.7rem .2rem;min-height:2.75rem;font:inherit;font-size:.85rem;cursor:pointer;}.search-results{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr;}.search-result{padding:1.5rem 0;border-bottom:1px solid var(--border-strong);}.search-result__link{display:grid;grid-template-columns:minmax(0,1fr) 180px;gap:2rem;align-items:start;max-width:62rem;}.search-result__link.is-active{outline:2px solid var(--green);outline-offset:7px;}.search-result__body{min-width:0;}.search-result__cat{display:block;color:var(--green);font-size:.65rem;text-transform:uppercase;letter-spacing:.1em;font-weight:650;margin-bottom:.65rem;}.search-result__title{font:600 clamp(1.35rem,2.3vw,1.8rem)/1.2 var(--font-serif);letter-spacing:-.025em;margin:0;}.search-result__link:hover h3{color:var(--green);}.search-result__excerpt{color:var(--text-muted);font-size:.92rem;line-height:1.7;margin:.75rem 0 0;}.search-result__excerpt :global(mark){background:var(--green-light);color:var(--text-main);padding:0 .1rem;}.search-result__meta{font-size:.72rem;color:var(--text-dim);margin:.8rem 0 0;}.search-result__visual{aspect-ratio:3/2;border-radius:3px;overflow:hidden;background:var(--bg-warm);}.search-result__visual img{width:100%;height:100%;display:block;object-fit:cover;}.search-result--plain .search-result__link{grid-template-columns:1fr;}.search-result__credit{display:flex;flex-wrap:wrap;gap:.25rem .65rem;color:var(--text-dim);font-size:.63rem;margin:.65rem 0 0;}.search-result__credit a{text-decoration:underline;text-underline-offset:.2em;}.search-no-results{color:var(--text-muted);font-size:.95rem;line-height:1.7;margin:2rem 0;}.search-more{margin-top:1.5rem;}
@media(max-width:639px){.search-output .resource-section-head{align-items:start;flex-direction:column;gap:.75rem;}.search-form{gap:.4rem;}.search-form>.resource-button{padding:.8rem .7rem;font-size:.82rem;}#search-input{font-size:.9rem;padding-left:.7rem;}.search-kbd-hint{font-size:.65rem;line-height:1.7;}.search-filters{margin-top:1rem;}.search-filters button{font-size:.78rem;padding:.5rem .6rem;}.search-result__link{grid-template-columns:minmax(0,1fr) 96px;gap:1rem;}.search-result__title{font-size:1.3rem;}.search-result__excerpt{font-size:.86rem;}.search-guide{padding-top:1rem;}}
</style>
<style>
  /* Le texte français passe de quatre à trois lignes après chargement de la police. */
  @media (max-width: 360px) {
    [data-editorial-search][data-lang="fr"] .resource-heading > p { min-block-size: 4lh; }
  }
</style>
<script>import "../scripts/editorial-search";</script>
