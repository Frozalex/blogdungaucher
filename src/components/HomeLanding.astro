---
import AdBanner from "./AdBanner.astro";
import ArticleCard from "./ArticleCard.astro";
import { categoryMap, categorySlugs } from "../data/site";
import { swapLangPrefix } from "../utils/lang-paths";
import type { BlogEntry } from "../utils/blog";

interface Props {
  lang: "fr" | "en" | "pt-br" | "nl";
  latestPosts: BlogEntry[];
  totalPosts: number;
  postsByCategory?: Partial<Record<(typeof categorySlugs)[number], number>>;
}

const { lang, latestPosts, totalPosts, postsByCategory = {} } = Astro.props;
const blogHref = `/${lang}/blog/`;

type HomeCopy = {
  eyebrow: string;
  titleLine1: string;
  titleAccent: string;
  titleLine2: string;
  lead: string;
  startReading: string;
  seeSections: string;
  proof1: string;
  proof2: string;
  proof3: string;
  featuredEyebrow: string;
  allPostsTitle: string;
  tabAll: string;
  searchPlaceholder: string;
  seeAll: string;
  noResults: string;
};

const homeByLang: Record<"fr" | "en" | "pt-br" | "nl", HomeCopy> = {
  fr: {
    eyebrow: "",
    titleLine1: "Un blog sur",
    titleAccent: "les échecs",
    titleLine2: "",
    lead: "Deux articles par semaine : des analyses claires sur la science du jeu, le mental compétitif et l'impact des échecs dans la société.",
    startReading: "Commencer la lecture",
    seeSections: "Voir les rubriques",
    proof1: `${totalPosts}+ analyses publiées`,
    proof2: "2 articles / semaine",
    proof3: "Sources citées, 0 clickbait",
    featuredEyebrow: "À la une",
    allPostsTitle: "Tous les articles",
    tabAll: "Tout",
    searchPlaceholder: "Chercher un article…",
    seeAll: "Voir tout →",
    noResults: "Aucun article trouvé.",
  },
  en: {
    eyebrow: "Independent editorial",
    titleLine1: "Understanding",
    titleAccent: "chess",
    titleLine2: "without oversimplifying.",
    lead: "Two articles every week: clear analyses on game science, the competitive mindset and the impact of chess on society.",
    startReading: "Start reading",
    seeSections: "See sections",
    proof1: `${totalPosts}+ analyses published`,
    proof2: "2 articles / week",
    proof3: "Cited sources, 0 clickbait",
    featuredEyebrow: "Featured",
    allPostsTitle: "All articles",
    tabAll: "All",
    searchPlaceholder: "Search articles…",
    seeAll: "See all →",
    noResults: "No articles found.",
  },
  "pt-br": {
    eyebrow: "Editorial independente",
    titleLine1: "Entendendo o",
    titleAccent: "xadrez",
    titleLine2: "sem simplificar o jogo.",
    lead: "Dois artigos por semana: análises claras sobre a ciência do jogo, a mentalidade competitiva e o impacto do xadrez na sociedade.",
    startReading: "Começar a ler",
    seeSections: "Ver as seções",
    proof1: `${totalPosts}+ análises publicadas`,
    proof2: "2 artigos / semana",
    proof3: "Fontes citadas, 0 clickbait",
    featuredEyebrow: "Destaque",
    allPostsTitle: "Todos os artigos",
    tabAll: "Todos",
    searchPlaceholder: "Buscar artigos…",
    seeAll: "Ver tudo →",
    noResults: "Nenhum artigo encontrado.",
  },
  nl: {
    eyebrow: "Onafhankelijk redactioneel",
    titleLine1: "Schaken begrijpen",
    titleAccent: "zonder",
    titleLine2: "het spel te vereenvoudigen.",
    lead: "Twee artikelen per week: heldere analyses over schaakwetenschap, competitieve mindset en de impact van schaken op de samenleving.",
    startReading: "Begin met lezen",
    seeSections: "Bekijk de rubrieken",
    proof1: `${totalPosts}+ gepubliceerde analyses`,
    proof2: "2 artikelen / week",
    proof3: "Bronnen vermeld, 0 clickbait",
    featuredEyebrow: "Uitgelicht",
    allPostsTitle: "Alle artikelen",
    tabAll: "Alles",
    searchPlaceholder: "Zoek artikelen…",
    seeAll: "Alles bekijken →",
    noResults: "Geen artikelen gevonden.",
  },
};

const c = homeByLang[lang];

const featuredPost = latestPosts[0];
const gridPosts = latestPosts.slice(1);

const articleCountLabel = (n: number): string => {
  if (lang === "en") return `${n} ${n > 1 ? "articles" : "article"}`;
  if (lang === "pt-br") return `${n} ${n > 1 ? "artigos" : "artigo"}`;
  if (lang === "nl") return `${n} ${n > 1 ? "artikelen" : "artikel"}`;
  return `${n} ${n > 1 ? "articles" : "article"}`;
};

const sectionsId = lang === "en" ? "sections" : "rubriques";
---

<div class="home-landing">

  <!-- ════════════════════════════════════════════
       HERO — texte centré sur la largeur du contenu
  ════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="home-hero-heading">
    <div class="hero__blobs" aria-hidden="true">
      <span class="hero__blob hero__blob--a"></span>
      <span class="hero__blob hero__blob--b"></span>
    </div>
    <div class="container hero__inner">
      <div class="hero__text">
        {c.eyebrow && <span class="eyebrow hero__eyebrow">{c.eyebrow}</span>}
        <h1 id="home-hero-heading" class="hero__title">
          {c.titleLine1} <span class="hero__accent">{c.titleAccent}</span><br/>
          {c.titleLine2}
        </h1>
        <p class="hero__lead">{c.lead}</p>
        <div class="hero__actions">
          <a href={blogHref} class="button-primary">{c.startReading}</a>
          <a href={`#${sectionsId}`} class="button-secondary">{c.seeSections}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       REPÈRES ÉDITORIAUX — un chiffre-phare + 3 mesures,
       façon page "in numbers" d'un magazine (pas une grille SaaS)
  ════════════════════════════════════════════ -->
  <section class="stats-section" aria-labelledby="stats-heading">
    <div class="container stats-section__inner">
      <div class="stats-section__head">
        <span class="stats-section__bolt" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 11-14h-7l1-6Z"/></svg>
        </span>
        <h2 id="stats-heading" class="stats-section__title">{lang === "en" ? "Honest, sourced writing." : lang === "pt-br" ? "Escrita honesta e referenciada." : lang === "nl" ? "Eerlijk, gebronneerd schrijven." : "Une écriture honnête, sourcée."}</h2>
        <p class="stats-section__sub">{lang === "en" ? "Our editorial process keeps every article accountable: checking sources, cutting filler, and respecting the reader's time so you can focus on what actually helps you improve." : lang === "pt-br" ? "Nosso processo editorial mantém cada artigo responsável: verificando fontes, cortando enrolação e respeitando o tempo do leitor para você focar no que realmente ajuda a melhorar." : lang === "nl" ? "Ons redactionele proces houdt elk artikel verantwoordelijk: bronnen controleren, opvulling schrappen en de tijd van de lezer respecteren, zodat jij je kunt richten op wat je echt vooruit helpt." : "Notre processus éditorial tient chaque article responsable : sources vérifiées, remplissage coupé, temps du lecteur respecté, pour se concentrer sur ce qui fait vraiment progresser."}</p>
      </div>

      <div class="stats-grid" aria-label="Repères éditoriaux">
        <div class="stat-tile stat-tile--wide stat-tile--a">
          <span class="stat-tile__value">{totalPosts}+</span>
          <span class="stat-tile__label">{lang === "en" ? "Analyses published" : lang === "pt-br" ? "Análises publicadas" : lang === "nl" ? "Analyses gepubliceerd" : "Analyses publiées"}</span>
        </div>
        <div class="stat-tile stat-tile--wide stat-tile--b">
          <span class="stat-tile__value">2 / {lang === "en" ? "week" : lang === "pt-br" ? "sem." : lang === "nl" ? "week" : "sem."}</span>
          <span class="stat-tile__label">{lang === "en" ? "Publishing rhythm" : lang === "pt-br" ? "Ritmo de publicação" : lang === "nl" ? "Publicatieritme" : "Rythme de publication"}</span>
        </div>
        <div class="stat-tile stat-tile--c">
          <span class="stat-tile__value">100%</span>
          <span class="stat-tile__label">{lang === "en" ? "Sources cited" : lang === "pt-br" ? "Fontes citadas" : lang === "nl" ? "Bronnen vermeld" : "Sources citées"}</span>
        </div>
        <div class="stat-tile stat-tile--photo" aria-hidden="true"></div>
        <div class="stat-tile stat-tile--e">
          <span class="stat-tile__value">0</span>
          <span class="stat-tile__label">Clickbait</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       ARTICLE EN UNE — carte horizontale
  ════════════════════════════════════════════ -->
  {featuredPost && (
    <section class="featured-section">
      <div class="container">
        <div class="featured-showcase reveal">
          <ArticleCard post={featuredPost} featured={true} lang={lang} />
        </div>
      </div>
    </section>
  )}

  <div class="container">
    <AdBanner format="leaderboard" />
  </div>

  <!-- ════════════════════════════════════════════
       RUBRIQUES — pillar grid (compact, horizontal)
  ════════════════════════════════════════════ -->
  <section class="pillars" id={sectionsId} aria-labelledby="pillars-heading">
    <div class="container">
      <div class="pillars__head">
        <span class="eyebrow">{lang === "en" ? "(Sections)" : lang === "pt-br" ? "(Seções)" : lang === "nl" ? "(Rubrieken)" : "(Rubriques)"}</span>
        <h2 id="pillars-heading" class="pillars__title">{lang === "en" ? "Four angles to explore the game" : lang === "pt-br" ? "Quatro ângulos para explorar o jogo" : lang === "nl" ? "Vier invalshoeken om het spel te verkennen" : "Quatre angles pour explorer le jeu"}</h2>
      </div>

      <div class="pillars__grid reveal-group">
        {categorySlugs.filter((slug) => lang === "fr" || slug !== "grand-oral").map((slug) => {
          const cat = categoryMap[slug];
          const href = lang === "fr" ? cat.href : swapLangPrefix(cat.href, lang);
          const count = postsByCategory[slug] ?? 0;
          return (
            <a href={href} class="feature-card" style={`--fc:${cat.accent};`}>
              <span class="feature-card__icon">
                {slug === "science" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>
                    <ellipse cx="12" cy="12" rx="9" ry="3.8"/>
                    <ellipse cx="12" cy="12" rx="9" ry="3.8" transform="rotate(60 12 12)"/>
                    <ellipse cx="12" cy="12" rx="9" ry="3.8" transform="rotate(120 12 12)"/>
                  </svg>
                )}
                {slug === "esprit" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="8.2"/>
                    <circle cx="12" cy="12" r="4.6"/>
                    <circle cx="12" cy="12" r="1.1" fill="currentColor" stroke="none"/>
                  </svg>
                )}
                {slug === "societe" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M17 20v-1.5a4 4 0 0 0-4-4h-2a4 4 0 0 0-4 4V20"/>
                    <circle cx="12" cy="8.2" r="3.2"/>
                    <path d="M21.5 20v-1.2a3.6 3.6 0 0 0-2.5-3.4"/>
                    <path d="M2.5 20v-1.2a3.6 3.6 0 0 1 2.5-3.4"/>
                  </svg>
                )}
                {slug === "grand-oral" && (
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 9.5 12 4.5 2 9.5l10 5 10-5Z"/>
                    <path d="M6 11.8v4.3c0 1.5 2.7 3.1 6 3.1s6-1.6 6-3.1v-4.3"/>
                  </svg>
                )}
              </span>
              <h3 class="feature-card__title">{cat.shortLabel}</h3>
              <p class="feature-card__text">{cat.tagline}</p>
              <span class="feature-card__meta">
                <span>{count > 0 ? articleCountLabel(count) : (lang === "en" ? "Explore" : lang === "pt-br" ? "Explorar" : lang === "nl" ? "Verkennen" : "Explorer")}</span>
                <svg class="feature-card__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       PROMO SPLIT A — texte + checklist | visuel
       (rythme repris de paynexus-template : sections alternées
       texte/checklist + carte illustrative, adaptées à notre contenu)
  ════════════════════════════════════════════ -->
  <section class="promo-split" aria-labelledby="promo-a-heading">
    <div class="container promo-split__inner">
      <div class="promo-split__text">
        <span class="eyebrow">{lang === "en" ? "(Method)" : lang === "pt-br" ? "(Método)" : lang === "nl" ? "(Methode)" : "(Méthode)"}</span>
        <h2 id="promo-a-heading" class="promo-split__title">{lang === "en" ? "A method, not an algorithm" : lang === "pt-br" ? "Um método, não um algoritmo" : lang === "nl" ? "Een methode, geen algoritme" : "Une méthode, pas un algorithme"}</h2>
        <ul class="promo-checklist">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{lang === "en" ? "Every scientific claim is sourced and dated" : lang === "pt-br" ? "Toda afirmação científica é referenciada e datada" : lang === "nl" ? "Elke wetenschappelijke claim is gebronneerd en gedateerd" : "Chaque affirmation scientifique est sourcée et datée"}</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{lang === "en" ? "No content generated just to fill a calendar" : lang === "pt-br" ? "Nenhum conteúdo gerado só para preencher um calendário" : lang === "nl" ? "Geen content gegenereerd om een kalender te vullen" : "Aucun contenu généré juste pour remplir un calendrier"}</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{lang === "en" ? "Two articles a week, not one more, not one less" : lang === "pt-br" ? "Dois artigos por semana, nem mais, nem menos" : lang === "nl" ? "Twee artikelen per week, niet meer, niet minder" : "Deux articles par semaine, pas un de plus"}</span>
          </li>
        </ul>
      </div>
      <div class="promo-split__visual" aria-hidden="true">
        <div class="promo-card promo-card--source">
          <span class="promo-card__eyebrow">{lang === "en" ? "Cited source" : lang === "pt-br" ? "Fonte citada" : lang === "nl" ? "Geciteerde bron" : "Source citée"}</span>
          <p class="promo-card__quote">“Mindfulness practice leads to increases in regional brain gray matter density.”</p>
          <span class="promo-card__cite">Hölzel et al., 2011, Psychiatry Research</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       PROMO SPLIT B — visuel | texte + checklist (sens inversé)
  ════════════════════════════════════════════ -->
  <section class="promo-split promo-split--reverse" aria-labelledby="promo-b-heading">
    <div class="container promo-split__inner">
      <div class="promo-split__text">
        <span class="eyebrow">{lang === "en" ? "(Reading experience)" : lang === "pt-br" ? "(Experiência de leitura)" : lang === "nl" ? "(Leeservaring)" : "(Expérience de lecture)"}</span>
        <h2 id="promo-b-heading" class="promo-split__title">{lang === "en" ? "Built so you actually finish reading" : lang === "pt-br" ? "Feito para você terminar de ler" : lang === "nl" ? "Ontworpen om het artikel echt uit te lezen" : "Conçu pour qu'on aille jusqu'au bout"}</h2>
        <ul class="promo-checklist">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{lang === "en" ? "Clickable table of contents at the start" : lang === "pt-br" ? "Sumário clicável no início" : lang === "nl" ? "Klikbare inhoudsopgave aan het begin" : "Sommaire cliquable en début d'article"}</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{lang === "en" ? "Key takeaways before the FAQ, to keep what matters" : lang === "pt-br" ? "O essencial antes do FAQ, para reter o que importa" : lang === "nl" ? "Het essentiële vóór de FAQ, om het belangrijkste te onthouden" : "L'essentiel avant la FAQ, pour retenir ce qui compte"}</span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span>{lang === "en" ? "Personalized suggestions at the end of each article" : lang === "pt-br" ? "Sugestões personalizadas no fim de cada artigo" : lang === "nl" ? "Persoonlijke suggesties aan het einde van elk artikel" : "Suggestions personnalisées en fin de lecture"}</span>
          </li>
        </ul>
      </div>
      <div class="promo-split__visual" aria-hidden="true">
        <div class="promo-card promo-card--stack">
          <div class="promo-mini-card" style="--pc:#5b9fd4">
            <span>Science du jeu</span>
            <strong>Échecs et sommeil</strong>
          </div>
          <div class="promo-mini-card promo-mini-card--offset" style="--pc:#f0a050">
            <span>Esprit compétitif</span>
            <strong>Le syndrome de l'imposteur</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       TOUS LES ARTICLES — onglets + recherche + grille (style Appux)
  ════════════════════════════════════════════ -->
  <section class="allposts">
    <div class="container">

      <!-- En-tête : titre gauche, actions droite -->
      <div class="allposts__header reveal">
        <h2 class="allposts__title">{c.allPostsTitle}</h2>
        <div class="allposts__controls">
          <!-- Onglets -->
          <div class="allposts__tabs" role="tablist" aria-label="Filtrer par rubrique">
            <button class="tab active" data-filter="all" role="tab" aria-selected="true">{c.tabAll}</button>
            {categorySlugs.filter((slug) => lang === "fr" || slug !== "grand-oral").map((slug) => (
              <button
                class="tab"
                data-filter={slug}
                role="tab"
                aria-selected="false"
                style={`--tab-accent: ${categoryMap[slug].accent}`}
              >{categoryMap[slug].shortLabel}</button>
            ))}
          </div>
          <!-- Recherche -->
          <div class="allposts__search-wrap">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input
              type="search"
              class="allposts__search"
              placeholder={c.searchPlaceholder}
              aria-label={c.searchPlaceholder}
            />
          </div>
        </div>
      </div>

      <!-- Grille d'articles -->
      <div class="allposts__grid reveal-group">
        {gridPosts.map((post) => (
          <div
            class="post-wrapper"
            data-category={post.data.category}
            data-title={post.data.title.toLowerCase()}
            data-excerpt={(post.data.excerpt ?? "").toLowerCase()}
          >
            <ArticleCard post={post} featured={false} lang={lang} />
          </div>
        ))}
      </div>

      <p class="allposts__empty" aria-live="polite" style="display:none">{c.noResults}</p>

      <div class="allposts__see-all reveal">
        <a href={blogHref} class="see-all-btn">{c.seeAll}</a>
      </div>

    </div>
  </section>

</div>

<style>
  .home-landing {
    overflow-x: clip;
    /* Le hero sert de gabarit : toutes les sections statiques de la
       landing (hero, chiffres, promos, rubriques, en une) partagent
       cette même hauteur minimale pour un rythme vertical régulier. */
    --section-h: 38rem;
  }

  @media (max-width: 760px) {
    .home-landing { --section-h: auto; }
  }

  /* ════════════════════════════════════════════
     HERO — gabarit de hauteur pour les autres sections
  ════════════════════════════════════════════ */
  .hero {
    position: relative;
    min-height: var(--section-h);
    display: grid;
    align-items: center;
    padding: calc(var(--navbar-h) + 2rem) 0 2rem;
    background: var(--bg);
    overflow: clip;
  }

  /* Formes abstraites floutées en fond, façon "gradient blobs" —
     idée reprise du site de référence, réinterprétée en tons sombres
     avec les couleurs de la charte plutôt que du bleu SaaS générique. */
  .hero__blobs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
  }

  .hero__blob--a {
    top: -12%;
    left: 8%;
    width: 26rem;
    height: 26rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--green) 22%, transparent), transparent 70%);
  }

  .hero__blob--b {
    top: 10%;
    right: -8%;
    width: 22rem;
    height: 22rem;
    background: radial-gradient(circle, color-mix(in srgb, #5b9fd4 16%, transparent), transparent 70%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 44rem;
    margin-inline: auto;
    text-align: center;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__eyebrow {
    margin-bottom: 0.4rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5.5vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
