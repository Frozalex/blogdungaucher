---
import AdBanner from "./AdBanner.astro";
import ArticleCard from "./ArticleCard.astro";
import { categoryMap, categorySlugs } from "../data/site";
import { swapLangPrefix } from "../utils/lang-paths";
import type { BlogEntry } from "../utils/blog";

interface Props {
  lang: "fr" | "en" | "pt-br" | "nl";
  latestPosts: BlogEntry[];
  totalPosts: number;
  postsByCategory?: Partial<Record<(typeof categorySlugs)[number], number>>;
}

const { lang, latestPosts, totalPosts, postsByCategory = {} } = Astro.props;
const blogHref = `/${lang}/blog/`;

type HomeCopy = {
  eyebrow: string;
  titleLine1: string;
  titleAccent: string;
  titleLine2: string;
  lead: string;
  startReading: string;
  seeSections: string;
  proof1: string;
  proof2: string;
  proof3: string;
  featuredEyebrow: string;
  allPostsTitle: string;
  tabAll: string;
  searchPlaceholder: string;
  seeAll: string;
  noResults: string;
};

const homeByLang: Record<"fr" | "en" | "pt-br" | "nl", HomeCopy> = {
  fr: {
    eyebrow: "",
    titleLine1: "Un blog sur",
    titleAccent: "les échecs",
    titleLine2: "",
    lead: "Deux articles par semaine : des analyses claires sur la science du jeu, le mental compétitif et l'impact des échecs dans la société.",
    startReading: "Commencer la lecture",
    seeSections: "Voir les rubriques",
    proof1: `${totalPosts}+ analyses publiées`,
    proof2: "2 articles / semaine",
    proof3: "Sources citées, 0 clickbait",
    featuredEyebrow: "À la une",
    allPostsTitle: "Tous les articles",
    tabAll: "Tout",
    searchPlaceholder: "Chercher un article…",
    seeAll: "Voir tout →",
    noResults: "Aucun article trouvé.",
  },
  en: {
    eyebrow: "Independent editorial",
    titleLine1: "Understanding",
    titleAccent: "chess",
    titleLine2: "without oversimplifying.",
    lead: "Two articles every week: clear analyses on game science, the competitive mindset and the impact of chess on society.",
    startReading: "Start reading",
    seeSections: "See sections",
    proof1: `${totalPosts}+ analyses published`,
    proof2: "2 articles / week",
    proof3: "Cited sources, 0 clickbait",
    featuredEyebrow: "Featured",
    allPostsTitle: "All articles",
    tabAll: "All",
    searchPlaceholder: "Search articles…",
    seeAll: "See all →",
    noResults: "No articles found.",
  },
  "pt-br": {
    eyebrow: "Editorial independente",
    titleLine1: "Entendendo o",
    titleAccent: "xadrez",
    titleLine2: "sem simplificar o jogo.",
    lead: "Dois artigos por semana: análises claras sobre a ciência do jogo, a mentalidade competitiva e o impacto do xadrez na sociedade.",
    startReading: "Começar a ler",
    seeSections: "Ver as seções",
    proof1: `${totalPosts}+ análises publicadas`,
    proof2: "2 artigos / semana",
    proof3: "Fontes citadas, 0 clickbait",
    featuredEyebrow: "Destaque",
    allPostsTitle: "Todos os artigos",
    tabAll: "Todos",
    searchPlaceholder: "Buscar artigos…",
    seeAll: "Ver tudo →",
    noResults: "Nenhum artigo encontrado.",
  },
  nl: {
    eyebrow: "Onafhankelijk redactioneel",
    titleLine1: "Schaken begrijpen",
    titleAccent: "zonder",
    titleLine2: "het spel te vereenvoudigen.",
    lead: "Twee artikelen per week: heldere analyses over schaakwetenschap, competitieve mindset en de impact van schaken op de samenleving.",
    startReading: "Begin met lezen",
    seeSections: "Bekijk de rubrieken",
    proof1: `${totalPosts}+ gepubliceerde analyses`,
    proof2: "2 artikelen / week",
    proof3: "Bronnen vermeld, 0 clickbait",
    featuredEyebrow: "Uitgelicht",
    allPostsTitle: "Alle artikelen",
    tabAll: "Alles",
    searchPlaceholder: "Zoek artikelen…",
    seeAll: "Alles bekijken →",
    noResults: "Geen artikelen gevonden.",
  },
};

const c = homeByLang[lang];

const featuredPost = latestPosts[0];
const gridPosts = latestPosts.slice(1);

const articleCountLabel = (n: number): string => {
  if (lang === "en") return `${n} ${n > 1 ? "articles" : "article"}`;
  if (lang === "pt-br") return `${n} ${n > 1 ? "artigos" : "artigo"}`;
  if (lang === "nl") return `${n} ${n > 1 ? "artikelen" : "artikel"}`;
  return `${n} ${n > 1 ? "articles" : "article"}`;
};

const sectionsId = lang === "en" ? "sections" : "rubriques";
---

<div class="home-landing">

  <!-- ════════════════════════════════════════════
       HERO — 2 colonnes : texte gauche, déco droite
  ════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="home-hero-heading">
    <div class="container hero__inner">

      <!-- Colonne texte -->
      <div class="hero__text">
        {c.eyebrow && <span class="eyebrow hero__eyebrow">{c.eyebrow}</span>}
        <h1 id="home-hero-heading" class="hero__title">
          {c.titleLine1} <span class="hero__accent">{c.titleAccent}</span><br/>
          {c.titleLine2}
        </h1>
        <p class="hero__lead">{c.lead}</p>
        <div class="hero__actions">
          <a href={blogHref} class="button-primary">{c.startReading}</a>
          <a href={`#${sectionsId}`} class="button-secondary">{c.seeSections}</a>
        </div>
        <ul class="hero__proof" aria-label="Repères éditoriaux">
          <li>{c.proof1}</li>
          <li>{c.proof2}</li>
          <li>{c.proof3}</li>
        </ul>
      </div>

      <!-- Colonne déco : pièce d'échecs illustrative (comme la 3D Appux) -->
      <div class="hero__deco" aria-hidden="true">
        <div class="hero__deco-card">
          <span class="hero__deco-glyph">♛</span>
          <div class="hero__deco-board">
            <svg width="100%" height="100%" viewBox="0 0 8 8" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
              {[...Array(8)].map((_, r) =>
                [...Array(8)].map((_, cc) => (
                  <rect x={cc} y={r} width="1" height="1"
                    fill={(r + cc) % 2 === 0 ? "currentColor" : "transparent"} />
                ))
              )}
            </svg>
          </div>
          <div class="hero__deco-chips">
            <span class="hero__deco-chip">Science du jeu</span>
            <span class="hero__deco-chip hero__deco-chip--accent">Esprit compétitif</span>
            <span class="hero__deco-chip">Société</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ════════════════════════════════════════════
       ARTICLE EN UNE — carte horizontale (style Appux)
  ════════════════════════════════════════════ -->
  {featuredPost && (
    <section class="featured-section">
      <div class="container">
        <span class="eyebrow featured-section__eyebrow">{c.featuredEyebrow}</span>
        <div class="featured-showcase reveal">
          <ArticleCard post={featuredPost} featured={true} lang={lang} />
        </div>
      </div>
    </section>
  )}

  <div class="container">
    <AdBanner format="leaderboard" />
  </div>

  <!-- ════════════════════════════════════════════
       RUBRIQUES — pillar grid (compact, horizontal)
  ════════════════════════════════════════════ -->
  <section class="pillars" id={sectionsId}>
    <div class="container">
      <div class="pillar-strip reveal-group">
        {categorySlugs.filter((slug) => lang === "fr" || slug !== "grand-oral").map((slug) => {
          const cat = categoryMap[slug];
          const href = lang === "fr" ? cat.href : swapLangPrefix(cat.href, lang);
          const count = postsByCategory[slug] ?? 0;
          return (
            <a href={href} class="pillar-chip" style={`--p:${cat.accent};`}>
              <span class="pillar-chip__label">{cat.shortLabel}</span>
              {count > 0 && <span class="pillar-chip__count">{count}</span>}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       TOUS LES ARTICLES — onglets + recherche + grille (style Appux)
  ════════════════════════════════════════════ -->
  <section class="allposts">
    <div class="container">

      <!-- En-tête : titre gauche, actions droite -->
      <div class="allposts__header reveal">
        <h2 class="allposts__title">{c.allPostsTitle}</h2>
        <div class="allposts__controls">
          <!-- Onglets -->
          <div class="allposts__tabs" role="tablist" aria-label="Filtrer par rubrique">
            <button class="tab active" data-filter="all" role="tab" aria-selected="true">{c.tabAll}</button>
            {categorySlugs.filter((slug) => lang === "fr" || slug !== "grand-oral").map((slug) => (
              <button
                class="tab"
                data-filter={slug}
                role="tab"
                aria-selected="false"
                style={`--tab-accent: ${categoryMap[slug].accent}`}
              >{categoryMap[slug].shortLabel}</button>
            ))}
          </div>
          <!-- Recherche -->
          <div class="allposts__search-wrap">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input
              type="search"
              class="allposts__search"
              placeholder={c.searchPlaceholder}
              aria-label={c.searchPlaceholder}
            />
          </div>
        </div>
      </div>

      <!-- Grille d'articles -->
      <div class="allposts__grid reveal-group">
        {gridPosts.map((post) => (
          <div
            class="post-wrapper"
            data-category={post.data.category}
            data-title={post.data.title.toLowerCase()}
            data-excerpt={(post.data.excerpt ?? "").toLowerCase()}
          >
            <ArticleCard post={post} featured={false} lang={lang} />
          </div>
        ))}
      </div>

      <p class="allposts__empty" aria-live="polite" style="display:none">{c.noResults}</p>

      <div class="allposts__see-all reveal">
        <a href={blogHref} class="see-all-btn">{c.seeAll}</a>
      </div>

    </div>
  </section>

</div>

<style>
  .home-landing {
    overflow-x: clip;
  }

  /* ════════════════════════════════════════════
     HERO
  ════════════════════════════════════════════ */
  .hero {
    padding: calc(var(--navbar-h) + 4rem) 0 4rem;
    background:
      radial-gradient(ellipse 80% 60% at 15% 40%, color-mix(in srgb, var(--green) 8%, transparent), transparent 55%),
      var(--bg);
  }

  :global([data-theme="dark"]) .hero {
    background:
      radial-gradient(ellipse 80% 60% at 15% 40%, color-mix(in srgb, var(--green) 10%, transparent), transparent 55%),
      var(--bg);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem 4rem;
    align-items: center;
    max-width: 72rem;
  }

  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__deco { display: none; }
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .hero__eyebrow {
    margin-bottom: 0.4rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5.5vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: var(--text-main);
    margin: 0;
  }

  .hero__accent {
    color: var(--green);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
  }

  .hero__lead {
    font-size: clamp(1rem, 2vw, 1.1rem);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 34rem;
    margin: 0.4rem 0 0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  .hero__proof {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .hero__proof li {
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-soft);
    background: var(--surface);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* Déco droite : carte illustrative avec grande pièce */
  .hero__deco {
    display: flex;
    justify-content: flex-end;
  }

  .hero__deco-card {
    position: relative;
    width: min(340px, 100%);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: var(--shadow-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero__deco-glyph {
    font-size: 7rem;
    line-height: 1;
    color: var(--green);
    opacity: 0.85;
    display: block;
    text-align: center;
    animation: float 4s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__deco-glyph { animation: none; }
  }

  .hero__deco-board {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 80px;
    height: 80px;
    color: var(--green);
    opacity: 0.1;
  }

  .hero__deco-chips {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero__deco-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-soft);
    background: var(--bg-warm);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    width: fit-content;
  }

  .hero__deco-chip--accent {
    border-color: var(--green-border);
    background: color-mix(in srgb, var(--green-light) 55%, var(--surface));
    color: var(--green);
  }

  /* ════════════════════════════════════════════
     FEATURED — carte horizontale (style Appux)
  ════════════════════════════════════════════ */
  .featured-section {
    padding: 2rem 0 0;
  }

  .featured-section__eyebrow {
    display: block;
    margin-bottom: 1rem;
  }

  /* Rendre la carte featured horizontale via :global() */
  .featured-showcase :global(.card.featured) {
    display: grid !important;
    grid-template-columns: 1fr !important;
    grid-template-rows: auto !important;
    grid-column: auto !important;
    grid-row: auto !important;
    border-radius: 12px;
    overflow: hidden;
  }

  .featured-showcase :global(.card.featured .card-link--thumb) {
    display: grid !important;
    grid-template-columns: 46% 54% !important;
    gap: 0 !important;
    align-items: stretch !important;
    height: 100%;
    min-height: 22rem;
  }

  .featured-showcase :global(.card.featured .card-thumb-wrap) {
    aspect-ratio: auto !important;
    height: 100% !important;
    border-radius: 12px 0 0 12px !important;
    min-height: 22rem;
  }

  .featured-showcase :global(.card.featured .card-body) {
    padding: 2.5rem 2.25rem !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    gap: 1rem !important;
  }

  .featured-showcase :global(.card.featured .card-title) {
    font-size: clamp(1.5rem, 2.5vw, 2.1rem) !important;
  }

  .featured-showcase :global(.card.featured .card-excerpt) {
    -webkit-line-clamp: 4 !important;
    font-size: 0.95rem !important;
  }

  @media (max-width: 760px) {
    .featured-showcase :global(.card.featured .card-link--thumb) {
      grid-template-columns: 1fr !important;
    }
    .featured-showcase :global(.card.featured .card-thumb-wrap) {
      height: 16rem !important;
      border-radius: 12px 12px 0 0 !important;
    }
  }

  /* ════════════════════════════════════════════
     RUBRIQUES — strip compact
  ════════════════════════════════════════════ */
  .pillars {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border-soft);
  }

  .pillar-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
  }

  .pillar-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--p) 30%, var(--border-soft));
    background: color-mix(in srgb, var(--p) 8%, var(--surface));
    color: var(--text-main);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    transition: transform 200ms var(--ease-spring), background 180ms ease, border-color 180ms ease;
  }

  .pillar-chip:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--p) 16%, var(--surface));
    border-color: color-mix(in srgb, var(--p) 55%, var(--border-soft));
    color: var(--p);
  }

  .pillar-chip__label { color: inherit; }

  .pillar-chip__count {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.75rem;
    color: var(--p);
    background: color-mix(in srgb, var(--p) 12%, var(--surface));
    border: 1px solid color-mix(in srgb, var(--p) 22%, transparent);
    border-radius: var(--radius-pill);
    padding: 0.05rem 0.45rem;
  }

  /* ════════════════════════════════════════════
     TOUS LES ARTICLES — header + tabs + grille
  ════════════════════════════════════════════ */
  .allposts {
    padding: 3rem 0 5rem;
  }

  .allposts__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-bottom: 1.75rem;
    max-width: 72rem;
    margin-inline: auto;
  }

  .allposts__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--text-main);
    margin: 0;
    letter-spacing: -0.025em;
  }

  .allposts__controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Onglets de filtre */
  .allposts__tabs {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tab {
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-soft);
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease, transform 180ms var(--ease-spring);
  }

  .tab:hover {
    border-color: color-mix(in srgb, var(--tab-accent, var(--green)) 45%, var(--border-soft));
    color: var(--tab-accent, var(--green));
    transform: translateY(-1px);
  }

  .tab.active {
    background: var(--tab-accent, var(--green));
    border-color: var(--tab-accent, var(--green));
    color: #fff;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--tab-accent, var(--green)) 30%, transparent);
  }

  /* Barre de recherche */
  .allposts__search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .allposts__search-wrap svg {
    position: absolute;
    left: 0.65rem;
    color: var(--text-dim);
    pointer-events: none;
  }

  .allposts__search {
    padding: 0.42rem 0.9rem 0.42rem 2rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-soft);
    background: var(--surface);
    color: var(--text-main);
    font-family: var(--font-display);
    font-size: 0.82rem;
    width: 13rem;
    outline: none;
    transition: border-color 160ms ease, width 220ms ease, box-shadow 160ms ease;
  }

  .allposts__search::placeholder { color: var(--text-dim); }

  .allposts__search:focus {
    border-color: var(--green);
    width: 17rem;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 16%, transparent);
  }

  /* Grille 3 colonnes (comme Appux) */
  .allposts__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 72rem;
    margin-inline: auto;
  }

  @media (max-width: 900px) {
    .allposts__grid { grid-template-columns: 1fr 1fr; }
    .allposts__header { flex-direction: column; align-items: flex-start; }
  }

  @media (max-width: 560px) {
    .allposts__grid { grid-template-columns: 1fr; }
    .allposts__search { width: 100%; }
    .allposts__search:focus { width: 100%; }
    .allposts__search-wrap { width: 100%; }
    .allposts__controls { width: 100%; flex-direction: column; align-items: flex-start; }
  }

  /* Wrappers de filtrage */
  .post-wrapper {
    display: contents;
  }

  .post-wrapper.hidden > :global(.card) {
    display: none !important;
  }

  .allposts__empty {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    padding: 3rem 0;
    max-width: 72rem;
    margin-inline: auto;
  }

  .allposts__see-all {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .see-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.75rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--green-border);
    background: transparent;
    color: var(--green);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    transition: background 180ms ease, color 180ms ease, transform 200ms var(--ease-spring);
  }

  .see-all-btn:hover {
    background: var(--green);
    color: #fff;
    transform: translateY(-2px);
  }
</style>

<script>
  function initFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".allposts__tabs .tab");
    const wrappers = document.querySelectorAll<HTMLElement>(".post-wrapper");
    const searchInput = document.querySelector<HTMLInputElement>(".allposts__search");
    const emptyMsg = document.querySelector<HTMLElement>(".allposts__empty");
    if (!tabs.length || !wrappers.length) return;

    let activeFilter = "all";
    let searchQuery = "";

    function applyFilters() {
      let visible = 0;
      wrappers.forEach((wrapper) => {
        const cat = wrapper.dataset.category ?? "";
        const title = wrapper.dataset.title ?? "";
        const excerpt = wrapper.dataset.excerpt ?? "";
        const matchesCat = activeFilter === "all" || cat === activeFilter;
        const matchesSearch =
          !searchQuery || title.includes(searchQuery) || excerpt.includes(searchQuery);
        const show = matchesCat && matchesSearch;
        wrapper.classList.toggle("hidden", !show);
        if (show) visible++;
      });
      if (emptyMsg) emptyMsg.style.display = visible === 0 ? "block" : "none";
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => { t.classList.remove("active"); t.setAttribute("aria-selected", "false"); });
        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");
        activeFilter = tab.dataset.filter ?? "all";
        applyFilters();
      });
    });

    searchInput?.addEventListener("input", () => {
      searchQuery = (searchInput.value ?? "").toLowerCase().trim();
      applyFilters();
    });
  }

  document.addEventListener("astro:page-load", initFilters);
</script>
