---
import EditorialLocaleMasthead from "./EditorialLocaleMasthead.astro";
import type { SiteLang } from "../utils/lang-paths";
import "../styles/editorial-resources.css";

interface Props {
  lang: SiteLang;
  kind: "notice" | "terms" | "privacy";
  title: string;
  headings: string[];
}

const { lang, kind, title, headings } = Astro.props;
const copy = {
  fr: {
    kicker: "Le média · Informations du site", documents: "Les documents du site",
    notice: "Mentions légales", terms: "CGU", privacy: "Confidentialité",
    paths: ["mentions-legales", "cgu", "politique-confidentialite"],
    contents: "Dans cette page", contact: "Une question ?", email: "Écrire au Gaucher",
    contactNote: "Pour toute question concernant le site ou ces documents.",
    about: "La ligne éditoriale du média",
  },
  en: {
    kicker: "The publication · Site information", documents: "Site documents",
    notice: "Legal notice", terms: "Terms of use", privacy: "Privacy",
    paths: ["legal-notice", "terms-of-use", "privacy-policy"],
    contents: "On this page", contact: "A question?", email: "Write to Le Gaucher",
    contactNote: "For questions about the site or these documents.",
    about: "The publication’s editorial approach",
  },
  "pt-br": {
    kicker: "A publicação · Informações do site", documents: "Documentos do site",
    notice: "Aviso legal", terms: "Termos de uso", privacy: "Privacidade",
    paths: ["aviso-legal", "termos-de-uso", "politica-de-privacidade"],
    contents: "Nesta página", contact: "Alguma dúvida?", email: "Escreva ao Gaucher",
    contactNote: "Para dúvidas sobre o site ou estes documentos.",
    about: "A linha editorial da publicação",
  },
  nl: {
    kicker: "De publicatie · Website-informatie", documents: "Documenten van de website",
    notice: "Juridische vermeldingen", terms: "Gebruiksvoorwaarden", privacy: "Privacy",
    paths: ["juridische-vermeldingen", "gebruiksvoorwaarden", "privacybeleid"],
    contents: "Op deze pagina", contact: "Een vraag?", email: "Schrijf naar Le Gaucher",
    contactNote: "Voor vragen over de website of deze documenten.",
    about: "De redactionele aanpak van de publicatie",
  },
}[lang];

const kinds = ["notice", "terms", "privacy"] as const;
const documents = kinds.map((key, index) => ({
  key,
  label: copy[key],
  href: `/${lang}/${copy.paths[index]}/`,
}));
const contents = headings.map((label, index) => ({
  label,
  href: `#legal-section-${index + 1}`,
}));
---

<div class="resource-page legal-page">
  <div class="container">
    <header>
      <EditorialLocaleMasthead lang={lang} />
      <div class="resource-heading legal-heading">
        <span class="resource-kicker">{copy.kicker}</span>
        <h1>{title}</h1>
        <div class="legal-intro"><slot name="intro" /></div>
        {Astro.slots.has("updated") && <div class="legal-updated"><slot name="updated" /></div>}
      </div>
    </header>

    <nav class="legal-documents" aria-label={copy.documents}>
      {documents.map((document, index) => <a href={document.href} aria-current={kind === document.key ? "page" : undefined}>
        <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        {document.label}
      </a>)}
    </nav>

    <details class="legal-mobile-contents">
      <summary>{copy.contents}<span aria-hidden="true">+</span></summary>
      <nav aria-label={copy.contents}>
        <ol>{contents.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ol>
      </nav>
    </details>

    <div class="legal-layout">
      <article class="legal-body" aria-label={title}><slot /></article>
      <aside class="legal-aside">
        <nav class="legal-desktop-contents" aria-labelledby="legal-contents-title">
          <h2 id="legal-contents-title" class="resource-kicker">{copy.contents}</h2>
          <ol>{contents.map(item => <li><a href={item.href}>{item.label}</a></li>)}</ol>
        </nav>
        <div class="legal-contact">
          <h2>{copy.contact}</h2>
          <p>{copy.contactNote}</p>
          <a class="resource-link" href="mailto:contact@blogdungaucher.com">{copy.email} <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </div>

    <div class="resource-end legal-end"><a class="resource-link" href={`/${lang}/about/`}>{copy.about} <span aria-hidden="true">→</span></a></div>
  </div>
</div>

<style>
  .legal-heading { max-width: none; }
  .legal-heading h1 { max-width: 22ch; overflow-wrap: anywhere; hyphens: auto; }
  .legal-intro { max-width: 73ch; }
  .legal-intro :global(p) { margin: 0; color: var(--text-muted); font-size: 1rem; line-height: 1.8; }
  .legal-updated :global(p) { margin: 1rem 0 0; color: var(--text-dim); font-size: .76rem; }
  .legal-documents { display: flex; flex-wrap: wrap; gap: 0 2rem; border-top: 2px solid var(--text-main); border-bottom: 1px solid var(--border-strong); margin-bottom: 2.25rem; }
  .legal-documents a { display: flex; align-items: baseline; gap: .6rem; padding: 1rem 0; font-size: .84rem; color: var(--text-muted); }
  .legal-documents a > span { font-size: .66rem; font-variant-numeric: tabular-nums; color: var(--text-dim); }
  .legal-documents a[aria-current="page"] { color: var(--green); border-bottom: 3px solid var(--green); margin-bottom: -1px; font-weight: 600; }
  .legal-documents a[aria-current="page"] > span { color: inherit; }
  .legal-documents a:hover { color: var(--green); }
  .legal-layout { display: grid; grid-template-columns: minmax(0, 2.5fr) minmax(14rem, 1fr); gap: 4rem; align-items: start; }
  .legal-body { min-width: 0; max-width: 47rem; }
  .legal-body :global(section) { padding: 0 0 1.8rem; scroll-margin-top: calc(var(--navbar-h) + 1.5rem); }
  .legal-body :global(section + section) { border-top: 1px solid var(--border-strong); padding-top: 1.8rem; }
  .legal-body :global(h2) { margin: 0 0 1rem; font: 550 1.55rem/1.3 var(--font-serif); letter-spacing: -.025em; text-wrap: pretty; overflow-wrap: anywhere; hyphens: auto; }
  .legal-body :global(p), .legal-body :global(li) { color: var(--text-muted); font-size: .98rem; line-height: 1.85; overflow-wrap: anywhere; }
  .legal-body :global(p) { margin: 0 0 1rem; }
  .legal-body :global(strong) { color: var(--text-main); font-weight: 600; }
  .legal-body :global(ul) { margin: .5rem 0 1rem; padding-left: 1.25rem; list-style: disc; }
  .legal-body :global(li) { padding-left: .2rem; margin-bottom: .6rem; }
  .legal-body :global(li::marker) { color: var(--green); }
  .legal-body :global(a) { color: var(--green); text-decoration: underline; text-underline-offset: .2em; }
  .legal-body :global(a:hover) { text-decoration-thickness: 2px; }
  .legal-body :global(section > :last-child) { margin-bottom: 0; }
  .legal-aside { position: sticky; top: calc(var(--navbar-h) + 1.5rem); max-height: calc(100dvh - var(--navbar-h) - 3rem); overflow-y: auto; scrollbar-width: thin; border-left: 1px solid var(--border-strong); padding-left: 1.5rem; }
  .legal-desktop-contents ol, .legal-mobile-contents ol { list-style: none; padding: 0; margin: 1rem 0 0; }
  .legal-desktop-contents li + li { margin-top: .8rem; }
  .legal-desktop-contents a { display: block; font-size: .79rem; line-height: 1.55; color: var(--text-muted); }
  .legal-desktop-contents a:hover, .legal-mobile-contents a:hover { color: var(--green); text-decoration: underline; text-underline-offset: .2em; }
  .legal-contact { margin-top: 1.8rem; padding-top: 1.25rem; border-top: 1px solid var(--border-strong); }
  .legal-contact h2 { font: 550 1.3rem/1.3 var(--font-serif); margin: 0 0 .65rem; }
  .legal-contact p { margin: 0 0 1rem; color: var(--text-muted); font-size: .82rem; line-height: 1.7; }
  .legal-mobile-contents { display: none; }
  .legal-end { margin-top: 1rem; }
  @media (max-width: 959px) {
    .legal-layout { gap: 2rem; grid-template-columns: minmax(0, 2fr) minmax(13rem, 1fr); }
    .legal-aside { padding-left: 1.2rem; }
  }
  @media (max-width: 719px) {
    .legal-heading h1 { font-size: clamp(2.1rem, 7.5vw, 3rem); }
    .legal-intro :global(p) { font-size: .95rem; }
    .legal-documents { gap: 0 1.25rem; margin-bottom: 1.25rem; }
    .legal-documents a { font-size: .78rem; padding: .8rem 0; gap: .4rem; }
    .legal-layout { display: block; }
    .legal-mobile-contents { display: block; border-block: 1px solid var(--border-strong); margin-bottom: 2rem; }
    .legal-mobile-contents summary { list-style: none; cursor: pointer; padding: .9rem 0; font-size: .8rem; font-weight: 600; color: var(--green); }
    .legal-mobile-contents summary::-webkit-details-marker { display: none; }
    .legal-mobile-contents summary:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
    .legal-mobile-contents summary > span { float: right; font-size: 1.1rem; line-height: 1; }
    .legal-mobile-contents[open] summary > span { transform: rotate(45deg); }
    .legal-mobile-contents ol { margin: 0; padding-bottom: .6rem; }
    .legal-mobile-contents a { display: block; padding: .55rem 0; font-size: .84rem; line-height: 1.5; color: var(--text-muted); }
    .legal-desktop-contents { display: none; }
    .legal-aside { position: static; max-height: none; overflow: visible; border-left: 0; padding-left: 0; }
    .legal-contact { background: var(--bg-warm); border-top: 2px solid var(--green); padding: 1.25rem; margin: .5rem 0 1.5rem; }
    .legal-body :global(h2) { font-size: 1.4rem; }
    .legal-body :global(p), .legal-body :global(li) { font-size: .95rem; }
  }
  @media print {
    .legal-documents, .legal-aside, .legal-mobile-contents, .legal-end { display: none; }
    .legal-layout { display: block; }
    .legal-body { max-width: none; }
    .legal-body :global(section) { break-inside: auto; }
    .legal-body :global(h2) { break-after: avoid; }
  }
</style>
