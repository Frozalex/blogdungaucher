---
import { editorialUi } from "../data/editorial-ui";
import { categoryMap, categorySlugs } from "../data/site";
import { swapLangPrefix } from "../utils/lang-paths";
import { t, type Lang } from "../i18n/translations";

const { frHref, enHref, ptBrHref, nlHref, lang = "fr" } = Astro.props as {
  frHref?: string;
  enHref?: string;
  ptBrHref?: string;
  nlHref?: string;
  lang?: "fr" | "en" | "pt-br" | "nl";
};

const pathname = Astro.url.pathname;
const E=editorialUi(lang);
const homeHref = lang === "en" ? "/en/" : lang === "pt-br" ? "/pt-br/" : lang === "nl" ? "/nl/" : "/fr/";

/** Langues proposées dans le sélecteur : uniquement celles réellement en ligne
 *  (NL lancé au 1er novembre, donc exclu pour l'instant). Les href sont déjà résolus
 *  par BaseLayout vers la traduction de la page courante — ou l'accueil de la
 *  langue en repli — ce qui évite tout lien mort. Libellés = endonymes (non traduits). */
const switchLanguages = [
  { code: "fr", label: "Français", short: "FR", href: frHref ?? "/fr/" },
  { code: "en", label: "English", short: "EN", href: enHref ?? "/en/" },
  { code: "pt-br", label: "Português", short: "PT", href: ptBrHref ?? "/pt-br/" },
] as const;
const currentSwitch = switchLanguages.find((l) => l.code === lang) ?? switchLanguages[0];

/** Lang sûr pour le helper t() : retombe sur fr si la langue n'est pas couverte. */
const tLang: Lang = (["fr", "en", "pt-br", "nl"].includes(lang) ? lang : "fr") as Lang;
const siteName = (() => {
  const v = t(tLang, "nav.siteName");
  return v && typeof v === "string" ? v : "Blog d'un Gaucher";
})();

// Libellés d'accessibilité (aria/title) localisés côté serveur — le dict runtime
// ne couvre que fr/en, donc on ne peut pas compter dessus pour pt-br/nl.
const navUi = {
  fr: { searchArticle: "Rechercher un article", searchTitle: "Rechercher (/)", changeLang: "Changer la langue", search: "Rechercher", mainNav: "Navigation principale", langGroup: "Langue" },
  en: { searchArticle: "Search articles", searchTitle: "Search (/)", changeLang: "Change language", search: "Search", mainNav: "Main navigation", langGroup: "Language" },
  "pt-br": { searchArticle: "Buscar um artigo", searchTitle: "Buscar (/)", changeLang: "Mudar de idioma", search: "Buscar", mainNav: "Navegação principal", langGroup: "Idioma" },
  nl: { searchArticle: "Een artikel zoeken", searchTitle: "Zoeken (/)", changeLang: "Taal wijzigen", search: "Zoeken", mainNav: "Hoofdnavigatie", langGroup: "Taal" },
} as const;
const ui = navUi[tLang as keyof typeof navUi] ?? navUi.fr;

const isActive = (href : string) => {
  const homePaths = ["/fr/", "/en/", "/pt-br/", "/nl/"];
  if (homePaths.includes(href)) {
    return pathname === href;
  }
  if (lang === "en") {
    return href === "/en/" ? pathname === "/en/" : pathname.startsWith(href);
  }
  if (lang === "pt-br") {
    return href === "/pt-br/" ? pathname === "/pt-br/" : pathname.startsWith(href);
  }
  if (lang === "nl") {
    return href === "/nl/" ? pathname === "/nl/" : pathname.startsWith(href);
  }
  return href === "/fr/" ? pathname === "/fr/" : pathname.startsWith(href);
};

// Correspondance href → clé de traduction navLinks
const linkKey : Record<string, string> = {
  "/fr/science/" : "navLinks.science",
  "/fr/esprit/" : "navLinks.esprit",
  "/fr/societe/" : "navLinks.societe",
  "/fr/grand-oral/" : "navLinks.grandOral",
  "/fr/dissertations/" : "navLinks.dissertations",
  "/fr/blog/" : "navLinks.blog",
  "/fr/about/" : "navLinks.about",
  "/fr/contact/" : "navLinks.contact",
  "/en/science/" : "navLinks.science",
  "/en/esprit/" : "navLinks.esprit",
  "/en/societe/" : "navLinks.societe",
  "/en/dissertations/" : "navLinks.dissertations",
  "/en/blog/" : "navLinks.blog",
  "/en/about/" : "navLinks.about",
  "/en/contact/" : "navLinks.contact",
  "/pt-br/science/" : "navLinks.science",
  "/pt-br/esprit/" : "navLinks.esprit",
  "/pt-br/societe/" : "navLinks.societe",
  "/pt-br/blog/" : "navLinks.blog",
  "/pt-br/about/" : "navLinks.about",
  "/pt-br/contact/" : "navLinks.contact",
  "/nl/science/" : "navLinks.science",
  "/nl/esprit/" : "navLinks.esprit",
  "/nl/societe/" : "navLinks.societe",
  "/nl/blog/" : "navLinks.blog",
  "/nl/about/" : "navLinks.about",
  "/nl/contact/" : "navLinks.contact",
};

// Rubriques éditoriales du header (menu déroulant). Grand oral est FR-only → exclu
// des autres langues (évite les liens 404). Libellés localisés via t(), href par langue.
const rubriques = categorySlugs
  .filter((slug) => lang === "fr" || slug !== "grand-oral")
  .map((slug) => ({
    slug,
    label: (t(tLang, `categories.${slug}.label`) as string) || categoryMap[slug].label,
    href: lang === "fr" ? categoryMap[slug].href : swapLangPrefix(categoryMap[slug].href, lang),
    accent: categoryMap[slug].accent,
  }));
const menuGroups = [
  {label:E.read,items:[{label:E.all,href:`/${lang}/blog/`,accent:"var(--green)",key:"navLinks.blog"},...(lang!=="nl"?[{label:E.series,href:`/${lang}/series/`,accent:"var(--green)",key:"navLinks.series"}]:[]),...((lang==="fr"||lang==="en")?[{label:E.essays,href:`/${lang}/dissertations/`,accent:"var(--green)",key:"navLinks.dissertations"}]:[])]},
  {label:E.understand,items:[{label:E.search,href:`/${lang}/recherche/`,accent:"var(--green)",key:""},...(lang==="fr"?[{label:"L’Atlas du Gaucher",href:"/fr/infographie/",accent:"var(--green)",key:""},{label:"Glossaire",href:"/fr/glossaire/",accent:"var(--green)",key:""}]:[])]},
  {label:E.media,items:[{label:E.about,href:`/${lang}/about/`,accent:"var(--green)",key:"navLinks.about"},{label:E.contact,href:`/${lang}/contact/`,accent:"var(--green)",key:"navLinks.contact"}]},
];
const articlesMenu=menuGroups.flatMap(group=>group.items);
const exploreLabel=E.explore;
const articlesActive = articlesMenu.some((item) => pathname.startsWith(item.href));

/** En français, les quatre rubriques sont directement visibles. Explorer rassemble
 *  les formats, les ressources et le média. L'ordre du DOM reste celui de lecture. */
type NavEntry =
  | { kind: "link"; label: string; href: string }
  | { kind: "articles" };
const navEntries: NavEntry[] = [...rubriques.map(r => ({ kind: "link" as const, label: r.label, href: r.href })), { kind: "articles" as const }];
---
<header class="navbar navbar--editorial" id="navbar" data-dark-on={t(tLang,"nav.darkOn")} data-dark-off={t(tLang,"nav.darkOff")} data-menu-open={t(tLang,"nav.openMenu")} data-menu-close={t(tLang,"nav.closeMenu")} data-pagefind-ignore data-lang-fr-href={frHref ?? "/fr/"} data-lang-en-href={enHref ?? "/en/"} data-lang-pt-br-href={ptBrHref ?? "/pt-br/"} data-lang-nl-href={nlHref ?? "/nl/"}>
  <div class="container nav-inner">

    <a href={homeHref} class="nav-logo" aria-label={lang === "en" ? "Home - A Left-Hander's Blog" : lang === "pt-br" ? "Início - Blog de um Canhoto" : lang === "nl" ? "Home - Blog van een Linkshandige" : "Accueil Blog d'un Gaucher"}>
      <img
        src="/images/logo.svg"
        alt=""
        aria-hidden="true"
        class="logo-img"
        width="26"
        height="36"
        loading="eager"
      />
      <span class="logo-text" data-t="nav.siteName">{siteName}</span>
    </a>

    <nav class="nav-desktop" aria-label={ui.mainNav}>
      <ul class="nav-links">
        {navEntries.map((entry) => entry.kind === "link" ? (
          <li>
            <a
              href={entry.href}
              class={`nav-link${isActive(entry.href) ? " active" : ""}`}
              aria-current={pathname === entry.href ? "page" : isActive(entry.href) ? "location" : undefined}
              data-t={linkKey[entry.href] ?? ""}
            >
              {entry.label}
            </a>
          </li>
        ) : (
          <li class="nav-dropdown" data-nav-dropdown>
            <button type="button" class={`nav-link nav-dropdown__btn${articlesActive ? " active" : ""}`} aria-controls="nav-explore-menu" aria-expanded="false">
              {exploreLabel}
              <svg class="nav-dropdown__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class:list={["nav-dropdown__menu", {"nav-dropdown__menu--grouped":true}]} id="nav-explore-menu">
              {menuGroups.map(group => <div class="nav-dropdown__group"><span class="nav-dropdown__label">{group.label}</span><ul>{group.items.map(item => <li><a href={item.href} class:list={["nav-dropdown__item",{active:isActive(item.href)}]} aria-current={pathname === item.href ? "page" : isActive(item.href) ? "location" : undefined}>{item.label}</a></li>)}</ul></div>)}
            </div>
          </li>
        ))}
      </ul>
    </nav>

    {/* Boutons icônes : recherche + dark mode + langue */}
    <div class="nav-actions">
      <button
        type="button"
        class="icon-btn search-btn"
        data-search-trigger
        aria-label={ui.searchArticle}
        title={ui.searchTitle}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </button>
      <button
        id="dark-toggle"
        class="icon-btn"
        type="button"
        aria-pressed="false"
        aria-label={t(tLang, "nav.darkOn")}
        data-t-aria="nav.darkOn"
        title=""
      >
        {/* Icône soleil (mode clair actif) */}
        <svg class="icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        {/* Icône lune (mode sombre actif) */}
        <svg class="icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      {/* Sélecteur de langue : menu déroulant FR · EN · PT-BR. Chaque lien pointe
         vers la traduction de la page courante (ou l'accueil de la langue en repli). */}
      <div class="lang-switch" data-lang-switch>
        <button
          id="lang-toggle"
          class="icon-btn lang-btn"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-label={`${currentSwitch.short} — ${ui.changeLang}`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span class="lang-label">{currentSwitch.short}</span>
        </button>
        <ul class="lang-menu" role="menu" hidden>
          {switchLanguages.map((l) => (
            <li role="none">
              <a
                role="menuitem"
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                class={`lang-menu__item${l.code === lang ? " is-current" : ""}`}
                aria-current={l.code === lang ? "true" : undefined}
              >
                <span class="lang-menu__name">{l.label}</span>
                <span class="lang-menu__code">{l.short}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <button
      class="burger"
      aria-label={t(tLang, "nav.openMenu")}
      aria-controls="mobileMenu"
      aria-expanded="false"
      id="burger"
      type="button"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobileMenu" aria-hidden="true" inert>
    <div class="mobile-menu__inner">
      <nav class="container mobile-menu__content" aria-label={ui.mainNav}>
        <>
          <span class="mobile-eyebrow">{E.sections}</span>
          <div class="mobile-rubriques mobile-rubriques--primary">{rubriques.map(item => <a href={item.href} class:list={["mobile-rubrique",{active:isActive(item.href)}]} style={`--fc:${item.accent}`} aria-current={pathname === item.href ? "page" : isActive(item.href) ? "location" : undefined}><span class="nav-dropdown__dot" aria-hidden="true"></span>{item.label}</a>)}</div>
          <div class="mobile-browse-groups">{menuGroups.map(group => <section><h2 class="mobile-sublabel">{group.label}</h2><ul>{group.items.map(item => <li><a href={item.href} class:list={["mobile-link",{active:isActive(item.href)}]} aria-current={pathname === item.href ? "page" : isActive(item.href) ? "location" : undefined}>{item.label}</a></li>)}</ul></section>)}</div>
        </>
        <div class="mobile-utils">
          <button
            id="dark-toggle-mobile"
            class="mobile-util-btn"
            type="button"
            aria-pressed="false"
            aria-label={t(tLang, "nav.darkOn")}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
            <span data-t="nav.darkOn">{(t(tLang, "nav.darkOn") as string) || "Mode sombre"}</span>
          </button>
          {/* Sélecteur de langue mobile : puces FR · EN · PT-BR. */}
          <div class="mobile-langs" role="group" aria-label={ui.langGroup}>
            <svg class="mobile-langs__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            {switchLanguages.map((l) => (
              <a
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                class={`mobile-lang${l.code === lang ? " is-current" : ""}`}
                aria-current={l.code === lang ? "true" : undefined}
              >{l.short}</a>
            ))}
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  /* ── base ── */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    will-change: transform;
    transition:
      transform    320ms var(--ease-out),
      background   260ms ease,
      border-color 260ms ease,
      box-shadow   260ms ease;
  }

  .navbar--editorial { background: var(--bg); border-bottom-color: var(--border-strong); }
  .navbar--editorial .logo-text { font-size: .83rem; }
  .navbar--editorial .logo-img { width: 19px; height: 27px; }
  .navbar--editorial .nav-link { font-size: .78rem; }

  /* ── scrolled : glassmorphism ── */
  .navbar.scrolled {
    background: var(--navbar-bg-scrolled);
    backdrop-filter: blur(16px) saturate(1.6);
    -webkit-backdrop-filter : blur(16px) saturate(1.6);
    border-color: var(--border-soft);
    box-shadow: 0 1px 0 var(--border-soft);
  }

  /* ── caché ── */
  .navbar.nav-hidden {
    transform: translateY(-110%);
  }

  /* ── peek ── */
  .navbar.nav-peek {
    transform: translateY(0);
    background: color-mix(in srgb, var(--page-accent, var(--green)) 14%, var(--navbar-bg-glass));
    backdrop-filter: blur(20px) saturate(1.8);
    -webkit-backdrop-filter : blur(20px) saturate(1.8);
    border-color: color-mix(in srgb, var(--page-accent, var(--green)) 28%, transparent);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--page-accent, var(--green)) 20%, transparent),
      0 4px 20px rgba(0,0,0,0.07);
  }

  /* ── inner ── */
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.75rem;
    justify-content: center;
  }

  /* ── logo ── */
  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
    transition: opacity 180ms ease;
  }
  .nav-logo:hover { opacity: 0.75; }

  .logo-img {
    width: 26px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
    display: block;
    transition: filter 260ms ease;
  }

  /* Mode sombre : inversion des couleurs du SVG (#1e1e1e → clair) */
  :global([data-theme="dark"]) .logo-img {
    filter: invert(1);
  }

  .logo-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-main);
  }

  /* ── desktop nav ── */
  .nav-desktop { margin-left : auto; }

  .nav-links {
    display: flex;
    gap: 0;
    list-style: none;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.7rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    transition: color 180ms ease, background 180ms ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 4px;
    left: 0.7rem;
    right: 0.7rem;
    height: 2px;
    background: var(--green);
    border-radius: 1px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 200ms var(--ease-out);
  }

  .nav-link:hover {
    color: var(--text-main);
    background: rgba(0,0,0,0.04);
  }
  :global([data-theme="dark"]) .nav-link:hover {
    background: rgba(255,255,255,0.05);
  }
  .nav-link:hover::after { transform : scaleX(1); }
  .nav-link.active {
    color: var(--text-main);
    background: color-mix(in srgb, var(--green-light) 72%, transparent);
  }
  .nav-link.active::after { transform : scaleX(1); }

  /* ── Menu déroulant « Rubriques » ── */
  .nav-dropdown { position: relative; }
  .nav-dropdown__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    background: transparent;
    border: none;
    cursor: pointer;
    /* font-family seul : le raccourci `font: inherit` remettait font-size/weight à
       `inherit` et cassait l'alignement de taille avec les autres .nav-link. */
    font-family: inherit;
  }
  .nav-dropdown__chevron {
    opacity: 0.65;
    transition: transform 200ms var(--ease-out);
  }
  .nav-dropdown__btn[aria-expanded="true"] .nav-dropdown__chevron { transform: rotate(180deg); }

  .nav-dropdown__menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    z-index: 20;
    min-width: 13rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 160ms ease, transform 160ms var(--ease-out), visibility 160ms;
  }
  .nav-dropdown.is-open .nav-dropdown__menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  /* Un menu ouvert dépasse la hauteur de la barre masquée au défilement. */
  .navbar.nav-hidden .nav-dropdown__menu {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: none;
  }

  .nav-dropdown__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    transition: background 140ms ease, color 140ms ease;
  }
  .nav-dropdown__item:hover,
  .nav-dropdown__item.active {
    background: color-mix(in srgb, var(--fc) 12%, var(--surface));
    color: var(--text-main);
  }
  .nav-dropdown__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--fc);
    flex-shrink: 0;
  }

  /* Rubriques dans le menu mobile */
  .mobile-sublabel {
    margin: 0.55rem 0 0.1rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    font-weight: 700;
  }
  .mobile-rubriques { display: grid; gap: 0.05rem; }
  .mobile-rubrique {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-weight: 600;
  }
  .mobile-rubrique:hover,
  .mobile-rubrique.active { background: var(--bg-warm); color: var(--text-main); }

  /* ── Boutons icônes ── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.25rem;
  }

  /* Touch target ≥ 44 px (Apple HIG / Material). Visuellement on garde
     l'icône à ~16-18 px mais on agrandit la zone cliquable via padding. */
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-soft);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
    position: relative;
  }
  .icon-btn:hover {
    background: var(--surface-warm);
    color: var(--text-main);
    border-color: var(--border-strong);
  }

  /* Icônes dark toggle */
  .icon-btn .icon-dark { display : none; }
  :global([data-theme="dark"]) .icon-btn .icon-light { display : none; }
  :global([data-theme="dark"]) .icon-btn .icon-dark  { display : block; }

  /* Bouton recherche : identique aux autres icon-btn */
  .search-btn {
    text-decoration: none;
  }

  /* ── Sélecteur de langue (menu déroulant) ── */
  .lang-switch { position: relative; }

  /* Bouton langue : globe + code de la langue courante (FR/EN/PT). */
  .lang-btn {
    width: auto;
    min-width: 2.75rem;
    gap: 0.3rem;
    padding: 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .lang-btn[aria-expanded="true"] {
    background: var(--surface-warm);
    color: var(--text-main);
    border-color: var(--border-strong);
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    z-index: 20;
    min-width: 11rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }
  .lang-menu[hidden] { display: none; }

  .lang-menu__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.65rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 140ms ease, color 140ms ease;
  }
  .lang-menu__item:hover { background: var(--surface-warm); color: var(--text-main); }
  .lang-menu__item.is-current {
    color: var(--text-main);
    background: color-mix(in srgb, var(--green-light) 70%, transparent);
  }
  .lang-menu__code {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--text-dim);
  }
  .lang-menu__item.is-current .lang-menu__code { color: var(--green); }

  /* ── burger ── */
  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: auto;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    background: var(--surface);
    cursor: pointer;
    transition: background 160ms ease;
  }
  .burger:hover { background : var(--surface-warm); }
  .burger span {
    width: 0.95rem;
    height: 1.5px;
    margin: 0 auto;
    background: var(--text-main);
    border-radius: 999px;
    transition: transform 240ms var(--ease-out), opacity 240ms ease;
    display: block;
  }
  .burger[aria-expanded="true"] span:nth-child(1) { transform : translateY(5.5px) rotate(45deg); }
  .burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded="true"] span:nth-child(3) { transform : translateY(-5.5px) rotate(-45deg); }

  /* ── mobile menu ── */
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    border-top: 1px solid transparent;
    background: var(--surface);
    transition:
      grid-template-rows 340ms var(--ease-out),
      border-color       340ms ease;
    overflow: hidden;
  }

  .mobile-menu.is-open {
    grid-template-rows: 1fr;
    border-color: var(--border-soft);
  }

  .mobile-menu__inner { overflow : hidden; }

  .mobile-menu__content {
    display: grid;
    gap: 0.1rem;
    padding: 0.75rem 0 1.25rem;
  }

  .mobile-eyebrow {
    margin: 0.2rem 0 0.45rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    font-weight: 700;
  }

  /* Stagger raccourci : tous les liens apparaissent en ≤ 140 ms total.
     5 × 50 ms = 260 ms d'attente avant le dernier item ressentait clairement
     comme un retard sur le tap. Maintenant 5 × 20 ms = 80 ms cumulé + 100 ms
     d'opacité = ouverture quasi instantanée tout en gardant un effet de cascade. */
  .mobile-link {
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity   140ms ease,
      transform 140ms var(--ease-out),
      background 140ms ease,
      color      140ms ease;
  }
  .mobile-menu.is-open .mobile-link { opacity: 1; transform : translateY(0); }

  .mobile-menu.is-open .mobile-link:nth-of-type(1) { transition-delay: 20ms; }
  .mobile-menu.is-open .mobile-link:nth-of-type(2) { transition-delay: 40ms; }
  .mobile-menu.is-open .mobile-link:nth-of-type(3) { transition-delay: 60ms; }
  .mobile-menu.is-open .mobile-link:nth-of-type(4) { transition-delay: 80ms; }
  .mobile-menu.is-open .mobile-link:nth-of-type(5) { transition-delay: 100ms; }

  .mobile-link {
    padding: 0.65rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-weight: 600;
  }
  .mobile-search-link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .mobile-link.active {
    color: var(--text-main);
    background: color-mix(in srgb, var(--green-light) 72%, transparent);
    border: 1px solid var(--green-border);
  }
  .mobile-link:hover { background : var(--bg-warm); color : var(--text-main); }

  /* Utilitaires mobile (dark + lang): apparition juste après le dernier lien. */
  .mobile-utils {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 140ms ease, transform 140ms var(--ease-out);
    transition-delay: 120ms;
  }
  .mobile-menu.is-open .mobile-utils { opacity: 1; transform : translateY(0); }

  .mobile-util-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    /* Touch target ≥ 44 px : padding vertical augmenté + min-height. */
    min-height: 2.75rem;
    padding: 0.65rem 0.95rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-soft);
    background: var(--surface-warm);
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }
  .mobile-util-btn:hover {
    background: var(--bg-warm);
    color: var(--text-main);
  }

  /* Puces de langue (menu mobile) */
  .mobile-langs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .mobile-langs__icon { color: var(--text-dim); flex-shrink: 0; margin-right: 0.15rem; }
  .mobile-lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 0.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-soft);
    background: var(--surface-warm);
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .mobile-lang.is-current {
    color: var(--text-main);
    background: color-mix(in srgb, var(--green-light) 72%, transparent);
    border-color: var(--green-border);
  }
  .mobile-lang:hover { background: var(--bg-warm); color: var(--text-main); }

  @media (max-width: 960px) {
    .nav-desktop, .nav-actions { display : none; }
    .burger { display : flex; }
    .nav-inner { justify-content : space-between; }
  }
  /* Navigation éditoriale : accès directs, panneau compact et cibles tactiles. */
  .navbar--editorial { background:var(--bg); border-bottom-color:var(--border-strong); }
  .navbar--editorial .logo-text { font:600 1.05rem var(--font-serif); letter-spacing:-.025em; white-space:nowrap; }
  .navbar--editorial .logo-img { width:22px; height:31px; }
  .navbar--editorial .nav-link { font-size:.82rem; }
  .nav-inner { min-height:var(--navbar-h); }
  .nav-link { min-height:2.75rem; white-space:nowrap; border-radius:3px; }
  .navbar :is(a,button):focus-visible { outline:2px solid var(--green); outline-offset:3px; }
  .navbar--editorial .icon-btn { border-color:transparent; border-radius:3px; }
  .nav-dropdown__menu { left:auto; right:0; border-radius:3px; background:var(--bg); max-height:calc(100dvh - var(--navbar-h) - 1rem); overflow-y:auto; overscroll-behavior:contain; pointer-events:none; }
  .nav-dropdown.is-open .nav-dropdown__menu { pointer-events:auto; }
  .nav-dropdown__menu ul { list-style:none; margin:0; padding:0; }
  .nav-dropdown__menu--grouped { display:grid; grid-template-columns:1fr 1fr; gap:1rem 1.25rem; width:26rem; padding:1.2rem; }
  .nav-dropdown__label { display:block; padding:0 .6rem .5rem; font-size:.62rem; text-transform:uppercase; letter-spacing:.12em; color:var(--green); font-weight:650; }
  .nav-dropdown__group:last-child { grid-column:1/-1; padding-top:.8rem; border-top:1px solid var(--border-strong); }
  .nav-dropdown__group:last-child ul { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
  .nav-dropdown__item { min-height:2.75rem; font-size:.85rem; border-radius:3px; }
  .nav-dropdown__group .nav-dropdown__item { --fc:var(--green); }
  .navbar.nav-hidden .lang-menu { display:none; }
  .mobile-menu { background:var(--bg); }
  .navbar.mobile-open { transform:none; background:var(--bg); }
  .mobile-menu__inner { min-height:0; overflow-y:auto; max-height:calc(100dvh - var(--navbar-h)); overscroll-behavior:contain; }
  .mobile-menu.is-open .mobile-menu__inner { height:calc(100dvh - var(--navbar-h) - 1px); max-height:calc(100dvh - var(--navbar-h) - 1px); }
  .mobile-menu__content { padding:1.1rem 0 1.25rem; }
  .mobile-rubriques--primary { grid-template-columns:1fr 1fr; gap:.5rem; }
  .mobile-rubriques--primary .mobile-rubrique { border:1px solid var(--border-strong); border-radius:3px; min-height:3rem; padding:.6rem .75rem; font-size:.92rem; }
  .mobile-browse-groups { display:grid; grid-template-columns:1fr 1fr; gap:1.1rem; margin-top:1.25rem; }
  .mobile-browse-groups h2 { margin:0 0 .45rem; font-family:var(--font-body); font-size:.65rem; font-weight:650; color:var(--green); }
  .mobile-browse-groups ul { list-style:none; margin:0; padding:0; }
  .mobile-browse-groups .mobile-link { display:flex; align-items:center; min-height:2.75rem; padding:.5rem .35rem; font-size:.88rem; border-radius:3px; }
  .mobile-browse-groups section:last-child { grid-column:1/-1; border-top:1px solid var(--border-strong); padding-top:.8rem; }
  .mobile-browse-groups section:last-child ul { display:grid; grid-template-columns:1fr 1fr; gap:1.1rem; }
  .mobile-utils { border-top:1px solid var(--border-strong); padding-top:1rem; margin-top:.8rem; gap:.75rem; }
  .mobile-util-btn { font-family:var(--font-body); border-radius:3px; padding:.6rem; }
  .mobile-lang { border-radius:3px; }
  @media(min-width:961px) { .mobile-menu { display:none; } }
  @media(max-width:960px) {
    .nav-actions { display:flex; margin-left:auto; }
    .nav-actions>:not(.search-btn) { display:none; }
    .burger { display:flex; margin-left:0; border-radius:3px; background:transparent; }
    .nav-inner { gap:.35rem; }
    .nav-logo { min-width:0; }
    .navbar--editorial .logo-text { font-size:1rem; }
  }
  @media(prefers-reduced-motion:reduce) { .navbar,.navbar * { transition:none!important; } }
</style>

<script>
  let _onScroll: any = null;
  let _onMouse: any = null;
  let _ctrl : AbortController | null = null;

  let _closeMobile: (() => void) | null = null;

  function initNavbar() {
    _closeMobile?.();
    const navbar = document.getElementById("navbar") as HTMLElement;
    if (!navbar) return;

    const rubDropdown = navbar.querySelector("[data-nav-dropdown]");
    const rubBtn = rubDropdown?.querySelector(".nav-dropdown__btn") as HTMLButtonElement | null;

    function closeRubMenu() {
      rubDropdown?.classList.remove("is-open");
      rubBtn?.setAttribute("aria-expanded", "false");
    }

    const langSwitch = navbar.querySelector("[data-lang-switch]");
    const langBtn    = document.getElementById("lang-toggle");
    const langMenu   = langSwitch?.querySelector(".lang-menu") as HTMLElement | null;

    function closeLangMenu() {
      if (langMenu) langMenu.hidden = true;
      langBtn?.setAttribute("aria-expanded", "false");
    }

    const burger = document.getElementById("burger");
    const menu   = document.getElementById("mobileMenu");
    const menuLinks = menu?.querySelectorAll("a");

    const previousBodyOverflow = document.body.style.overflow;

    // Nettoyer les anciens listeners pour éviter les doublons
    if (_onScroll) { window.removeEventListener("scroll",    _onScroll); }
    if (_onMouse)  { document.removeEventListener("mousemove", _onMouse); }
    if (_ctrl)     { _ctrl.abort(); }
    _ctrl = new AbortController();
    const { signal } = _ctrl;

    const HIDE_AFTER       = 72;
    const JITTER           = 4;
    const PEEK_ZONE        = 60;
    const LEAVE_DELAY      = 800;
    /** Délai minimum après le dernier scroll avant qu'un mouvement souris
       puisse re-déclencher le peek. Empêche le peek "involontaire" quand
       l'utilisateur scrolle et que sa souris est haute par accident. */
    const SCROLL_QUIET_MS  = 220;
    /** Vélocité verticale minimale (px/100ms) pour considérer un mouvement
       comme une intention claire de remonter vers la navbar. */
    const PEEK_VELOCITY    = 18;

    let prevY     = window.scrollY;
    let peekTimer : ReturnType<typeof setTimeout> | null = null;
    let lastScrollAt = 0;
    let lastMouseY   = -1;
    let lastMouseAt  = 0;

    function applyState(state : string) {
      navbar.classList.remove("scrolled", "nav-hidden", "nav-peek");
      if (state === "scrolled") navbar.classList.add("scrolled");
      if (state === "hidden") {
        closeRubMenu();
        closeLangMenu();
        navbar.classList.add("nav-hidden");
      }
      if (state === "peek")     navbar.classList.add("nav-peek");
    }

    function cancelPeek() {
      if (peekTimer) { clearTimeout(peekTimer); peekTimer = null; }
    }

    function onScroll() {
      if (menu?.classList.contains("is-open")) return;
      const y     = window.scrollY;
      const delta = y - prevY;
      prevY = y;
      lastScrollAt = performance.now();
      if (y < HIDE_AFTER) { cancelPeek(); applyState("top"); return; }
      if (Math.abs(delta) <= JITTER) return;
      if (delta > 0) { cancelPeek(); applyState("hidden"); }
      else           { cancelPeek(); applyState("scrolled"); }
    }

    function onMouse(e : MouseEvent) {
      if (menu?.classList.contains("is-open")) return;
      const now = performance.now();
      const dt  = lastMouseAt > 0 ? Math.max(1, now - lastMouseAt) : 16;
      const dy  = lastMouseY >= 0 ? e.clientY - lastMouseY : 0;
      // Vélocité normalisée à 100ms.
      const velocity = (dy / dt) * 100;
      lastMouseY  = e.clientY;
      lastMouseAt = now;

      // Conditions pour déclencher le peek (toutes requises) :
      //   1. La souris est dans la zone "haut" du viewport
      //   2. La navbar est actuellement cachée
      //   3. L'utilisateur ne vient pas de scroller (≥ SCROLL_QUIET_MS)
      //   4. Mouvement de la souris VERS LE HAUT, suffisamment rapide
      //      (velocity négative = vers le haut, < -PEEK_VELOCITY)
      if (
        e.clientY <= PEEK_ZONE &&
        navbar.classList.contains("nav-hidden") &&
        now - lastScrollAt > SCROLL_QUIET_MS &&
        velocity < -PEEK_VELOCITY
      ) {
        cancelPeek();
        applyState("peek");
      } else if (
        navbar.classList.contains("nav-peek") &&
        e.clientY > PEEK_ZONE + 16
      ) {
        if (!peekTimer) {
          peekTimer = setTimeout(() => {
            peekTimer = null;
            if (window.scrollY >= HIDE_AFTER && navbar.classList.contains("nav-peek")) {
              applyState("hidden");
            }
          }, LEAVE_DELAY);
        }
      }
    }

    _onScroll = onScroll;
    _onMouse  = onMouse;
    window.addEventListener("scroll",     onScroll, { passive : true });
    document.addEventListener("mousemove", onMouse,  { passive : true });
    onScroll();

    navbar.addEventListener("focusin", () => {
      cancelPeek();
      applyState(window.scrollY >= HIDE_AFTER ? "scrolled" : "top");
    }, { signal });

    /* ── Burger ── */

    function setMenuState(isOpen: boolean) {
      menu?.classList.toggle("is-open", isOpen);
      navbar.classList.toggle("mobile-open", isOpen);
      document.body.style.overflow = isOpen ? "hidden" : previousBodyOverflow;
      if (isOpen) {
        cancelPeek();
        closeRubMenu();
        closeLangMenu();
        applyState(window.scrollY >= HIDE_AFTER ? "scrolled" : "top");
      }
      burger?.setAttribute("aria-expanded", isOpen ? "true" : "false");
      burger?.setAttribute("aria-label", isOpen
        ? navbar.dataset.menuClose!
        : navbar.dataset.menuOpen!);
      menu?.setAttribute("aria-hidden", isOpen ? "false" : "true");
      // `inert` quand fermé : retire les liens du menu du tab order ET de l'arbre
      // d'accessibilité (sinon des <a> focusables restent dans un conteneur
      // aria-hidden → erreur a11y/aria-hidden-focus).
      if (isOpen) menu?.removeAttribute("inert");
      else menu?.setAttribute("inert", "");
    }

    burger?.addEventListener("click", () => {
      const isOpen = !menu?.classList.contains("is-open");
      setMenuState(isOpen);
      if (isOpen) menuLinks?.[0]?.focus({ preventScroll: true });
    }, { signal });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menu?.classList.contains("is-open")) {
        menu.classList.remove("is-open");
        setMenuState(false);
        burger?.focus();
      }
    }, { signal });

    menuLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        if (!menu?.classList.contains("is-open")) return;
        menu.classList.remove("is-open");
        setMenuState(false);
      }, { signal });
    });

    setMenuState(false);
    _closeMobile = () => setMenuState(false);
    document.addEventListener("astro:before-swap", () => setMenuState(false), { signal });
    window.matchMedia("(max-width: 960px)").addEventListener("change", () => {
      setMenuState(false);
      closeRubMenu();
      closeLangMenu();
      applyState(window.scrollY >= HIDE_AFTER ? "scrolled" : "top");
    }, { signal });

    // Fermer le panneau avant que la recherche ne prenne le focus et le verrouillage du scroll.
    navbar.addEventListener("click", (e) => {
      if ((e.target as Element).closest("[data-search-trigger]") && menu?.classList.contains("is-open")) setMenuState(false);
    }, { capture: true, signal });
    document.addEventListener("keydown", (e) => {
      if (!menu?.classList.contains("is-open")) return;
      const target = e.target as HTMLElement;
      if ((e.key === "/" && !target.matches("input,textarea,[contenteditable]")) || (e.key.toLowerCase() === "k" && (e.ctrlKey || e.metaKey))) {
        setMenuState(false);
        return;
      }
      if (e.key !== "Tab") return;
      const controls = Array.from(navbar.querySelectorAll<HTMLElement>("a[href],button:not([disabled])")).filter(el => el.getClientRects().length > 0 && !el.closest("[inert]"));
      const first = controls[0], last = controls.at(-1);
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
    }, { signal });

    /* ── Dark mode toggle ── */
    function syncDarkBtn(isDark : boolean) {
      const label = isDark
        ? navbar.dataset.darkOff!
        : navbar.dataset.darkOn!;

      [document.getElementById("dark-toggle"), document.getElementById("dark-toggle-mobile")]
        .filter(Boolean)
        .forEach((btn) => {
          btn!.setAttribute("aria-pressed", String(isDark));
          btn!.setAttribute("aria-label", label);
          const span = btn!.querySelector("span[data-t]");
          if (span) span.textContent = label;
        });
    }

    function toggleDark() {
      const isDark = document.documentElement.dataset.theme !== "dark";
      document.documentElement.dataset.theme = isDark ? "dark" : "light";
      localStorage.setItem("blogdungaucher.theme", isDark ? "dark" : "light");
      syncDarkBtn(isDark);
    }

    document.getElementById("dark-toggle")?.addEventListener("click", toggleDark, { signal });
    document.getElementById("dark-toggle-mobile")?.addEventListener("click", toggleDark, { signal });

    syncDarkBtn(document.documentElement.dataset.theme === "dark");

    /* ── Sélecteur de langue (menu déroulant) ──
       Chaque langue a sa propre URL (site statique) : le menu NAVIGUE vers la
       traduction, il ne fait plus de bascule i18n en place. */

    langBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = langBtn.getAttribute("aria-expanded") === "true";
      if (isOpen) { closeLangMenu(); return; }
      closeRubMenu();
      if (langMenu) langMenu.hidden = false;
      langBtn.setAttribute("aria-expanded", "true");
    }, { signal });

    document.addEventListener("click", (e) => {
      if (langSwitch && !langSwitch.contains(e.target as Node)) closeLangMenu();
    }, { signal });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && langBtn?.getAttribute("aria-expanded") === "true") {
        closeLangMenu();
        langBtn.focus();
      }
    }, { signal });

    /* ── Menu déroulant « Rubriques » (clic + clavier + clic-extérieur) ── */
    rubBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      closeLangMenu();
      const isOpen = rubDropdown!.classList.toggle("is-open");
      rubBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
    }, { signal });

    rubDropdown?.addEventListener("focusout", (e) => {
      if (!rubDropdown.contains((e as FocusEvent).relatedTarget as Node | null)) closeRubMenu();
    }, { signal });
    rubBtn?.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowDown") return;
      e.preventDefault();
      closeLangMenu();
      rubDropdown?.classList.add("is-open");
      rubBtn.setAttribute("aria-expanded", "true");
      rubDropdown?.querySelector<HTMLAnchorElement>(".nav-dropdown__item")?.focus();
    }, { signal });

    document.addEventListener("click", (e) => {
      if (rubDropdown && !rubDropdown.contains(e.target as Node)) closeRubMenu();
    }, { signal });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && rubDropdown?.classList.contains("is-open")) {
        closeRubMenu();
        rubBtn?.focus();
      }
    }, { signal });
  }

  /* Init immédiate EN PLUS de astro:page-load : au tout premier chargement, cet évènement
     n'arrive qu'au window load, ce qui laisserait le menu « Articles » inerte jusque-là.
     Depuis que les rubriques, les séries et l'index du blog sont regroupés derrière ce
     menu, ce délai rendrait toute la navigation vers les articles injoignable.
     initNavbar est idempotent (il abandonne ses anciens écouteurs), donc le second appel
     déclenché par astro:page-load ne crée pas de doublon. */
  initNavbar();
  document.addEventListener("astro:page-load", initNavbar);
</script>
