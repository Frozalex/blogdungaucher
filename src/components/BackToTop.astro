---
const { lang = "fr" } = Astro.props as { lang?: "fr" | "en" | "pt-br" | "nl" };
const bttCopy = {
  fr: { aria: "Retour en haut de page", title: "Retour en haut", label: "Retour en haut" },
  en: { aria: "Back to top", title: "Back to top", label: "Back to top" },
  "pt-br": { aria: "Voltar ao topo", title: "Voltar ao topo", label: "Voltar ao topo" },
  nl: { aria: "Terug naar boven", title: "Naar boven", label: "Terug naar boven" },
} as const;
const b = bttCopy[lang] ?? bttCopy.fr;
---
<button id="back-to-top" class="btt" aria-label={b.aria} title={b.title}>
  <span class="btt-label">{b.label}</span>
</button>

<style>
  /* Bouton réservé au mobile : sur desktop la molette et la touche Origine suffisent,
     et un overlay flottant permanent y était surtout du bruit visuel. Le site étant
     généré en statique (un seul HTML pour toutes les largeurs), le masquage ne peut
     se faire qu'en CSS. */
  .btt {
    display: none;
  }

  @media (max-width: 900px) {
    .btt {
      /* En flux, juste avant le footer : pas d'overlay qui recouvre le texte sur
         petit écran. Toujours visible, donc aucune logique liée au défilement. */
      display: flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      height: 2.6rem;
      margin: 1.75rem 1rem;
      padding: 0 0.95rem;
      border-radius: var(--radius-pill);
      border: 1.5px solid color-mix(in srgb, var(--green) 18%, var(--border-soft));
      background: color-mix(in srgb, var(--green) 12%, var(--surface));
      color: var(--text-main);
      box-shadow: var(--shadow-md);
      cursor: pointer;
      transition:
        background-color 180ms ease,
        border-color 180ms ease,
        transform 180ms ease;
    }

    .btt-label {
      font-family: var(--font-display);
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;
    }

    .btt:hover {
      background: color-mix(in srgb, var(--green) 18%, var(--surface));
      border-color: color-mix(in srgb, var(--green) 26%, var(--border-soft));
      transform: translateY(-2px);
    }

    .btt:active {
      transform: scale(0.97);
    }
  }

  @media (max-width: 900px) and (prefers-reduced-motion: reduce) {
    .btt:hover,
    .btt:active {
      transform: none;
    }
  }
</style>

<script>
  /* Le bouton n'est rendu qu'en dessous de 900 px et y est toujours visible : plus de
     bascule liée au défilement, seul le clic reste à gérer. La délégation sur document
     survit aux navigations du ClientRouter (le bouton est remplacé à chaque page, un
     listener posé sur l'élément serait perdu). */
  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    if (!target?.closest("#back-to-top")) return;
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
