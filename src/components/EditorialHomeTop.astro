---
import BlogviCard from './BlogviCard.astro';
import BlogviSidebar from './BlogviSidebar.astro';
import ReadingPaths from './ReadingPaths.astro';
import {editorialUi} from '../data/editorial-ui';
import {getHomeEditorialPosts,homeTitles} from '../data/home-editorial';
import {getLocalizedPostText,getPostUrlLang,formatDateForLang,type BlogEntry} from '../utils/blog';
import type {SiteLang} from '../utils/lang-paths';
interface Props{posts:BlogEntry[];lang?:SiteLang;}
const {posts,lang='fr'}=Astro.props;
const L=editorialUi(lang),{feed,latest,selection}=getHomeEditorialPosts(posts);
const latestText=latest?await getLocalizedPostText(latest,lang):null;
---
<header class="bv-home-intro"><h1 id="home-heading">{homeTitles[lang]}</h1><p>{L.strap}</p></header>
{latest&&latestText&&<div class="bv-ticker"><span>{L.latest}</span><a href={await getPostUrlLang(latest,lang)}>{latestText.title}</a><time datetime={latest.data.publishDate.toISOString()}>{formatDateForLang(latest.data.publishDate,lang)}</time><span aria-hidden="true">↗</span></div>}
{feed[0] && <BlogviCard post={feed[0]} lang={lang} featured />}
<ReadingPaths lang={lang} />
<div class="bv-home-grid"><section aria-labelledby="feed-heading"><h2 id="feed-heading">{L.latest}</h2><div class="bv-home-feed">{feed.slice(1).map(post=><BlogviCard post={post} lang={lang}/>)}</div><a class="resource-button bv-home-all" href={`/${lang}/blog/`}>{L.all} →</a></section><BlogviSidebar posts={selection} lang={lang}/></div>
<style>
.bv-ticker{display:flex;align-items:center;gap:16px;padding:10px 14px;border:1px solid var(--bv-line);border-radius:16px;background:var(--bv-paper);margin:0 0 26px;font-size:14px}.bv-ticker>span:first-child{padding:9px 16px;border-radius:9px;background:var(--green);color:var(--on-green);font-weight:550;white-space:nowrap}.bv-ticker>a{flex:1;color:var(--text-main);font-weight:550}.bv-ticker>time{font-size:12px;white-space:nowrap;color:var(--text-muted)}.bv-home-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:28px;margin-top:28px}.bv-home-grid>section{min-width:0}.bv-home-grid>:global(.bv-sidebar){padding-top:0}.bv-home-intro{margin-bottom:24px}.bv-home-intro>p{font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:650;color:var(--green);margin:8px 0 0}.bv-home-intro h1{font-size:32px;margin:0;line-height:1.2}#feed-heading{margin:0 0 1rem;font:650 clamp(1.45rem,2.5vw,2rem)/1.2 var(--font-body)}.bv-home-feed{display:grid;gap:24px}.bv-home-all{display:inline-flex;margin-top:28px}
@media(max-width:900px){.bv-home-grid{display:block}.bv-home-grid>:global(.bv-sidebar){padding-top:28px}}@media(max-width:600px){.bv-ticker{font-size:12px;gap:10px}.bv-ticker>time{display:none}.bv-ticker>span:first-child{padding:8px 10px;font-size:11px}.bv-ticker>a{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.bv-home-intro h1{font-size:27px}}
</style>
