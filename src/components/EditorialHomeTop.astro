---
import BlogviCard from './BlogviCard.astro';
import BlogviSidebar from './BlogviSidebar.astro';
import ReadingPaths from './ReadingPaths.astro';
import {editorialUi} from '../data/editorial-ui';
import {getHomeEditorialPosts} from '../data/home-editorial';
import {getLocalizedPostText,getPostUrlLang,formatDateForLang,type BlogEntry} from '../utils/blog';
import type {SiteLang} from '../utils/lang-paths';
interface Props{posts:BlogEntry[];lang?:SiteLang;}
const {posts,lang='fr'}=Astro.props;
const L=editorialUi(lang),{lead}=getHomeEditorialPosts(posts);
const latest=posts.filter(p=>!p.data.noindex)[0];
const latestText=latest?await getLocalizedPostText(latest,lang):null;
const feed=[...(lead?[lead]:[]),...posts.filter(p=>!p.data.noindex&&p.id!==lead?.id).slice(0,6)];
const headings={fr:'Les échecs, sous un autre angle.',en:'Chess, from another angle.','pt-br':'O xadrez, sob outro ângulo.',nl:'Schaken vanuit een andere hoek.'};
---
{latest&&latestText&&<div class="bv-ticker"><span>{L.latest}</span><a href={await getPostUrlLang(latest,lang)}>{latestText.title}</a><time datetime={latest.data.publishDate.toISOString()}>{formatDateForLang(latest.data.publishDate,lang)}</time><span aria-hidden="true">↗</span></div>}
<header class="bv-home-intro"><p>{L.strap}</p><h1 id="home-heading">{headings[lang]}</h1></header>
<ReadingPaths lang={lang} />
<div class="bv-home-grid"><section aria-labelledby="home-heading"><div class="bv-home-feed">{feed.map((post,i)=><BlogviCard post={post} lang={lang} featured={i===0}/>)}</div><a class="resource-button bv-home-all" href={`/${lang}/blog/`}>{L.all} →</a></section><BlogviSidebar posts={posts} lang={lang}/></div>
<style>
.bv-ticker{display:flex;align-items:center;gap:16px;padding:10px 14px;border:1px solid var(--bv-line);border-radius:16px;background:var(--bv-paper);margin:0 0 26px;font-size:14px}.bv-ticker>span:first-child{padding:9px 16px;border-radius:9px;background:var(--green);color:var(--on-green);font-weight:550;white-space:nowrap}.bv-ticker>a{flex:1;color:var(--text-main);font-weight:550}.bv-ticker>time{font-size:12px;white-space:nowrap;color:var(--text-muted)}.bv-home-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:28px;margin-top:28px}.bv-home-grid>section{min-width:0}.bv-home-grid>:global(.bv-sidebar){padding-top:0}.bv-home-intro{margin-bottom:24px}.bv-home-intro>p{font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:650;color:var(--green);margin:0 0 8px}.bv-home-intro h1{font-size:32px;margin:0;line-height:1.2}.bv-home-feed{display:grid;gap:24px}.bv-home-all{display:inline-flex;margin-top:28px}
@media(max-width:900px){.bv-home-grid{display:block}.bv-home-grid>:global(.bv-sidebar){padding-top:28px}}@media(max-width:600px){.bv-ticker{font-size:12px;gap:10px}.bv-ticker>time{display:none}.bv-ticker>span:first-child{padding:8px 10px;font-size:11px}.bv-ticker>a{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.bv-home-intro h1{font-size:27px}}
</style>
