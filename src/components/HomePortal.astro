---
import EditorialHomeTop from "./EditorialHomeTop.astro";
import EditorialHomeRest from "./EditorialHomeRest.astro";
import { getAllPosts, filterPostsForLang } from "../utils/blog";
import type { SiteLang } from "../utils/lang-paths";
interface Props {lang:SiteLang;}
const {lang}=Astro.props;
const posts=filterPostsForLang(await getAllPosts(),lang);
---
<div class="portal"><div class="container"><EditorialHomeTop posts={posts} lang={lang} /><EditorialHomeRest posts={posts} lang={lang} /></div></div>
<style>.portal{padding:.5rem 0 1rem;background:var(--bg);}</style>
