---
const { lang = "fr" } = Astro.props as { lang?: "fr" | "en" | "pt-br" | "nl" };
const VAPID_KEY = import.meta.env.PUBLIC_NTFY_VAPID_KEY ?? "";
const pushEnabled = !!VAPID_KEY;

const pushCopy = {
  fr: { aria: "Activer les notifications push", off: "Notifications", on: "Notifié ✓", error: "Erreur", titleOn: "Cliquer pour se désabonner", titleOff: "Recevoir une notification à chaque nouvel article" },
  en: { aria: "Enable push notifications", off: "Notifications", on: "Subscribed ✓", error: "Error", titleOn: "Click to unsubscribe", titleOff: "Get notified for each new article" },
  "pt-br": { aria: "Ativar notificações push", off: "Notificações", on: "Inscrito ✓", error: "Erro", titleOn: "Clique para cancelar", titleOff: "Receber uma notificação a cada novo artigo" },
  nl: { aria: "Pushmeldingen inschakelen", off: "Meldingen", on: "Geabonneerd ✓", error: "Fout", titleOn: "Klik om af te melden", titleOff: "Ontvang een melding bij elk nieuw artikel" },
} as const;
const p = pushCopy[lang] ?? pushCopy.fr;
---

{pushEnabled && (
  <div class="push-subscribe" id="push-subscribe-wrap">
    <button
      type="button"
      id="push-subscribe-btn"
      class="push-btn"
      aria-label={p.aria}
      data-vapid={VAPID_KEY}
      data-label-on={p.on}
      data-label-off={p.off}
      data-label-error={p.error}
      data-title-on={p.titleOn}
      data-title-off={p.titleOff}
    >
      <svg class="push-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
      </svg>
      <span class="push-label" id="push-label">{p.off}</span>
    </button>
  </div>
)}

<script>
import { getPushActive, setPushEnabled } from '../scripts/push-preferences.mjs';
function initPushSubscribe() {
  const btn = document.getElementById("push-subscribe-btn") as HTMLButtonElement;
  const label = document.getElementById("push-label");
  if (!btn || !label || btn.dataset.bound === "1") return;
  btn.dataset.bound = "1";
  if (!("serviceWorker" in navigator) || !("PushManager" in window) || !("Notification" in window)) {
    document.getElementById("push-subscribe-wrap")?.remove(); return;
  }
  const key = btn.dataset.vapid || "";
  let active = false;
  let busy = false;
  function display(state: string) {
    btn.disabled = state === "loading";
    btn.classList.toggle("push-btn--active", state === "on");
    btn.classList.toggle("push-btn--error", state === "error");
    btn.setAttribute("aria-pressed", String(state === "on"));
    label!.textContent = state === "loading" ? "…" : btn.dataset[state === "on" ? "labelOn" : state === "error" ? "labelError" : "labelOff"] || "Notifications";
    btn.title = btn.dataset[state === "on" ? "titleOn" : "titleOff"] || "";
  }
  async function refresh() {
    if (busy) return;
    try { const current = await getPushActive(key); if (!busy) { active = current; display(active ? "on" : "off"); } }
    catch { display("error"); }
  }
  display("off");
  void refresh();
  const onUpdate = () => { void refresh(); };
  document.addEventListener("push:updated", onUpdate);
  document.addEventListener("astro:before-swap", () => document.removeEventListener("push:updated", onUpdate), { once: true });
  btn.addEventListener("click", async () => {
    busy = true;
    display("loading");
    try { active = await setPushEnabled(!active, key); display(active ? "on" : "off"); }
    catch { display("error"); }
    finally { busy = false; }
  });
}
document.addEventListener("astro:page-load", initPushSubscribe);
initPushSubscribe();
</script>

<style>
  .push-subscribe {
    margin-top: 0.5rem;
  }

  .push-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-soft);
    background: transparent;
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 180ms ease, color 180ms ease, background 180ms ease;
  }

  .push-btn:hover:not(:disabled) {
    border-color: var(--green-border);
    color: var(--green);
  }

  .push-btn:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .push-btn--active {
    border-color: var(--green-border);
    background: color-mix(in srgb, var(--green-light) 60%, transparent);
    color: var(--green);
  }

  .push-btn--error {
    border-color: #c0392b;
    color: #c0392b;
  }

  .push-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
</style>
