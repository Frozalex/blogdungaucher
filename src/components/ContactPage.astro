const c = COPY[lang] ?? COPY.fr;
const canonicalPath = swapLangPrefix("/fr/contact/", lang);
const aboutHref = swapLangPrefix("/fr/about/", lang);
/** Le flux RSS n'existe qu'en FR et EN. */
const rssHref = lang === "en" ? "/en/rss.xml" : "/rss.xml";
const inLanguage =
  lang === "en" ? "en-US" : lang === "pt-br" ? "pt-BR" : lang === "nl" ? "nl-NL" : "fr-FR";

const contactPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${siteConfig.siteUrl}${canonicalPath}#contactpage`,
  url: `${siteConfig.siteUrl}${canonicalPath}`,
  name: c.breadcrumb,
  description: c.seoDescription,
  inLanguage,
  mainEntity: {
    "@type": "Organization",
    "@id": `${siteConfig.siteUrl}/#publisher`,
    name: siteConfig.name,
    url: siteConfig.siteUrl,
    email: EMAIL,
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "customer support",
      email: EMAIL,
      availableLanguage: ["fr", "en", "pt-BR", "nl"],
    },
  },
};
---
<BaseLayout
  title={c.seoTitle}
  description={c.seoDescription}
  canonicalPath={canonicalPath}
  lang={lang}
  structuredData={[
    buildBreadcrumbJsonLd([
      { name: c.homeLabel, path: swapLangPrefix("/", lang) },
      { name: c.breadcrumb, path: canonicalPath },
    ]),
    contactPageJsonLd,
  ]}
>
  <section class="contact">
    <div class="container">

      {/* ── Hero centré, chevrons + filet pointillé (repris de la maquette) ── */}
      <header class="c-hero fade-up">
        <div class="c-hero__line">
          <span class="c-hero__chev c-hero__chev--l" aria-hidden="true"></span>
          <h1 class="c-hero__title">{c.heroTitle}</h1>
          <span class="c-hero__chev c-hero__chev--r" aria-hidden="true"></span>
        </div>
        <span class="c-hero__rule" aria-hidden="true"></span>
      </header>

      <div class="c-layout">

        {/* ── Panneau sombre : le formulaire ── */}
        <div class="c-panel fade-up" style="--motion-delay: 80ms;">
          <h2 class="c-panel__title">{c.formTitle}</h2>

          <form class="c-form" data-contact-form data-email={EMAIL} novalidate>
            <div class="c-field">
              <label class="c-label" for="cf-name">{c.fieldName}</label>
              <input class="c-input" id="cf-name" name="name" type="text" autocomplete="name" required />
            </div>

            <div class="c-field">
              <label class="c-label" for="cf-email">{c.fieldEmail}</label>
              <input class="c-input" id="cf-email" name="email" type="email" autocomplete="email" required />
            </div>

            <div class="c-field">
              <label class="c-label" for="cf-subject">{c.fieldSubject}</label>
              <select class="c-input c-select" id="cf-subject" name="subject" required>
                <option value="" disabled selected>{c.subjectPlaceholder}</option>
                {c.subjects.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>

            <div class="c-field">
              <label class="c-label" for="cf-message">{c.fieldMessage}</label>
              <textarea class="c-input c-textarea" id="cf-message" name="message" rows="6" required></textarea>
            </div>

            <p class="c-error" data-form-error aria-live="polite" hidden></p>

            <button class="c-submit" type="submit">{c.submit}</button>
            <p class="c-hint">{c.submitHint}</p>
          </form>
        </div>

        {/* ── Carte flottante : infos de contact ── */}
        <aside class="c-card fade-up" style="--motion-delay: 160ms;">
          <p class="c-card__pill">{c.cardPill}</p>

          <div class="c-card__body">
            <p class="c-card__intro">{c.cardIntro}</p>

            <h2 class="c-card__title">{c.infoTitle}</h2>
            <dl class="c-info">
              <div class="c-info__row">
                <dt>{c.emailRow}</dt>
                <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
              </div>
              <div class="c-info__row">
                <dt>{c.siteRow}</dt>
                <dd>blogdungaucher.com</dd>
              </div>
              <div class="c-info__row">
                <dt>{c.delayRow}</dt>
                <dd>{c.delayValue}</dd>
              </div>
              <div class="c-info__row">
                <dt>{c.langRow}</dt>
                <dd>{c.langValue}</dd>
              </div>
            </dl>

            <p class="c-card__note">{c.noAddress}</p>

            <h2 class="c-card__title c-card__title--follow">{c.followTitle}</h2>
            <div class="c-social">
              <a class="c-social__link" href={CHESS_URL} target="_blank" rel="noopener noreferrer">
                {/* Marque Chess.com (simple-icons, CC0). */}
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0a3.85 3.85 0 0 0-3.875 3.846A3.84 3.84 0 0 0 9.73 6.969l-2.79 1.85c0 .622.144 1.114.434 1.649H9.83c-.014.245-.014.549-.014.925 0 .025.003.048.006.071-.064 1.353-.507 3.472-3.62 5.842-.816.625-1.423 1.495-1.806 2.533a.33.33 0 0 0-.045.084 8.124 8.124 0 0 0-.39 2.516c0 .1.216 1.561 8.038 1.561s8.038-1.46 8.038-1.561c0-2.227-.824-4.048-2.24-5.133-4.034-3.08-3.586-5.74-3.644-6.838h2.458c.29-.535.434-1.027.434-1.649l-2.79-1.836a3.86 3.86 0 0 0 1.604-3.123A3.873 3.873 0 0 0 13.445.275c-.004-.002-.01.004-.015.004A3.76 3.76 0 0 0 12 0Z"/>
                </svg>
                {c.chessLabel}
              </a>
              <a class="c-social__link" href={rssHref}>
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                  <circle cx="6.2" cy="17.8" r="2.2"/>
                  <path d="M4 10.2v3a6.8 6.8 0 0 1 6.8 6.8h3A9.8 9.8 0 0 0 4 10.2Zm0-6v3A15.8 15.8 0 0 1 19.8 23h3A18.8 18.8 0 0 0 4 4.2Z"/>
                </svg>
                {c.rssLabel}
              </a>
            </div>

            <p class="c-card__about">
              {c.aboutLine[0]} <a href={aboutHref}>{c.aboutLabel}</a> {c.aboutLine[1]}
            </p>
          </div>
        </aside>

      </div>

      <p class="c-privacy fade-up" style="--motion-delay: 200ms;">
        {c.privacy[0]} <a href={PRIVACY_HREF}>{c.privacy[1]}</a>{c.privacy[2]}
      </p>

    </div>
  </section>
</BaseLayout>

<script>
  /* Le site est en `output: "static"` : aucun endpoint pour recevoir un POST. Le formulaire
     assemble donc un lien mailto: (objet + corps préremplis) et laisse le client mail de
     l'utilisateur faire l'envoi. Le libellé du bouton et la note sous le formulaire le disent
     explicitement pour ne pas laisser croire à un envoi depuis la page.

     Initialisé au niveau module ET sur astro:page-load : au tout premier chargement,
     astro:page-load n'arrive qu'au window load, ce qui laisserait le formulaire inerte
     pendant plusieurs centaines de ms sur connexion lente. */
  const MSG = {
    fr: { required: "Merci de remplir tous les champs.", email: "Adresse email invalide." },
    en: { required: "Please fill in every field.", email: "Invalid email address." },
    "pt-br": { required: "Preencha todos os campos.", email: "Endereço de e-mail inválido." },
    nl: { required: "Vul alle velden in.", email: "Ongeldig e-mailadres." },
  } as const;

  function bindContactForm() {
    document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
      if (form.dataset.bound === "1") return;
      form.dataset.bound = "1";

      const email = form.dataset.email!;
      const err = form.querySelector<HTMLElement>("[data-form-error]")!;

      form.addEventListener("submit", (e) => {
        e.preventDefault();

        const lang = document.documentElement.lang || "fr";
        const T = MSG[lang as keyof typeof MSG] ?? MSG.fr;

        const get = (n: string) =>
          (form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
            `[name="${n}"]`,
          )!).value.trim();

        const name = get("name");
        const from = get("email");
        const subject = get("subject");
        const message = get("message");

        const fail = (text: string) => {
          err.textContent = text;
          err.hidden = false;
        };

        if (!name || !from || !subject || !message) return fail(T.required);
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(from)) return fail(T.email);

        err.hidden = true;

        // Le corps reprend l'expéditeur : si la personne écrit depuis une autre adresse que
        // celle saisie, on garde quand même une trace de celle qu'elle veut voir utilisée.
        const body = `${message}\n\n--\n${name}\n${from}`;
        const href =
          `mailto:${email}` +
          `?subject=${encodeURIComponent(`[${subject}] ${name}`)}` +
          `&body=${encodeURIComponent(body)}`;

        window.location.href = href;
      });
    });
  }

  bindContactForm();
  document.addEventListener("astro:page-load", bindContactForm);
</script>

<style>
  /* Panneau sombre : teinte dérivée du vert du site plutôt que le cyan de la maquette,
     pour rester dans la charte. */
  .contact {
    --panel: #2f4a3c;
    --panel-soft: rgba(255, 255, 255, 0.09);
    --scallop: 15px;
    padding: 3rem 0 5rem;
  }

  :global([data-theme="dark"]) .contact {
    --panel: #23342c;
  }

  .contact .container {
    max-width: 68rem;
  }

  /* ── Hero ── */
  .c-hero {
    text-align: center;
    margin-bottom: 3rem;
  }

  .c-hero__line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
  }

  .c-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 6.4vw, 3.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--panel);
    margin: 0;
  }

  :global([data-theme="dark"]) .c-hero__title {
    color: var(--text-main);
  }

  /* Chevrons pleins de la maquette, en CSS pur (pas d'image à charger). */
  .c-hero__chev {
    width: 0;
    height: 0;
    border-top: 0.62rem solid transparent;
    border-bottom: 0.62rem solid transparent;
    flex: none;
  }

  .c-hero__chev--l {
    border-left: 0.85rem solid var(--green);
  }

  .c-hero__chev--r {
    border-right: 0.85rem solid var(--green);
  }

  .c-hero__rule {
    display: block;
    width: min(24rem, 70%);
    height: 2px;
    margin: 0.9rem auto 0;
    background-image: linear-gradient(to right, var(--border-strong) 55%, transparent 55%);
    background-size: 11px 2px;
    background-repeat: repeat-x;
  }

  /* ── Grille : panneau + carte chevauchante ── */
  .c-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: start;
    gap: 0;
  }

  /* ── Panneau formulaire ── */
  .c-panel {
    background: var(--panel);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    padding: 2.2rem 2.2rem calc(2.2rem + var(--scallop));
    /* Bosses arrondies en bas, comme la maquette : une bande de hauteur --scallop
       n'est conservée que là où les demi-cercles la couvrent. */
    -webkit-mask:
      radial-gradient(circle at 50% 0, #000 var(--scallop), #0000 calc(var(--scallop) + 0.5px))
        50% 100% / calc(2 * var(--scallop)) var(--scallop) repeat-x,
      linear-gradient(#000 0 0) 0 0 / 100% calc(100% - var(--scallop)) no-repeat;
    mask:
      radial-gradient(circle at 50% 0, #000 var(--scallop), #0000 calc(var(--scallop) + 0.5px))
        50% 100% / calc(2 * var(--scallop)) var(--scallop) repeat-x,
      linear-gradient(#000 0 0) 0 0 / 100% calc(100% - var(--scallop)) no-repeat;
    /* La carte de droite passe par-dessus. */
    margin-right: -3.5rem;
  }

  .c-panel__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 1.4rem;
  }

  /* ── Formulaire ── */
  .c-field {
    margin-bottom: 0.8rem;
  }

  .c-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 0.35rem;
  }

  .c-input {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-main);
    background: var(--surface);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    padding: 0.72rem 0.85rem;
    transition:
      border-color var(--motion-fast) var(--ease-out),
      box-shadow var(--motion-fast) var(--ease-out);
  }

  .c-input:focus-visible {
    outline: none;
    border-color: var(--green);
    box-shadow: 0 0 0 3px var(--green-light);
  }

  .c-select {
    appearance: none;
    /* Chevron dessiné en CSS : deux dégradés qui forment les deux branches. */
    background-image:
      linear-gradient(45deg, transparent 50%, currentColor 50%),
      linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      calc(100% - 1.05rem) calc(50% + 0.1rem),
      calc(100% - 0.75rem) calc(50% + 0.1rem);
    background-size: 0.3rem 0.3rem, 0.3rem 0.3rem;
