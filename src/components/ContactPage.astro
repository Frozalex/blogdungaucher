---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbJsonLd } from "../utils/blog";
import { siteConfig } from "../data/site";
import { swapLangPrefix, type SiteLang } from "../utils/lang-paths";

const { lang = "fr" } = Astro.props as { lang?: SiteLang };

const EMAIL = "contact@blogdungaucher.com";
const CHESS_URL = "https://www.chess.com/member/le_gaucher";

/** Les pages légales n'existent qu'en FR : toutes les langues y pointent (cf. Footer). */
const PRIVACY_HREF = "/fr/politique-confidentialite/";

type Copy = {
  homeLabel: string;
  breadcrumb: string;
  seoTitle: string;
  seoDescription: string;
  /** Titre du hero, encadré par les chevrons de la maquette. */
  heroTitle: string;
  formTitle: string;
  fieldName: string;
  fieldEmail: string;
  fieldSubject: string;
  fieldMessage: string;
  subjectPlaceholder: string;
  /** Options du menu Sujet : servent de préfixe d'objet dans le mailto. */
  subjects: string[];
  submit: string;
  submitHint: string;
  errRequired: string;
  errEmail: string;
  cardPill: string;
  cardIntro: string;
  infoTitle: string;
  emailRow: string;
  siteRow: string;
  delayRow: string;
  delayValue: string;
  langRow: string;
  langValue: string;
  noAddress: string;
  followTitle: string;
  chessLabel: string;
  rssLabel: string;
  aboutLabel: string;
  aboutLine: [string, string];
  privacy: [string, string, string];
