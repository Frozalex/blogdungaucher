---
/**
 * Overlay de recherche global (style « command palette »).
 * Inclus une seule fois dans BaseLayout, disponible sur TOUTES les pages.
 * Ouverture : clic sur un élément [data-search-trigger] (icône loupe navbar),
 * touche « / », ou Ctrl/⌘+K. Fermeture : Échap, clic sur le fond, bouton.
 * Résultats instantanés via Pagefind, scopés à la langue de la page.
 * La page /recherche/ reste disponible comme recherche plein écran (repli).
 */
const { lang = "fr" } = Astro.props as { lang?: "fr" | "en" | "pt-br" | "nl" };

const copy = {
  fr: { placeholder: "Rechercher un article…", dialog: "Recherche", start: "Ex. Alzheimer, TDAH, Elo, minimax, dopamine…", allLink: "Recherche avancée" },
  en: { placeholder: "Search articles…", dialog: "Search", start: "e.g. Alzheimer, ADHD, Elo, minimax, dopamine…", allLink: "Advanced search" },
  "pt-br": { placeholder: "Buscar artigos…", dialog: "Busca", start: "ex. Alzheimer, TDAH, Elo, minimax, dopamina…", allLink: "Busca avançada" },
  nl: { placeholder: "Artikelen zoeken…", dialog: "Zoeken", start: "bijv. Alzheimer, ADHD, Elo, minimax, dopamine…", allLink: "Uitgebreid zoeken" },
} as const;
const c = copy[lang] ?? copy.fr;
const searchPageHref = `/${lang}/recherche/`;
---

<div class="search-overlay" id="searchOverlay" data-search-overlay data-lang={lang} hidden>
  <div class="search-overlay__backdrop" data-search-close aria-hidden="true"></div>
  <div class="search-overlay__panel" role="dialog" aria-modal="true" aria-label={c.dialog}>
    <div class="search-overlay__box">
      <svg class="search-overlay__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        type="search"
        id="searchOverlayInput"
        class="search-overlay__input"
        placeholder={c.placeholder}
        aria-label={c.placeholder}
        autocomplete="off"
        spellcheck="false"
      />
      <button class="search-overlay__esc" data-search-close type="button" aria-label="Fermer"><kbd>Esc</kbd></button>
    </div>
    <p class="search-overlay__state" data-search-state aria-live="polite">{c.start}</p>
    <ul class="search-overlay__results" data-search-results role="list"></ul>
    <a class="search-overlay__all" href={searchPageHref} data-search-all hidden>{c.allLink} →</a>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    justify-items: center;
    align-content: start;
    padding: clamp(3rem, 12vh, 8rem) 1rem 2rem;
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .search-overlay[hidden] { display: none; }
  .search-overlay.is-open { opacity: 1; }

  .search-overlay__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, #0b0d10 55%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .search-overlay__panel {
    position: relative;
    width: min(40rem, 100%);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px rgba(0,0,0,0.35), var(--shadow-md);
    overflow: hidden;
    transform: translateY(-10px) scale(0.985);
    transition: transform 200ms var(--ease-out);
  }
  .search-overlay.is-open .search-overlay__panel { transform: translateY(0) scale(1); }

  .search-overlay__box {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .search-overlay__icon { color: var(--text-dim); flex-shrink: 0; }

  .search-overlay__input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: var(--text-main);
    font-family: var(--font-display);
    font-size: 1.05rem;
    outline: none;
  }
  .search-overlay__input::placeholder { color: var(--text-dim); }

  .search-overlay__esc {
    flex-shrink: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }
  .search-overlay__esc kbd {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface-warm);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.45rem;
    box-shadow: 0 1px 0 var(--border-soft);
  }

  .search-overlay__state {
    margin: 0;
    padding: 0.7rem 1.15rem;
    font-size: 0.82rem;
    color: var(--text-dim);
  }

  .search-overlay__results {
    list-style: none;
    margin: 0;
    padding: 0 0.5rem 0.5rem;
    max-height: min(52vh, 30rem);
    overflow-y: auto;
    display: grid;
    gap: 0.15rem;
  }
  .search-overlay__results:empty { display: none; }

  /* Résultats injectés en JS → pas d'attribut de scope Astro : globalisés via le parent. */
  .search-overlay__results :global(.search-overlay__result) {
    display: block;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 120ms ease, border-color 120ms ease;
  }
  .search-overlay__results :global(.search-overlay__result:hover),
  .search-overlay__results :global(.search-overlay__result.is-active) {
    background: var(--surface-warm);
    border-color: var(--border-soft);
  }
  .search-overlay__results :global(.search-overlay__result strong) {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 0.15rem;
  }
  .search-overlay__results :global(.search-overlay__result span) {
    display: block;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-overlay__results :global(.search-overlay__result mark) {
    background: color-mix(in srgb, var(--green) 26%, transparent);
    color: inherit;
    border-radius: 3px;
    padding: 0 0.1em;
  }

  .search-overlay__all {
    display: block;
    padding: 0.7rem 1.15rem;
    border-top: 1px solid var(--border-soft);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--green);
    text-decoration: none;
  }
  .search-overlay__all[hidden] { display: none; }
  .search-overlay__all:hover { background: var(--surface-warm); }

  @media (max-width: 560px) {
    .search-overlay { padding-top: 2rem; }
    .search-overlay__input { font-size: 16px; } /* évite le zoom auto iOS */
  }

  @media (prefers-reduced-motion: reduce) {
    .search-overlay, .search-overlay__panel { transition: none; }
  }
</style>

<script>
  // Messages dynamiques par langue (le placeholder + le message initial sont rendus côté serveur).
  const MESSAGES: Record<string, { searching: string; empty: string; min: string; start: string; unavailable: string; count: (n: number) => string }> = {
    fr:      { searching: "Recherche…",  empty: "Aucun résultat pour",  min: "Continuez à taper…", start: "Ex. Alzheimer, TDAH, Elo, minimax, dopamine…",   unavailable: "Recherche indisponible (build requis).", count: (n) => `${n} résultat${n > 1 ? "s" : ""}` },
    en:      { searching: "Searching…",  empty: "No results for",       min: "Keep typing…",       start: "e.g. Alzheimer, ADHD, Elo, minimax, dopamine…",  unavailable: "Search unavailable (build required).",   count: (n) => `${n} result${n > 1 ? "s" : ""}` },
    "pt-br": { searching: "Buscando…",   empty: "Nenhum resultado para", min: "Continue digitando…",start: "ex. Alzheimer, TDAH, Elo, minimax, dopamina…",  unavailable: "Busca indisponível (build necessário).", count: (n) => `${n} resultado${n > 1 ? "s" : ""}` },
    nl:      { searching: "Zoeken…",     empty: "Geen resultaten voor",  min: "Blijf typen…",       start: "bijv. Alzheimer, ADHD, Elo, minimax, dopamine…",unavailable: "Zoeken niet beschikbaar (build vereist).",count: (n) => `${n} resultaat${n > 1 ? "ten" : ""}` },
  };

  type PfResult = { url: string; excerpt: string; meta: Record<string, string> };

  let pfPromise: Promise<any> | null = null;
  let overlayCtrl: AbortController | null = null;

  function initSearchOverlay() {
    const overlay = document.getElementById("searchOverlay");
    if (!overlay) return;
    const input   = overlay.querySelector<HTMLInputElement>("#searchOverlayInput");
    const stateEl = overlay.querySelector<HTMLElement>("[data-search-state]");
    const listEl  = overlay.querySelector<HTMLUListElement>("[data-search-results]");
    const allLink = overlay.querySelector<HTMLElement>("[data-search-all]");
    if (!input || !stateEl || !listEl) return;

    const lang = overlay.dataset.lang || "fr";
    const M = MESSAGES[lang] || MESSAGES.fr;

    if (overlayCtrl) overlayCtrl.abort();
    overlayCtrl = new AbortController();
    const { signal } = overlayCtrl;

    let activeIdx = -1;

    async function getPagefind() {
      try {
        if (!pfPromise) {
          pfPromise = (async () => {
            const url = window.location.origin + "/pagefind/pagefind.js";
            const mod = await import(/* @vite-ignore */ url);
            await mod.init();
            return mod;
          })();
        }
        const mod = await pfPromise;
        // Scoping par langue ré-appliqué à chaque appel : la nav SPA peut avoir
        // changé la langue depuis l'init (module mis en cache globalement).
        if (mod && typeof mod.options === "function") {
          await mod.options({ language: lang });
        }
        return mod;
      } catch {
        return null;
      }
    }

    function isOpen() { return !overlay.hidden; }

    function openOverlay() {
      if (isOpen()) return;
      overlay.hidden = false;
      document.documentElement.style.overflow = "hidden";
      requestAnimationFrame(() => {
        overlay.classList.add("is-open");
        input.focus();
        input.select();
      });
      getPagefind(); // préchauffe l'index
    }

    function closeOverlay() {
      overlay.classList.remove("is-open");
      document.documentElement.style.overflow = "";
      window.setTimeout(() => { overlay.hidden = true; }, 190);
    }

    function setActive(idx: number) {
      const links = Array.from(listEl.querySelectorAll<HTMLAnchorElement>(".search-overlay__result"));
      if (!links.length) { activeIdx = -1; return; }
      activeIdx = ((idx % links.length) + links.length) % links.length;
      links.forEach((a, i) => {
        const on = i === activeIdx;
        a.classList.toggle("is-active", on);
        if (on) a.scrollIntoView({ block: "nearest" });
      });
    }

    function render(results: PfResult[], q: string) {
      listEl.innerHTML = "";
      activeIdx = -1;
      if (!results.length) {
        stateEl.textContent = `${M.empty} « ${q} »`;
        if (allLink) allLink.hidden = false;
        return;
      }
      stateEl.textContent = M.count(results.length);
      results.forEach((d) => {
        const li = document.createElement("li");
        const title = d.meta?.title || d.url;
        li.innerHTML =
          `<a href="${d.url}" class="search-overlay__result"><strong>${title}</strong><span>${d.excerpt}</span></a>`;
        listEl.appendChild(li);
      });
      if (allLink) allLink.hidden = false;
    }

    let seq = 0;
    async function runSearch(raw: string) {
      const q = raw.trim();
      const mine = ++seq;
      if (q.length < 2) {
        stateEl.textContent = q.length === 1 ? M.min : M.start;
        listEl.innerHTML = "";
        if (allLink) allLink.hidden = true;
        return;
      }
      stateEl.textContent = M.searching;
      const pf = await getPagefind();
      if (mine !== seq) return; // une frappe plus récente a pris le relais
      if (!pf) { stateEl.textContent = M.unavailable; return; }
      const response = await pf.search(q);
      if (mine !== seq) return;
      const data = await Promise.all(response.results.slice(0, 8).map((r: any) => r.data()));
      if (mine !== seq) return;
      render(data as PfResult[], q);
    }

    input.addEventListener("input", () => runSearch(input.value), { signal });

    input.addEventListener("keydown", (e) => {
      const links = Array.from(listEl.querySelectorAll<HTMLAnchorElement>(".search-overlay__result"));
      if (e.key === "ArrowDown") { e.preventDefault(); setActive(activeIdx + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive(activeIdx - 1); }
      else if (e.key === "Enter") {
        const target = activeIdx >= 0 ? links[activeIdx] : links[0];
        if (target) { e.preventDefault(); target.click(); }
      }
    }, { signal });

    // Déclencheurs d'ouverture
    document.querySelectorAll("[data-search-trigger]").forEach((t) => {
      t.addEventListener("click", (e) => { e.preventDefault(); openOverlay(); }, { signal });
    });
    overlay.querySelectorAll("[data-search-close]").forEach((el) => {
      el.addEventListener("click", closeOverlay, { signal });
    });

    document.addEventListener("keydown", (e) => {
      const target = e.target as HTMLElement | null;
      const typing = target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable);
      const onSearchPage = /\/recherche\/?$/.test(window.location.pathname);
      if ((e.key === "/" && !typing && !onSearchPage) ||
          (e.key.toLowerCase() === "k" && (e.metaKey || e.ctrlKey))) {
        e.preventDefault();
        openOverlay();
      } else if (e.key === "Escape" && isOpen()) {
        e.preventDefault();
        closeOverlay();
      }
    }, { signal });
  }

  document.addEventListener("astro:page-load", initSearchOverlay);
</script>
