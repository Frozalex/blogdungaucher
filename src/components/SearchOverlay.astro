---
/**
 * Overlay de recherche global (style « command palette »).
 * Inclus une seule fois dans BaseLayout, disponible sur TOUTES les pages.
 * Ouverture : clic sur un élément [data-search-trigger] (icône loupe navbar),
 * touche « / », ou Ctrl/⌘+K. Fermeture : Échap, clic sur le fond, bouton.
 * Catalogue commun de tous les formats, complété par le plein texte Pagefind.
 * La page /recherche/ reste disponible comme recherche plein écran (repli).
 */
const { lang = "fr" } = Astro.props as { lang?: "fr" | "en" | "pt-br" | "nl" };

const copy = {
  fr: { placeholder: "Rechercher dans le site…", dialog: "Recherche", start: "Ex. Alzheimer, TDAH, Elo, minimax, dopamine…", allLink: "Tous les résultats et filtres", close: "Fermer" },
  en: { placeholder: "Search the site…", dialog: "Search", start: "e.g. Alzheimer, ADHD, Elo, minimax, dopamine…", allLink: "All results and filters", close: "Close" },
  "pt-br": { placeholder: "Buscar no site…", dialog: "Busca", start: "ex. Alzheimer, TDAH, Elo, minimax, dopamina…", allLink: "Todos os resultados e filtros", close: "Fechar" },
  nl: { placeholder: "Zoek op de site…", dialog: "Zoeken", start: "bijv. Alzheimer, ADHD, Elo, minimax, dopamine…", allLink: "Alle resultaten en filters", close: "Sluiten" },
} as const;
const c = copy[lang] ?? copy.fr;
const searchPageHref = `/${lang}/recherche/`;
---

<div class="search-overlay" id="searchOverlay" data-search-overlay data-lang={lang} data-search-index={`/search-index/${lang}.json`} hidden>
  <div class="search-overlay__backdrop" data-search-close aria-hidden="true"></div>
  <div class="search-overlay__panel" role="dialog" aria-modal="true" aria-label={c.dialog}>
    <div class="search-overlay__box">
      <svg class="search-overlay__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        type="search"
        id="searchOverlayInput"
        class="search-overlay__input"
        placeholder={c.placeholder}
        aria-label={c.placeholder}
        aria-controls="searchOverlayResults"
        aria-describedby="searchOverlayState"
        autocomplete="off"
        spellcheck="false"
      />
      <button class="search-overlay__esc" data-search-close type="button" aria-label={`${c.close} (Esc)`}><kbd>Esc</kbd><svg class="search-overlay__close-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
    </div>
    <p id="searchOverlayState" class="search-overlay__state" data-search-state aria-live="polite">{c.start}</p>
    <ul id="searchOverlayResults" class="search-overlay__results" data-search-results role="list"></ul>
    <p class="search-overlay__state" data-search-partial aria-live="polite" hidden></p>
    <a class="search-overlay__all" href={searchPageHref} data-search-all>{c.allLink} →</a>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    justify-items: center;
    align-content: start;
    --search-top: clamp(3rem, 12vh, 8rem);
    --search-bottom: 2rem;
    padding: var(--search-top) 1rem var(--search-bottom);
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .search-overlay[hidden] { display: none; }
  .search-overlay.is-open { opacity: 1; }

  .search-overlay__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, #0b0d10 55%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .search-overlay__panel {
    position: relative;
    width: min(40rem, 100%);
    display: flex;
    flex-direction: column;
    max-height: calc(100dvh - var(--search-top) - var(--search-bottom));
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px rgba(0,0,0,0.35), var(--shadow-md);
    overflow: hidden;
    transform: translateY(-10px) scale(0.985);
    transition: transform 200ms var(--ease-out);
  }
  .search-overlay.is-open .search-overlay__panel { transform: translateY(0) scale(1); }

  .search-overlay__box {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .search-overlay__icon { color: var(--text-dim); flex-shrink: 0; }

  .search-overlay__input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: var(--text-main);
    font-family: var(--font-display);
    font-size: 1.05rem;
    outline: none;
  }
  .search-overlay__input::placeholder { color: var(--text-dim); }

  .search-overlay__esc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--text-main);
    flex-shrink: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
  }
  .search-overlay__close-icon { display: none; }
  .search-overlay__esc:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .search-overlay__esc kbd {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface-warm);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    padding: 0.15rem 0.45rem;
    box-shadow: 0 1px 0 var(--border-soft);
  }

  .search-overlay__state[hidden] { display: none; }
  .search-overlay__state {
    flex-shrink: 0;
    margin: 0;
    padding: 0.7rem 1.15rem;
    font-size: 0.82rem;
    color: var(--text-dim);
  }

  .search-overlay__results {
    list-style: none;
    margin: 0;
    padding: 0 0.5rem 0.5rem;
    min-height: 0;
    flex: 0 1 auto;
    max-height: min(52dvh, 30rem);
    overscroll-behavior: contain;
    overflow-y: auto;
    display: grid;
    gap: 0.15rem;
  }
  .search-overlay__results:empty { display: none; }

  /* Résultats injectés en JS → pas d'attribut de scope Astro : globalisés via le parent. */
  .search-overlay__results :global(.search-overlay__result) {
    display: block;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 120ms ease, border-color 120ms ease;
  }
  .search-overlay__results :global(.search-overlay__result:hover),
  .search-overlay__results :global(.search-overlay__result.is-active) {
    background: var(--surface-warm);
    border-color: var(--border-soft);
  }
  .search-overlay__results :global(.search-overlay__result:focus-visible) {
    outline: 2px solid var(--green);
    outline-offset: -2px;
    background: var(--surface-warm);
  }
  .search-overlay__results :global(.search-overlay__result small) {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--green);
    font-size: 0.7rem;
    font-weight: 600;
  }
  .search-overlay__results :global(.search-overlay__result strong) {
    display: block;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 0.15rem;
  }
  .search-overlay__results :global(.search-overlay__result span) {
    display: block;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-overlay__results :global(.search-overlay__result mark) {
    background: color-mix(in srgb, var(--green) 26%, transparent);
    color: inherit;
    border-radius: 3px;
    padding: 0 0.1em;
  }

  .search-overlay__all {
    flex-shrink: 0;
    display: block;
    padding: 0.7rem 1.15rem;
    border-top: 1px solid var(--border-soft);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--green);
    text-decoration: none;
  }
  .search-overlay__all[hidden] { display: none; }
  .search-overlay__all:hover { background: var(--surface-warm); }

  @media (max-width: 960px) {
    .search-overlay { --search-top: 1rem; --search-bottom: 1rem; }
    .search-overlay__esc kbd { display: none; }
    .search-overlay__close-icon { display: block; }
    .search-overlay__input { font-size: 16px; } /* évite le zoom auto iOS */
  }

  @media (prefers-reduced-motion: reduce) {
    .search-overlay, .search-overlay__panel { transition: none; }
  }
</style>

<script>
  import "../scripts/search-overlay";
</script>
