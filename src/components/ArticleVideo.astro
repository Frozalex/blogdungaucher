---
/**
 * Lecteur vidéo intégré aux articles.
 *
 * Affiche un MP4 produit par Motion Canvas (cf. motion-canvas/README.md pour
 * le workflow de rendu). Le fichier vit dans `public/videos/` et est référencé
 * via le champ frontmatter `summaryVideo` de l'article (chemin commençant par /).
 *
 * Si le fichier n'existe pas encore (asset absent), le composant ne rend rien.
 * Le `<noscript>` fallback garantit que la vidéo reste lisible sans JS.
 */
interface Props {
  src: string;
  poster?: string | null;
  title: string;
  /** Texte du label "RÉSUMÉ VIDÉO" / "VIDEO RECAP" / etc. */
  eyebrow?: string;
  accentColor?: string;
  /** Note libre sous le lecteur (durée, source, statut imperfections). */
  note?: string;
}

const {
  src,
  poster,
  title,
  eyebrow = "Résumé vidéo",
  accentColor = "#3d8b37",
  note,
} = Astro.props;
---

<figure class="article-video" style={`--av-accent: ${accentColor};`}>
  <figcaption class="article-video__eyebrow">{eyebrow}</figcaption>
  <video
    class="article-video__player"
    controls
    preload="metadata"
    poster={poster ?? undefined}
    aria-label={title}
  >
    <source src={src} type="video/mp4" />
    Ton navigateur ne supporte pas la lecture vidéo HTML5.
  </video>
  {note && <p class="article-video__note">{note}</p>}
</figure>

<style>
  .article-video {
    margin: 2rem 0 2.25rem;
    padding: 0;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-left: 4px solid var(--av-accent);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .article-video__eyebrow {
    display: block;
    padding: 0.85rem 1.1rem 0.65rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--av-accent);
    border-bottom: 1px solid var(--border-soft);
  }

  .article-video__player {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0d0d0d;
    border: none;
  }

  .article-video__note {
    margin: 0;
    padding: 0.75rem 1.1rem 0.95rem;
    font-family: var(--font-display);
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--av-accent) 5%, var(--surface));
  }
</style>
