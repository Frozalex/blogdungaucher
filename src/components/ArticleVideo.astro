---
/**
 * Lecteur vidéo intégré aux articles.
 *
 * Affiche un MP4 déposé dans `public/videos/` et référencé
 * via le champ frontmatter `summaryVideo` de l'article (chemin commençant par /).
 *
 * Les pages d'articles vérifient la présence du fichier avant d'afficher le lecteur.
 * Les contrôles HTML natifs permettent la lecture sans JavaScript.
 */
interface Props {
  src: string;
  poster?: string | null;
  title: string;
  /** Texte du label "RÉSUMÉ VIDÉO" / "VIDEO RECAP" / etc. */
  eyebrow?: string;
  accentColor?: string;
  /** Note libre sous le lecteur (durée, source, statut imperfections). */
  note?: string;
  transcript?: Array<{ heading: string; text: string }>;
}

const {
  src,
  poster,
  title,
  eyebrow = "Résumé vidéo",
  accentColor = "#3d8b37",
  note,
  transcript = [],
} = Astro.props;
---

<figure class="article-video" style={`--av-accent: ${accentColor};`}>
  <figcaption class="article-video__eyebrow">{eyebrow}</figcaption>
  <video
    class="article-video__player"
    controls
    preload="none"
    playsinline
    poster={poster ?? undefined}
    aria-label={title}
  >
    <source src={src} type="video/mp4" />
    Ton navigateur ne supporte pas la lecture vidéo HTML5.
  </video>
  {note && <p class="article-video__note">{note}</p>}
  {transcript.length > 0 && (
    <details class="article-video__transcript">
      <summary>Lire le résumé en texte</summary>
      <div>
        {transcript.map((scene) => (
          <section>
            <h2>{scene.heading}</h2>
            <p>{scene.text}</p>
          </section>
        ))}
      </div>
    </details>
  )}
</figure>

<style>
  .article-video {
    margin: 2rem 0 2.25rem;
    padding: 0;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-left: 4px solid var(--av-accent);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .article-video__eyebrow {
    display: block;
    padding: 0.85rem 1.1rem 0.65rem;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--av-accent);
    border-bottom: 1px solid var(--border-soft);
  }

  .article-video__player {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0d0d0d;
    border: none;
  }

  .article-video__note {
    margin: 0;
    padding: 0.75rem 1.1rem 0.95rem;
    font-family: var(--font-display);
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--text-muted);
    background: color-mix(in srgb, var(--av-accent) 5%, var(--surface));
  }

  .article-video__transcript {
    border-top: 1px solid var(--border-soft);
    padding: 0.9rem 1.1rem;
    line-height: 1.65;
  }

  .article-video__transcript summary {
    cursor: pointer;
    font-weight: 600;
  }

  .article-video__transcript h2 {
    font-size: 1rem;
    margin: 1.1rem 0 0.3rem;
  }

  .article-video__transcript p { margin: 0; }
</style>
