---
interface Props {
  lang?: "fr" | "en" | "pt-br" | "nl";
  postId?: string;
}
const { lang = "fr", postId } = Astro.props;

const remark42Url  = import.meta.env.PUBLIC_REMARK42_URL  ?? "";
const remark42Site = import.meta.env.PUBLIC_REMARK42_SITE ?? "blog-gaucher";

const localeMap: Record<string, string> = { fr: "fr", en: "en", "pt-br": "pt-BR", nl: "nl" };
const locale = localeMap[lang] ?? "fr";

const copy: Record<string, { title: string }> = {
  fr: { title: "Commentaires" },
  en: { title: "Comments" },
  "pt-br": { title: "Comentários" },
  nl: { title: "Reacties" },
};
const t = copy[lang] ?? copy.fr;

// remark42 is only embedded when a URL is configured
const enabled = remark42Url !== "";
---

<section class="comments" id="commentaires" data-pagefind-ignore>
  <h2>{t.title}</h2>

  {enabled ? (
    <div
      id="remark42"
      data-r42-url={remark42Url}
      data-r42-site={remark42Site}
      data-r42-locale={locale}
      data-r42-post-id={postId}
    />
  ) : (
    <p class="comments-unavailable">Commentaires indisponibles en mode développement.</p>
  )}
</section>

<script>
  // Boot remark42 once; reinitialise on each View Transition page load.
  // Guard on window.__r42Boot prevents double-registration of event listeners.
  declare global {
    interface Window {
      __r42Boot?: boolean;
      REMARK42?: {
        destroy: () => void;
        createInstance: (cfg: Record<string, unknown>) => void;
        changeTheme: (theme: string) => void;
      };
    }
  }

  function getTheme(): string {
    return document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
  }

  function mountRemark42() {
    const container = document.getElementById("remark42") as HTMLElement | null;
    if (!container) return;

    const url    = container.dataset.r42Url;
    const siteId = container.dataset.r42Site;
    const locale = container.dataset.r42Locale ?? "fr";
    const postId = container.dataset.r42PostId;
    if (!url || !siteId) return;

    const config: Record<string, unknown> = {
      host:    url,
      site_id: siteId,
      locale,
      theme:   getTheme(),
      components: ["embed"],
    };
    if (postId) config.page_id = postId;

    if (window.REMARK42) {
      window.REMARK42.createInstance(config);
      return;
    }

    // Inject the remark42 embed script once
    const script = document.createElement("script");
    script.src   = `${url}/web/embed.js`;
    script.defer = true;
    // remark42 reads window.remark_config on load
    (window as unknown as Record<string, unknown>)["remark_config"] = config;
    document.head.appendChild(script);
  }

  if (!window.__r42Boot) {
    window.__r42Boot = true;

    document.addEventListener("astro:before-swap", () => {
      window.REMARK42?.destroy();
    });

    document.addEventListener("astro:page-load", () => {
      mountRemark42();
    });

    // Sync theme changes in real time
    const themeObserver = new MutationObserver(() => {
      window.REMARK42?.changeTheme(getTheme());
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }

  // Initial mount (first page load - astro:page-load fires before this script on SSG)
  mountRemark42();
</script>

<style>
  .comments {
    margin-top: 1.1rem;
    padding: 1.5rem 1.6rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-left: 4px solid var(--c, var(--green));
    box-shadow: var(--shadow-xs);
  }

  .comments h2 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.35rem;
    color: var(--c, var(--green));
    margin: 0 0 1rem;
  }

  .comments-unavailable {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  @media (max-width: 560px) {
    .comments { padding: 1.25rem 1.15rem; }
  }
</style>
