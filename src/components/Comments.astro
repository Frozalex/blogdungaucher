---
/**
 * Bloc "Une réaction ?" en fin d'article.
 *
 * Volontairement sobre : un seul CTA, un email direct. Pas de système de
 * commentaires (Giscus a été retiré : compte GitHub requis = friction
 * massive pour le lecteur, et fréquence de vraies réactions très faible
 * sur ce type de contenu éditorial long).
 *
 * Si l'on veut un jour réactiver Giscus, l'ancienne implémentation est
 * dans l'historique git (commit avant la refonte UX du 17 mai 2026).
 */
interface Props {
  lang?: "fr" | "en" | "de";
}
const { lang = "fr" } = Astro.props;

const contactEmail = "contact@blogdungaucher.com";

const copy = {
  fr: {
    title: "Une réaction ?",
    lead:
      "Un avis, une nuance, un témoignage : un email arrive directement, je le lis et je réponds.",
    subject: "Réaction à l'article",
    aria: `Envoyer un email à ${contactEmail}`,
  },
  en: {
    title: "Have a reaction?",
    lead:
      "A thought, a nuance, a story: an email lands directly with me, I read every one and reply.",
    subject: "Reaction to the article",
    aria: `Send an email to ${contactEmail}`,
  },
  de: {
    title: "Eine Reaktion?",
    lead:
      "Eine Meinung, ein Hinweis, eine Erfahrung: eine E-Mail kommt direkt bei mir an, ich lese jede und antworte.",
    subject: "Reaktion auf den Artikel",
    aria: `E-Mail an ${contactEmail} senden`,
  },
};
const t = copy[lang];
---

<section class="comments" id="commentaires">
  <h2>{t.title}</h2>
  <p class="comments-lead">{t.lead}</p>

  <a
    href={`mailto:${contactEmail}?subject=${encodeURIComponent(t.subject)}`}
    class="comments-email-cta"
    aria-label={t.aria}
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2"/>
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
    </svg>
    <span class="comments-email-cta__addr">{contactEmail}</span>
  </a>
</section>

<style>
  .comments {
    margin-top: 1.1rem;
    padding: 1.5rem 1.6rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-left: 4px solid var(--c, var(--green));
    box-shadow: var(--shadow-xs);
  }

  .comments h2 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.35rem;
    color: var(--c, var(--green));
    margin: 0 0 0.45rem;
  }

  .comments-lead {
    margin: 0 0 1.1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 38rem;
  }

  .comments-email-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.15rem;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--c, var(--green));
    background: color-mix(in srgb, var(--c, var(--green)) 8%, var(--surface));
    color: var(--c, var(--green));
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 160ms ease,
      box-shadow 160ms ease,
      transform 160ms var(--ease-spring);
  }

  .comments-email-cta:hover {
    background: color-mix(in srgb, var(--c, var(--green)) 16%, var(--surface));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c, var(--green)) 18%, transparent);
    transform: translateY(-1px);
  }
  .comments-email-cta:active {
    transform: translateY(0);
  }

  .comments-email-cta__addr {
    /* font monospace-ish pour faire "lien email" tout en gardant l'identité */
    font-feature-settings: "tnum" 1;
  }

  @media (max-width: 560px) {
    .comments { padding: 1.25rem 1.15rem; }
    .comments-email-cta {
      width: 100%;
      justify-content: center;
    }
  }
</style>
