---
// Localisation côté serveur (le dict runtime ne couvre que fr/en) — même pattern
// que HomeLanding/NewsletterForm : un objet `copy` par langue.
//
// Depuis le 2026-10-13, ce panneau ne gère QUE les notifications push ntfy.
// Les catégories « Publicité » et « Mesure d'audience » ont été retirées : le
// consentement publicitaire relève du CMP certifié de Google (livré par le script
// AdSense, cf. BaseLayout) et Google Analytics a été supprimé du site au profit
// d'Umami, auto-hébergé et sans cookie.
//
// Conséquence : le panneau ne s'ouvre plus de lui-même à la première visite — sinon
// il s'empilerait avec la fenêtre du CMP Google. Il s'ouvre uniquement à la demande,
// via « Notifications » en pied de page.
const { lang = "fr" } = Astro.props as { lang?: "fr" | "en" | "pt-br" | "nl" };

const consentCopy = {
  fr: {
    brand: "Blog d'un Gaucher",
    title: "Notifications de nouveaux articles",
    intro: "Recevez une alerte dans votre navigateur à chaque publication. Aucun cookie n'est posé pour cela, et c'est révocable à tout moment.",
    pushName: "Notifications push",
    pushDesc: "Alerte navigateur à chaque nouvel article (2 par semaine). Le navigateur demandera confirmation.",
    enable: "Activer les notifications",
    decline: "Non merci",
    save: "Enregistrer mon choix",
    footerNote: "Vos préférences de publicité sont gérées par la fenêtre de consentement de Google, distincte de ce réglage.",
    privacyLink: "Politique de confidentialité →",
  },
  en: {
    brand: "A Left-Hander's Blog",
    title: "New article notifications",
    intro: "Get a browser alert whenever an article goes live. No cookie is set for this, and you can turn it off at any time.",
    pushName: "Push notifications",
    pushDesc: "Browser alert for each new article (2 per week). The browser will ask for confirmation.",
    enable: "Enable notifications",
    decline: "No thanks",
    save: "Save my choice",
    footerNote: "Your advertising preferences are handled by Google's own consent window, separate from this setting.",
    privacyLink: "Privacy policy →",
  },
  "pt-br": {
    brand: "Blog de um Canhoto",
    title: "Notificações de novos artigos",
    intro: "Receba um alerta no navegador a cada publicação. Nenhum cookie é usado para isso, e você pode desativar quando quiser.",
    pushName: "Notificações push",
    pushDesc: "Alerta do navegador a cada novo artigo (2 por semana). O navegador pedirá confirmação.",
    enable: "Ativar notificações",
    decline: "Não, obrigado",
    save: "Salvar minha escolha",
    footerNote: "As suas preferências de publicidade são gerenciadas pela janela de consentimento do Google, separada deste ajuste.",
    privacyLink: "Política de privacidade →",
  },
  nl: {
    brand: "Blog van een Linkshandige",
    title: "Meldingen bij nieuwe artikelen",
    intro: "Ontvang een browsermelding bij elke publicatie. Hiervoor wordt geen cookie geplaatst, en je kunt het altijd uitzetten.",
    pushName: "Pushmeldingen",
    pushDesc: "Browsermelding bij elk nieuw artikel (2 per week). De browser vraagt om bevestiging.",
    enable: "Meldingen aanzetten",
    decline: "Nee, bedankt",
    save: "Mijn keuze opslaan",
    footerNote: "Je advertentievoorkeuren worden beheerd door het consentvenster van Google, los van deze instelling.",
    privacyLink: "Privacybeleid →",
  },
} as const;
const c = consentCopy[lang] ?? consentCopy.fr;
// La politique existe désormais dans les 4 langues, sous un slug différent
// par langue : on pointe vers celle du lecteur plutôt que vers le FR.
const privacyHref =
  lang === "en"
    ? "/en/privacy-policy/"
    : lang === "pt-br"
      ? "/pt-br/politica-de-privacidade/"
      : lang === "nl"
        ? "/nl/privacybeleid/"
        : "/fr/politique-confidentialite/";
---

{/* ── Backdrop ──────────────────────────────────────────────── */}
<div class="consent-backdrop" id="consent-backdrop" hidden aria-hidden="true"></div>

{/* ── Modal de consentement ──────────────────────────────── */}
<div
  class="consent-panel"
  id="consent-panel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="consent-title"
  hidden
>
  <div class="consent-header">
    <span class="consent-badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6z"/>
        <circle cx="12" cy="11" r="1.8"/>
        <path d="M12 12.8v2.4"/>
      </svg>
    </span>
    <span class="consent-site">{c.brand}</span>
  </div>

  <h2 class="consent-title" id="consent-title">{c.title}</h2>

  <p class="consent-text" set:html={c.intro}></p>

  <fieldset class="consent-fieldset">
    <legend class="consent-fieldset__legend">{c.pushName}</legend>

    <label class="consent-option">
      <span class="consent-option__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9a6 6 0 0112 0c0 4.5 1.8 5.8 1.8 5.8H4.2S6 13.5 6 9z"/><path d="M10 19a2 2 0 004 0"/>
        </svg>
      </span>
      <span class="consent-option__body">
        <span class="consent-option__name">{c.pushName}</span>
        <span class="consent-option__desc">{c.pushDesc}</span>
      </span>
      <input type="checkbox" id="cookie-notifications" class="consent-switch-input" />
      <span class="consent-switch" aria-hidden="true"></span>
    </label>
  </fieldset>

  <p id="consent-error" role="alert" hidden></p>

  <div class="consent-quick">
    <button type="button" class="consent-btn consent-btn--primary" id="consent-accept">
      {c.enable}
    </button>
    <button type="button" class="consent-btn consent-btn--ghost" id="consent-reject">
      {c.decline}
    </button>
  </div>

  <div class="consent-save-wrap">
    <button type="button" class="consent-btn consent-btn--save" id="consent-save">
      {c.save}
    </button>
  </div>

  <p class="consent-footer-note">
    {c.footerNote}
    <a href={privacyHref} class="consent-privacy-link">{c.privacyLink}</a>
  </p>
</div>

{/*
  Déclencheur programmatique (utilisé par le footer).
  Invisible et non-interactif pour l'utilisateur, mais .click() fonctionne via JS.
*/}
<button
  type="button"
  id="cookie-manage"
  aria-label="Gérer les cookies"
  aria-hidden="true"
  tabindex="-1"
  style="position:absolute;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none"
></button>

<script>
  import { readPushPreference, setPushEnabled } from "../scripts/push-preferences.mjs";
  (function () {
    var _prevFocus: HTMLElement | null = null;

    /* ── Persistance ──────────────────────────────────────── */
    function readConsent() { return { notifications: readPushPreference() }; }
    async function writeConsent(payload: { notifications: boolean }) {
      var error = document.getElementById("consent-error");
      var buttons = [...document.querySelectorAll<HTMLButtonElement>("#consent-panel button")];
      buttons.forEach(button => { button.disabled = true; });
      if (error) error.hidden = true;
      try {
        await setPushEnabled(Boolean(payload.notifications), import.meta.env.PUBLIC_NTFY_VAPID_KEY || "");
        syncForm(readConsent());
        hideModal();
      } catch (_) {
        if (error) {
          error.textContent = ({fr: "Impossible d’enregistrer ce choix. Vérifiez l’autorisation du navigateur puis réessayez.", en: "Unable to save. Check browser permission and try again.", "pt-BR": "Não foi possível salvar. Verifique a permissão e tente novamente.", nl: "Opslaan mislukt. Controleer de browsertoestemming en probeer opnieuw."} as Record<string, string>)[document.documentElement.lang] || "Unable to save. Please try again.";
          error.hidden = false;
        }
      } finally { buttons.forEach(button => { button.disabled = false; }); }
    }

    /* ── Formulaire ───────────────────────────────────────── */
    function syncForm(consent: { notifications: boolean }) {
      var n = document.getElementById("cookie-notifications") as HTMLInputElement | null;
      if (!n) return;
      n.checked = Boolean(consent && consent.notifications);
    }

    /* ── Affichage du modal ───────────────────────────────── */
    function showModal() {
      var backdrop = document.getElementById("consent-backdrop");
      var panel    = document.getElementById("consent-panel");
      if (!backdrop || !panel) return;
      _prevFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      backdrop.hidden = false;
      panel.hidden    = false;
      document.body.style.setProperty("overflow", "hidden");
      requestAnimationFrame(function () {
        var btn = panel!.querySelector("button");
        if (btn) btn.focus();
      });
    }

    function hideModal() {
      var backdrop = document.getElementById("consent-backdrop");
      var panel    = document.getElementById("consent-panel");
      if (!backdrop || !panel) return;
      backdrop.hidden = true;
      panel.hidden    = true;
      document.body.style.removeProperty("overflow");
      if (_prevFocus) { _prevFocus.focus(); _prevFocus = null; }
    }

    /* ── Init (appelé à chaque transition Astro) ─────────── */
    function bindClick(el: HTMLElement | null, handler: () => void) {
      if (!el || el.dataset.consentBound === "1") return;
      el.dataset.consentBound = "1";
      el.addEventListener("click", handler);
    }

    function initCookieConsent() {
      var panel    = document.getElementById("consent-panel");
      var backdrop = document.getElementById("consent-backdrop");
      if (!panel || !backdrop) return;

      var acceptBtn  = document.getElementById("consent-accept");
      var rejectBtn  = document.getElementById("consent-reject");
      var saveBtn    = document.getElementById("consent-save");
      var manageBtn  = document.getElementById("cookie-manage");
      var notifI     = document.getElementById("cookie-notifications") as HTMLInputElement | null;

      // Plus d'ouverture automatique : le panneau ne porte qu'un réglage optionnel
      // (notifications), et la fenêtre de première visite appartient au CMP Google.
      // Deux modales empilées à l'arrivée seraient ingérables.
      syncForm(readConsent());
      if (!panel.hidden) hideModal();

      bindClick(acceptBtn, function () {
        writeConsent({ notifications : true });
      });

      bindClick(rejectBtn, function () {
        writeConsent({ notifications : false });
      });

      bindClick(saveBtn, function () {
        writeConsent({ notifications: notifI ? notifI.checked : false });
      });

      // Ouverture depuis le footer (« Notifications »)
      bindClick(manageBtn, function () {
        syncForm(readConsent());
        showModal();
      });
    }

    /* ── Keyboard : focus trap + ESC ─────────────────────── */
    document.addEventListener("keydown", function (e) {
      var panel = document.getElementById("consent-panel");
      if (!panel || panel.hidden) return;

      // ESC ferme toujours : le panneau ne s'ouvre plus qu'à la demande, et il ne
      // porte aucun choix obligatoire qu'il faudrait forcer avant de le refermer.
      if (e.key === "Escape") {
        hideModal();
        return;
      }

      // Focus trap : garder le focus dans le modal
      if (e.key === "Tab") {
        var focusable = panel.querySelectorAll(
          'button:not([disabled]), input[type="checkbox"], a[href]'
        );
        var arr = Array.from(focusable) as HTMLElement[];
        if (!arr.length) return;
        var first = arr[0];
        var last  = arr[arr.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    /* ── Restaurer overflow avant transitions Astro ───────── */
    document.addEventListener("astro:before-swap", function () {
      document.body.style.removeProperty("overflow");
    });

    document.addEventListener("astro:page-load", initCookieConsent);
    initCookieConsent();
  })();
</script>

<style>
  /* Accent du modal (façon CMP). Changer cette seule valeur pour tout re-teinter
     (ex. var(--green) pour rester sur la couleur de marque). */
  .consent-panel {
    --consent-accent: #534ab7;
    --consent-accent-hover: #443c99;
    --consent-accent-tint: color-mix(in srgb, var(--consent-accent) 12%, transparent);
  }

  /* ── hidden override ── */
  .consent-backdrop[hidden],
  .consent-panel[hidden] {
    display: none;
  }

  /* ── Backdrop ──────────────────────────────────────────── */
  .consent-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(10, 10, 15, 0.55);
    -webkit-backdrop-filter : blur(3px);
    backdrop-filter: blur(3px);
  }

  .consent-backdrop:not([hidden]) {
    animation: consent-backdrop-in 220ms ease both;
  }

  @keyframes consent-backdrop-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Panel ─────────────────────────────────────────────── */
  .consent-panel {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 201;
    width: min(480px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-lg), 0 0 0 1px rgba(0, 0, 0, 0.04);
    padding: 1.6rem 1.6rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .consent-panel:not([hidden]) {
    animation: consent-panel-in 300ms var(--ease-out) both;
  }

  @keyframes consent-panel-in {
    from { opacity: 0; transform : translate(-50%, calc(-50% + 20px)); }
    to   { opacity: 1; transform : translate(-50%, -50%); }
  }

  /* ── Header (badge + marque) ───────────────────────────── */
  .consent-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .consent-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--consent-accent-tint);
    color: var(--consent-accent);
  }

  .consent-badge svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .consent-site {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-dim);
    letter-spacing: 0.02em;
  }

  /* ── Title ─────────────────────────────────────────────── */
  .consent-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
    line-height: 1.25;
  }

  /* ── Body text ─────────────────────────────────────────── */
  .consent-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .consent-text strong {
    color: var(--text-main);
    font-weight: 600;
  }

  /* ── Boutons rapides ───────────────────────────────────── */
  .consent-quick {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  /* ── Boutons ───────────────────────────────────────────── */
  .consent-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid transparent;
    touch-action: manipulation;
    -webkit-tap-highlight-color : transparent;
    user-select: none;
    transition:
      background 120ms ease,
      border-color 120ms ease,
      color 120ms ease,
      box-shadow 120ms ease,
      transform 120ms var(--ease-out),
      opacity 120ms ease;
    white-space: nowrap;
  }

  .consent-btn:focus { outline: none; }

  .consent-btn:focus-visible {
    outline: 2px solid var(--consent-accent);
    outline-offset: 2px;
  }

  .consent-btn:active {
    transform: scale(0.98);
    transition-duration: 60ms;
  }

  @media (hover : hover) and (pointer : fine) {
    .consent-btn:hover { transform: translateY(-1px); }
    .consent-btn:active { transform: translateY(0) scale(0.99); }
  }

  .consent-btn--primary {
    background: var(--consent-accent);
    color: #fff;
    border-color: var(--consent-accent);
  }
  .consent-btn--primary:active {
    background: var(--consent-accent-hover);
    border-color: var(--consent-accent-hover);
  }

  @media (hover : hover) and (pointer : fine) {
    .consent-btn--primary:hover {
      background: var(--consent-accent-hover);
      border-color: var(--consent-accent-hover);
      box-shadow: 0 4px 16px color-mix(in srgb, var(--consent-accent) 38%, transparent);
    }
  }

  .consent-btn--ghost {
    background: transparent;
    color: var(--text-muted);
    border-color: var(--border-strong);
  }
  .consent-btn--ghost:active {
    color: var(--text-main);
    background: var(--bg-warm);
  }

  @media (hover : hover) and (pointer : fine) {
    .consent-btn--ghost:hover {
      color: var(--text-main);
      border-color: var(--text-muted);
      background: var(--bg-warm);
    }
  }

  .consent-btn--save {
    width: 100%;
    background: var(--consent-accent);
    color: #fff;
    border-color: var(--consent-accent);
  }
  .consent-btn--save:active {
    background: var(--consent-accent-hover);
    border-color: var(--consent-accent-hover);
  }

  @media (hover : hover) and (pointer : fine) {
    .consent-btn--save:hover {
      background: var(--consent-accent-hover);
      border-color: var(--consent-accent-hover);
    }
  }

  /* ── Fieldset options ──────────────────────────────────── */
  .consent-fieldset {
    margin: 0;
    padding: 0 0.9rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
  }

  .consent-fieldset__legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* ── Ligne d'option (avec interrupteur) ────────────────── */
  .consent-option {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border-soft);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color : transparent;
  }

  .consent-option:last-of-type { border-bottom: none; }

  .consent-option__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--consent-accent-tint);
    color: var(--consent-accent);
  }

  .consent-option__icon svg { width: 1.05rem; height: 1.05rem; }

  .consent-option__body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
    min-width: 0;
  }

  .consent-option__name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-main);
  }

  .consent-option__desc {
    font-size: 0.78rem;
    color: var(--text-dim);
    line-height: 1.45;
  }

  /* ── Interrupteur (checkbox stylée en toggle) ──────────── */
  .consent-switch-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    margin: 0;
    pointer-events: none;
  }

  .consent-switch {
    position: relative;
    flex-shrink: 0;
    width: 2.6rem;
    height: 1.5rem;
    margin-top: 0.15rem;
    border-radius: 999px;
    background: var(--border-strong);
    transition: background 180ms var(--ease-out);
  }

  .consent-switch::after {
    content: "";
    position: absolute;
    top: 0.18rem;
    left: 0.18rem;
    width: 1.14rem;
    height: 1.14rem;
    border-radius: 50%;
    background: #fff;
    transition: left 180ms var(--ease-out);
  }

  .consent-switch-input:checked ~ .consent-switch {
    background: var(--consent-accent);
  }

  .consent-switch-input:checked ~ .consent-switch::after {
    left: 1.28rem;
  }

  .consent-switch-input:focus-visible ~ .consent-switch {
    outline: 2px solid var(--consent-accent);
    outline-offset: 2px;
  }

  .consent-save-wrap {
    padding: 0.9rem;
    padding-top: 0.75rem;
  }

  /* ── Note de bas ───────────────────────────────────────── */
  .consent-footer-note {
    font-size: 0.76rem;
    color: var(--text-dim);
    line-height: 1.55;
    margin: 0;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border-soft);
  }

  .consent-privacy-link {
    color: var(--consent-accent);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .consent-privacy-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ── Mobile ────────────────────────────────────────────── */
  @media (max-width: 560px) {
    .consent-panel {
      width: calc(100vw - 1.25rem);
      max-height: calc(100dvh - 1.25rem - env(safe-area-inset-bottom, 0px));
      padding: 1.25rem 1.25rem calc(1rem + env(safe-area-inset-bottom, 0px));
      border-radius: var(--radius-lg);
      top: auto;
      bottom: max(0.625rem, env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
    }

    .consent-btn { min-height: 3rem; font-size: 0.94rem; }

    .consent-panel:not([hidden]) {
      animation: consent-panel-mobile-in 300ms var(--ease-out) both;
    }

    @keyframes consent-panel-mobile-in {
      from { opacity: 0; transform : translateX(-50%) translateY(20px); }
      to   { opacity: 1; transform : translateX(-50%) translateY(0); }
    }

    .consent-quick { grid-template-columns: 1fr; }
  }

  /* ── Accessibilité : réduction de mouvement ────────────── */
  @media (prefers-reduced-motion : reduce) {
    .consent-backdrop:not([hidden]),
    .consent-panel:not([hidden]) {
      animation: none;
    }
    .consent-switch,
    .consent-switch::after { transition: none; }
  }
</style>
