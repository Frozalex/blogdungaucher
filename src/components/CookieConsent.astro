---
// Localisation côté serveur (le dict runtime ne couvre que fr/en) — même pattern
// que HomeLanding/NewsletterForm : un objet `copy` par langue.
// Design « façon CMP » : modal centré, interrupteurs, catégorie « nécessaires »
// toujours active, accent indigo (var --consent-accent, changer ici pour tout basculer).
const { lang = "fr" } = Astro.props as { lang?: "fr" | "en" | "pt-br" | "nl" };

const consentCopy = {
  fr: {
    brand: "Blog d'un Gaucher",
    title: "Nous respectons votre vie privée",
    intro: "Ce site utilise des cookies de <strong>mesure d'audience</strong> pour comprendre ce qui intéresse les lecteurs. Les <strong>notifications push</strong> sont indépendantes des cookies et entièrement optionnelles.",
    acceptAll: "Tout accepter",
    rejectAll: "Tout refuser",
    customize: "Personnaliser mes choix",
    chooseByCategory: "Choisir par catégorie",
    necessaryName: "Strictement nécessaires",
    necessaryDesc: "Indispensables au fonctionnement du site. Toujours actifs.",
    alwaysOn: "Toujours actif",
    analyticsName: "Mesure d'audience",
    analyticsDesc: "Google Analytics : comprendre combien de personnes lisent le blog et quels articles intéressent le plus.",
    pushName: "Notifications push",
    pushDesc: "Alerte navigateur à chaque nouvel article (2 par semaine). Le navigateur demandera confirmation. Révocable à tout moment.",
    save: "Enregistrer mes choix",
    footerNote: "Modifiable à tout moment via « Notifications et cookies » en bas de page.",
    privacyLink: "Politique de confidentialité →",
  },
  en: {
    brand: "A Left-Hander's Blog",
    title: "We respect your privacy",
    intro: "This site uses <strong>audience measurement</strong> cookies to understand what readers are interested in. <strong>Push notifications</strong> are independent of cookies and entirely optional.",
    acceptAll: "Accept all",
    rejectAll: "Reject all",
    customize: "Customize my choices",
    chooseByCategory: "Choose by category",
    necessaryName: "Strictly necessary",
    necessaryDesc: "Essential for the site to work. Always on.",
    alwaysOn: "Always on",
    analyticsName: "Audience measurement",
    analyticsDesc: "Google Analytics: see how many people read the blog and which articles are most popular.",
    pushName: "Push notifications",
    pushDesc: "Browser alert for each new article (2 per week). The browser will ask for confirmation. Revocable at any time.",
    save: "Save my choices",
    footerNote: "Changeable anytime via “Notifications & cookies” at the bottom of the page.",
    privacyLink: "Privacy policy →",
  },
  "pt-br": {
    brand: "Blog de um Canhoto",
    title: "Respeitamos a sua privacidade",
    intro: "Este site usa cookies de <strong>medição de audiência</strong> para entender o que interessa aos leitores. As <strong>notificações push</strong> são independentes dos cookies e totalmente opcionais.",
    acceptAll: "Aceitar tudo",
    rejectAll: "Recusar tudo",
    customize: "Personalizar minhas escolhas",
    chooseByCategory: "Escolher por categoria",
    necessaryName: "Estritamente necessários",
    necessaryDesc: "Essenciais para o funcionamento do site. Sempre ativos.",
    alwaysOn: "Sempre ativo",
    analyticsName: "Medição de audiência",
    analyticsDesc: "Google Analytics: entender quantas pessoas leem o blog e quais artigos despertam mais interesse.",
    pushName: "Notificações push",
    pushDesc: "Alerta do navegador a cada novo artigo (2 por semana). O navegador pedirá confirmação. Revogável a qualquer momento.",
    save: "Salvar minhas escolhas",
    footerNote: "Alterável a qualquer momento via « Notificações e cookies » no rodapé da página.",
    privacyLink: "Política de privacidade →",
  },
  nl: {
    brand: "Blog van een Linkshandige",
    title: "We respecteren je privacy",
    intro: "Deze site gebruikt cookies voor <strong>publieksmeting</strong> om te begrijpen wat lezers interesseert. <strong>Pushmeldingen</strong> staan los van cookies en zijn volledig optioneel.",
    acceptAll: "Alles accepteren",
    rejectAll: "Alles weigeren",
    customize: "Mijn keuzes aanpassen",
    chooseByCategory: "Kies per categorie",
    necessaryName: "Strikt noodzakelijk",
    necessaryDesc: "Essentieel voor de werking van de site. Altijd actief.",
    alwaysOn: "Altijd actief",
    analyticsName: "Publieksmeting",
    analyticsDesc: "Google Analytics: zien hoeveel mensen de blog lezen en welke artikelen het populairst zijn.",
    pushName: "Pushmeldingen",
    pushDesc: "Browsermelding bij elk nieuw artikel (2 per week). De browser vraagt om bevestiging. Op elk moment intrekbaar.",
    save: "Mijn keuzes opslaan",
    footerNote: "Altijd aanpasbaar via « Meldingen en cookies » onderaan de pagina.",
    privacyLink: "Privacybeleid →",
  },
} as const;
const c = consentCopy[lang] ?? consentCopy.fr;
// Seule la version FR de la politique existe → on y pointe quelle que soit la langue
// (évite un 404 sur /en/politique-confidentialite/ qui n'est pas générée).
const privacyHref = "/fr/politique-confidentialite/";
---

<!-- ── Backdrop ──────────────────────────────────────────────── -->
<div class="consent-backdrop" id="consent-backdrop" hidden aria-hidden="true"></div>

<!-- ── Modal de consentement ──────────────────────────────── -->
<div
  class="consent-panel"
  id="consent-panel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="consent-title"
  hidden
>
  <div class="consent-header">
    <span class="consent-badge" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6z"/>
        <circle cx="12" cy="11" r="1.8"/>
        <path d="M12 12.8v2.4"/>
      </svg>
    </span>
    <span class="consent-site">{c.brand}</span>
  </div>

  <h2 class="consent-title" id="consent-title">{c.title}</h2>

  <p class="consent-text" set:html={c.intro}></p>

  <div class="consent-quick">
    <button type="button" class="consent-btn consent-btn--primary" id="consent-accept">
      {c.acceptAll}
    </button>
    <button type="button" class="consent-btn consent-btn--ghost" id="consent-reject">
      {c.rejectAll}
    </button>
  </div>

  <details class="consent-details" id="consent-customize-details">
    <summary class="consent-summary">
      <span class="consent-summary__label">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="6" cy="8" r="2"/><path d="M8 8h11"/><path d="M5 8H4"/>
          <circle cx="16" cy="16" r="2"/><path d="M14 16H4"/><path d="M20 16h-2"/>
        </svg>
        <span>{c.customize}</span>
      </span>
      <svg
        class="consent-chevron"
        width="14" height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 9l6 6 6-6"/>
      </svg>
    </summary>

    <fieldset class="consent-fieldset">
      <legend class="consent-fieldset__legend">{c.chooseByCategory}</legend>

      <!-- Nécessaires : toujours actif, non modifiable -->
      <div class="consent-option consent-option--locked">
        <span class="consent-option__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 018 0v3"/>
          </svg>
        </span>
        <span class="consent-option__body">
          <span class="consent-option__name">{c.necessaryName}</span>
          <span class="consent-option__desc">{c.necessaryDesc}</span>
        </span>
        <span class="consent-switch consent-switch--on consent-switch--locked" aria-hidden="true"></span>
        <span class="sr-only">{c.alwaysOn}</span>
      </div>

      <label class="consent-option">
        <span class="consent-option__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19V5"/><path d="M4 19h16"/><path d="M8 16v-4"/><path d="M13 16V8"/><path d="M18 16v-2"/>
          </svg>
        </span>
        <span class="consent-option__body">
          <span class="consent-option__name">{c.analyticsName}</span>
          <span class="consent-option__desc">{c.analyticsDesc}</span>
        </span>
        <input type="checkbox" id="cookie-analytics" class="consent-switch-input" />
        <span class="consent-switch" aria-hidden="true"></span>
      </label>

      <label class="consent-option">
        <span class="consent-option__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9a6 6 0 0112 0c0 4.5 1.8 5.8 1.8 5.8H4.2S6 13.5 6 9z"/><path d="M10 19a2 2 0 004 0"/>
          </svg>
        </span>
        <span class="consent-option__body">
          <span class="consent-option__name">{c.pushName}</span>
          <span class="consent-option__desc">{c.pushDesc}</span>
        </span>
        <input type="checkbox" id="cookie-notifications" class="consent-switch-input" />
        <span class="consent-switch" aria-hidden="true"></span>
      </label>
    </fieldset>

    <div class="consent-save-wrap">
      <button type="button" class="consent-btn consent-btn--save" id="consent-save">
        {c.save}
      </button>
    </div>
  </details>

  <p class="consent-footer-note">
    {c.footerNote}
    <a href={privacyHref} class="consent-privacy-link">{c.privacyLink}</a>
  </p>
</div>

<!--
  Déclencheur programmatique (utilisé par le footer).
  Invisible et non-interactif pour l'utilisateur, mais .click() fonctionne via JS.
-->
<button
  type="button"
  id="cookie-manage"
  aria-label="Gérer les cookies"
  aria-hidden="true"
  tabindex="-1"
  style="position:absolute;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none"
></button>

<script is:inline>
  (function () {
    var KEY = "blogdungaucher.cookieConsent.v1";
    var _isManageMode = false;
    var _prevFocus = null;

    /* ── Persistance ──────────────────────────────────────── */
    function readConsent() {
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return null;
        var p = JSON.parse(raw);
        // Migration : anciens enregistrements sans "notifications"
        if (p && typeof p === "object" && !("notifications" in p)) {
          var migrated = {
            analytics: p.analytics,
            marketing: false,
            notifications: false,
            updatedAt: p.updatedAt || new Date().toISOString(),
          };
          localStorage.setItem(KEY, JSON.stringify(migrated));
          return migrated;
        }
        return p;
      } catch (_) {
        return null;
      }
    }

    function writeConsent(payload) {
      var normalized = {
        analytics: Boolean(payload.analytics),
        // Plus de régie publicitaire : marketing toujours false (catégorie retirée de l'UI).
        marketing: false,
        notifications: Boolean(payload.notifications),
        updatedAt: new Date().toISOString(),
      };
      localStorage.setItem(KEY, JSON.stringify(normalized));
      document.dispatchEvent(new CustomEvent("cookie:updated", { detail : normalized }));
      return normalized;
    }

    /* ── Formulaire ───────────────────────────────────────── */
    function syncForm(consent) {
      var a = document.getElementById("cookie-analytics");
      var n = document.getElementById("cookie-notifications");
      if (!a || !n) return;
      a.checked = Boolean(consent && consent.analytics);
      n.checked = Boolean(consent && consent.notifications);
    }

    /* ── Affichage du modal ───────────────────────────────── */
    function showModal() {
      var backdrop = document.getElementById("consent-backdrop");
      var panel    = document.getElementById("consent-panel");
      if (!backdrop || !panel) return;
      _prevFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      backdrop.hidden = false;
      panel.hidden    = false;
      document.body.style.setProperty("overflow", "hidden");
      requestAnimationFrame(function () {
        var btn = panel.querySelector("button");
        if (btn) btn.focus();
      });
    }

    function hideModal() {
      var backdrop = document.getElementById("consent-backdrop");
      var panel    = document.getElementById("consent-panel");
      if (!backdrop || !panel) return;
      backdrop.hidden = true;
      panel.hidden    = true;
      document.body.style.removeProperty("overflow");
      _isManageMode = false;
      if (_prevFocus) { _prevFocus.focus(); _prevFocus = null; }
    }

    /* ── Init (appelé à chaque transition Astro) ─────────── */
    function bindClick(el, handler) {
      if (!el || el.dataset.consentBound === "1") return;
      el.dataset.consentBound = "1";
      el.addEventListener("click", handler);
    }

    function initCookieConsent() {
      var panel    = document.getElementById("consent-panel");
      var backdrop = document.getElementById("consent-backdrop");
      if (!panel || !backdrop) return;

      var acceptBtn  = document.getElementById("consent-accept");
      var rejectBtn  = document.getElementById("consent-reject");
      var saveBtn    = document.getElementById("consent-save");
      var manageBtn  = document.getElementById("cookie-manage");
      var analyticsI = document.getElementById("cookie-analytics");
      var notifI     = document.getElementById("cookie-notifications");

      var current = readConsent();

      if (!current) {
        // Premier passage : pas de consentement stocké → ouvrir le modal
        _isManageMode = false;
        syncForm(null);
        showModal();
      } else {
        // Déjà consenti : s'assurer que le modal est fermé
        syncForm(current);
        if (!panel.hidden) hideModal();
      }

      bindClick(acceptBtn, function () {
        writeConsent({ analytics : true, notifications : true });
        hideModal();
      });

      bindClick(rejectBtn, function () {
        writeConsent({ analytics : false, notifications : false });
        hideModal();
      });

      bindClick(saveBtn, function () {
        writeConsent({
          analytics:     analyticsI ? analyticsI.checked : false,
          notifications: notifI     ? notifI.checked     : false,
        });
        hideModal();
      });

      // Ouverture depuis le footer (« Notifications et cookies »)
      bindClick(manageBtn, function () {
        _isManageMode = true;
        syncForm(readConsent());
        var details = document.getElementById("consent-customize-details");
        if (details) details.open = false;
        showModal();
      });
    }

    /* ── Keyboard : focus trap + ESC ─────────────────────── */
    document.addEventListener("keydown", function (e) {
      var panel = document.getElementById("consent-panel");
      if (!panel || panel.hidden) return;

      // ESC ferme seulement si l'utilisateur a déjà un consentement stocké
      if (e.key === "Escape" && _isManageMode) {
        hideModal();
        return;
      }

      // Focus trap : garder le focus dans le modal
      if (e.key === "Tab") {
        var focusable = panel.querySelectorAll(
          'button:not([disabled]), input[type="checkbox"], a[href], summary'
        );
        var arr = Array.prototype.slice.call(focusable);
        if (!arr.length) return;
        var first = arr[0];
        var last  = arr[arr.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    /* ── Restaurer overflow avant transitions Astro ───────── */
    document.addEventListener("astro:before-swap", function () {
      document.body.style.removeProperty("overflow");
    });

    document.addEventListener("astro:page-load", initCookieConsent);
  })();
</script>

<style>
  /* Accent du modal (façon CMP). Changer cette seule valeur pour tout re-teinter
     (ex. var(--green) pour rester sur la couleur de marque). */
  .consent-panel {
    --consent-accent: #534ab7;
    --consent-accent-hover: #443c99;
    --consent-accent-tint: color-mix(in srgb, var(--consent-accent) 12%, transparent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── hidden override ── */
  .consent-backdrop[hidden],
  .consent-panel[hidden] {
    display: none;
  }

  /* ── Backdrop ──────────────────────────────────────────── */
  .consent-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(10, 10, 15, 0.55);
    -webkit-backdrop-filter : blur(3px);
    backdrop-filter: blur(3px);
  }

  .consent-backdrop:not([hidden]) {
    animation: consent-backdrop-in 220ms ease both;
  }

  @keyframes consent-backdrop-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Panel ─────────────────────────────────────────────── */
  .consent-panel {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 201;
    width: min(480px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: var(--radius-xl);
    background: var(--surface);
    border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-lg), 0 0 0 1px rgba(0, 0, 0, 0.04);
    padding: 1.6rem 1.6rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .consent-panel:not([hidden]) {
    animation: consent-panel-in 300ms var(--ease-out) both;
  }

  @keyframes consent-panel-in {
    from { opacity: 0; transform : translate(-50%, calc(-50% + 20px)); }
    to   { opacity: 1; transform : translate(-50%, -50%); }
  }

  /* ── Header (badge + marque) ───────────────────────────── */
  .consent-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .consent-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--consent-accent-tint);
    color: var(--consent-accent);
  }

  .consent-badge svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .consent-site {
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-dim);
    letter-spacing: 0.02em;
  }

  /* ── Title ─────────────────────────────────────────────── */
  .consent-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
    line-height: 1.25;
  }

  /* ── Body text ─────────────────────────────────────────── */
  .consent-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .consent-text strong {
    color: var(--text-main);
    font-weight: 600;
  }

  /* ── Boutons rapides ───────────────────────────────────── */
  .consent-quick {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  /* ── Boutons ───────────────────────────────────────────── */
  .consent-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.55rem 1.15rem;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    border: 1.5px solid transparent;
    touch-action: manipulation;
    -webkit-tap-highlight-color : transparent;
    user-select: none;
    transition:
      background 120ms ease,
      border-color 120ms ease,
      color 120ms ease,
      box-shadow 120ms ease,
      transform 120ms var(--ease-out),
      opacity 120ms ease;
    white-space: nowrap;
  }

  .consent-btn:focus { outline: none; }

  .consent-btn:focus-visible {
    outline: 2px solid var(--consent-accent);
    outline-offset: 2px;
  }

  .consent-btn:active {
    transform: scale(0.98);
    transition-duration: 60ms;
  }

  @media (hover : hover) and (pointer : fine) {
    .consent-btn:hover { transform: translateY(-1px); }
    .consent-btn:active { transform: translateY(0) scale(0.99); }
  }

  .consent-btn--primary {
    background: var(--consent-accent);
    color: #fff;
    border-color: var(--consent-accent);
  }
  .consent-btn--primary:active {
    background: var(--consent-accent-hover);
    border-color: var(--consent-accent-hover);
  }

  @media (hover : hover) and (pointer : fine) {
    .consent-btn--primary:hover {
      background: var(--consent-accent-hover);
      border-color: var(--consent-accent-hover);
      box-shadow: 0 4px 16px color-mix(in srgb, var(--consent-accent) 38%, transparent);
    }
  }

  .consent-btn--ghost {
    background: transparent;
    color: var(--text-muted);
    border-color: var(--border-strong);
  }
  .consent-btn--ghost:active {
    color: var(--text-main);
    background: var(--bg-warm);
  }

  @media (hover : hover) and (pointer : fine) {
    .consent-btn--ghost:hover {
      color: var(--text-main);
      border-color: var(--text-muted);
      background: var(--bg-warm);
    }
  }

  .consent-btn--save {
    width: 100%;
    background: var(--consent-accent);
    color: #fff;
    border-color: var(--consent-accent);
  }
  .consent-btn--save:active {
    background: var(--consent-accent-hover);
    border-color: var(--consent-accent-hover);
  }

  @media (hover : hover) and (pointer : fine) {
    .consent-btn--save:hover {
      background: var(--consent-accent-hover);
      border-color: var(--consent-accent-hover);
    }
  }

  /* ── Personnaliser (details) ───────────────────────────── */
  .consent-details {
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .consent-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    padding: 0.7rem 0.9rem;
    background: var(--bg-warm);
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-muted);
    list-style: none;
    -webkit-user-select : none;
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color : transparent;
    transition: color 120ms ease, background 120ms ease;
  }

  .consent-summary__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .consent-summary::-webkit-details-marker { display : none; }
  .consent-summary:focus { outline: none; }
  .consent-summary:focus-visible {
    outline: 2px solid var(--consent-accent);
    outline-offset: -2px;
  }

  @media (hover : hover) and (pointer : fine) {
    .consent-summary:hover {
      color: var(--text-main);
      background: color-mix(in srgb, var(--consent-accent) 6%, var(--bg-warm));
    }
  }

  .consent-details[open] > .consent-summary {
