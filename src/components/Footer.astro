---
import NewsletterForm from "./NewsletterForm.astro";
import PushSubscribe from "./PushSubscribe.astro";
import { t, type Lang } from "../i18n/translations";

interface Props {
  lang?: "fr" | "en" | "pt-br" | "nl";
}
const { lang = "fr" } = Astro.props;

const blogHref =
  lang === "en" ? "/en/blog/" : lang === "pt-br" ? "/pt-br/blog/" : lang === "nl" ? "/nl/blog/" : "/fr/blog/";
const aboutHref =
  lang === "en" ? "/en/about/" : lang === "pt-br" ? "/pt-br/about/" : lang === "nl" ? "/nl/about/" : "/fr/about/";

const tLang: Lang = (["fr", "en", "pt-br", "nl"].includes(lang) ? lang : "fr") as Lang;
const tt = (key: string, fallback: string) => {
  const v = t(tLang, key);
  return v && typeof v === "string" ? v : fallback;
};

const signupHeadline = lang === "en"
  ? "Sign up for the latest articles, analyses and chess insights."
  : lang === "pt-br"
  ? "Inscreva-se para receber os últimos artigos e análises."
  : lang === "nl"
  ? "Meld je aan voor de nieuwste artikelen en analyses."
  : "Inscris-toi pour recevoir les derniers articles et analyses.";

const requiredNote = lang === "en"
  ? "(* indicates a required field)"
  : lang === "pt-br"
  ? "(* campo obrigatório)"
  : lang === "nl"
  ? "(* verplicht veld)"
  : "(* champ obligatoire)";
---

<footer class="footer" data-pagefind-ignore>

  <!-- ── Zone newsletter centrée avec logo + traits ── -->
  <div class="footer-signup-zone">
    <div class="container">

      <!-- Logo entre deux traits horizontaux -->
      <div class="footer-logo-divider">
        <span class="divider-line" aria-hidden="true"></span>
        <div class="footer-logo-circle">
          <img
            src="/images/logo.svg"
            alt="Blog d'un Gaucher"
            class="footer-logo-img"
            width="32"
            height="45"
            loading="lazy"
          />
        </div>
        <span class="divider-line" aria-hidden="true"></span>
      </div>

      <p class="footer-signup-headline">{signupHeadline}</p>
      <p class="footer-signup-required">{requiredNote}</p>

      <div class="footer-signup-form">
        <NewsletterForm variant="footer" lang={lang} />
      </div>

    </div>
  </div>

  <!-- ── Corps : brand à gauche | nav à droite séparés par un trait vertical ── -->
  <div class="container footer-body">

    <div class="footer-brand-col fade-up" style="--motion-delay: 60ms;">
      <p class="footer-brand-name-text" data-t="nav.siteName">{tt("nav.siteName", "Blog d'un Gaucher")}</p>
      <p class="footer-tagline" data-t="footer.tagline">
        {tt("footer.tagline", "Un espace éditorial indépendant pour explorer les échecs en profondeur, avec des contenus utiles et actionnables.")}
      </p>
      <PushSubscribe lang={lang} />
      <a class="footer-contact" href="mailto:contact@blogdungaucher.com" data-t="footer.suggestTopic">
        {tt("footer.suggestTopic", "Proposer un sujet ou poser une question")}
      </a>
    </div>

    <div class="footer-vertical-divider" aria-hidden="true"></div>

    <nav class="footer-nav-col fade-up" style="--motion-delay: 120ms;" aria-label="Navigation du pied de page">

      <div class="footer-col-group">
        <h2 class="footer-col-label" data-t="footer.exploreTitle">{tt("footer.exploreTitle", "Explorer")}</h2>
        <a href={blogHref} data-t="footer.allArticles">{tt("footer.allArticles", "Tous les articles")}</a>
        <a href={aboutHref} data-t="footer.editorial">{tt("footer.editorial", "Ligne éditoriale")}</a>
        {lang === "fr" && <a href="/fr/glossaire/">Glossaire</a>}
        {lang === "fr" && <a href="/fr/infographie/">Infographies</a>}
      </div>

      <div class="footer-col-group">
        <h2 class="footer-col-label" data-t="footer.trustTitle">{tt("footer.trustTitle", "Confiance")}</h2>
        <button
          type="button"
          class="footer-text-link"
          id="footer-open-notification-settings"
          data-t="footer.notificationSettings"
        >{tt("footer.notificationSettings", "Notifications et cookies")}</button>
      </div>

    </nav>
  </div>

  <!-- ── Barre de copyright ── -->
  <div class="footer-bottom-bar">
    <div class="container footer-bottom-bar__inner">
      <p>&copy; {new Date().getFullYear()} <span data-t="nav.siteName">{tt("nav.siteName", "Blog d'un Gaucher")}</span></p>
      <div class="footer-bottom-links">
        {/* Pages légales : seules les versions FR existent → tous les liens y pointent
            (évite un 404 sur les liens /en/ qui n'ont pas de page). */}
        <a href="/fr/mentions-legales/" data-t="footer.legal">{tt("footer.legal", "Mentions légales")}</a>
        <a href="/fr/politique-confidentialite/" data-t="footer.privacy">{tt("footer.privacy", "Confidentialité")}</a>
        <a href={aboutHref}>{lang === "en" ? "About" : lang === "pt-br" ? "Sobre" : lang === "nl" ? "Over" : "À propos"}</a>
      </div>
      <!-- Icônes pièces d'échecs en guise d'icônes sociales -->
      <div class="footer-chess-icons" aria-hidden="true">
        <span title={tt("categories.science.label", "Science")}>♞</span>
        <span title={tt("categories.esprit.label", "Esprit")}>♛</span>
        <span title={tt("categories.societe.label", "Société")}>♜</span>
      </div>
    </div>
  </div>

</footer>

<script is:inline>
  document.addEventListener("astro:page-load", function bindFooterNotifPrefs() {
    var btn = document.getElementById("footer-open-notification-settings");
    if (!btn || btn.dataset.notifBound === "1") return;
    btn.dataset.notifBound = "1";
    btn.addEventListener("click", function () {
      var manage = document.getElementById("cookie-manage");
      if (manage) manage.click();
    });
  });
</script>

<style>
  .footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border-soft);
    background: var(--bg-warm);
  }

  /* ══════════════════════════════════════════
     Zone newsletter (partie haute — style Fishwife)
  ══════════════════════════════════════════ */
  .footer-signup-zone {
    padding: 3rem 0 2.5rem;
    text-align: center;
    border-bottom: 1px solid var(--border-soft);
  }

  /* Logo entre deux traits horizontaux : ──── [O] ──── */
  .footer-logo-divider {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    max-width: 28rem;
    margin-inline: auto;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--border-soft);
  }

  .footer-logo-circle {
    flex-shrink: 0;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    border: 1px solid var(--border-soft);
    background: var(--surface);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-xs);
  }

  .footer-logo-img {
    width: 32px;
    height: 45px;
    object-fit: contain;
  }

  :global([data-theme="dark"]) .footer-logo-img {
    filter: invert(1);
  }

  .footer-signup-headline {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    font-weight: 500;
    color: var(--text-main);
    max-width: 34rem;
    margin: 0 auto 0.35rem;
    line-height: 1.4;
  }

  .footer-signup-required {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 0 0 1.35rem;
  }

  .footer-signup-form {
    display: flex;
    justify-content: center;
  }

  /* ══════════════════════════════════════════
     Corps : brand | trait | nav
  ══════════════════════════════════════════ */
  .footer-body {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0 3rem;
    padding: 2.75rem 0 2.5rem;
    align-items: start;
  }

  @media (max-width: 820px) {
    .footer-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .footer-vertical-divider {
      display: none;
    }
  }

  .footer-vertical-divider {
    width: 1px;
    background: var(--border-soft);
    align-self: stretch;
    min-height: 8rem;
  }

  /* Brand gauche */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .footer-brand-name-text {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
  }

  .footer-tagline {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
    max-width: 26rem;
    margin: 0;
  }

  .footer-contact {
    display: inline-flex;
    align-items: center;
    margin-top: 0.4rem;
    min-height: 2.1rem;
    padding: 0 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--green-border);
    background: color-mix(in srgb, var(--green-light) 72%, #fff);
    color: var(--text-main);
    font-size: 0.82rem;
    font-weight: 600;
    transition: transform 180ms var(--ease-spring), border-color 180ms ease;
  }
  .footer-contact:hover {
    transform: translateY(-1px);
    border-color: var(--green);
    color: var(--green);
  }

  /* Navigation droite */
  .footer-nav-col {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
    align-items: start;
  }

  @media (max-width: 500px) {
    .footer-nav-col {
      grid-template-columns: 1fr 1fr;
    }
  }

  .footer-col-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-col-label {
    font-size: 0.7rem;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--green);
    margin: 0 0 0.3rem;
  }

  .footer-col-group a,
  .footer-text-link {
    color: var(--text-muted);
    font-size: 0.88rem;
    transition: color 150ms ease, transform 180ms var(--ease-soft);
  }
  .footer-col-group a:hover,
  .footer-text-link:hover {
    color: var(--green);
    transform: translateX(2px);
  }

  .footer-text-link {
    display: inline;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    /* font-family seul (pas le raccourci `font`) : sinon font-size retomberait à
       `inherit` et écraserait le 0.88rem partagé avec les liens voisins. */
    font-family: inherit;
    cursor: pointer;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* ══════════════════════════════════════════
     Barre de copyright (bas — style Fishwife)
  ══════════════════════════════════════════ */
  .footer-bottom-bar {
    border-top: 1px solid var(--border-soft);
    background: color-mix(in srgb, var(--bg-warm) 80%, var(--border-soft));
  }

  .footer-bottom-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1rem 0;
    color: var(--text-dim);
    font-size: 0.82rem;
  }

  .footer-bottom-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-bottom-links a {
    color: var(--text-dim);
    font-size: 0.82rem;
    transition: color 150ms ease;
    /* Zone tactile >= 44px (norme WCAG 2.5.5 / mobile) sans grossir le texte. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.15rem;
  }
  .footer-bottom-links a:hover {
    color: var(--green);
  }

  .footer-chess-icons {
    display: flex;
    gap: 0.65rem;
    font-size: 1.15rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .footer-chess-icons span {
    cursor: default;
    transition: color 200ms ease, transform 200ms ease;
  }
  .footer-chess-icons span:hover {
    color: var(--green);
    transform: scale(1.2);
  }

  @media (max-width: 540px) {
    .footer-bottom-bar__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.6rem;
    }
    .footer-signup-zone {
      padding: 2rem 0 1.75rem;
    }
  }
</style>
