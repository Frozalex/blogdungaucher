---
import NewsletterForm from "./NewsletterForm.astro";
import { newsletterCopy, type NewsletterLang, type NewsletterCategory } from "../data/newsletter";

const { lang = "fr", category } = Astro.props as { lang?: NewsletterLang; category?: NewsletterCategory };
const c = newsletterCopy[lang] ?? newsletterCopy.fr;
const context = category && c.contexts[category];
---

<aside class="nl-cta fade-up" style="--motion-delay: 140ms;" aria-label={c.title}>
  <div class="nl-cta__inner">
    <div class="nl-cta__text">
      <span class="nl-cta__eyebrow">{c.title}</span>
      <p class="nl-cta__title">{context || c.promise}</p>
      {context && <p class="nl-cta__desc">{c.promise}</p>}
      <p class="nl-cta__note">{c.note}</p>
      <a class="nl-cta__sample" href="/fr/lettre/" hreflang="fr">{c.sample} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="nl-cta__form">
      <NewsletterForm variant="article" lang={lang} placement={category ? `article-${category}` : "article"} />
    </div>
  </div>
</aside>

<style>
  .nl-cta {
    margin: 2.5rem 0;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md, 12px);
    background: color-mix(in srgb, var(--green-light, #e8f5e9) 40%, var(--bg-warm));
    overflow: hidden;
  }

  .nl-cta__inner {
    display: flex;
    gap: 2rem;
    align-items: center;
    padding: 1.75rem 2rem;
  }

  .nl-cta__text {
    flex: 1;
    min-width: 0;
  }

  .nl-cta__eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--green);
    margin-bottom: 0.3rem;
  }

  .nl-cta__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0 0 0.3rem;
    line-height: 1.3;
  }

  .nl-cta__desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .nl-cta__note { color: var(--text-muted); font-size: .78rem; line-height: 1.5; margin: .6rem 0; }
  .nl-cta__sample { color: var(--green); font-weight: 600; font-size: .85rem; text-decoration: underline; text-underline-offset: .2em; }

  .nl-cta__form {
    flex: 0 0 300px;
    min-width: 0;
  }

  @media (max-width: 680px) {
    .nl-cta__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
      padding: 1.4rem 1.25rem;
    }

    .nl-cta__form {
      flex: none;
    }
  }
</style>
