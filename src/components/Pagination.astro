---
interface Props {
  currentPage: number;
  lastPage: number;
  /** Tableau des numéros de page à afficher (avec ellipses calculées automatiquement entre non-consécutifs). */
  pages: number[];
  /** Génère le href d'une page donnée. */
  getHref: (n: number) => string;
  prevHref?: string;
  nextHref?: string;
  ariaLabel?: string;
}

const {
  currentPage,
  lastPage,
  pages,
  getHref,
  prevHref,
  nextHref,
  ariaLabel = "Navigation entre les pages",
} = Astro.props;
---

{lastPage > 1 && (
  <nav class="pagination" aria-label={ariaLabel}>

    <!-- Flèche précédente -->
    {prevHref ? (
      <a href={prevHref} class="pag-btn pag-btn--arrow" rel="prev" aria-label="Page précédente">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </a>
    ) : (
      <span class="pag-btn pag-btn--arrow is-disabled" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </span>
    )}

    <!-- Numéros de page + ellipses -->
    <div class="pag-numbers" role="list">
      {pages.map((p, i) => {
        const prev = pages[i - 1];
        const showEllipsis = prev !== undefined && p - prev > 1;
        return (
          <>
            {showEllipsis && (
              <span class="pag-ellipsis" aria-hidden="true">…</span>
            )}
            {p === currentPage ? (
              <span class="pag-btn pag-btn--num pag-btn--current" aria-current="page" role="listitem">
                {p}
              </span>
            ) : (
              <a href={getHref(p)} class="pag-btn pag-btn--num" role="listitem" aria-label={`Page ${p}`}>
                {p}
              </a>
            )}
          </>
        );
      })}
    </div>

    <!-- Flèche suivante -->
    {nextHref ? (
      <a href={nextHref} class="pag-btn pag-btn--arrow" rel="next" aria-label="Page suivante">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </a>
    ) : (
      <span class="pag-btn pag-btn--arrow is-disabled" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </span>
    )}

  </nav>
)}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-soft);
    flex-wrap: wrap;
  }

  .pag-numbers {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Base commune à tous les boutons */
  .pag-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.2rem;
    height: 2.2rem;
    border-radius: 6px;
    border: 1px solid var(--border-soft);
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      transform 180ms var(--ease-spring);
    cursor: pointer;
    user-select: none;
    text-decoration: none;
  }

  /* Flèches : légèrement plus larges */
  .pag-btn--arrow {
    padding: 0 0.55rem;
    color: var(--text-muted);
  }

  .pag-btn--arrow:not(.is-disabled):hover {
    background: var(--surface);
    border-color: var(--green);
    color: var(--green);
    transform: scale(1.06);
  }

  .pag-btn--arrow.is-disabled {
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  /* Numéros de page */
  .pag-btn--num {
    padding: 0 0.35rem;
  }

  .pag-btn--num:not(.pag-btn--current):hover {
    border-color: var(--green);
    color: var(--green);
    background: color-mix(in srgb, var(--green) 8%, var(--surface));
    transform: translateY(-2px);
  }

  /* Page courante — remplie, vert */
  .pag-btn--current {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--green) 30%, transparent);
    cursor: default;
  }

  /* Ellipsis */
  .pag-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.2rem;
    height: 2.2rem;
    color: var(--text-dim);
    font-family: var(--font-display);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
  }

  @media (max-width: 480px) {
    .pag-btn {
      min-width: 2rem;
      height: 2rem;
      font-size: 0.82rem;
    }
    .pag-ellipsis {
      min-width: 1.5rem;
    }
  }
</style>
