---
interface Props {
  variant?: "footer" | "article";
  lang?: "fr" | "en" | "pt-br" | "nl";
  placement?: string;
}
const { variant = "footer", lang = "fr", placement = variant } = Astro.props;

const endpoint =
  (import.meta.env.PUBLIC_NEWSLETTER_URL ?? "https://blogdungaucher.com/newsletter") +
  "/subscribe";

// Placeholder + libellé bouton localisés côté serveur (le dict runtime ne couvre que fr/en).
const formCopy = {
  fr: { placeholder: "ton@email.com", submit: "S'inscrire", label: "Adresse email" },
  en: { placeholder: "your@email.com", submit: "Subscribe", label: "Email address" },
  "pt-br": { placeholder: "seu@email.com", submit: "Inscrever-se", label: "Endereço de e-mail" },
  nl: { placeholder: "jouw@email.com", submit: "Aanmelden", label: "E-mailadres" },
} as const;
const fc = formCopy[lang] ?? formCopy.fr;
---

<form
  class:list={["nl-form", `nl-form--${variant}`]}
  data-newsletter-form
  data-endpoint={endpoint}
  data-placement={placement}
  data-lang={lang}
  novalidate
>
  <div class="nl-row">
    <input
      type="email"
      name="email"
      class="nl-input"
      required
      autocomplete="email"
      placeholder={fc.placeholder}
      aria-label={fc.label}
    />
    <button type="submit" class="nl-btn" disabled>
      {fc.submit}
    </button>
  </div>
  {/*
    Pot de miel : un champ que les robots remplissent volontiers et qu'un humain
    ne voit jamais. Pas `type="hidden"` (les robots savent l'éviter) mais un champ
    réel sorti du flux visuel, retiré du parcours clavier (`tabindex="-1"`) et de
    l'arbre d'accessibilité (`aria-hidden`) pour ne piéger personne au lecteur
    d'écran. Rempli → la requête est abandonnée côté serveur.
  */}
  <div class="nl-trap" aria-hidden="true">
    <label>Site web <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <p class="nl-msg" role="status" aria-live="polite" tabindex="-1"></p>
  <noscript><p class="nl-msg">{lang === "fr" ? "Active JavaScript pour utiliser ce formulaire d’inscription." : lang === "en" ? "Enable JavaScript to use this subscription form." : lang === "pt-br" ? "Ative o JavaScript para usar este formulário." : "Schakel JavaScript in om dit formulier te gebruiken."}</p></noscript>
</form>

<script>
  import { requestNewsletterSubscription } from "../scripts/newsletter-subscription";

  function initNewsletterForms() {
    document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]").forEach((form) => {
      if (form.dataset.bound === "1") return;
      form.dataset.bound = "1";

      // Piège temporel : un robot poste dans la milliseconde, un humain met
      // quelques secondes à taper son adresse. On envoie le délai écoulé et le
      // serveur refuse en dessous d'un seuil. Filtre grossier assumé (la valeur
      // est falsifiable) : le vrai garde-fou est la limitation de débit côté
      // serveur, celui-ci ne coûte rien et écarte les robots naïfs.
      const readyAt = Date.now();

      const endpoint = form.dataset.endpoint!;
      const btn = form.querySelector<HTMLButtonElement>(".nl-btn")!;
      const msg = form.querySelector<HTMLElement>(".nl-msg")!;
      btn.disabled = false;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (btn.disabled) return;
        const lang = form.dataset.lang || "fr";
        const MSG = {
          fr:      { loading: "Inscription…",  success: "Ton inscription a été prise en compte. Merci !", errorEmail: "Saisis une adresse email valide.", error: "L’inscription n’a pas abouti. Réessaie dans un moment.", submit: "S’inscrire" },
          en:      { loading: "Subscribing…",  success: "Your subscription request was accepted. Thank you!", errorEmail: "Enter a valid email address.", error: "Your request could not be completed. Please try again later.", submit: "Subscribe" },
          "pt-br": { loading: "Inscrevendo…",  success: "Seu pedido de inscrição foi aceito. Obrigado!", errorEmail: "Digite um endereço de e-mail válido.", error: "Não foi possível concluir a inscrição. Tente novamente mais tarde.", submit: "Inscrever-se" },
          nl:      { loading: "Aanmelden…", success: "Je aanmelding is in behandeling genomen. Bedankt!", errorEmail: "Vul een geldig e-mailadres in.", error: "Aanmelden is niet gelukt. Probeer het later opnieuw.", submit: "Aanmelden" },
        };
        const T = MSG[lang as keyof typeof MSG] || MSG.fr;

        const input = form.querySelector<HTMLInputElement>('[name="email"]')!;
        const email = input.value.trim();

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          msg.textContent = T.errorEmail;
          msg.className = "nl-msg nl-msg--error";
          input.setAttribute("aria-invalid", "true");
          input.focus();
          return;
        }

        btn.disabled = true;
        input.removeAttribute("aria-invalid");
        btn.textContent = T.loading;
        msg.textContent = "";

        try {
          await requestNewsletterSubscription(endpoint, {
            email,
            website: (form.querySelector<HTMLInputElement>('[name="website"]')?.value ?? ""),
            elapsedMs: Date.now() - readyAt,
          }, form.dataset.placement || "article");
          input.disabled = true;
          form.querySelector<HTMLElement>(".nl-row")!.hidden = true;
          msg.className = "nl-msg nl-success";
          msg.textContent = T.success;
          msg.focus();
        } catch {
          msg.textContent = T.error;
          msg.className = "nl-msg nl-msg--error";
          btn.disabled = false;
          btn.textContent = T.submit;
        }
      });
    });
  }
  initNewsletterForms();
  document.addEventListener("astro:page-load", initNewsletterForms);
</script>

<style>
  .nl-form {
    display: grid;
    gap: 0.4rem;
    /* Référence de positionnement pour le pot de miel. */
    position: relative;
  }

  /* Hors écran plutôt que `display: none` : un robot qui lit le CSS saute un champ
     masqué, alors qu'il remplit volontiers un champ simplement déporté. */
  .nl-trap {
    position: absolute;
    left: -9999px;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .nl-row {
    display: flex;
    gap: 0.4rem;
  }
  .nl-row[hidden] { display: none; }

  .nl-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    /* --field-border, pas --border-soft : un contour de champ doit faire 3:1. */
    border: 1px solid var(--field-border);
    border-radius: var(--radius-sm, 6px);
    background: color-mix(in srgb, var(--bg-warm) 80%, var(--surface));
    color: var(--text-main);
    font-size: 0.85rem;
    font-family: inherit;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .nl-input:focus {
    outline: none;
    border-color: var(--green);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--green) 18%, transparent);
  }

  .nl-btn {
    flex-shrink: 0;
    padding: 0.5rem 1rem;
    border: 1px solid var(--green);
    border-radius: var(--radius-sm, 6px);
    background: var(--green);
    color: var(--on-green);
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 180ms ease, transform 180ms var(--ease-spring, cubic-bezier(.34,1.56,.64,1));
  }

  .nl-btn:hover:not(:disabled) {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .nl-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .nl-btn:focus-visible { outline: 3px solid var(--green); outline-offset: 3px; }

  .nl-msg {
    font-size: 0.82rem;
    margin: 0;
    padding: 0;
  }

  .nl-msg--error { color: var(--danger); }

  .nl-success {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--green);
    margin: 0;
  }

  /* Mobile : cibles tactiles ≥ 44px + input à 16px pour éviter le zoom
     automatique de Safari iOS au focus (déclenché si font-size < 16px). */
  @media (max-width: 560px) {
    .nl-input,
    .nl-btn {
      min-height: 44px;
    }
    .nl-input {
      font-size: 16px;
    }
  }
</style>
