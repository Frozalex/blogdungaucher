---
interface Props {
  variant?: "footer" | "article";
}
const { variant = "footer" } = Astro.props;

const endpoint =
  (import.meta.env.PUBLIC_NEWSLETTER_URL ?? "https://blogdungaucher.com/newsletter") +
  "/subscribe";
---

<form
  class:list={["nl-form", `nl-form--${variant}`]}
  data-newsletter-form
  data-endpoint={endpoint}
  novalidate
>
  <div class="nl-row">
    <input
      type="email"
      name="email"
      class="nl-input"
      required
      autocomplete="email"
      placeholder="ton@email.com"
      data-t-placeholder="newsletter.emailPlaceholder"
    />
    <button type="submit" class="nl-btn" data-t="newsletter.submit">
      S'inscrire
    </button>
  </div>
  <p class="nl-msg" aria-live="polite" hidden></p>
</form>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLFormElement>("[data-newsletter-form]").forEach((form) => {
      if (form.dataset.bound === "1") return;
      form.dataset.bound = "1";

      const endpoint = form.dataset.endpoint!;
      const btn = form.querySelector<HTMLButtonElement>(".nl-btn")!;
      const msg = form.querySelector<HTMLElement>(".nl-msg")!;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const lang = (document.documentElement.lang ?? "fr") as "fr" | "en";
        const T = {
          loading:    lang === "en" ? "Subscribing…" : "Inscription…",
          success:    lang === "en" ? "You’re subscribed!" : "Inscription confirmée !",
          errorEmail: lang === "en" ? "Invalid email address." : "Adresse email invalide.",
          error:      lang === "en" ? "An error occurred. Please try again." : "Une erreur s’est produite. Réessaie.",
          submit:     lang === "en" ? "Subscribe" : "S’inscrire",
        };

        const email = (form.querySelector<HTMLInputElement>('[name="email"]')!).value.trim();

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          msg.textContent = T.errorEmail;
          msg.className = "nl-msg nl-msg--error";
          msg.hidden = false;
          return;
        }

        btn.disabled = true;
        btn.textContent = T.loading;
        msg.hidden = true;

        try {
          const r = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email }),
          });
          if (r.ok) {
            form.innerHTML = `<p class="nl-success">${T.success}</p>`;
          } else {
            throw new Error();
          }
        } catch {
          msg.textContent = T.error;
          msg.className = "nl-msg nl-msg--error";
          msg.hidden = false;
          btn.disabled = false;
          btn.textContent = T.submit;
        }
      });
    });
  });
</script>

<style>
  .nl-form {
    display: grid;
    gap: 0.4rem;
  }

  .nl-row {
    display: flex;
    gap: 0.4rem;
  }

  .nl-input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm, 6px);
    background: color-mix(in srgb, var(--bg-warm) 80%, #fff);
    color: var(--text-main);
    font-size: 0.85rem;
    font-family: inherit;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .nl-input:focus {
    outline: none;
    border-color: var(--green);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--green) 18%, transparent);
  }

  .nl-btn {
    flex-shrink: 0;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: var(--radius-sm, 6px);
    background: var(--green);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 180ms ease, transform 180ms var(--ease-spring, cubic-bezier(.34,1.56,.64,1));
  }

  .nl-btn:hover:not(:disabled) {
    opacity: 0.88;
    transform: translateY(-1px);
  }

  .nl-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .nl-msg {
    font-size: 0.82rem;
    margin: 0;
    padding: 0;
  }

  .nl-msg--error { color: #e05252; }

  .nl-success {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--green);
    margin: 0;
  }
</style>
