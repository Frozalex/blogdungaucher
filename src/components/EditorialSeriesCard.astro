---
import { getPostHeroSrc, calculateReadingTime, formatDateForLang, getLocalizedPostText, type BlogEntry } from "../utils/blog";
import { buildSrcset } from "../utils/image-variants";
import { editorialUi } from "../data/editorial-ui";
import type { SiteLang } from "../utils/lang-paths";
interface Props {lang?:SiteLang; post?: BlogEntry; illustrationPost?: BlogEntry; href?: string | null; title: string; excerpt?: string | null; verification?: string; pilier?: boolean; }
const { lang="fr",post, illustrationPost = post, href, title, excerpt, verification, pilier = false } = Astro.props;
const L=editorialUi(lang);
const localized=illustrationPost?await getLocalizedPostText(illustrationPost,lang):null;
const image = illustrationPost ? getPostHeroSrc(illustrationPost) : null;
const hero = illustrationPost?.data.heroImage;
const Tag = href ? "a" : "div";
---
<article class:list={["series-card", { "series-card--pending": !href }]}>
  <Tag class="series-card__link" href={href || undefined}>
    {image && <div class="series-card__visual"><img src={image} srcset={buildSrcset(image)} sizes="(min-width: 900px) 360px, (min-width: 640px) 45vw, 100vw" alt={localized?.heroImageAlt || hero?.alt || ""} width="1200" height="800" loading="lazy" /></div>}
    <div class="series-card__body">
      {(!href || pilier) && <span class="series-card__kicker">{!href ? ({fr:"À venir",en:"Coming soon","pt-br":"Em breve",nl:"Binnenkort"}[lang]) : ({fr:"Article repère",en:"Key article","pt-br":"Artigo de referência",nl:"Basisartikel"}[lang])}</span>}
      <h3>{title}</h3>
      {excerpt && <p class="series-card__excerpt">{excerpt}</p>}
      {verification && <p class="series-card__verification"><span>À vérifier par toi-même</span>{verification}</p>}
      {post && href && <div class="series-card__meta"><time datetime={post.data.publishDate.toISOString()}>{formatDateForLang(post.data.publishDate,lang)}</time><span aria-hidden="true">·</span><span>{post.data.readingTime || calculateReadingTime(post.body ?? "")} {L.reading}</span></div>}
    </div>
  </Tag>
  {image && (hero?.credit || hero?.sourceUrl || hero?.license) && <p class="series-card__credit">{hero?.credit && <span>{L.credit} : {hero.credit} </span>}{hero?.sourceUrl && <a href={hero.sourceUrl} target="_blank" rel="noopener noreferrer">{L.source} ↗ </a>}{hero?.license && <span>{hero.license}</span>}</p>}
</article>
<style>
.series-card{min-width:0;}.series-card__link{display:block;color:var(--text-main);}.series-card__visual{aspect-ratio:3/2;background:var(--bg-warm);overflow:hidden;border-radius:3px;}.series-card__visual img{display:block;width:100%;height:100%;object-fit:cover;}.series-card__body{padding-top:1rem;}.series-card__kicker{display:block;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--green);margin-bottom:.6rem;font-weight:600;}.series-card--pending .series-card__kicker{color:var(--text-dim);}.series-card h3{font:600 1.45rem/1.22 var(--font-serif);letter-spacing:-.025em;margin:0;text-wrap:pretty;}a.series-card__link:hover h3{color:var(--green);}.series-card__excerpt{font-size:.9rem;line-height:1.7;color:var(--text-muted);margin:.8rem 0 0;}.series-card__meta{display:flex;flex-wrap:wrap;gap:.45rem;font-size:.72rem;color:var(--text-dim);margin-top:1rem;}.series-card__verification{font-size:.82rem;color:var(--text-muted);line-height:1.6;margin:1rem 0 0;padding-top:.7rem;border-top:1px solid var(--border-strong);}.series-card__verification>span{display:block;font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;color:var(--green);margin-bottom:.35rem;}.series-card__credit{font-size:.65rem;line-height:1.6;color:var(--text-dim);margin:.6rem 0 0;}.series-card__credit a{text-decoration:underline;text-underline-offset:.2em;}
@media(max-width:640px){.series-card h3{font-size:1.35rem;}}
</style>
