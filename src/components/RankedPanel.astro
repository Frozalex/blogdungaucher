---
/**
 * Panneau « Les plus lus » — même en-tête que FilPanel. Chaque entrée : numéro
 * en serif italique à gauche (colonne 32px), titre à droite. Présentationnel.
 */
export interface RankedItem {
  href: string;
  title: string;
}
interface Props {
  items: RankedItem[];
  heading: string;
}
const { items, heading } = Astro.props;
---
<aside class="ranked">
  <div class="ranked__head">{heading}</div>
  <ol class="ranked__list">
    {items.map((it, i) => (
      <li class="ranked__item">
        <span class="ranked__num" aria-hidden="true">{i + 1}</span>
        <a class="ranked__title" href={it.href}>{it.title}</a>
      </li>
    ))}
  </ol>
</aside>

<style>
  .ranked {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ranked__head {
    padding: 0.85rem 1.15rem;
    background: #1c1a16;
    color: #f0ebe0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.14rem;
    line-height: 1;
  }
  .ranked__list {
    list-style: none;
    margin: 0;
    padding: 0.35rem 1.15rem 0.6rem;
  }
  .ranked__item {
    display: grid;
    grid-template-columns: 32px 1fr;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .ranked__item:last-child { border-bottom: none; }
  .ranked__num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--text-dim);
    text-align: center;
  }
  .ranked__title {
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text-main);
    transition: color 160ms ease;
  }
  .ranked__title:hover { color: var(--green); }
</style>
