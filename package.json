{
  "name": "blog-d-un-gaucher",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-og-png.mjs && node scripts/generate-image-variants.mjs && node scripts/check-publish-weekly.mjs && node scripts/generate-pinterest.mjs && astro build && pagefind --site dist --glob \"{fr,en,pt-br,nl}/blog/**/*.html\" && node scripts/strip-inline-script-comments.mjs && node scripts/add-image-srcset.mjs && node scripts/add-image-dimensions.mjs && node scripts/defer-article-images.mjs && node scripts/finalize-public-navigation.mjs && node scripts/verify-dist-urls.mjs && node scripts/check-dead-links.mjs && node scripts/check-pinterest.mjs",
    "build:clean": "node scripts/build-clean.mjs",
    "strip:em-dash": "node scripts/strip-em-dash.mjs",
    "strip:em-dash:dry": "node scripts/strip-em-dash.mjs --dry",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "serpmantics": "node scripts/serpmantics.mjs",
    "check:publish-weekly": "node scripts/check-publish-weekly.mjs",
    "check:link-timing": "node scripts/check-internal-link-timing.mjs",
    "check:dead-links": "node scripts/check-dead-links.mjs",
    "apply:publish-schedule": "node scripts/apply-future-publish-schedule.mjs",
    "pair:week-themes": "node scripts/pair-week-themes.mjs",
    "preview": "astro preview",
    "pdfs": "node scripts/generate-pdfs.mjs",
    "build:pdfs": "npm run build && npm run pdfs",
    "docx": "node scripts/generate-docx.mjs",
    "docx:en": "node scripts/generate-docx-en.mjs",
    "notify": "node scripts/notify-ntfy.mjs",
    "check": "astro check",
    "check:languages": "node scripts/check-language-regression.mjs",
    "test": "node --test scripts/*.test.mjs",
    "pinterest:preview": "node scripts/generate-pinterest.mjs --at=2026-11-08T15:00:00Z --out=work/pinterest-preview",
    "check:pinterest": "node scripts/check-pinterest.mjs",
    "check:pinterest-preview": "npm run pinterest:preview && node scripts/check-pinterest.mjs --preview",
    "pinterest:campaign": "node scripts/prepare-pinterest-campaign.mjs",
    "check:pinterest-variants": "node scripts/generate-pinterest.mjs --at=2027-04-20T15:00:00Z --out=work/pinterest-preview-variants && node scripts/check-pinterest.mjs --preview --dir=work/pinterest-preview-variants",
    "pinterest:media:data": "node scripts/pinterest/media/prepare-data.mjs",
    "pinterest:media:html": "node scripts/pinterest/media/motion.mjs",
    "pinterest:media:video": "node scripts/pinterest/media/render-video.mjs",
    "pinterest:media:math": "node scripts/pinterest/media/render-math.mjs",
    "pinterest:media:pdf": "python3 scripts/pinterest/media/render-pdf.py && node scripts/pinterest/media/render-pdf-previews.mjs",
    "pinterest:media:verify": "node scripts/pinterest/media/verify-assets.mjs",
    "pinterest:media:storyboards": "node scripts/pinterest/media/storyboards.mjs",
    "pinterest:media:review": "node scripts/pinterest/media/review-html.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.3",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/outfit": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "astro": "^7.4.0",
    "cheerio": "^1.2.0",
    "chess.js": "^1.4.0",
    "chessboard-element": "^1.2.0",
    "docx": "^9.7.1",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.19.0",
    "marked": "^18.0.2",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "stockfish": "^18.0.7",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "pagefind": "^1.3.0",
    "puppeteer": "^25.0.4",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "katex": "$katex"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=9.6.5"
  }
}
