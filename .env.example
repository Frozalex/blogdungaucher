# ── Variables locales pour `npm run build` / dev Astro ──────────────────────
# Copier vers `.env` si besoin (le fichier `.env` est ignoré par git).
# Les secrets CI/CD ne vont PAS ici : GitHub → Settings → Secrets → Actions.

# ntfy Web Push (côté navigateur — clé VAPID publique du serveur ntfy)
# Générer les clés : docker compose exec ntfy ntfy webpush keys
# Puis renseigner web-push-public-key dans ntfy/server.yml
PUBLIC_NTFY_URL=https://ntfy.blogdungaucher.com
PUBLIC_NTFY_TOPIC=blog-gaucher
# Clé VAPID publique (copiée depuis la sortie de `ntfy webpush keys`)
PUBLIC_NTFY_VAPID_KEY=

# ── remark42 (commentaires auto-hébergés) ───────────────────────────────────
# https://remark42.com/docs/
# Instance remark42 auto-hébergée via Docker (docker-compose.yml)
PUBLIC_REMARK42_URL=https://remark42.blogdungaucher.com
PUBLIC_REMARK42_SITE=blog-gaucher
# Secret de signature remark42 (chaîne aléatoire, par ex. openssl rand -hex 32)
REMARK42_SECRET=
# OAuth GitHub (optionnel — permet aux lecteurs de s’authentifier avec GitHub)
REMARK42_GITHUB_CID=
REMARK42_GITHUB_CSEC=
# USER_ID GitHub de l’admin (récupéré via /api/v1/admin/user après connexion)
REMARK42_ADMIN_ID=

# Google AdSense : slots d’unités publicitaires (optionnel si renseignés dans src/data/site.ts)
PUBLIC_ADSENSE_SLOT=
PUBLIC_ADSENSE_SLOT_LEADERBOARD=
PUBLIC_ADSENSE_SLOT_ARTICLE=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ── Newsletter — Hostinger Reach ────────────────────────────────────────────
# Token API Hostinger (Reach > Paramètres API dans le dashboard Hostinger)
HOSTINGER_REACH_API_TOKEN=
# URL publique du proxy newsletter (docker-compose newsletter-proxy → Nginx)
PUBLIC_NEWSLETTER_URL=https://blogdungaucher.com/newsletter
# Origine autorisée par le proxy (CORS)
NEWSLETTER_ALLOWED_ORIGIN=https://blogdungaucher.com

# Serpmantics (scripts/serpmantics.mjs — SEO éditorial, usage local uniquement)
# https://app.serpmantics.com/
SERPMANTICS_API_KEY=

# ── ntfy (notifications push auto-hébergées — scripts/notify-ntfy.mjs) ──
# https://docs.ntfy.sh/
# Serveur ntfy auto-hébergé via Docker (docker-compose.yml)
NTFY_URL=https://ntfy.blogdungaucher.com
NTFY_TOPIC=blog-gaucher
# Token créé avec : docker compose exec ntfy ntfy user token add <username>
NTFY_TOKEN=

# ── Secrets réservés à GitHub Actions (ne pas mettre dans .env versionné) ──
# DEPLOY_HOST          : hôte SSH du VPS
# DEPLOY_USER          : utilisateur SSH de déploiement
# DEPLOY_SSH_KEY       : clé privée PEM (multi-ligne)
# NTFY_URL             : URL ntfy (même valeur qu'au-dessus, en secret CI)
# NTFY_TOKEN           : token Bearer ntfy (secret CI)
# PUBLIC_NTFY_VAPID_KEY: clé VAPID publique (même valeur, secret CI)
